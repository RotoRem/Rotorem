---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import reviewsData from '../data/google-reviews.json';
import { formatReviewDate, getLocalizedReviewComment } from '../utils/googleReviews';

interface Props {
  title?: string;
  subtitle?: string;
  prioritizeAppliance?: string;
}

type DisplayReview = {
  name: string;
  date: string;
  rating: number;
  text: string;
  appliance: string;
};

const { title: titleOverride, subtitle: subtitleOverride, prioritizeAppliance } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEN = lang === 'en';
const reviewLang = isEN ? 'en' : 'bg';

const title = titleOverride ?? (isEN ? 'Customer Reviews' : 'Отзиви от клиенти');
const subtitle = subtitleOverride ?? (isEN
  ? 'See what our customers say about our repair services'
  : 'Вижте какво казват нашите клиенти за ремонтните ни услуги');

const applianceKeywords: Record<string, RegExp> = {
  Фурна: /фурн|oven/i,
  Бойлер: /бойлер|water heater|boiler/i,
  Пералня: /перал|washing machine/i,
  Съдомиялна: /съдомиял|dishwasher/i,
  Сушилня: /сушил|dryer/i,
};

function commentMatchesAppliance(comment: string, appliance: string): boolean {
  const pattern = applianceKeywords[appliance];
  return pattern ? pattern.test(comment) : comment.toLowerCase().includes(appliance.toLowerCase());
}

function buildGoogleReviews(appliance?: string): DisplayReview[] {
  const raw = reviewsData.accounts
    .flatMap((account) => account.locations)
    .flatMap((location) => location.reviews)
    .filter((review) => ['FOUR', 'FIVE'].includes(review.starRating) && review.comment);

  const mapped = raw.map((review) => {
    const comment = review.comment ?? '';
    return {
      name: review.reviewer.displayName || (isEN ? 'Google User' : 'Google потребител'),
      date: formatReviewDate(review.createTime, reviewLang),
      rating: review.starRating === 'FIVE' ? 5 : 4,
      text: getLocalizedReviewComment(comment, reviewLang),
      appliance: appliance ?? (isEN ? 'Appliance repair' : 'Ремонт на уред'),
      comment,
    };
  });

  if (appliance) {
    mapped.sort((a, b) => {
      const aMatch = commentMatchesAppliance(a.comment, appliance);
      const bMatch = commentMatchesAppliance(b.comment, appliance);
      if (aMatch === bMatch) return 0;
      return aMatch ? -1 : 1;
    });
  }

  return mapped.slice(0, 3).map(({ comment: _comment, ...review }) => review);
}

const fallbackReviews: DisplayReview[] = [
  {
    name: isEN ? 'Velizar Dimov' : 'Велизар Димов',
    date: isEN ? 'June 20, 2025' : '20 юни, 2025',
    rating: 5,
    text: isEN
      ? 'Very very satisfied! They responded instantly, super competent, the problem with the dishwasher was solved. Wife happy, me calm :) huge THANKS TO THE TEAM!'
      : 'Много много доволен ! Реагираха мигновенно,супер компетентни,проблема беше решен със съдомиялната машина.Жената доволна аз спокоен :) огромно БЛАГОДАРЯ НА ЕКИПА !',
    appliance: isEN ? 'Dishwasher' : 'Съдомиялна',
  },
  {
    name: isEN ? 'Martin Ivanov' : 'Мартин Иванов',
    date: isEN ? 'June 15, 2025' : '15 юни, 2025',
    rating: 5,
    text: isEN
      ? 'I had a problem with the water heater. After I called, the next day Mr. N. Ivanov responded and quickly fixed the damage. I recommend!'
      : 'Имах проблем с бойлера.След като се обадих на другия ден г-н Н.Иванов се отзова и бързо отстрани повредата.Препоръчвам!',
    appliance: isEN ? 'Water Heater' : 'Бойлер',
  },
  {
    name: isEN ? 'Desislava Zlateva' : 'Десислава Златева',
    date: isEN ? 'June 10, 2025' : '10 юни, 2025',
    rating: 5,
    text: isEN
      ? 'Quality and fast service! I recommend!'
      : 'Качествено и бързо обслужване! Препоръчвам!',
    appliance: isEN ? 'Washing Machine' : 'Пералня',
  },
];

function reviewMatchesPriority(review: DisplayReview, priority: string): boolean {
  if (commentMatchesAppliance(review.text, priority)) return true;
  const pattern = applianceKeywords[priority];
  if (pattern?.test(review.appliance)) return true;
  return review.appliance.toLowerCase().includes(priority.toLowerCase());
}

function sortReviewsByAppliance(reviews: DisplayReview[], priority: string): DisplayReview[] {
  return [...reviews].sort((a, b) => {
    const aMatch = reviewMatchesPriority(a, priority);
    const bMatch = reviewMatchesPriority(b, priority);
    if (aMatch === bMatch) return 0;
    return aMatch ? -1 : 1;
  });
}

const googleReviews = prioritizeAppliance ? buildGoogleReviews(prioritizeAppliance) : [];
const sortedReviews: DisplayReview[] = prioritizeAppliance
  ? googleReviews.length > 0
    ? googleReviews
    : sortReviewsByAppliance(fallbackReviews, prioritizeAppliance)
  : fallbackReviews;
---

<section id="reviews" class="py-16 md:py-20 bg-gradient-to-b from-white to-gray-50">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900">{title}</h2>
      <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
      <p class="mt-4 text-lg md:text-xl text-gray-700">{subtitle}</p>
    </div>
    
    <!-- Desktop layout - grid of cards -->
    <div class="mt-12 hidden md:grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {sortedReviews.map(review => (
        <div class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="font-semibold text-lg text-gray-900">{review.name}</h3>
              <p class="text-sm text-gray-500 mt-1">{review.date}</p>
            </div>
            <div class="flex">
              {Array.from({ length: review.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-yellow-500" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
              ))}
            </div>
          </div>
          
          <p class="mt-4 text-gray-600">{review.text}</p>
          
          <div class="mt-4 pt-4 border-t border-gray-100">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
              {review.appliance}
            </span>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Mobile layout - single prominent card with pagination -->
    <div class="mt-8 md:hidden">
      <div id="customer-review-carousel" class="relative">
        <!-- Visually enhanced card with border accent and background -->
        <div class="bg-white rounded-lg shadow-md border border-gray-100 overflow-hidden">
          <div class="border-l-4 border-amber-500 p-5">
            <div class="flex justify-between items-start mb-3">
              <div>
                <h3 id="customer-review-name" class="font-semibold text-gray-900">{sortedReviews[0].name}</h3>
                <p id="customer-review-date" class="text-sm text-gray-500">{sortedReviews[0].date}</p>
              </div>
              <div class="flex">
                {Array.from({ length: 5 }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-yellow-500" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                ))}
              </div>
            </div>
            
            <div class="min-h-[100px]">
              <p id="customer-review-text" class="text-gray-700">{sortedReviews[0].text}</p>
            </div>
            
            <div class="mt-4 pt-3 border-t border-gray-200 flex justify-between items-center">
              <span id="customer-review-appliance" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                {sortedReviews[0].appliance}
              </span>
              
              <!-- "Verified customer" badge -->
              <span class="inline-flex items-center text-xs text-green-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                {isEN ? 'Verified customer' : 'Проверен клиент'}
              </span>
            </div>
          </div>
        </div>
        
        <!-- Navigation arrows and pagination dots with styling -->
        <div class="flex justify-between items-center mt-4">
          <button id="customer-review-prev" type="button" class="review-nav-btn w-10 h-10 flex items-center justify-center rounded-full bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 active:bg-gray-100 shadow-sm touch-manipulation" aria-label={isEN ? 'Previous review' : 'Предишен отзив'}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          
          <div class="flex gap-1.5">
            <span class="customer-review-dot w-2.5 h-2.5 rounded-full bg-primary"></span>
            <span class="customer-review-dot w-2.5 h-2.5 rounded-full bg-gray-300"></span>
            <span class="customer-review-dot w-2.5 h-2.5 rounded-full bg-gray-300"></span>
          </div>
          
          <button id="customer-review-next" type="button" class="review-nav-btn w-10 h-10 flex items-center justify-center rounded-full bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 active:bg-gray-100 shadow-sm touch-manipulation" aria-label={isEN ? 'Next review' : 'Следващ отзив'}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Simple call to action below reviews - PHONE ONLY NOW -->
      <div class="mt-8 text-center">
        <a 
          href="tel:0898340982"
          class="inline-flex items-center justify-center px-5 py-2.5 bg-primary text-white rounded-lg font-medium shadow-sm hover:bg-primary-dark transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          {isEN ? 'Join our satisfied customers' : 'Присъединете се към доволните ни клиенти'}
        </a>
        <!-- Additional info text for phone booking -->
        <div class="mt-3 text-center text-gray-700 text-sm">
          <p>{isEN ? 'Call to schedule your repair appointment' : 'Обадете се за запазване на час за ремонт'}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ reviewData: sortedReviews.map((r) => ({ name: r.name, date: r.date, text: r.text, appliance: r.appliance })) }}>
  // Mobile review carousel — unique IDs to avoid conflict with Hero carousel
  function initCustomerReviewCarousel() {
    let currentIndex = 0;
    
    const nameElement = document.getElementById('customer-review-name');
    const dateElement = document.getElementById('customer-review-date');
    const textElement = document.getElementById('customer-review-text');
    const applianceElement = document.getElementById('customer-review-appliance');
    const prevButton = document.getElementById('customer-review-prev');
    const nextButton = document.getElementById('customer-review-next');
    const dots = document.querySelectorAll('.customer-review-dot');
    const carouselElement = document.getElementById('customer-review-carousel');

    if (!nameElement || !dateElement || !textElement || !applianceElement || !carouselElement || !reviewData?.length) {
      return;
    }
    
    function updateReview(index) {
      carouselElement.classList.add('opacity-0');
      
      setTimeout(() => {
        nameElement.textContent = reviewData[index].name;
        dateElement.textContent = reviewData[index].date;
        textElement.textContent = reviewData[index].text;
        applianceElement.textContent = reviewData[index].appliance;
        
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.remove('bg-gray-300');
            dot.classList.add('bg-primary');
          } else {
            dot.classList.remove('bg-primary');
            dot.classList.add('bg-gray-300');
          }
        });
        
        carouselElement.classList.remove('opacity-0');
      }, 200);
    }
    
    prevButton?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + reviewData.length) % reviewData.length;
      updateReview(currentIndex);
    });
    
    nextButton?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % reviewData.length;
      updateReview(currentIndex);
    });
    
    let touchStartX = 0;
    let touchEndX = 0;
    
    carouselElement.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    carouselElement.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchEndX < touchStartX - 50) {
        currentIndex = (currentIndex + 1) % reviewData.length;
        updateReview(currentIndex);
      } else if (touchEndX > touchStartX + 50) {
        currentIndex = (currentIndex - 1 + reviewData.length) % reviewData.length;
        updateReview(currentIndex);
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomerReviewCarousel);
  } else {
    initCustomerReviewCarousel();
  }
</script>

<style>
  /* Enhanced styling for mobile reviews */
  #customer-review-carousel {
    transition: opacity 0.2s ease-in-out;
  }
  
  .review-nav-btn {
    transition: all 0.2s ease;
  }
  
  .review-nav-btn:active {
    transform: scale(0.95);
  }
</style>
