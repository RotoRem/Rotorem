<style>
  /* Hide scrollbar while allowing scrolling */
  .scrollbar-hide {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
  
  /* Ensure proper text contrast and readability */
  .text-shadow {
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }
  
  /* Smooth transitions for hover states */
  a, button {
    transition: all 0.2s ease-in-out;
  }

  .hero-review-full[hidden] {
    display: none;
  }
</style>

<script define:vars={{ mobileReviews, readMoreLabel: isEN ? 'Read more' : 'Прочети повече', readLessLabel: isEN ? 'Show less' : 'Виж по-малко' }}>
  document.addEventListener('DOMContentLoaded', () => {

    const reviewsGrid = document.getElementById('desktop-reviews-grid');

    reviewsGrid?.addEventListener('click', (event) => {
      const toggle = event.target.closest('.hero-review-toggle');
      if (!toggle) return;

      const card = toggle.closest('.hero-review-card');
      if (!card) return;

      const shortText = card.querySelector('.hero-review-short');
      const fullText = card.querySelector('.hero-review-full');
      if (!shortText || !fullText) return;

      const expanded = toggle.getAttribute('aria-expanded') === 'true';

      if (expanded) {
        shortText.hidden = false;
        fullText.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.textContent = readMoreLabel;
      } else {
        shortText.hidden = true;
        fullText.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = readLessLabel;
      }
    });

    const nameElement = document.getElementById('review-name');
    const dateElement = document.getElementById('review-date');
    const textElement = document.getElementById('review-text');
    const reviewLink = document.getElementById('review-link');

    const prevButton = document.getElementById('review-prev');
    const nextButton = document.getElementById('review-next');
    const dotsContainer = document.getElementById('review-dots');

    let current = 0;

    function renderDots() {
      dotsContainer.innerHTML = mobileReviews
        .map((_, i) => `
          <span
            class="w-2 h-2 rounded-full ${
              i === current ? 'bg-primary' : 'bg-gray-300'
            }">
          </span>
        `)
        .join('');
    }

    function render() {

      const review = mobileReviews[current];

      nameElement.textContent = review.authorName;
      dateElement.textContent = review.date;
      textElement.textContent = review.text;
      reviewLink.href = review.url;

      renderDots();
    }

    prevButton?.addEventListener('click', () => {
      current = (current - 1 + mobileReviews.length) % mobileReviews.length;
      render();
    });

    nextButton?.addEventListener('click', () => {
      current = (current + 1) % mobileReviews.length;
      render();
    });

    render();

  });
</script>