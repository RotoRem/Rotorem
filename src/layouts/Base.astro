  <!-- Updated script for mobile menu, modal interactions, and dataLayer tracking -->
  <script type="module">
    // Initialize dataLayer tracking helper
    const trackDataLayerEvent = (eventData) => {
      if (window.dataLayer) {
        window.dataLayer.push({
          ...eventData,
          timestamp: Date.now(),
          page_path: window.location.pathname,
        });

        if (
          location.hostname === 'localhost' ||
          location.hostname.includes('netlify')
        ) {
          console.log('📍 Interaction Event:', eventData);
        }
      }
    };

    document.addEventListener('DOMContentLoaded', function() {
      // Mobile menu functionality
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const closeMenuButton = document.getElementById('close-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuLinks = document.querySelectorAll('#mobile-menu nav a');
      const menuPanel = mobileMenu?.querySelector('div');
      const floatingButton = document.getElementById('floating-phone-btn');
      
      // Mobile cities → services
      const serviceToggleButtons = document.querySelectorAll('[data-mobile-services-toggle]');
      const serviceSubmenus = document.querySelectorAll('[data-mobile-services-submenu]');
      const citiesToggle = document.querySelector('[data-mobile-cities-toggle]');
      const citiesPanel = document.querySelector('[data-mobile-cities-panel]');
      const citiesArrow = citiesToggle?.querySelector('[data-mobile-cities-arrow]');

      const resetServicesSubmenus = () => {
        serviceSubmenus.forEach((submenu) => submenu.classList.add('hidden'));
        serviceToggleButtons.forEach((toggle) => {
          const arrow = toggle.querySelector('[data-mobile-services-arrow]');
          if (arrow) arrow.setAttribute('style', 'transform: rotate(0deg)');
        });
      };

      const setCitiesOpen = (open) => {
        if (!citiesPanel) return;
        citiesPanel.classList.toggle('hidden', !open);
        if (citiesArrow) citiesArrow.setAttribute('style', `transform: rotate(${open ? 90 : 0}deg)`);
        if (!open) resetServicesSubmenus();
      };

      function openMenu() {
        if (mobileMenu && menuPanel) {
          mobileMenu.classList.remove('hidden');
          menuPanel.classList.add('slide-in-right');
          document.body.style.overflow = 'hidden';
          if (floatingButton) floatingButton.style.display = 'none';

          // Track menu open
          trackDataLayerEvent({
            event: 'menu_open',
            category: 'Navigation',
            action: 'opened',
            label: 'Mobile Menu',
          });
        }
      }

      function closeMenu() {
        if (mobileMenu && menuPanel) {
          menuPanel.classList.add('slide-out-right');
          menuPanel.classList.remove('slide-in-right');

          setTimeout(() => {
            mobileMenu.classList.add('hidden');
            menuPanel.classList.remove('slide-out-right');
            document.body.style.overflow = '';
            if (floatingButton) floatingButton.style.display = 'flex';
            setCitiesOpen(false);
          }, 300);

          // Track menu close
          trackDataLayerEvent({
            event: 'menu_close',
            category: 'Navigation',
            action: 'closed',
            label: 'Mobile Menu',
          });
        }
      }

      if (citiesToggle) {
        citiesToggle.addEventListener('click', () => {
          const shouldOpen = citiesPanel?.classList.contains('hidden');
          setCitiesOpen(Boolean(shouldOpen));

          if (shouldOpen) {
            trackDataLayerEvent({
              event: 'cities_menu_open',
              category: 'Navigation',
              action: 'opened',
              label: 'Cities',
            });
          }
        });
      }

      serviceToggleButtons.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const key = toggle.getAttribute('data-mobile-services-toggle');
          const submenu = key ? document.querySelector(`[data-mobile-services-submenu="${key}"]`) : null;
          const arrow = toggle.querySelector('[data-mobile-services-arrow]');

          if (!submenu) return;

          const shouldOpen = submenu.classList.contains('hidden');
          resetServicesSubmenus();

          if (shouldOpen) {
            submenu.classList.remove('hidden');
            if (arrow) arrow.setAttribute('style', 'transform: rotate(90deg)');

            trackDataLayerEvent({
              event: 'service_submenu_open',
              category: 'Navigation',
              action: 'opened',
              label: key,
            });
          }
        });
      });

      const citiesDropdown = document.querySelector('.cities-dropdown');
      const citiesDesktopToggle = citiesDropdown?.querySelector('.cities-toggle');

      if (citiesDropdown && citiesDesktopToggle) {
        citiesDesktopToggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const open = citiesDropdown.classList.toggle('is-open');
          citiesDesktopToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        citiesDropdown.querySelectorAll('.city-row-btn').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.stopPropagation();
            const row = button.closest('.city-row');
            if (!row) return;
            const willOpen = !row.classList.contains('is-open');
            citiesDropdown.querySelectorAll('.city-row.is-open').forEach((openRow) => {
              openRow.classList.remove('is-open');
            });
            if (willOpen) row.classList.add('is-open');
          });
        });

        document.addEventListener('click', (event) => {
          if (!citiesDropdown.contains(event.target)) {
            citiesDropdown.classList.remove('is-open');
            citiesDesktopToggle.setAttribute('aria-expanded', 'false');
            citiesDropdown.querySelectorAll('.city-row.is-open').forEach((openRow) => {
              openRow.classList.remove('is-open');
            });
          }
        });
      }

      if (mobileMenuButton) mobileMenuButton.addEventListener('click', openMenu);
      if (closeMenuButton) closeMenuButton.addEventListener('click', closeMenu);
      
      if (mobileMenu) {
        mobileMenu.addEventListener('click', function(event) {
          if (event.target === mobileMenu) closeMenu();
        });
      }
      
      mobileMenuLinks.forEach(link => {
        link.addEventListener('click', () => {
          const href = link.getAttribute('href');
          const text = link.textContent || '';

          // Track navigation link click
          trackDataLayerEvent({
            event: 'click',
            category: 'Navigation',
            action: 'clicked',
            label: text.trim(),
            url: href,
          });

          closeMenu();
        });
      });

      // SEO Sections
      const seoSections = document.querySelectorAll('.rotorem-seo-text');
      const isEnglish = document.documentElement.lang === 'en' || window.location.pathname.startsWith('/en/');
      const readMoreLabel = isEnglish ? 'Read more' : 'Прочети повече';
      const readLessLabel = isEnglish ? 'See less' : 'Виж по-малко';

      seoSections.forEach((section) => {
        const container = section.querySelector('.container') || section;

        const elements = Array.from(container.children);
        if (elements.length <= 2) return;

        const details = document.createElement('details');
        details.className = 'rotorem-seo-details';

        const summary = document.createElement('summary');
        summary.className = 'rotorem-seo-summary';
        const labelText = section.getAttribute('data-read-more-label') || readMoreLabel;
        const lessLabelText = section.getAttribute('data-read-less-label') || readLessLabel;
        const labelSpan = document.createElement('span');
        labelSpan.textContent = labelText;

        const chevron = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        chevron.setAttribute('viewBox', '0 0 24 24');
        chevron.setAttribute('fill', 'none');
        chevron.setAttribute('stroke', 'currentColor');
        chevron.setAttribute('stroke-width', '2');
        chevron.setAttribute('stroke-linecap', 'round');
        chevron.setAttribute('stroke-linejoin', 'round');

        const polyline = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
        polyline.setAttribute('points', '6 9 12 15 18 9');
        chevron.appendChild(polyline);

        summary.appendChild(labelSpan);
        summary.appendChild(chevron);
        details.appendChild(summary);

        const hiddenWrapper = document.createElement('div');
        hiddenWrapper.className = 'rotorem-seo-body';

        elements.slice(2).forEach((element) => hiddenWrapper.appendChild(element));
        details.appendChild(hiddenWrapper);
        container.appendChild(details);

        details.addEventListener('toggle', () => {
          labelSpan.textContent = details.open ? lessLabelText : labelText;
        });
      });

      // Track phone button clicks
      if (floatingButton) {
        floatingButton.addEventListener('click', () => {
          trackDataLayerEvent({
            event: 'cta_click',
            category: 'Conversions',
            action: 'clicked',
            label: 'Floating Phone Button',
            cta_type: 'call',
          });
        });
      }

      // Track desktop dropdown hovers and clicks
      const desktopDropdowns = document.querySelectorAll('.dropdown');
      desktopDropdowns.forEach((dropdown) => {
        const items = dropdown.querySelectorAll('.dropdown-item');
        items.forEach((item) => {
          item.addEventListener('click', (e) => {
            const href = item.getAttribute('href');
            const text = item.textContent || '';
            
            trackDataLayerEvent({
              event: 'click',
              category: 'Navigation',
              action: 'service_clicked',
              label: text.trim(),
              url: href,
            });
          });
        });
      });
    });
  </script>
</html>


