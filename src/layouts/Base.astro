  },
  {
    key: 'plovdiv',
    label: isEN ? 'Plovdiv' : 'Пловдив',
    pathSuffix: 'plovdiv',
    languages: ['en', 'bg'],
    allServicesUrl: '',
    itemUrls: plovdivServiceUrls,
  }
];

const baseServicesPath = isEN ? '/en/services' : '/services';

const serviceMenuSections = serviceCityConfigs
  .filter((city) => city.languages.includes(locale))
  .map(({ key, label, pathSuffix, allServicesUrl: allServicesOverride, itemUrls }) => {
  const allServicesUrl = allServicesOverride
    ? allServicesOverride
    : pathSuffix
      ? `${baseServicesPath}/${pathSuffix}/`
      : `${baseServicesPath}/`;
  const buttonLabel = isEN ? `${label} Services` : `Услуги ${label}`;
  const viewAllLabel = isEN ? `View all ${label} services` : `Всички услуги за ${label}`;

  return {
    key,
    label,
    buttonLabel,
    allServicesUrl,
    viewAllLabel,
    items: serviceDefinitions
      .filter(
        (item) =>
          item.availableIn.includes(key) &&
          item.availableLanguages.includes(locale)
      )
      .map((item) => ({
        title: item.titles[locale],
        icon: item.icon,
        url: itemUrls[item.key] ?? `${allServicesUrl}${item.slug}/`
