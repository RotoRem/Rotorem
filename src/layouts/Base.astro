---
import { SEO } from 'astro-seo';
import { getLangFromUrl, useTranslations, getRouteFromUrl, getLocalizedPath } from '../i18n/utils';
import { getJsonLdOverride } from '../lib/jsonldOverrides';
import {
  buildAggregateRating,
  buildSchemaReviews,
} from '../utils/schemaReviews';
// import ReviewsModal from '../components/ReviewsModal.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceFAQ from '../components/ServiceFAQ.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  hideServiceFaq?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEN = lang === 'en';
const locale = isEN ? 'en' : 'bg';

// Navigation paths based on language
const navPaths = {
  services: isEN ? '/en/services/' : '/services/',
  reviews: isEN ? '/en/reviews/' : '/reviews/',
  contact: isEN ? '/en/contact/' : '/contact/',
  blog: isEN ? '/en/blog/' : '/blog/',
  faq: isEN ? '/en/faq/' : '/faq/',
  careers: isEN ? '/en/careers/' : '/careers/', // Added careers path
