  dryer: `${plovdivPrefix}/remont-na-sushilni-plovdiv/`,
  dishwasher: `${plovdivPrefix}/remont-na-sadomiyalni-plovdiv/`,
  oven: `${plovdivPrefix}/remont-na-furni-plovdiv/`,
  boiler: `${plovdivPrefix}/remont-na-boileri-plovdiv/`,
};

