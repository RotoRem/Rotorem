  image = '/img/hero.webp',
  noindex: noindexProp = false,
  hideServiceFaq = false,
} = Astro.props;

const route = getRouteFromUrl(Astro.url);
const canonicalPath = Astro.url.pathname;

const isSofiaPage = /\/sofia(\/|$)/.test(canonicalPath);
const isPlovdivPage = /plovdiv(\/|$)/.test(canonicalPath);
const isServicesPage = /\/services(\/|$)/.test(canonicalPath);
const isHomePage = canonicalPath === '/' || canonicalPath === '/en' || canonicalPath === '/en/';
const footerOffice = isSofiaPage
  ? 'sofia'
  : (isHomePage || (isServicesPage && !isPlovdivPage))
    ? 'varna'
    : null;

const footerLocations = {
