    key: 'varna',
    label: isEN ? 'Varna' : 'Варна',
    pathSuffix: '',
    languages: ['en', 'bg'],
    allServicesUrl: '',
    itemUrls: {} as Record<string, string>,
  },
  {
    key: 'sofia',
    label: isEN ? 'Sofia' : 'София',
    pathSuffix: 'sofia',
    languages: ['en', 'bg'],
    allServicesUrl: '',
