    titles: {
      en: 'Washing Machine Repair',
      bg: 'Ремонт на перални'
    },
    availableIn: ['varna', 'sofia', 'plovdiv'],
    availableLanguages: ['en', 'bg']
  },
  {
    key: 'dryer',
    slug: 'dryer-repair',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="20" x="3" y="2" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M10 11l2 2 2-2"/><path d="M10 15l2-2 2 2"/></svg>`,
    titles: {
