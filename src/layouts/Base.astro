<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Enhanced favicon setup -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <meta name="generator" content={Astro.generator} />
    {isHomeRoute && <meta name="msvalidate.01" content="B7D17E7B09E9699C794865F6DFFAFA56" />}
    
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    {!shouldNoindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    
    <!-- Enhanced hreflang with proper x-default -->
    <link rel="alternate" hreflang="bg" href={bgURL.toString()} />
    <link rel="alternate" hreflang="en" href={enURL.toString()} />
    <link rel="alternate" hreflang="x-default" href={bgURL.toString()} />
    
    <!-- Geo meta tags for local SEO -->
    <meta name="geo.region" content="BG-VAR" />
    <meta name="geo.placename" content="Varna & Sofia, Bulgaria" />
    <meta name="geo.position" content="43.2141;27.9147" />
    <meta name="ICBM" content="43.2141, 27.9147" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://www.google-analytics.com">

    <!-- LCP image -->
    <link 
      rel="preload" 
      href="/img/hero.webp" 
      as="image" 
      type="image/webp"
      fetchpriority="high"
    >

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        
    <!-- Google Tag Manager -->
    <script type="module">
      const GTM_ID = 'GTM-TS8Q99GB';

      // Инициализирайте dataLayer преди GTM скрипта
      const existingDataLayer = window.dataLayer || [];
      window.dataLayer = window.dataLayer || [];

      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        const f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        if (f.parentNode) {
          f.parentNode.insertBefore(j, f);
        }
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>
    <!-- End Google Tag Manager -->
    
    <!-- Enhanced SEO with better structured data -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image,
          url: canonicalURL.toString(),
        },
        optional: {
          description,
          locale: lang === 'bg' ? 'bg_BG' : 'en_US',
          siteName: isEN ? 'RotoRem Varna & Sofia' : 'РотоРем Варна и София',
        },
        image: {
          url: new URL(image, Astro.site).toString(),
          width: 1200,
          height: 630,
          alt: title,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@rotorem_varna',
        creator: '@rotorem_varna',
        title,
        description,
        image: new URL(image, Astro.site).toString(),
      }}
      extend={{
        meta: [
          { name: 'theme-color', content: '#2563eb' },
          { name: 'format-detection', content: 'telephone=yes' },
          { name: 'mobile-web-app-capable', content: 'yes' },
          { name: 'apple-mobile-web-app-status-bar-style', content: 'default' },
          { name: 'msapplication-TileColor', content: '#2563eb' },
          { name: 'application-name', content: isEN ? 'RotoRem Varna & Sofia' : 'РотоРем Варна и София' },
        ],
      }}
    />
    
    <!-- Enhanced LocalBusiness Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)}></script>
    
    <!-- Web Vitals and Analytics Event Tracking via dataLayer -->
    <script type="module">
      // Initialize dataLayer if not present
      window.dataLayer = window.dataLayer || [];

      /**
       * Track events to dataLayer for GTM to handle GA4/marketing tags
       */
      const trackEvent = (eventData) => {
        if (window.dataLayer) {
          window.dataLayer.push({
            ...eventData,
            page_path: window.location.pathname,
            page_title: document.title,
            language: document.documentElement.lang || 'en',
            timestamp: Date.now(),
          });

          // Log in development for debugging
          if (
            location.hostname === 'localhost' ||
            location.hostname.includes('netlify') ||
            location.hostname.includes('dev')
          ) {
            console.log('📊 Analytics Event:', eventData);
          }
        }
      };

      // Track initial page view
      trackEvent({
        event: 'page_view',
        page_type: document.body.getAttribute('data-page-type') || 'standard',
      });

      // Web Vitals Monitoring via dataLayer
      import('https://unpkg.com/web-vitals@3/dist/web-vitals.js').then(
        ({ getCLS, getFID, getFCP, getLCP, getTTFB, getINP }) => {
          const sendToDataLayer = (metric) => {
            const value = Math.round(
              metric.name === 'CLS' ? metric.value * 1000 : metric.value
            );
            const rating =
              metric.value <=
              (metric.rating?.good ||
                (metric.name === 'CLS'
                  ? 0.1
                  : metric.name === 'FID'
                    ? 100
                    : 2500))
                ? 'good'
                : metric.value <=
                    (metric.rating?.needs_improvement ||
                      (metric.name === 'CLS'
                        ? 0.25
                        : metric.name === 'FID'
                          ? 300
                          : 4000))
                  ? 'needs_improvement'
                  : 'poor';

            trackEvent({
              event: 'web_vital',
              category: 'Performance',
              action: 'measure',
              metric_name: metric.name,
              metric_value: value,
              rating,
            });
          };

          getCLS(sendToDataLayer);
          getFID(sendToDataLayer);
          getFCP(sendToDataLayer);
          getLCP(sendToDataLayer);
          getTTFB(sendToDataLayer);
          getINP(sendToDataLayer);
        }
      );

      // JavaScript Error Tracking
      window.addEventListener('error', (e) => {
        trackEvent({
          event: 'error',
          category: 'Errors',
          action: 'javascript_error',
          label: e.message,
          error_message: e.message,
          error_type: 'javascript_error',
          filename: e.filename,
          line_number: e.lineno,
        });
      });

      // Unhandled Promise Rejection Tracking
      window.addEventListener('unhandledrejection', (e) => {
        trackEvent({
          event: 'error',
          category: 'Errors',
          action: 'unhandled_rejection',
          label: e.reason?.message || String(e.reason),
          error_message: e.reason?.message || String(e.reason),
          error_type: 'unhandled_promise_rejection',
        });
      });

      // 404 Page Detection
      if (document.title.includes('404') || document.title.includes('Not Found')) {
        trackEvent({
          event: 'page_not_found',
          category: 'Errors',
          action: '404',
          label: window.location.pathname,
          referrer: document.referrer || 'direct',
        });
      }

      // Slow Page Load Detection
      window.addEventListener('load', () => {
        const loadTime =
          performance.timing.loadEventEnd - performance.timing.navigationStart;
        if (loadTime > 5000) {
          trackEvent({
            event: 'slow_page_load',
            category: 'Performance',
            action: 'slow_load',
            label: window.location.pathname,
            value: Math.round(loadTime),
          });
        }
      });

      // Service Worker and Network Error Tracking
      const isLocalDev =
        location.hostname === 'localhost' ||
        location.hostname === '127.0.0.1' ||
        location.hostname === '[::1]';

      if ('serviceWorker' in navigator) {
        if (isLocalDev) {
          // SW cache-first for CSS/JS breaks Vite dev navigation; remove any stale registration
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            registrations.forEach((registration) => registration.unregister());
          });
        } else {
          navigator.serviceWorker
            .register('/sw.js')
            .then(() => {
              console.log('✅ Service Worker registered successfully');
            })
            .catch(() => {
              trackEvent({
                event: 'error',
                category: 'Errors',
                action: 'service_worker_registration_failed',
                label: 'Service Worker Registration',
              });
            });

          navigator.serviceWorker.addEventListener('message', (event) => {
            if (event.data?.type === 'NETWORK_ERROR') {
              trackEvent({
                event: 'error',
                category: 'Errors',
                action: 'network_error',
                label: event.data.url,
                error_message: event.data.url,
                error_type: 'network_error',
              });
            }
          });
        }
      }
    </script>

