---
import Layout from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEN = lang === 'en';

const title = isEN 
  ? 'Careers at RotoRem Varna | Join Our Team'
  : 'Кариери в РотоРем Варна | Присъединете се към нашия екип';

const description = isEN 
  ? 'Interested in joining RotoRem Varna? Learn about our company culture and future opportunities in appliance repair services in Varna.'
  : 'Интересувате се да се присъедините към РотоРем Варна? Научете за нашата корпоративна култура и бъдещи възможности в сервиза на битова техника във Варна.';

// Company values
const values = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: isEN ? 'Quality First' : 'Качеството на първо място',
    description: isEN 
      ? 'We never compromise on the quality of our work and always strive for excellence.'
      : 'Никога не правим компромиси с качеството на работата си и винаги се стремим към съвършенство.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    title: isEN ? 'Team Spirit' : 'Екипен дух',
    description: isEN 
      ? 'We work together as a team, supporting each other to achieve our goals.'
      : 'Работим заедно като екип, подкрепяйки се взаимно за постигане на целите си.'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>`,
    title: isEN ? 'Customer Focus' : 'Фокус върху клиента',
    description: isEN 
      ? 'Our customers are at the heart of everything we do. Their satisfaction drives us.'
      : 'Нашите клиенти са в центъра на всичко, което правим. Тяхното удовлетворение ни мотивира.'
  }
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-16">
    <div class="container max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        {isEN ? 'Careers at RotoRem Varna' : 'Кариери в РотоРем Варна'}
      </h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
        {isEN 
          ? 'We are always interested in meeting talented professionals who share our passion for quality service and customer satisfaction.'
          : 'Винаги се интересуваме от талантливи професионалисти, които споделят нашата страст към качествено обслужване и удовлетворение на клиентите.'}
      </p>
      <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 max-w-2xl mx-auto">
        <p class="text-lg text-blue-100 mb-4">
          {isEN 
            ? '🔍 No current openings, but we\'re always growing!'
            : '🔍 Няма текущи позиции, но винаги растем!'}
        </p>
        <p class="text-blue-200">
          {isEN 
            ? 'Send us your CV and we\'ll contact you when suitable opportunities arise.'
            : 'Изпратете ни вашето CV и ще се свържем с вас, когато се появят подходящи възможности.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Why Work With Us -->
  <section class="py-16 bg-gradient-to-b from-white to-gray-50">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {isEN ? 'Why Choose RotoRem Varna?' : 'Защо да изберете РотоРем Варна?'}
        </h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-lg text-gray-600">
          {isEN 
            ? 'We believe in creating a positive work environment where our team members can thrive and grow.'
            : 'Вярваме в създаването на позитивна работна среда, в която членовете на нашия екип могат да процъфтяват и растат.'}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {isEN ? 'Competitive Benefits' : 'Конкурентни облаги'}
          </h3>
          <p class="text-gray-600">
            {isEN 
              ? 'Excellent salary packages, performance bonuses, and comprehensive benefits for our employees.'
              : 'Отлични заплащания, бонуси за представяне и всеобхватни облаги за нашите служители.'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {isEN ? 'Professional Growth' : 'Професионален растеж'}
          </h3>
          <p class="text-gray-600">
            {isEN 
              ? 'Continuous training, skill development, and career advancement opportunities.'
              : 'Непрекъснато обучение, развитие на умения и възможности за кариерно развитие.'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {isEN ? 'Great Team Culture' : 'Отлична екипна култура'}
          </h3>
          <p class="text-gray-600">
            {isEN 
              ? 'Work with experienced professionals in a supportive and collaborative environment.'
              : 'Работете с опитни професионалисти в подкрепяща и съвместна среда.'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 6v6l4 2"/>
              <circle cx="12" cy="12" r="10"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {isEN ? 'Work-Life Balance' : 'Баланс работа-живот'}
          </h3>
          <p class="text-gray-600">
            {isEN 
              ? 'Flexible scheduling and reasonable working hours to maintain a healthy work-life balance.'
              : 'Гъвкаво планиране и разумни работни часове за поддържане на здравословен баланс.'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {isEN ? 'Modern Equipment' : 'Модерно оборудване'}
          </h3>
          <p class="text-gray-600">
            {isEN 
              ? 'Work with the latest tools and technology to provide the best service to our customers.'
              : 'Работете с най-новите инструменти и технологии за предоставяне на най-добрата услуга.'}
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            {isEN ? 'Local Impact' : 'Местно въздействие'}
          </h3>
          <p class="text-gray-600">
            {isEN 
              ? 'Make a real difference in your community by helping families in Varna with their appliance needs.'
              : 'Направете реална разлика в общността си, помагайки на семействата във Варна с техните нужди.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Values -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {isEN ? 'Our Values' : 'Нашите ценности'}
        </h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4">
              <Fragment set:html={value.icon} />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">{value.title}</h3>
            <p class="text-gray-600">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Look For -->
  <section class="py-16 bg-gradient-to-b from-gray-50 to-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {isEN ? 'What We Look For' : 'Какво търсим'}
        </h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-lg text-gray-600">
          {isEN 
            ? 'While we don\'t have current openings, here\'s what we value in potential team members:'
            : 'Въпреки че няма текущи позиции, ето какво ценим в потенциалните членове на екипа:'}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              {isEN ? 'Technical Professionals' : 'Технически специалисти'}
            </h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Experience with appliance repair or electrical work'
                    : 'Опит с ремонт на битова техника или електрически работи'}
                </span>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Technical education or relevant certifications'
                    : 'Техническо образование или съответни сертификации'}
                </span>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Problem-solving skills and attention to detail'
                    : 'Умения за решаване на проблеми и внимание към детайлите'}
                </span>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Valid driving license for home visits'
                    : 'Валидна шофьорска книжка'}
                </span>
              </li>
            </ul>
          </div>

          <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              {isEN ? 'Customer Service' : 'Обслужване на клиенти'}
            </h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Excellent communication skills in Bulgarian'
                    : 'Отлични комуникативни умения на български език'}
                </span>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Customer service experience preferred'
                    : 'Предпочита се опит в обслужване на клиенти'}
                </span>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Computer skills for scheduling and coordination'
                    : 'Компютърни умения за планиране и координация'}
                </span>
              </li>
              <li class="flex items-start">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary mr-3 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-gray-700">
                  {isEN 
                    ? 'Friendly, professional demeanor'
                    : 'Приятелско, професионално държание'}
                </span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Future Opportunities -->
  <section class="py-16 bg-gradient-to-r from-primary to-primary-dark text-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold mb-4">
          {isEN ? 'Join Our Talent Network' : 'Присъединете се към нашата мрежа от таланти'}
        </h2>
        <div class="w-20 h-1 bg-white mx-auto my-4"></div>
        <p class="text-lg text-blue-100">
          {isEN 
            ? 'Even without current openings, we\'re always growing and looking for exceptional people.'
            : 'Дори без текущи позиции, ние винаги растем и търсим изключителни хора.'}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="w-16 h-16 bg-white text-primary rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">1</div>
          <h3 class="text-lg font-semibold mb-2">
            {isEN ? 'Send Your CV' : 'Изпратете CV-то си'}
          </h3>
          <p class="text-blue-100">
            {isEN ? 'Email your resume even if no positions are currently open' : 'Изпратете ни вашето CV дори ако няма текущи позиции'}
          </p>
        </div>
        
        <div>
          <div class="w-16 h-16 bg-white text-primary rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">2</div>
          <h3 class="text-lg font-semibold mb-2">
            {isEN ? 'We\'ll Keep It' : 'Ще го запазим'}
          </h3>
          <p class="text-blue-100">
            {isEN ? 'Your information will be stored in our talent database' : 'Информацията ви ще бъде запазена в нашата база от таланти'}
          </p>
        </div>
        
        <div>
          <div class="w-16 h-16 bg-white text-primary rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">3</div>
          <h3 class="text-lg font-semibold mb-2">
            {isEN ? 'We\'ll Contact You' : 'Ще се свържем с вас'}
          </h3>
          <p class="text-blue-100">
            {isEN ? 'When suitable opportunities arise, we\'ll reach out first' : 'Когато се появят подходящи възможности, първо ще се свържем с вас'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {isEN ? 'Interested in Future Opportunities?' : 'Интересувате се от бъдещи възможности?'}
        </h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-lg text-gray-600 mb-8">
          {isEN 
            ? 'Send us your CV and we\'ll keep you in mind for future openings that match your skills.'
            : 'Изпратете ни вашето CV и ще ви запомним за бъдещи позиции, които отговарят на вашите умения.'}
        </p>
        
        <div class="bg-gray-50 p-8 rounded-xl">
          <div class="flex flex-col md:flex-row justify-center items-center gap-6">
            <div class="text-center">
              <h3 class="font-semibold text-gray-900 mb-2">
                {isEN ? 'Email Your CV' : 'Изпратете CV-то по имейл'}
              </h3>
              <a href="mailto:n.ivanov.ivanov@abv.bg" class="text-primary font-semibold hover:text-primary-dark text-lg">
                n.ivanov.ivanov@abv.bg
              </a>
            </div>
            
            <div class="text-gray-400">|</div>
            
            <div class="text-center">
              <h3 class="font-semibold text-gray-900 mb-2">
                {isEN ? 'Call Us' : 'Обадете се'}
              </h3>
              <a href="tel:+359 89 834 0982" class="text-primary font-semibold hover:text-primary-dark text-lg">
                089 834 0982
              </a>
            </div>
          </div>
          
          <div class="mt-6 text-sm text-gray-600">
            <p>
              {isEN 
                ? 'Please include "Career Interest" in your email subject line.'
                : 'Моля, включете "Кариерен интерес" в темата на имейла си.'}
            </p>
          </div>
        </div>

        <div class="mt-8 bg-blue-50 p-6 rounded-lg border border-blue-200">
          <h3 class="text-lg font-semibold text-blue-900 mb-2">
            {isEN ? '💡 Stay Connected' : '💡 Останете свързани'}
          </h3>
          <p class="text-blue-800">
            {isEN 
              ? 'Follow our growth and learn about new opportunities as they become available. We typically expand during busy seasons and as we grow our service area.'
              : 'Следете нашия растеж и научавайте за нови възможности, когато се появят. Обикновено се разширяваме в натоварени сезони и докато увеличаваме зоната си на обслужване.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
