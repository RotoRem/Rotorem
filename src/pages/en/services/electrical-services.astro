---
import Layout from '../../../layouts/Base.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';

const lang = 'en';

const title = 'Electrical Services in Varna | Electrician On-Site | RotoRem';
const description = 'On-site electrical services in Varna – diagnostics, sockets, switches, lighting, panels, wiring and fault repair. RotoRem.';

const heroImage = '/img/services/ремонт-на-ел-услуги-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-ел-услуги-варна-диагностика.webp';

const serviceCategories = [
  {
    title: 'Sockets and switches',
    text: 'Installation of new switches and sockets, replacement of old or damaged mechanisms, and repair when a socket is loose, sparking or not working. Before replacement, the connections and conductors are checked.',
    items: ['installation of new switches', 'replacement of old switches', 'socket installation', 'socket and switch repair'],
    border: 'border-amber-500',
  },
  {
    title: 'Lighting',
    text: 'Installation of chandeliers and LED lighting, outdoor and emergency lighting. When there is a fault, the connection, the driver on LED systems and the switch are checked.',
    items: ['chandelier installation', 'LED lighting', 'outdoor lighting', 'emergency lighting'],
    border: 'border-yellow-500',
  },
  {
    title: 'Home installations',
    text: 'New electrical installations, repair of existing ones, cable replacement and work on the electrical panel.',
    items: ['new electrical installations', 'installation repair', 'cable replacement', 'electrical panels'],
    border: 'border-orange-500',
  },
  {
    title: 'Small appliances',
    text: 'Repair of small electrical appliances, replacement of power cables and plugs, and diagnostics before repair or component replacement.',
    items: ['small appliance repair', 'cable replacement', 'plug repair', 'device diagnostics'],
    border: 'border-lime-600',
  },
  {
    title: 'Emergency repairs',
    text: 'Urgent electrical repairs for short circuits, loss of power or panel problems. The affected circuit stays switched off until it has been checked, when that can be done safely.',
    items: ['urgent electrical repairs', 'short circuit repair', 'power restoration', 'emergency panel repairs'],
    border: 'border-red-500',
  },
];

const pricingRows = [
  { service: 'Visit and diagnostics in Varna', eur: '20 €', featured: true },
  { service: 'Socket replacement', eur: 'By agreement' },
  { service: 'Socket installation', eur: 'By agreement' },
  { service: 'Switch replacement', eur: 'By agreement' },
  { service: 'Switch installation', eur: 'By agreement' },
  { service: 'Light fixture installation', eur: 'By agreement' },
  { service: 'Circuit breaker replacement', eur: 'By agreement' },
  { service: 'Electrical panel diagnostics', eur: 'By agreement' },
  { service: 'Short circuit location', eur: 'By agreement' },
  { service: 'Partial cable replacement', eur: 'By agreement' },
];

const partsTable = [
  { part: 'Socket', problem: 'No power, overheating or sparking' },
  { part: 'Switch', problem: 'Lighting does not work' },
  { part: 'Circuit breaker', problem: 'Trips or does not supply power' },
  { part: 'RCD (residual current device)', problem: 'Trips on leakage' },
  { part: 'Electrical panel', problem: 'Tripping, overheating or damaged connection' },
  { part: 'Cable / conductor', problem: 'Break or overheating' },
  { part: 'Terminal / connection', problem: 'Poor contact or overheating' },
  { part: 'Junction box', problem: 'Connection problems' },
  { part: 'Lighting circuit', problem: 'Lamps do not work or flicker' },
  { part: 'LED driver', problem: 'LED lighting works incorrectly' },
];

const realCases = [
  {
    title: 'Socket with no power',
    problem: 'The socket had no power / the breaker tripped',
    area: 'City Center',
    diagnosis: 'The socket had no power / the breaker tripped',
    repair: undefined as string | undefined,
    image: '/img/services/ремонт-на-ел-услуги-варна-случай-1.webp',
    alt: 'Socket with no power in City Center, Varna',
  },
  {
    title: 'Voltage loss at socket and switches',
    problem: 'No voltage at a socket, the water heater switch and the lighting switch',
    area: 'Chaika',
    diagnosis: 'Burnt cables were found due to a poor or loose connection.',
    repair: 'The socket, water heater switch and lighting switch were replaced.',
    image: '/img/services/ремонт-на-ел-услуги-варна-случай-2.webp',
    alt: 'No voltage at a socket, water heater switch and lighting switch in Chaika, Varna',
  },
  {
    title: 'Loss of power supply',
    problem: 'No power to a socket, water heater switch and lighting switch',
    area: 'Levski',
    diagnosis: 'The inspection found burnt conductors caused by loose electrical connections.',
    repair: 'The damaged socket, water heater switch and lighting switch were replaced and the electrical connections were restored.',
    image: '/img/services/ремонт-на-ел-услуги-варна-случай-3.webp',
    alt: 'Repair of socket, water heater switch and lighting switch after loss of power in Levski district, Varna',
  },
];

const processSteps = [
  { step: 1, title: 'Contact RotoRem', text: 'Describe the problem by phone.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 2, title: 'We schedule a visit', text: 'A technician visits your address in Varna at the agreed time.', circleClass: 'bg-gradient-to-r from-yellow-500 to-yellow-600' },
  { step: 3, title: 'Diagnostics and measurements', text: 'The relevant electrical circuit is checked and the cause is located.', circleClass: 'bg-gradient-to-r from-orange-500 to-orange-600' },
  { step: 4, title: 'You receive information', text: 'We explain what fault was found and what work is required.', circleClass: 'bg-gradient-to-r from-amber-600 to-amber-700' },
  { step: 5, title: 'Repair or installation', text: 'The necessary work is carried out and the system is checked after the repair.', circleClass: 'bg-gradient-to-r from-yellow-600 to-yellow-700' },
];

const faqs = getServiceFaqItems('/en/services/electrical-services/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="el-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Electrician on site in Varna"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-amber-950/85 via-amber-900/75 to-yellow-900/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            On-site electrical services in Varna
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            In-home electrical services in Varna
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            No power in part of your home, a sparking socket, lighting that cuts out or a tripping breaker? RotoRem offers electrical services in Varna for diagnostics, repair and installation on home electrical systems.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            We find the cause of the problem before replacing a socket, switch, circuit breaker, cable or other component.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Diagnostics in Varna</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call to schedule a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">On-site diagnostics and electrical services</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>Before any repair, the actual location of the fault must be established. Diagnostics may include checking for voltage, measurements, inspection of sockets, switches, lighting circuits, circuit breakers, the panel, circuits, connections, short circuits and cables.</p>
            <p class="font-semibold text-gray-900">Visit and diagnostics in Varna: 20 €</p>
          </div>
          <div>
            <img src={diagnosticImage} alt="Electrical installation diagnostics in Varna" class="w-full rounded-2xl shadow-lg object-cover" loading="lazy" width="600" height="450" />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Electrical services we provide</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {serviceCategories.map((cat) => (
            <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${cat.border}`}>
              <h3 class="text-lg font-semibold text-gray-900 mb-3">{cat.title}</h3>
              <p class="text-gray-800 leading-relaxed mb-3">{cat.text}</p>
              <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
                {cat.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <section class={sectionClass} aria-labelledby="el-pricing-heading">
        <div class="text-center mb-10">
          <h2 id="el-pricing-heading" class="text-3xl font-bold text-gray-900 mb-4">Electrical service prices in Varna</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {pricingRows.map((row) => (
            <div class:list={['rounded-xl border p-5 shadow-sm', row.featured ? 'border-amber-300 bg-amber-50/50' : 'border-gray-200 bg-white']}>
              <p class="font-semibold text-gray-900 mb-1">{row.service}</p>
              <p class="text-gray-800">{row.eur}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-amber-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-amber-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Service</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Price</th>
              </tr>
            </thead>
            <tbody>
              {pricingRows.map((row, index) => (
                <tr class:list={['border-t border-gray-100', row.featured ? 'bg-amber-50/80' : index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.service}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.eur}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Important: The final price depends on the specific fault, the work required, access to the installation and the materials used. After the inspection, the customer receives information about the necessary work and the price.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Parts and systems of the electrical installation</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-amber-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>
        <div class="hidden md:block overflow-hidden rounded-xl border border-amber-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-amber-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Part / system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Common related issue</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          With electrical faults, the visible symptom does not always point directly to the faulty component. The cause is determined through inspection and measurement.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Socket installation and repair</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>RotoRem carries out diagnostics, installation and replacement of household sockets. With physical damage, a loose mechanism or signs of overheating, the conductors behind the socket are checked before a new one is fitted.</p>
          <p>When installing a new socket, the existing installation is assessed first and where the new point can be fed correctly. On sockets that overheat under heavy load, heating should not be treated as normal.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Switches and lighting</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>With a faulty lighting switch, the mechanism, connections, conductors and lighting line can be checked. When installing light fixtures, the electrical connections, mechanical fixing and operation after installation are verified.</p>
          <p>With LED lighting, the problem is not always the lamp itself – the LED module, driver, supply, connections and switch are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Electrical panels and protective devices</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>The electrical panel distributes and protects the different circuits. When there is a problem, circuit breakers, RCDs, connections, terminals, conductors and individual circuits can be checked.</p>
          <p>A circuit breaker should not be replaced with a larger one just because it trips – first it must be established why the protection is activating. If protection trips repeatedly, the cause is located before replacement.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Short circuits, cables and emergency issues</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>When a short circuit is suspected, the relevant circuit is checked until the location or component causing the problem is found. When there is no power but the breakers are on, the cause may be a broken connection, conductor, protective device or a point in the panel.</p>
          <p>With a smell of burning, visible sparking, a strongly overheating socket or a breaker that trips repeatedly, the affected circuit should stay switched off until it has been checked, when that can be done safely.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real electrical repairs in Varna</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
                <img src={item.image} alt={item.alt} class="w-full md:w-2/5 object-cover min-h-[220px]" loading="lazy" width="480" height="360" />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.title}</h3>
                  <p class="text-gray-800"><span class="font-semibold">Problem:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">Area:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Cause identified:</span> {item.diagnosis}</p>
                  {item.repair && (
                    <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {item.repair}</p>
                  )}
                </div>
              </article>
            ))}
          </div>
          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden max-w-5xl mx-auto">
            <img src={realCases[2].image} alt={realCases[2].alt} class="w-full lg:w-2/5 object-cover min-h-[240px]" loading="lazy" width="560" height="400" />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].title}</h3>
              <p class="text-gray-800"><span class="font-semibold">Problem:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Area:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Cause identified:</span> {realCases[2].diagnosis}</p>
              {realCases[2].repair && (
                <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {realCases[2].repair}</p>
              )}
            </div>
          </article>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Electrical services and appliance repair</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-4 text-gray-800 leading-relaxed max-w-3xl mx-auto text-center">
          <p>
            If the breaker trips only when the water heater is switched on, the fault may be inside the appliance itself – see <a href="/en/services/boiler-repair/" class="text-amber-800 font-medium hover:underline">water heater repair in Varna</a>.
          </p>
          <p>
            If the installation is fine but the oven does not heat or trips the breaker, see <a href="/en/services/oven-repair/" class="text-amber-800 font-medium hover:underline">oven repair in Varna</a>.
          </p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How the service works</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          {processSteps.slice(0, 3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {processSteps.slice(3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Electrical services across Varna</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          <p>RotoRem provides in-home electrical services in Varna, including Mladost, Levski, Chaika, Vazrazhdane, Asparuhovo, Vladislav Varnenchik, Galata, the city centre and other served areas.</p>
          <p>For addresses outside the standard service zone, visit conditions are agreed in advance.</p>
        </div>
      </section>

      <section class={sectionClass} id="faq">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Frequently asked questions</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((faq) => (
            <div class="bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
              <details class="group">
                <summary class="flex justify-between items-center p-5 cursor-pointer">
                  <h3 class="text-lg font-semibold text-gray-900 pr-4">{faq.q}</h3>
                  <div class="flex-shrink-0 text-gray-600 transition-transform duration-300 group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </div>
                </summary>
                <div class="p-5 pt-0 text-gray-800 border-t border-gray-100">
                  <p class="leading-relaxed">{faq.a}</p>
                </div>
              </details>
            </div>
          ))}
        </div>
      </section>
    </div>
  </article>

  <div class="container max-w-5xl mb-28">
