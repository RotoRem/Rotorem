---
import Layout from '../../../layouts/Base.astro';

const title = 'Boiler Repair in Varna | Fast In-Home Service by RotoRem';
const description = 'Professional electric boiler repair in Varna. Heating element replacement, thermostat fixes, leak diagnostics, descaling, and warranty-backed service.';
---

<Layout title={title} description={description}>
  <article>
    <section class="bg-gradient-to-r from-teal-600 to-teal-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Boiler Repair in Varna</h1>
        <p class="text-xl md:text-2xl text-teal-100 max-w-3xl mx-auto mb-8">
          On-site electric boiler diagnostics and repair across Varna with clear pricing and quality guarantee.
        </p>
        <a href="tel:+359 89 834 0982" class="bg-white text-teal-700 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg inline-flex">📞 089 834 0982</a>
      </div>
    </section>

    <div class="container max-w-4xl">
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Typical boiler issues we fix</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-teal-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Boiler not heating water</h3>
            <p class="text-gray-700">Testing and replacement of heating elements, thermostats, and thermal protection components.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Water leakage</h3>
            <p class="text-gray-700">Inspection of flange, gaskets, valves, and tank condition with practical repair options.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Power trips or electrical faults</h3>
            <p class="text-gray-700">Safe diagnostics for short circuits, damaged wiring, and insulation-related issues.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Scale buildup and reduced efficiency</h3>
            <p class="text-gray-700">Descaling, anode replacement, and preventive maintenance for longer boiler lifespan.</p>
          </div>
        </div>
      </section>

      <section class="py-12 bg-gradient-to-r from-teal-600 to-teal-800 text-white rounded-2xl shadow-xl mb-6 text-center">
        <h2 class="text-3xl font-bold mb-4">Need urgent boiler repair?</h2>
        <p class="text-teal-100 mb-6">Call now to schedule a technician visit in Varna.</p>
        <a href="tel:+359 89 834 0982" class="bg-white text-teal-700 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg inline-flex">📞 089 834 0982</a>
      </section>
    </div>
  </article>
</Layout>
