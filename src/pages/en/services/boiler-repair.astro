---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';
const lang = 'en';
const pricing = getServicePricing('boiler', 'varna', lang);

const title = 'Water Heater (Boiler) Repair in Varna | In-Home Service | RotoRem';
const description = 'Water heater repair, diagnostics and installation in Varna. Heating element, thermostat, leaks, tripping breaker and limescale problems. RotoRem.';

const heroImage = '/img/services/ремонт-на-бойлер-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-бойлер-варна-диагностика.webp';

const problems = [
  {
    title: 'Water heater does not heat the water',
    text: 'When the water heater has power but the water stays cold, we can check the heating element, the thermostat, the thermal protection and the electrical connections. A burnt-out heating element is one of the possible causes, but it should not automatically be assumed that it must be replaced.',
    border: 'border-teal-500',
  },
  {
    title: 'Water heater heats the water weakly',
    text: 'If the water warms up but does not reach the normal temperature, or heating takes significantly longer, the cause may be related to the heating element, the temperature control or build-up around the heating element. Before any repair, the specific condition of the appliance is checked.',
    border: 'border-emerald-500',
  },
  {
    title: 'Water heater trips the circuit breaker',
    text: 'If the circuit breaker or protection trips when the water heater is switched on or while it is heating, the water heater must be inspected before it is used again. The cause may be the heating element, an electrical leakage, a wiring connection or another electrical component.',
    border: 'border-red-500',
  },
  {
    title: 'Water heater leaks',
    text: 'First, it must be established where the water is coming from. The leak may be around the flange, the gasket, the safety valve, the water connections or another part of the water heater. If the problem is related to the tank itself, the technician must judge whether the repair is technically and economically justified.',
    border: 'border-amber-500',
  },
  {
    title: 'Leak around the flange',
    text: 'The flange gives access to the heating element and other internal components. In case of a leak around it, the gasket, the fastening, the condition of the flange and the contact surface must be checked. It is not enough to simply tighten it without finding the cause.',
    border: 'border-orange-500',
  },
  {
    title: 'Safety valve releases water',
    text: 'A certain amount of water from the safety valve during heating may be related to the normal rise in pressure, but constant or unusual discharge should be checked. It should not automatically be assumed that the valve is faulty – the conditions under which the leak appears need to be examined.',
    border: 'border-cyan-500',
  },
  {
    title: 'Water heater overheats the water',
    text: 'If the water becomes unusually hot or the water heater does not stop heating normally, the temperature control system must be checked. Possible causes include the thermostat, the thermal protection or another control component.',
    border: 'border-rose-500',
  },
  {
    title: 'Water heater switches off before the water is hot',
    text: 'Switching off too early may be related to the temperature control, the thermal protection, the heating element or another fault. Diagnostics need to establish at which point heating is interrupted and how the appliance reacts afterwards.',
    border: 'border-indigo-500',
  },
  {
    title: 'Water heater heats very slowly',
    text: 'A longer heating time may be related to the heating element, its power rating, build-up around it or another problem in the system. In older water heaters, the condition of the internal components must also be assessed.',
    border: 'border-violet-500',
  },
  {
    title: 'Water heater does not turn on',
    text: 'When there is no indication and heating does not start at all, we can check the power supply, the electrical connections, the thermal protection, the thermostat and the other components in the circuit.',
    border: 'border-slate-500',
  },
  {
    title: 'Water heater makes unusual noise',
    text: 'Noise during heating may be related to build-up around the heating element or to other conditions inside the water heater. The noise alone is not enough to determine the cause and must be considered together with the other symptoms.',
    border: 'border-lime-600',
  },
];

const partsTable = [
  { part: 'Heating element', problem: 'Water does not heat / heats slowly' },
  { part: 'Thermostat', problem: 'Incorrect temperature' },
  { part: 'Thermal protection', problem: 'Water heater cuts out or does not start' },
  { part: 'Flange', problem: 'Leak at the bottom' },
  { part: 'Gasket', problem: 'Leak around the flange' },
  { part: 'Safety valve', problem: 'Water discharge' },
  { part: 'Electrical connections', problem: 'Does not start / trips the breaker' },
  { part: 'Water connections', problem: 'Leak' },
  { part: 'Anode protection', problem: 'Protects the tank from corrosion' },
  { part: 'Limescale', problem: 'Build-up around the internal components' },
];

const realCases = [
  {
    brand: 'Water Heater',
    problem: 'There was a problem with the on/off switch of the water heater',
    area: 'Chaika',
    diagnosis: 'The cables turned out to be burnt.',
    repair: 'They were replaced and the water heater now works normally.',
    image: diagnosticImage,
    alt: 'Water heater on/off switch repair and replacement of burnt cables in the Chaika district, Varna.',
  },
  {
    brand: 'Water Heater',
    problem: 'Old water heater due for replacement, with a faulty switch and burnt cables',
    area: 'Mladost',
    diagnosis: 'The inspection found damaged cables and a defect in the water heater control switch.',
    repair: 'The old water heater was removed and a new one was installed. The damaged cables and the switch were replaced. After the repair, the water heater was tested and works normally.',
    image: '/img/services/ремонт-на-бойлер-варна-случай-2.webp',
    alt: 'Removal of an old water heater and installation of a new one, with replacement of burnt cables and the on/off switch in Mladost, Varna.',
  },
  {
    brand: 'Water Heater',
    problem: 'Water heater was tripping the circuit breaker and not heating the water properly',
    area: 'Asparuhovo',
    diagnosis: 'A defective heating element with heavy limescale build-up was found.',
    repair: 'The faulty heating element was removed and a new one was installed. After the replacement, the water heater was checked and works normally.',
    image: '/img/services/ремонт-на-бойлер-варна-случай-3.webp',
    alt: 'Replacement of a burnt-out water heater heating element with limescale build-up and a tripping circuit breaker in Asparuhovo, Varna.',
  },
];

const processSteps = [
  { step: 1, title: 'Contact RotoRem', text: 'Describe how the problem shows up – no hot water, a leak, the water heater tripping the breaker or another symptom.', circleClass: 'bg-gradient-to-r from-teal-500 to-teal-600' },
  { step: 2, title: 'We schedule a visit', text: 'A technician visits your address in Varna at the agreed time.', circleClass: 'bg-gradient-to-r from-emerald-500 to-emerald-600' },
  { step: 3, title: 'We run diagnostics', text: 'The components and systems that could cause the specific problem are inspected.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 4, title: 'You get repair information', text: 'We explain what was found and what needs to be repaired or replaced.', circleClass: 'bg-gradient-to-r from-cyan-500 to-cyan-600' },
  { step: 5, title: 'Repair and test', text: 'Where possible, the repair is carried out at your address. The water heater is then checked for normal and safe operation.', circleClass: 'bg-gradient-to-r from-teal-600 to-teal-700' },
];

const brands = ['TESY', 'Ariston', 'Atlantic', 'Eldom', 'Diplomat', 'Gorenje', 'AEG', 'Beko'];

const faqs = getServiceFaqItems('/en/services/boiler-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="boiler-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="In-home water heater repair in Varna"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-teal-950/85 via-teal-900/75 to-teal-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            In-home service in Varna
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            In-Home Water Heater Repair in Varna
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Water heater not heating the water, heating too slowly, tripping the breaker or leaking? RotoRem provides in-home diagnostics and repair of electric water heaters (boilers) in Varna. We find the cause before replacing a heating element, thermostat, thermal protection, gasket or any other component.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            We also install and remove water heaters when needed. A technician visits your address, finds the fault and tells you what repair is needed before any work is carried out.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Diagnostics in Varna</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call to book a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">

      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">In-Home Water Heater Repair and Diagnostics</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            With water heaters, the same symptom can have different causes. A lack of hot water may be related to the heating element, the thermostat, the thermal protection, the electrical supply or another part of the system.
          </p>
          <p>
            In case of a leak, it is important first to establish where the water is coming from. A leak around the flange or the connections is a different problem from a leak related to the tank itself. That is why every repair starts with diagnostics.
          </p>
          <p>
            The technician checks the components related to the specific symptom, and you receive information about the fault found and the recommended repair. When the fault allows it, the repair is carried out at your address. You can also read <a href="/en/reviews/" class="text-teal-700 font-medium hover:underline">RotoRem customer reviews</a>.
          </p>
        </div>
      </section>

    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Бойлер" />

    <div class="container max-w-5xl">

      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Faults We Repair</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-teal-50 via-white to-teal-50 p-6 md:p-8 rounded-2xl shadow-xl border border-teal-100">
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
                {item.extra && item.link && (
                  <p class="mt-3 text-gray-800 leading-relaxed">
                    {item.extra}{' '}
                    <a href={item.link.href} class="font-semibold text-blue-700 hover:underline">{item.link.label}</a>.
                  </p>
                )}
                {item.link && !item.extra && (
                  <p class="mt-3">
                    <a href={item.link.href} class="font-bold text-blue-700 hover:underline">{item.link.label}</a>
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Diagnostics in Varna</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Diagnostics aim to establish the cause of the problem before any components are replaced.
            </p>
            <p class="font-medium text-gray-900">Depending on the symptom, we may check:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>the heating element;</li>
              <li>the thermostat;</li>
              <li>the thermal protection;</li>
              <li>electrical connections;</li>
              <li>the power cable;</li>
              <li>the flange;</li>
              <li>the gasket;</li>
              <li>the safety valve;</li>
              <li>the water inlet and outlet connections;</li>
              <li>the presence of a leak;</li>
              <li>the condition around the heating element;</li>
              <li>limescale build-up;</li>
              <li>anode protection, where the construction allows it;</li>
              <li>the overall condition of the water heater.</li>
            </ul>
            <p>
              After the inspection, you receive information about what was found and what repair is recommended.
            </p>
            <p class="font-semibold text-gray-900">Visit and diagnostics in Varna: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Water heater diagnostics in Varna"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Parts and Systems We Inspect and Repair</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-teal-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-teal-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-teal-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Commonly related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Important: the same symptom can be caused by different components. The exact repair and the required parts are determined after diagnostics.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Heating Element Replacement</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-teal-50 via-white to-teal-50 p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>The heating element converts electrical energy into heat and is one of the main components of an electric water heater.</p>
          <p>When it fails, symptoms may include cold water, insufficient heating, the protection tripping or the heating cycle being interrupted.</p>
          <p>Before replacement, the heating element must be tested, because similar symptoms can also be caused by the thermostat, the thermal protection or an electrical fault. When a replacement is needed, a component suitable for the specific model is used.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Thermostat and Thermal Protection</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-teal-50 via-white to-teal-50 p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>The thermostat takes part in controlling the water temperature, and the protective components play an important role in the safe operation of the appliance.</p>
          <p>When there is a problem, the water heater may not heat, may cut out too early, may overheat or may not restart after the protection has tripped. Before replacement, we check which component is causing the specific behavior.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Leaks</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-teal-50 via-white to-teal-50 p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>Not all leaks have the same cause or the same repair. It is important to establish whether the water is coming from a connection, a valve, the flange, the gasket or the tank itself.</p>
          <p>In case of a leak around the flange, it may be necessary to check the gasket and the condition of the related components. If there is a suspected problem with the tank itself, it must be assessed whether a repair is reasonable.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Descaling (Limescale Removal)</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-teal-50 via-white to-teal-50 p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>Over time, mineral deposits can build up on the heating element and other internal parts. The amount depends on the operating conditions, the water and the period of use.</p>
          <p>When the water heater is opened, the technician can assess the condition of the heating element and the presence of build-up. Cleaning is carried out when it is necessary and suitable for the specific appliance.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Anode Protection</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-teal-50 via-white to-teal-50 p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>In water heaters with a magnesium anode, the anode protects the tank against corrosion. Its condition can be checked during suitable maintenance or when the water heater is opened for another repair.</p>
          <p>No universal replacement interval is set without taking into account the model, the manufacturer's instructions and the operating conditions.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Installation and Removal</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Water heater installation</h3>
            <p class="mb-3 font-medium text-gray-900">When installing a new electric water heater, the following may be carried out:</p>
            <ul class="list-disc pl-5 space-y-2 mb-4">
              <li>positioning and suitable mounting;</li>
              <li>checking the water connections;</li>
              <li>installing or checking the safety valve;</li>
              <li>connection according to the specific installation;</li>
              <li>filling and checking for leaks;</li>
              <li>a test run of the appliance.</li>
            </ul>
          </div>
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-teal-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Removal of an old water heater</h3>
            <p>When the appliance is being replaced, the old water heater can be switched off, drained, disconnected from the water connections and safely taken down.</p>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Types of Water Heaters We Service</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          <div class="bg-white p-6 rounded-2xl shadow-lg border border-teal-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Vertical water heaters</h3>
            <p class="text-gray-800 leading-relaxed">One of the most common types for the home. The repair depends on the construction, the capacity and the specific fault.</p>
          </div>
          <div class="bg-white p-6 rounded-2xl shadow-lg border border-teal-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Horizontal water heaters</h3>
            <p class="text-gray-800 leading-relaxed">The layout of the components and the way they are mounted can differ from vertical models.</p>
          </div>
          <div class="bg-white p-6 rounded-2xl shadow-lg border border-teal-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Compact water heaters</h3>
            <p class="text-gray-800 leading-relaxed">Models for under-sink installation. Diagnostics are carried out according to the specific model and access to the components.</p>
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="teal" /></div>}

      <!-- Brands -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water Heater Brands We Service</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">
            RotoRem diagnoses and repairs electric water heaters from many manufacturers, including:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            Construction, heating elements, thermostats, flanges and other components can differ depending on the brand and model. When you call, it is helpful to give the manufacturer, the model and the approximate capacity of the water heater.
          </p>
        </div>
      </section>

      <!-- Real cases -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real Water Heater Repairs in Varna</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>

        <div class="space-y-8">
