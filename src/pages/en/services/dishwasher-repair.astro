---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';
const lang = 'en';
const pricing = getServicePricing('dishwasher', 'varna', lang);

const title = 'Dishwasher Repair in Varna | In-Home Service | RotoRem';
const description =
  'In-home dishwasher repair and diagnostics in Varna. Drainage, filling, heating, leaks, pumps, door and electronics problems. RotoRem.';

const heroImage = '/img/services/ремонт-на-съдомиялна-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-съдомиялна-варна-диагностика.webp';
const builtInImage = '/img/services/ремонт-на-съдомиялна-варна-вградена.webp';
const freestandingImage = '/img/services/ремонт-на-съдомиялна-варна-свободностояща.webp';

const accentBar = 'bg-emerald-500';
const accentLink = 'text-emerald-700';
const accentShell = 'from-emerald-50 via-white to-teal-50 border-emerald-100';
const accentBorder = 'border-emerald-100';
const tableHeader = 'bg-emerald-600';

const problems = [
  {
    title: 'Dishwasher does not drain',
    text: 'If water remains at the bottom of the dishwasher after the program ends, the cause may be a clogged filter, a problem along the drain path, a bent or blocked hose or a faulty drain pump. During diagnostics we first establish where the problem comes from, instead of going straight to replacing the pump.',
    border: 'border-emerald-500',
  },
  {
    title: 'Dishwasher does not fill with water',
    text: 'When the program starts but not enough water enters the machine, we check the water supply and the components that control filling. The cause may be related to the inlet hose, the filter, the inlet valve, a sensor or another part of the system.',
    border: 'border-teal-500',
  },
  {
    title: 'Dishwasher does not heat the water',
    text: 'If dishes stay cold or wet after the program, the heating system needs to be checked. Depending on the model, the problem may be related to the heating element, a temperature sensor, the electronic control or another component involved in temperature control. Diagnostics show whether a heating element really needs to be replaced or whether the cause is something else.',
    border: 'border-green-500',
  },
  {
    title: 'Dishwasher does not clean well',
    text: 'Food residue, stains or poorly cleaned dishes do not always mean a serious fault. We check the filters, spray arms and nozzles, water circulation and other components that affect washing performance. Grease and limescale build-up can also affect how the machine works.',
    border: 'border-lime-600',
  },
  {
    title: 'Dishwasher leaks',
    text: 'Water can appear under the machine, around the door or at a certain stage of the program. The cause may be related to the door seal, a hose, a connection, the pump or another component of the water system. If there is a visible leak, it is best to stop using the machine until the cause has been found.',
    border: 'border-red-500',
  },
  {
    title: 'Dishwasher does not start',
    text: 'When the machine has power but the program does not begin, we check the components involved in starting and controlling the cycle. The problem may be related to the door lock, the electronic control, the power supply or another electrical component.',
    border: 'border-cyan-500',
  },
  {
    title: 'Program stops before it finishes',
    text: 'An interruption in the middle of the program may be related to a filling, drainage or heating problem, a sensor or the electronic control. It is important to determine at which point in the cycle the machine stops, because this helps with diagnostics.',
    border: 'border-indigo-500',
  },
  {
    title: 'Dishwasher makes unusual noise',
    text: 'The noise may come from the circulation or drain pump, a spray arm, a foreign object or another moving component. The type of noise and when it occurs help determine which system needs to be checked.',
    border: 'border-violet-500',
  },
  {
    title: 'Door does not close or lock',
    text: 'A closing problem can stop the machine from starting at all. We check the door mechanism, the lock, the hinges and the correct positioning of the appliance. For built-in dishwashers, we also check whether the installation and the cabinet front panel interfere with proper closing.',
    border: 'border-orange-500',
  },
  {
    title: 'Dishwasher shows an error code',
    text: 'An error code gives an important clue during diagnostics, but it does not automatically mean that a specific part must be replaced. The technician compares the code with the machine\'s symptoms and checks the relevant system before determining the required repair.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Drain pump', problem: 'Water remains in the machine' },
  { part: 'Circulation pump', problem: 'Weak or no circulation' },
  { part: 'Filter', problem: 'Poor washing results or a drainage problem' },
  { part: 'Drain hose', problem: 'Machine does not drain properly' },
  { part: 'Inlet valve', problem: 'Dishwasher does not fill with water' },
  { part: 'Heating system', problem: 'Water does not heat' },
  { part: 'Temperature sensor', problem: 'Incorrect heating' },
  { part: 'Spray arms', problem: 'Dishes are not washed evenly' },
  { part: 'Nozzles', problem: 'Reduced water circulation' },
  { part: 'Door seal', problem: 'Leak around the door' },
  { part: 'Door lock', problem: 'Machine does not start' },
  { part: 'Electronic module', problem: 'Program stops or does not start' },
  { part: 'Control board', problem: 'Various control problems' },
];

const realCases = [
  {
    brand: 'Miele',
    problem: 'Dishwasher would not turn on',
    area: 'Levski',
    diagnosis: 'We found a problem with the machine\'s main board.',
    repair: 'After the board was replaced, the machine works normally.',
    image: builtInImage,
    alt: 'Miele dishwasher repair: machine not turning on due to a faulty main board, board replaced in the Levski district, Varna.',
  },
  {
    brand: 'Bosch',
    problem: 'Dishwasher was not cleaning the dishes',
    area: 'Hristo Botev',
    diagnosis: 'A power supply problem with the machine\'s circulation pump.',
    repair: 'A new power supply was installed.',
    image: diagnosticImage,
    alt: 'Bosch dishwasher repair: dishes not being cleaned because of a power supply problem with the circulation pump, in the Hristo Botev district, Varna.',
  },
  {
    brand: 'Bosch',
    problem: 'Dishwasher showed a "Communication Error"',
    area: 'Hristo Botev',
    diagnosis: 'A problem on one of the machine\'s boards.',
    repair: 'The board was successfully repaired and the machine now works normally.',
    image: '/img/services/ремонт-на-съдомиялна-варна-случай-3.webp',
    alt: 'Bosch dishwasher repair: "Communication Error" caused by an electronic board fault, in the Hristo Botev district, Varna.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Contact RotoRem',
    text: 'Describe how the problem shows up. If the machine displays an error code, tell us that too.',
    circleClass: 'bg-gradient-to-r from-emerald-500 to-emerald-600',
  },
  {
    step: 2,
    title: 'We schedule a visit',
    text: 'A technician visits your address in Varna at the agreed time.',
    circleClass: 'bg-gradient-to-r from-teal-500 to-teal-600',
  },
  {
    step: 3,
    title: 'Diagnostics',
    text: 'The systems and components that could cause the specific symptom are inspected.',
    circleClass: 'bg-gradient-to-r from-green-500 to-green-600',
  },
  {
    step: 4,
    title: 'You get repair information',
    text: 'We explain what was found and what needs to be repaired or replaced.',
    circleClass: 'bg-gradient-to-r from-cyan-500 to-cyan-600',
  },
  {
    step: 5,
    title: 'Repair and test',
    text: 'Where possible, the repair is carried out on site. Once finished, the machine is tested.',
    circleClass: 'bg-gradient-to-r from-emerald-600 to-teal-700',
  },
];

const brands = ['Bosch', 'Siemens', 'Electrolux', 'Whirlpool', 'Indesit', 'Candy', 'Miele'];

const faqs = getServiceFaqItems('/en/services/dishwasher-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dishwasher-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="In-home dishwasher repair in Varna"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/85 via-emerald-900/75 to-emerald-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            In-home service in Varna
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            In-Home Dishwasher Repair in Varna
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Dishwasher not draining, not heating the water, not starting, or leaving dishes dirty after the program?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            RotoRem provides in-home diagnostics and repair of dishwashers in Varna. A technician visits your address, inspects the appliance and finds the cause of the problem before any repair or part replacement is carried out.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Diagnostics in Varna</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call to book a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">In-Home Dishwasher Repair and Diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            With dishwashers, the same symptom can have more than one cause. A machine that does not drain, for example, may have a blockage or a problem with the filter, the drain hose or the pump. When there is no heating, the cause is not necessarily just the heating element either. That is why a repair starts with checking the specific problem.
          </p>
          <p>
            Depending on the symptom, the technician may inspect the water inlet and drainage system, the filters, the pumps, the heating system, the spray arms, the seals, the door, the sensors and the electronic control.
          </p>
          <p>
            When the fault allows it, the repair is carried out at your address. If a specific spare part is needed, you receive information about what was found and what has to be replaced.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Съдомиялна" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher Faults We Repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="emerald" /></div>}

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher Diagnostics in Varna</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Diagnostics aim to establish the cause of the problem before any parts are replaced.
            </p>
            <p class="font-medium text-gray-900">Depending on the symptom, we may check:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>filters;</li>
              <li>the drainage system;</li>
              <li>the drain pump;</li>
              <li>the circulation pump;</li>
              <li>the inlet valve;</li>
              <li>the inlet and drain hoses;</li>
              <li>the heating system;</li>
              <li>temperature sensors;</li>
              <li>spray arms;</li>
              <li>nozzles;</li>
              <li>seals;</li>
              <li>the door mechanism and lock;</li>
              <li>the electronic module;</li>
              <li>the control board;</li>
              <li>any error codes displayed.</li>
            </ul>
            <p>
              After the inspection, you receive information about what fault was found and what repair is needed.
            </p>
            <p class="font-semibold text-gray-900">Visit and diagnostics in Varna: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Dishwasher diagnostics in Varna"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher Parts and Systems We Inspect and Repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Commonly related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every symptom means a faulty part. A blockage, an incorrect connection or a problem in another system can lead to similar behavior, so the exact repair is determined after diagnostics.
        </p>
      </section>

      <!-- Pumps -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Pumps and Water Circulation Problems</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>
            A dishwasher uses different systems to move and drain water during the program. A pump problem can therefore show up in different ways – the machine may not drain, may wash poorly, may make unusual noise or may interrupt the program.
          </p>
          <p>
            During diagnostics we check whether the problem comes from the pump, a blockage, a foreign object or another component of the system. A pump is replaced only when the inspection shows that it is really the cause of the fault.
          </p>
        </div>
      </section>

      <!-- Installation -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher Installation and Removal</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Freestanding dishwasher installation</h3>
            <p class="mb-3 font-medium text-gray-900">Installation may include:</p>
            <ul class="list-disc pl-5 space-y-2 mb-4">
              <li>positioning the appliance;</li>
              <li>leveling;</li>
              <li>connecting to the water supply;</li>
              <li>connecting to the drain;</li>
              <li>checking the hoses and connections;</li>
              <li>a leak test;</li>
              <li>a test run of the machine.</li>
            </ul>
            <p>Correct connection and leveling are important for the normal operation of the dishwasher.</p>
          </div>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Built-in dishwasher installation</h3>
            <p class="mb-4">
              A built-in dishwasher requires correct positioning relative to the kitchen cabinet and the existing connections. During installation we check leveling, water supply, drainage and the free movement of the door. When the model requires a cabinet front panel, the installation must follow the specific system of the manufacturer.
            </p>
          </div>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Removal of an old dishwasher</h3>
            <p>
              When an old appliance is being replaced, RotoRem can remove it and disconnect it from the existing water and drain connections. With a built-in model, removal must be done carefully so that the kitchen cabinets and the existing connections are not damaged.
            </p>
          </div>
        </div>
      </section>

      <!-- Freestanding and built-in -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Freestanding and Built-In Dishwashers</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>
            RotoRem services both freestanding and built-in dishwashers. With built-in models, access to some components may require partially removing the appliance from the kitchen cabinet. During diagnostics we take into account how the machine is installed, the water connections, the drainage and the positioning of the appliance.
          </p>
          <p>
            When you call, it helps to say whether the dishwasher is freestanding or built-in, as well as the brand and model, if known.
          </p>
          <div class="grid md:grid-cols-2 gap-6">
            <img
              src={builtInImage}
              alt="Built-in dishwasher repair in Varna"
              class="w-full rounded-2xl shadow-lg object-cover min-h-[220px]"
              loading="lazy"
              width="600"
              height="450"
            />
            <img
              src={freestandingImage}
              alt="Freestanding dishwasher – installation and repair in Varna"
              class="w-full rounded-2xl shadow-lg object-cover min-h-[220px]"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Brands -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher Brands We Service</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center max-w-3xl mx-auto">
            RotoRem diagnoses and repairs dishwashers from many manufacturers, including:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            Construction, electronics, programs and error codes can differ depending on the manufacturer and the specific model. When you book, it is helpful to provide the brand, the model and the error code, if one is displayed.
          </p>
        </div>
      </section>

      <!-- Real cases -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real Dishwasher Repairs in Varna</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full md:w-2/5 lg:w-5/12 object-cover min-h-[220px] md:min-h-[280px]"
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.brand} – Dishwasher</h3>
                  <p class="text-gray-800"><span class="font-semibold">Problem:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">Area:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Cause identified:</span> {item.diagnosis}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {item.repair}</p>
                </div>
              </article>
            ))}
          </div>

          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow max-w-5xl mx-auto">
            <img
              src={realCases[2].image}
              alt={realCases[2].alt}
              class="w-full lg:w-2/5 object-cover min-h-[240px] lg:min-h-[300px]"
              loading="lazy"
              width="560"
              height="400"
            />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].brand} – Dishwasher</h3>
              <p class="text-gray-800"><span class="font-semibold">Problem:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Area:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Cause identified:</span> {realCases[2].diagnosis}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {realCases[2].repair}</p>
            </div>
          </article>
        </div>
      </section>

      <!-- Process -->
      <section class={sectionClass}>
