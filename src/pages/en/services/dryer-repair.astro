---
import Layout from '../../../layouts/Base.astro';

const title = 'Dryer Repair in Varna | In-Home Service by RotoRem';
const description = 'Fast dryer repair in Varna for all major brands. We fix heating problems, drum faults, electronics issues, and unusual noise with warranty.';
---

<Layout title={title} description={description}>
  <article>
    <section class="bg-gradient-to-r from-indigo-600 to-indigo-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">In-Home Dryer Repair and Installation in Varna</h1>
        <p class="text-xl md:text-2xl text-indigo-100 max-w-3xl mx-auto mb-8">
          Professional in-home dryer diagnostics and repair in Varna with fast response and guaranteed workmanship.
        </p>
        <p class="text-base md:text-lg text-indigo-100 max-w-2xl mx-auto mb-8">
          Visit and diagnostics in Varna - 20,46 € (40 BGN)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-indigo-700 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Send Email
          </a>
          <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Call 089 834 0982
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Why choose our dryer repair service in Varna?</h2>
          <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-indigo-200">
            <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-indigo-900 mb-3">On-site service</h3>
            <p class="text-indigo-800">We come directly to your address in Varna, so there is no need to move the appliance.</p>
          </div>
          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-emerald-200">
            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-emerald-900 mb-3">Same-day repair</h3>
            <p class="text-emerald-800">In most cases we complete the repair during the first visit.</p>
          </div>
          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Warranty</h3>
            <p class="text-amber-800">We provide warranty on both labour and installed parts.</p>
          </div>
          <div class="bg-gradient-to-br from-lime-50 to-lime-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-lime-200">
            <div class="w-12 h-12 bg-lime-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-lime-900 mb-3">Fair prices</h3>
            <p class="text-lime-800">Visit and diagnostics in Varna - 20,46 € (40 BGN). Clear pricing without hidden fees.</p>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer repair process in Varna</h2>
          <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8 mb-10">
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-indigo-500 to-indigo-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">1</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">You call us</h3>
              <p class="text-gray-700">Call 089 834 0982 to book dryer repair in Varna.</p>
            </div>
          </div>
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">We come to you</h3>
              <p class="text-gray-700">Our technician arrives on time with the required tools and parts.</p>
            </div>
          </div>
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">3</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">We repair</h3>
              <p class="text-gray-700">We diagnose the issue and complete the repair the same day whenever possible.</p>
            </div>
          </div>
        </div>

        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Common dryer problems we resolve</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Dryer not heating</h3>
            <p class="text-gray-700">Heater, thermostat, sensor, and relay diagnostics with professional component replacement.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-emerald-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Drum not spinning</h3>
            <p class="text-gray-700">Repair of belts, rollers, motors, and drive systems to restore stable operation.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Cycle stops unexpectedly</h3>
            <p class="text-gray-700">Full electronics and overheating checks to identify and remove root causes.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Noise and vibration</h3>
            <p class="text-gray-700">Bearing and mechanical inspection to eliminate friction, vibration, and abnormal sounds.</p>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Dryer brands we service</h2>
          <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-gray-700 text-center">
          <h3>AEG</h3>
          <h3>Bosch</h3>
          <h3>Whirlpool</h3>
          <h3>Beko</h3>
          <h3>Indesit</h3>
          <h3>Samsung</h3>
          <h3>LG</h3>
          <h3>Electrolux</h3>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="text-center bg-gradient-to-r from-indigo-600 to-indigo-800 text-white p-12 rounded-2xl shadow-2xl">
        <h2 class="text-3xl font-bold mb-4">Need dryer repair in Varna?</h2>
        <p class="text-xl mb-8 text-indigo-100">Call now for professional dryer repair service!</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-indigo-700 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Send Email
          </a>
          <a href="tel:+359 89 834 0982" class="bg-indigo-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-indigo-600 transition-colors shadow-lg">
            Call 089 834 0982
          </a>
        </div>
        
        <div class="text-indigo-100">
          <p class="text-sm">
            Visit and diagnostics: Varna - 20,46 € (40 BGN) • Certified engineers • Service in Varna
          </p>
        </div>
      </section>
    </div>
  </article>
</Layout>
