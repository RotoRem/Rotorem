---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';

const lang = 'en';
const pricing = getServicePricing('dryer', 'varna', lang);

const title = 'Dryer Repair in Varna | In-Home Service | RotoRem';
const description =
  'In-home dryer repair and diagnostics in Varna. Heating, heat pump, drum, belt, pump, noise and electronics problems. RotoRem.';

const heroImage = '/img/services/ремонт-на-сушилня-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-сушилня-варна-диагностика.webp';

const accentBar = 'bg-fuchsia-500';
const accentLink = 'text-fuchsia-700';
const accentShell = 'from-fuchsia-50 via-white to-purple-50 border-fuchsia-100';
const accentBorder = 'border-fuchsia-100';
const tableHeader = 'bg-fuchsia-600';

const problems = [
  {
    title: 'Dryer does not heat',
    text: 'When the drum turns but the clothes stay cold and damp, the problem may be related to the heating element, thermostat, temperature sensor, electronic control or another part of the heating system. On heat pump dryers the cause can differ from standard condenser models, so the specific system is checked first.',
    border: 'border-fuchsia-500',
  },
  {
    title: 'Dryer runs but does not dry well',
    text: 'Longer drying times do not always mean a serious fault. The cause may be reduced airflow, dirty filters, a condenser problem, a temperature sensor, a fan or another part of the system. On heat pump models, the components related to that system are checked as well.',
    border: 'border-purple-500',
  },
  {
    title: 'Drum does not rotate',
    text: 'If the program starts but the drum stays still, we check the belt, motor, rollers, bearings and the mechanical movement of the drum. A broken belt is one possible cause, but it is not the only one.',
    border: 'border-pink-500',
  },
  {
    title: 'Dryer does not start',
    text: 'When the machine does not respond or the program will not start, we may check the power supply, the door mechanism, the electronic module, the programmer and the other components involved in starting.',
    border: 'border-violet-500',
  },
  {
    title: 'Dryer stops during the program',
    text: 'An interruption may be related to overheating, temperature sensors, insufficient airflow, the motor, electronics or a safety system. It is important to establish at which point the dryer stops and whether it shows an error code.',
    border: 'border-rose-500',
  },
  {
    title: 'Dryer is making a loud noise',
    text: 'Humming, grinding, whistling or banging can be related to rollers, bearings, the motor, the drum or a foreign object. The type of noise and when it appears give important information during diagnostics.',
    border: 'border-indigo-500',
  },
  {
    title: 'Dryer vibrates',
    text: 'Excessive vibration can be related to leveling of the appliance, the drum, rollers, bearings or another mechanical part. If the dryer is stacked on a washing machine, the stability of the installation should also be checked.',
    border: 'border-teal-500',
  },
  {
    title: 'Dryer does not collect or drain water',
    text: 'On condenser models the problem may be related to the pump, the condensate tank, the hose or another part of the water drainage system. On models connected directly to the drain, the drainage connection is checked as well.',
    border: 'border-cyan-500',
  },
  {
    title: 'Door does not close or the dryer does not detect closing',
    text: 'If the machine does not recognize that the door is closed, the program may not start at all. We check the locking mechanism, the door sensor and the mechanical closing.',
    border: 'border-orange-500',
  },
  {
    title: 'Dryer shows an error code',
    text: 'An error code helps direct diagnostics toward a specific system, but it does not by itself prove which part must be replaced. The technician compares the code with the machine’s behavior and checks the relevant components.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Heating element', problem: 'Dryer does not heat' },
  { part: 'Thermostat', problem: 'No heating or overheating' },
  { part: 'Temperature sensor', problem: 'Incorrect temperature' },
  { part: 'Humidity sensor', problem: 'Program ends too early or too late' },
  { part: 'Belt', problem: 'Drum does not rotate' },
  { part: 'Rollers', problem: 'Noise or incorrect drum movement' },
  { part: 'Bearings', problem: 'Loud noise during operation' },
  { part: 'Motor', problem: 'Drum does not rotate' },
  { part: 'Fan', problem: 'Reduced airflow' },
  { part: 'Filter', problem: 'Long drying / overheating' },
  { part: 'Condenser', problem: 'Reduced efficiency' },
  { part: 'Pump', problem: 'Water is not drained' },
  { part: 'Door lock', problem: 'Machine does not start' },
  { part: 'Electronic module', problem: 'Interruptions or program problems' },
  { part: 'Heat pump', problem: 'Low efficiency or lack of drying' },
];

const diagnosticChecks = [
  'heating element;',
  'thermostats;',
  'temperature sensors;',
  'humidity sensor;',
  'drum;',
  'belt;',
  'rollers;',
  'bearings;',
  'motor;',
  'fan;',
  'filters;',
  'condenser;',
  'condensate water pump;',
  'hoses;',
  'door mechanism;',
  'electronic module;',
  'control board;',
  'heat pump system;',
  'visible error codes.',
];

const realCases = [
  {
    brand: 'AEG',
    problem: 'Dryer was not drying clothes well',
    area: 'Mladost',
    diagnosis: 'We found that the dryer was heavily contaminated.',
    repair: 'After maintenance and cleaning of the compressor unit, the dryer works like new.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-1.webp',
    alt: 'Maintenance and cleaning of an AEG dryer that was not drying clothes well because of a heavily contaminated compressor unit in the Mladost district, Varna.',
  },
  {
    brand: 'Bosch',
    problem: 'Drum was not turning',
    area: 'Levski',
    diagnosis: 'We found a broken belt on the motor that drives the drum.',
    repair: 'After the belt was replaced, the dryer works normally.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-2.webp',
    alt: 'Bosch dryer repair: drum not turning, broken drive belt replaced in the Levski district, Varna.',
  },
  {
    brand: 'BEKO',
    problem: 'Overheating protection kept activating.',
    area: 'City Center',
    diagnosis: 'We found that there was no air circulation because of contamination.',
    repair: 'After cleaning, the dryer started working normally and no longer showed any error.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-3.webp',
    alt: 'BEKO dryer repair: overheating protection triggered by lack of air circulation, resolved in the city center of Varna.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Contact RotoRem',
    text: 'Describe how the problem shows up. If there is an error code, tell us that as well.',
    circleClass: 'bg-gradient-to-r from-fuchsia-500 to-fuchsia-600',
  },
  {
    step: 2,
    title: 'We schedule a visit',
    text: 'A technician visits your address in Varna at the agreed time.',
    circleClass: 'bg-gradient-to-r from-purple-500 to-purple-600',
  },
  {
    step: 3,
    title: 'Diagnostics',
    text: 'The components and systems that may cause the specific problem are checked.',
    circleClass: 'bg-gradient-to-r from-pink-500 to-pink-600',
  },
  {
    step: 4,
    title: 'Repair information',
    text: 'The customer receives information about the fault found and what needs to be done.',
    circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600',
  },
  {
    step: 5,
    title: 'Repair and test',
    text: 'Where possible, the repair is carried out on site, after which the dryer is tested.',
    circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600',
  },
];

const brands = ['AEG', 'Bosch', 'Whirlpool', 'Beko', 'Indesit', 'Samsung', 'LG', 'Electrolux'];

const faqs = getServiceFaqItems('/en/services/dryer-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dryer-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="In-home dryer repair in Varna"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-purple-950/85 via-fuchsia-900/75 to-purple-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            In-home service in Varna
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            In-home dryer repair in Varna
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Dryer not heating, not drying clothes well, drum not turning, or the machine interrupting mid-program?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            RotoRem provides in-home dryer diagnostics and repair in Varna. We work with condenser dryers and heat pump models, first establishing the cause of the problem before repairing or replacing a component.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Diagnostics in Varna</p>
              <p class="text-xl font-bold text-white">€20</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call to book a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">In-home dryer repair and diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            With dryers, the same symptom can have different causes.
          </p>
          <p>
            A machine that does not dry well, for example, may have a problem with airflow, filters, the heating system, a temperature sensor or the heat pump. If the drum does not rotate, the cause may be the belt, motor, rollers or another mechanical part.
          </p>
          <p>
            That is why repair starts with diagnostics of the systems related to the specific symptom.
          </p>
          <p>
            Depending on the model and the problem, the technician may check the heating element, thermostats, temperature sensors, belt, drum, rollers, bearings, motor, fan, pump, condenser system, heat pump and electronic control.
          </p>
          <p>
            When the fault allows it, the repair is carried out at your address.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="Customer Reviews of RotoRem" prioritizeAppliance="Сушилня" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What dryer problems we repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Pricing — higher on the page -->
      {pricing && (
        <div class={sectionClass}>
          <ServicePricing pricing={pricing} accent="purple" />
          <p class="mt-6 text-center text-gray-800 leading-relaxed max-w-3xl mx-auto">
            The final price depends on the fault found, the labour required and the spare parts used. The customer receives repair information after diagnostics.
          </p>
        </div>
      )}

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer diagnostics in Varna</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-start">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Diagnostics aim to establish the cause of the problem before parts are replaced.
            </p>
            <p class="font-medium text-gray-900">Depending on the symptom, the following may be checked:</p>
            <ul class="list-disc pl-5 space-y-1.5 columns-1 sm:columns-2 gap-x-8">
              {diagnosticChecks.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p>
              After the inspection, the customer receives information about what was found and what repair is needed.
            </p>
            <p class="font-semibold text-gray-900">Diagnostics in Varna: €20</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Dryer diagnostics in Varna"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer parts and systems we check and repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Part / system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Commonly related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every symptom means a damaged part. A dirty filter, restricted airflow or another system problem can cause similar behavior, so the specific repair is determined after diagnostics.
        </p>
      </section>

      <!-- Heat pump -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Heat pump dryer repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>
            Heat pump dryers work differently from standard models with a heating element and use a closed system to reuse heat.
          </p>
          <p>
            When such an appliance starts drying significantly more slowly, does not reach the required temperature or interrupts the program, the cause may be related to airflow, sensors, the fan, the condenser system or heat pump components.
          </p>
          <p>
            Before repair is undertaken, it must be established which part of the system is actually causing the problem.
          </p>
          <p>
            RotoRem diagnoses and services the accessible components of heat pump dryers. We do not repair compressors or the refrigeration circuit of the heat pump.
          </p>
        </div>
      </section>

      <!-- Belt and drum -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Belt, rollers and drum problems</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>
            When the drum does not rotate or a strong mechanical noise appears during operation, the parts involved in its movement need to be checked.
          </p>
          <p class="font-medium text-gray-900">This may include:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>the belt;</li>
            <li>the rollers;</li>
            <li>the bearings;</li>
            <li>the motor;</li>
            <li>the drum itself.</li>
          </ul>
          <p>
            A broken or stretched belt can stop rotation completely, while a worn roller or bearing often shows up as loud noise.
          </p>
          <p>
            The specific cause is established after a mechanical inspection.
          </p>
        </div>
      </section>

      <!-- Installation -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer installation and removal</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <p>RotoRem installs and removes dryers in Varna.</p>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Dryer installation</h3>
            <p class="mb-3 font-medium text-gray-900">Installation may include:</p>
            <ul class="list-disc pl-5 space-y-2 mb-4">
              <li>positioning;</li>
              <li>leveling;</li>
              <li>stability check;</li>
              <li>connection to drainage when the model allows it;</li>
              <li>checking the required space around the appliance;</li>
              <li>testing the machine.</li>
            </ul>
            <p>Correct placement is important for stable operation and normal airflow.</p>
          </div>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Installing a dryer on a washing machine</h3>
            <p class="mb-4">
              Where space is limited, the dryer can be placed on top of a washing machine when the models and conditions allow it.
            </p>
            <p class="mb-4">
              The installation must ensure stability and safe positioning of both appliances.
            </p>
            <p class="mb-4">
              If a stacking kit is required, it must be provided in advance by the owner of the appliances. RotoRem carries out the installation but does not supply stacking kits.
            </p>
            <p>
              See also the page for{' '}
              <a href="/en/services/washing-machine-repair/" class={`${accentLink} font-medium hover:underline`}>washing machine repair and installation in Varna</a>.
            </p>
          </div>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Removal of an old dryer</h3>
            <p>
              When replacing an appliance, RotoRem can remove and safely disconnect the old dryer.
            </p>
          </div>
        </div>
      </section>

      <!-- Dryer types -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Condenser dryers and heat pump dryers</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <p class="text-center text-gray-800 leading-relaxed mb-8 max-w-3xl mx-auto">
          RotoRem services different types of dryers, including:
        </p>
        <div class="grid md:grid-cols-2 gap-8">
          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder} space-y-4 text-gray-800 leading-relaxed`}>
            <h3 class="text-xl font-semibold text-gray-900">Condenser dryers</h3>
            <p>
              In these models moisture from the clothes is condensed and collected in a tank or drained through a hose.
            </p>
            <p>
              Problems can be related to heating, the condenser, the pump, airflow or sensors.
            </p>
          </div>
          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder} space-y-4 text-gray-800 leading-relaxed`}>
            <h3 class="text-xl font-semibold text-gray-900">Heat pump dryers</h3>
            <p>
              These models use a more complex system for reusing heat and usually operate at a lower temperature.
            </p>
            <p>
              When there is a problem, not only the filters and airflow need to be checked, but also the systems specific to the model.
            </p>
          </div>
        </div>
      </section>

      <!-- Brands -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer brands we service</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">
            RotoRem provides diagnostics and repair of dryers from various manufacturers, including:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            Construction and diagnostics can differ by brand, model and dryer type.
            When booking, it is helpful for the customer to provide the brand and model, as well as an error code if the machine shows one.
          </p>
        </div>
      </section>

      <!-- Real cases -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real dryer repairs in Varna</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full md:w-2/5 lg:w-5/12 object-cover min-h-[220px] md:min-h-[280px]"
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.brand} dryer</h3>
                  <p class="text-gray-800"><span class="font-semibold">Problem:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">Area:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Diagnostics:</span> {item.diagnosis}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair:</span> {item.repair}</p>
                </div>
              </article>
            ))}
          </div>

          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow max-w-5xl mx-auto">
            <img
              src={realCases[2].image}
              alt={realCases[2].alt}
              class="w-full lg:w-2/5 object-cover min-h-[240px] lg:min-h-[300px]"
              loading="lazy"
              width="560"
              height="400"
            />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].brand} dryer</h3>
              <p class="text-gray-800"><span class="font-semibold">Problem:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Area:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Diagnostics:</span> {realCases[2].diagnosis}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair:</span> {realCases[2].repair}</p>
            </div>
          </article>
        </div>
      </section>

      <!-- Process -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How the repair works</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-8">
          {processSteps.slice(0, 3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {processSteps.slice(3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Service areas -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer repair across Varna districts</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto`}>
          <p>
            RotoRem makes home visits in different parts of Varna, including:
            Mladost, Levski, Chaika, Asparuhovo, Vladislav Varnenchik, Galata, the city center and other service areas.
          </p>
          <p>
            For addresses outside the standard zone, visit terms are confirmed in advance.
          </p>
          <p>
            Customers do not need to transport the dryer to a physical service workshop.
          </p>
        </div>
      </section>

      <!-- FAQ -->
      <section class={sectionClass} id="faq">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Frequently asked questions</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((faq) => (
            <div class="bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
              <details class="group">
                <summary class="flex justify-between items-center p-5 cursor-pointer">
                  <h3 class="text-lg font-semibold text-gray-900 pr-4">{faq.q}</h3>
                  <div class="flex-shrink-0 text-gray-600 transition-transform duration-300 group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </summary>
                <div class="p-5 pt-0 text-gray-800 border-t border-gray-100">
                  <p class="leading-relaxed">{faq.a}</p>
                </div>
              </details>
            </div>
          ))}
        </div>
      </section>
    </div>
  </article>

  <div class="container max-w-5xl mb-28">
    <section class="text-center bg-gradient-to-r from-fuchsia-600 to-purple-800 text-white p-12 md:p-14 rounded-2xl shadow-2xl">
      <h2 class="text-3xl font-bold mb-4">Problem with your dryer?</h2>
      <p class="text-lg md:text-xl mb-4 text-white/90 max-w-3xl mx-auto leading-relaxed">
        If the dryer does not heat, does not dry well, the drum does not rotate, the machine stops, makes noise or shows an error, contact RotoRem for in-home diagnostics and repair in Varna.
      </p>
      <p class="text-lg mb-8">Phone: <a href="tel:0898340982" class="font-semibold text-white hover:underline">089 834 0982</a></p>
      <a href="tel:0898340982" class="inline-block bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
        Call to book a visit
      </a>
    </section>
  </div>
</Layout>

