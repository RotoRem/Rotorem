---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';
const lang = 'en';
const pricing = getServicePricing('washing-machine', 'varna', lang);

const title = 'Washing Machine Repair in Varna | In-Home Service | RotoRem';
const description = 'In-home washing machine repair and diagnostics in Varna. Leaks, spin cycle problems, drainage, heating, bearings, pumps and electronics. Call RotoRem.';

const heroImage = '/img/services/ремонт-на-пералня-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-пералня-варна-диагностика.webp';

const problems = [
  {
    title: 'Washing machine does not drain',
    text: 'If water remains in the drum after the cycle ends, the cause may be a clogged filter, the drain hose, the drain pump or another part of the drainage system. During diagnostics we check for a mechanical blockage and confirm whether the pump is working properly before any component is replaced.',
    border: 'border-blue-500',
  },
  {
    title: 'Washing machine does not spin',
    text: 'When the machine washes but does not move on to the spin cycle properly, the cause may be the motor, drive belt, carbon brushes, electronic control, drainage or drum movement. Before repairing, the technician checks whether the problem is mechanical, electrical or related to another system in the machine.',
    border: 'border-green-500',
    link: { href: '/en/blog/washing-machine-wont-spin-causes/', label: 'What can cause a spin cycle problem' },
  },
  {
    title: 'Washing machine does not heat the water',
    text: 'Cold washes do not automatically mean a burnt-out heating element. The cause may be the heater itself, the temperature sensor, the electronic module or the program control. Diagnostics identify the specific cause first, and only then do we decide whether a repair or a part replacement is needed.',
    border: 'border-amber-500',
  },
  {
    title: 'Washing machine leaks',
    text: 'A leak can appear around the door, under the machine or at a particular stage of the program. We check the door gasket, inlet and outlet hoses, the pump, the connections and any other place where water could escape. If there is a leak, it is best not to use the machine until the cause has been found.',
    border: 'border-red-500',
  },
  {
    title: 'Washing machine is noisy or vibrates heavily',
    text: 'Loud noise during spinning, metallic grinding, banging or excessive vibration can be related to the bearings, shock absorbers, drum, belt, a foreign object or incorrect leveling. The nature of the noise often gives a first clue, but the final cause is determined only after inspecting the machine.',
    border: 'border-purple-500',
  },
  {
    title: 'Drum does not rotate',
    text: 'When the machine starts but the drum does not turn normally, the belt, motor, carbon brushes, electronic control and the mechanical part of the drum need to be checked. The cause may be a relatively minor fault, but it can also point to a more serious problem, so it is important to have the machine diagnosed.',
    border: 'border-indigo-500',
  },
  {
    title: 'Washing machine does not start',
    text: 'If the machine does not respond or the program will not start, the inspection may cover the power supply, the door lock, the control board, the program selector and the other electronic components. Not every washing machine that "won\'t start" has a faulty board. Diagnostics should begin with the specific symptom.',
    border: 'border-teal-500',
    extra: 'If the problem is related to the power supply or wiring, an inspection of the electrical installation may also be needed.',
    link: { href: '/en/services/electrical-services/', label: 'In-home electrical services' },
  },
  {
    title: 'Washing machine door will not open',
    text: 'A locked door may be caused by a fault in the locking mechanism, water remaining in the machine, or a problem with the program and electronics. We do not recommend forcing the door open, as this can damage the handle, the mechanism or the door itself.',
    border: 'border-orange-500',
  },
  {
    title: 'Washing machine shows an error code',
    text: 'Error codes help with diagnostics, but a code does not always mean that a specific part must be replaced right away. The technician combines the information on the display with the machine\'s actual behavior and checks the relevant components to find the cause of the problem.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Drain pump', problem: 'Washing machine does not drain' },
  { part: 'Filter and drainage', problem: 'Water is left behind or the cycle is interrupted' },
  { part: 'Heating element', problem: 'Water does not heat' },
  { part: 'Temperature sensor', problem: 'Incorrect heating' },
  { part: 'Bearings', problem: 'Loud noise during spinning' },
  { part: 'Shaft seal', problem: 'Problems around the bearings and water ingress' },
  { part: 'Drive belt', problem: 'Drum does not rotate' },
  { part: 'Motor', problem: 'No rotation or rotation problems' },
  { part: 'Motor brushes', problem: 'Rotation and spin problems' },
  { part: 'Shock absorbers', problem: 'Strong vibrations' },
  { part: 'Door gasket', problem: 'Leak around the door' },
  { part: 'Inlet valve', problem: 'Washing machine does not fill with water' },
  { part: 'Door lock', problem: 'Machine does not start or the door stays locked' },
  { part: 'Program selector', problem: 'Program does not run properly' },
  { part: 'Electronic module', problem: 'Machine stops mid-cycle, does not start or shows errors' },
];

const realCases = [
  {
    brand: 'Bosch',
    problem: 'Water was leaking from the washing machine',
    area: 'Hristo Botev',
    diagnosis: 'The leak was traced to the front door gasket of the washing machine.',
    repair: 'After the gasket was replaced, the leak stopped and the washing machine works normally.',
    image: '/img/services/ремонт-на-пералня-варна-случай-1.webp',
    alt: 'Bosch washing machine repair: water leak from the front door gasket, damaged gasket replaced in the Hristo Botev district, Varna.',
  },
  {
    brand: 'LG',
    problem: 'Washing machine would not drain',
    area: 'City Center',
    diagnosis: 'The drain pump turned out to be burnt out.',
    repair: 'After the pump was replaced, the machine drains properly again and works normally.',
    image: diagnosticImage,
    alt: 'LG washing machine repair: machine not draining, burnt-out drain pump replaced in the city center of Varna.',
  },
  {
    brand: 'Candy',
    problem: 'Washing machine was very loud during spinning',
    area: 'Vladislav Varnenchik',
    diagnosis: 'The problem turned out to be worn shock absorbers.',
    repair: 'After the shock absorbers were replaced and the machine was leveled, the noise disappeared and the washing machine works normally.',
    image: '/img/services/ремонт-на-пералня-варна-случай-2.webp',
    alt: 'Candy washing machine repair: loud noise during spinning, worn shock absorbers replaced and machine leveled in the Vladislav Varnenchik district, Varna.',
  },
];

const processSteps = [
  { step: 1, title: 'Contact RotoRem', text: 'Tell us what is wrong with the washing machine and how the problem shows up.', circleClass: 'bg-gradient-to-r from-blue-500 to-blue-600' },
  { step: 2, title: 'We schedule a visit', text: 'A technician visits your address in Varna at the agreed time.', circleClass: 'bg-gradient-to-r from-green-500 to-green-600' },
  { step: 3, title: 'We run diagnostics', text: 'The components and systems related to the specific symptom are inspected.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 4, title: 'You get repair information', text: 'We explain what fault was found and what needs to be done.', circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600' },
  { step: 5, title: 'Repair and test', text: 'Where possible, the repair is carried out on site and the washing machine is tested before the visit ends.', circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600' },
];

const brands = ['Bosch', 'Siemens', 'AEG', 'Electrolux', 'Gorenje', 'Samsung', 'LG', 'Beko', 'Indesit', 'Whirlpool'];

const faqs = getServiceFaqItems('/en/services/washing-machine-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="wm-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="In-home washing machine repair in Varna"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/85 via-blue-900/75 to-blue-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            In-home service in Varna
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            In-Home Washing Machine Repair in Varna
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Problem with your washing machine? RotoRem provides in-home diagnostics and repair of washing machines in Varna. We handle drainage, spin cycle, heating, leaks, noise, drum, pump, bearing, motor and electronics issues.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            A technician visits your address, finds the cause of the fault and tells you what repair is needed before any work is carried out.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Diagnostics in Varna</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call to book a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">

      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">In-Home Washing Machine Repair and Diagnostics</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            When a washing machine breaks down, the first task is to find out where the problem really comes from. The same symptom can be caused by different components, which is why we do not recommend replacing parts before running diagnostics.
          </p>
          <p>
            During the visit, the technician inspects the machine according to the specific problem – the water inlet and drainage system, the heating element, the pump, the motor, the drum, the electronics and any other components related to the symptom.
          </p>
          <p>
            When the repair can be done on site, it is carried out during the visit. If a specific spare part is needed, you are told in advance what has to be replaced. You can also read <a href="/en/reviews/" class="text-blue-700 font-medium hover:underline">RotoRem customer reviews</a> that confirm the quality of our service.
          </p>
        </div>
      </section>

    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Пералня" />

    <div class="container max-w-5xl">

      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Washing Machine Faults We Repair</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 p-6 md:p-8 rounded-2xl shadow-xl border border-blue-100">
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
                {item.extra && item.link && (
                  <p class="mt-3 text-gray-800 leading-relaxed">
                    {item.extra}{' '}
                    <a href={item.link.href} class="font-semibold text-blue-700 hover:underline">{item.link.label}</a>.
                  </p>
                )}
                {item.link && !item.extra && (
                  <p class="mt-3">
                    <a href={item.link.href} class="font-bold text-blue-700 hover:underline">{item.link.label}</a>
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Washing Machine Diagnostics in Varna</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Diagnostics are a separate part of the repair and aim to establish the cause of the fault before any parts are replaced.
            </p>
            <p class="font-medium text-gray-900">Depending on the symptom, we may check:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>the water inlet system;</li>
              <li>the pump and drainage;</li>
              <li>the filter and drain hose;</li>
              <li>the heating element;</li>
              <li>the temperature sensors;</li>
              <li>the motor and carbon brushes;</li>
              <li>the drive belt;</li>
              <li>the drum;</li>
              <li>the bearings and shock absorbers;</li>
              <li>the door locking mechanism;</li>
              <li>the program selector;</li>
              <li>the electronic module and control board.</li>
            </ul>
            <p>
              After the inspection, you receive information about what was found and what repair is needed.
            </p>
            <p class="font-semibold text-gray-900">Diagnostics price in Varna: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Washing machine diagnostics in Varna"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Washing Machine Parts and Systems We Inspect and Repair</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-blue-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-blue-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-blue-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Commonly related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every fault means a part has to be replaced. In many cases, diagnostics reveal a different problem elsewhere in the system, so the exact repair is determined only after the inspection.
        </p>
      </section>

      <!-- Bearings -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Bearing Replacement and Drum Problems</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>A loud rumble or metallic noise during spinning often points to a bearing problem, but the entire mechanical system should be checked before any repair.</p>
          <p>During the inspection, we may examine the bearings, the shaft seal, the drum and the condition of the other related components.</p>
          <p>For older washing machines, it is also important to judge whether the cost of the repair is reasonable compared with the condition of the machine.</p>
          <p>RotoRem tells you what was found and what repair is recommended before any work begins.</p>
        </div>
      </section>

      <!-- Installation -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Washing Machine Installation and Removal</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <p>In addition to repairs, RotoRem installs and removes washing machines in Varna.</p>

          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Washing machine installation</h3>
            <p class="mb-3 font-medium text-gray-900">Installation may include:</p>
            <ul class="list-disc pl-5 space-y-2 mb-4">
              <li>positioning the machine;</li>
              <li>leveling;</li>
              <li>connecting to the water supply;</li>
              <li>connecting to the drain;</li>
              <li>checking the inlet and outlet connections;</li>
              <li>a test run to confirm correct operation.</li>
            </ul>
            <p>Proper leveling is especially important, because a machine that is not set up correctly can vibrate and walk across the floor during spinning.</p>
          </div>

          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Washing machine removal</h3>
            <p>When needed, an old or faulty machine can be safely disconnected from the water supply and the drain. The goal is to remove it without leaks and without damaging the existing connections.</p>
          </div>

          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Washing machine and dryer</h3>
            <p>When a dryer is installed together with the washing machine, an additional check of how the two appliances are positioned and connected may be needed. RotoRem also provides <a href="/en/services/dryer-repair/" class="text-blue-700 font-medium hover:underline">dryer repair and installation in Varna</a>.</p>
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="blue" /></div>}

      <!-- Brands -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Washing Machine Brands We Service</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">
            RotoRem repairs washing machines from many manufacturers, including:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            Construction, electronics and error codes can differ between brands, so diagnostics are carried out according to the specific model and symptom.
          </p>
        </div>
      </section>

      <!-- Real cases -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real Washing Machine Repairs in Varna</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full md:w-2/5 lg:w-5/12 object-cover min-h-[220px] md:min-h-[280px]"
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.brand} – Washing Machine</h3>
                  <p class="text-gray-800"><span class="font-semibold">Problem:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">Area:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Cause identified:</span> {item.diagnosis}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {item.repair}</p>
                </div>
              </article>
            ))}
          </div>

          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow max-w-5xl mx-auto">
            <img
              src={realCases[2].image}
              alt={realCases[2].alt}
              class="w-full lg:w-2/5 object-cover min-h-[240px] lg:min-h-[300px]"
              loading="lazy"
              width="560"
              height="400"
            />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].brand} – Washing Machine</h3>
              <p class="text-gray-800"><span class="font-semibold">Problem:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Area:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Cause identified:</span> {realCases[2].diagnosis}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {realCases[2].repair}</p>
            </div>
          </article>
        </div>
      </section>

      <!-- Process: 3 + 2 grid -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How the Repair Works</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-8">
          {processSteps.slice(0, 3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {processSteps.slice(3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
