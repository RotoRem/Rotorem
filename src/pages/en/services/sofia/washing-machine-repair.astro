  },
  {
    "title": "The door won't open",
    "text": "The locking mechanism, the water drain and the control of the washing machine are checked.",
    "border": "border-pink-500",
    "centrifugeLink": false
  },
  {
    "title": "The washing machine displays an error code",
    "text": "The code is used as part of diagnostics and is considered along with the symptoms and actual behavior of the machine.",
    "border": "border-slate-500",
    "centrifugeLink": false
  }
];

const partsTable = [
  {
    "part": "Pump",
    "problem": "The washing machine does not drain"
  },
  {
    "part": "Filter",
    "problem": "Difficult draining"
  },
  {
    "part": "Hoses",
    "problem": "Water leak or problem"
  },
  {
    "part": "Heater",
    "problem": "The washing machine does not heat up"
  },
  {
    "part": "Temperature sensor",
    "problem": "Temperature problem"
  },
  {
    "part": "Strap",
    "problem": "The drum does not rotate"
  },
  {
    "part": "Engine",
    "problem": "Rotation problem"
  },
  {
    "part": "Camps",
    "problem": "Spinning noise"
  },
  {
    "part": "Shock absorbers",
    "problem": "Vibration and movement"
  },
  {
    "part": "Gasket",
    "problem": "Current"
  },
  {
    "part": "Door lock",
    "problem": "The machine does not start"
  },
  {
    "part": "Electronic management",
    "problem": "Problem with programs"
  }
];

const pricingRows = [
  {
    "service": "Visit and diagnostics",
    "price": "30 €"
  },
  {
    "service": "The washing machine does not drain",
    "price": "After diagnostics"
  },
  {
    "service": "The washing machine does not spin",
    "price": "After diagnostics"
  },
  {
    "service": "The washing machine does not heat up",
    "price": "After diagnostics"
  },
  {
    "service": "Pump problem",
    "price": "After diagnostics"
  },
  {
    "service": "Belt problem",
    "price": "After diagnostics"
  },
  {
