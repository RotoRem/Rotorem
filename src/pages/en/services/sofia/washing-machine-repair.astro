    "centrifugeLink": true
  },
  {
    "title": "The washing machine does not heat the water",
    "text": "If the program works, but the water does not reach the required temperature, the heater, temperature sensor, electrical connections and controls are checked.",
    "border": "border-amber-500",
    "centrifugeLink": false
  },
  {
    "title": "The washing machine does not turn on",
    "text": "The power supply and components related to starting and controlling the machine are checked.",
    "border": "border-violet-500",
