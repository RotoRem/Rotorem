    "price": "Upon agreement"
  }
];

const realCases = [
  {
    "brand": "AEG",
    "problem": "There were no light indications.",
    "area": "Red village",
    "diagnosis": "It turned out to be a problem with the main board.",
    "repair": "After repairing the circuit board, the washing machine works normally again.",
    "image": "/img/services/ремонт-на-пералня-софия-случай-1.webp",
    "alt": "Repair of AEG washing machine in Krasno Selo, Sofia"
  },
  {
    "brand": "CANDY",
    "problem": "The washing machine did not spin the drum.",
    "area": "Lozenets",
    "diagnosis": "It turned out that the board responsible for controlling the motor that turns the drum was defective.",
    "repair": "It was repaired and now the washing machine is working normally.",
    "image": "/img/services/ремонт-на-пералня-софия-случай-2.webp",
    "alt": "Repair of a CANDY washing machine in Lozenets, Sofia"
  },
  {
    "brand": "Samsung",
    "problem": "The washing machine had a leak.",
    "area": "Vitosha",
    "diagnosis": "It turned out that the leak was from the door seal.",
    "repair": "After its replacement, the leak was eliminated.",
    "image": "/img/services/ремонт-на-пералня-софия-случай-3.webp",
    "alt": "Repair of a Samsung washing machine in Vitosha, Sofia"
  }
];

const processSteps = [
  {
    "step": 1,
    "title": "You are contacting RotoRem",
    "text": "You describe the problem, the make and model of the washing machine.",
    "circleClass": "bg-gradient-to-r from-blue-500 to-blue-600"
  },
  {
    "step": 2,
    "title": "We arrange a visit",
    "text": "A technician visits the specified address.",
    "circleClass": "bg-gradient-to-r from-green-500 to-green-600"
  },
  {
    "step": 3,
    "title": "We check the washing machine",
    "text": "The systems and components associated with the particular symptom are checked.",
    "circleClass": "bg-gradient-to-r from-amber-500 to-amber-600"
  },
  {
    "step": 4,
    "title": "You receive information about the repair",
    "text": "We explain what was found and what repairs are needed.",
    "circleClass": "bg-gradient-to-r from-violet-500 to-violet-600"
  },
  {
    "step": 5,
    "title": "Repair and test",
    "text": "After the repair, the operation of the washing machine is checked.",
    "circleClass": "bg-gradient-to-r from-indigo-500 to-indigo-600"
  }
];

const brands = ["Bosch","Siemens","AEG","Electrolux","Gorenje","Samsung","LG","Beko","Whirlpool"];

const faqs = getServiceFaqItems('/en/services/sofia/washing-machine-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="wm-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Repair of a washing machine at an address in Sofia"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/85 via-blue-900/75 to-blue-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Service at an address in Sofia
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Repair of washing machines in Sofia
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Washing machine won't drain, spin, heat, run, start, or make unusual noises?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            RotoRem carries out diagnostics and repairs of washing machines in homes in Sofia and settlements around the city. A technician visits the address, checks the appliance and determines the cause of the problem. We repair various types and brands of washing machines and carry out repairs, installation and dismantling at an address.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Visit and diagnostics</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call for a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Diagnostics and repair of washing machines at address</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>When the washing machine stops working normally, the same symptom can be caused by different components.</p>
            <p>If the washing machine does not drain, for example, the problem may be related to the filter, pump, hose, blockage or other component of the water drainage system. If the drum does not rotate, the drive, belt, motor and related components are checked.</p>
            <p>The technician starts with the specific symptom and checks the systems that may be causing it. After the diagnostics, the customer receives information about what was found and what repairs are needed.</p>
            <p>Repair of washing machines is part of RotoRem's services for <a href="/en/services/sofia/" class="text-blue-700 font-medium hover:underline">repair of household appliances in Sofia</a>, which are carried out at customers' homes.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Diagnostics and repair of a washing machine in Sofia"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Пералня" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What washing machine problems do we repair?</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-blue-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine does not drain the water</h3>
                <p class="text-gray-800 leading-relaxed">If water remains in the drum after the program, check the filter, pump, hoses and water drain.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-green-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine does not spin</h3>
                <p class="text-gray-800 leading-relaxed">When the washing machine washes, but <a href="/en/blog/washing-machine-wont-spin-causes/" class="text-blue-700 font-medium hover:underline">does not move on to the spin cycle properly</a>, the cause may be related to the water drain, engine, belt, steering or other component.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine does not heat the water</h3>
                <p class="text-gray-800 leading-relaxed">If the program works, but the water does not reach the required temperature, the heater, temperature sensor, electrical connections and controls are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-violet-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine does not turn on</h3>
                <p class="text-gray-800 leading-relaxed">The power supply and components related to starting and controlling the machine are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-teal-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine does not start the program</h3>
                <p class="text-gray-800 leading-relaxed">The cause may be related to the door, locking mechanism, control, or other component required for starting.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The drum does not rotate</h3>
                <p class="text-gray-800 leading-relaxed">The belt, motor, drum and related mechanical parts are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine is running</h3>
                <p class="text-gray-800 leading-relaxed">If there is water around the machine, check the hoses, connections, gaskets, pump and other places where the leak may come from.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-purple-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine makes a loud noise</h3>
                <p class="text-gray-800 leading-relaxed">A knocking, scraping, whining or other unusual noise may be related to the bearings, drum, shock absorbers, motor or other mechanical component.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-orange-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine vibrates or moves</h3>
                <p class="text-gray-800 leading-relaxed">The leveling, shock absorbers, drum and other components that affect the stability of the machine are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-pink-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The door won't open</h3>
                <p class="text-gray-800 leading-relaxed">The locking mechanism, the water drain and the control of the washing machine are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-slate-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The washing machine displays an error code</h3>
                <p class="text-gray-800 leading-relaxed">The code is used as part of diagnostics and is considered along with the symptoms and actual behavior of the machine.</p>
              </div>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What we check during diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">Depending on the problem, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>the power supply</li>
            <li>the incoming water</li>
            <li>the drain system</li>
            <li>the filter</li>
            <li>the pump</li>
            <li>the hoses</li>
            <li>the heater</li>
            <li>the temperature sensor</li>
            <li>the drum</li>
            <li>the camps</li>
            <li>the strap</li>
            <li>the engine</li>
            <li>shock absorbers</li>
            <li>the seals</li>
            <li>the door and the lock</li>
            <li>electrical connections</li>
            <li>electronic management</li>
            <li>the error codes</li>
          </ul>
          <p>First, the cause of the specific malfunction is determined, and then the necessary repair is determined.</p>
          <p class="font-semibold text-gray-900">Visit and diagnostics: {diagnosticPrice}</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Washing machine parts we check and repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">A part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every failure needs to result in part replacement. In many cases, diagnostics indicate another problem in the system, so the specific repair is determined after inspection.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The washing machine does not drain the water</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>If the program ends with water in the drum or the machine stops before spinning, first check that the water can be drained normally.</p>
          <p>Depending on the problem, the filter, pump, drain hose, connections, water path and pump control may be checked.</p>
          <p>The drain problem can also affect the subsequent stages of the program, including the centrifuge.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The washing machine does not spin</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>When the washing machine washes clothes but does not spin normally, it should not be automatically assumed that the problem is with the motor.</p>
          <p>The cause may be related to undrained water, the pump, the belt, the motor, the drum, the control or another component depending on the specific model.</p>
          <p>The behavior of the machine before the moment of spinning helps in finding the cause.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The washing machine does not heat the water</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>When the washing machine runs the program but the water does not reach the set temperature, the components involved in heating and temperature control are checked.</p>
          <p>The heater, temperature sensor, electrical connections, wiring and electronic controls can be checked.</p>
          <p>Before replacing a heater, it is determined whether it is actually the cause of the problem.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Drum and drive problems</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>A loud spinning noise, a drum movement problem, or unusual vibrations may be related to the washing machine's mechanical system.</p>
          <p>The drum, bearings, belt, motor, shock absorbers and related mechanical parts are checked.</p>
          <p>If there is a problem with the bearings, a loud whirring or grinding noise may occur, which becomes more noticeable at higher revs.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The washing machine is running</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>Water around the washing machine can come from a variety of places and the cause must be determined before repair.</p>
          <p>Check the inlet hoses, drain hose, connections, pump, door seal, internal water connections and other components according to the location of the leak.</p>
          <p>Before using the machine, it must again be determined where the water is coming from and what is causing the leak.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Maintenance and cleaning of the washing machine</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
