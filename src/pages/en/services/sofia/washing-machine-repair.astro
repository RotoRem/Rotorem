---
import Layout from '../../../../layouts/Base.astro';
import Reviews from '../../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../../lib/jsonldOverrides';
const title = 'Washing Machine Repair in Sofia | At Your Home | RotoRem';
const description =
  'At-home washing machine repair and diagnostics in Sofia. Drainage, spin, heating, leaks, drum issues, and other faults. Diagnostics 30 €.';

const heroImage = '/img/services/ремонт-на-пералня-софия-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-пералня-софия-диагностика.webp';
const diagnosticPrice = '30 €';

const accentBar = 'bg-blue-500';
const accentLink = 'text-blue-700';
const accentShell = 'from-blue-50 via-white to-blue-50 border-blue-100';
const accentBorder = 'border-blue-100';
const tableHeader = 'bg-blue-600';

const problems = [
  {
    "title": "The washing machine does not drain the water",
    "text": "If water remains in the drum after the program, check the filter, pump, hoses and water drain.",
    "border": "border-blue-500",
    "centrifugeLink": false
  },
  {
