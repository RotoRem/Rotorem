    "problem": "Incorrect temperature"
  },
  {
    "part": "Temperature sensor",
    "problem": "Inaccurate reporting"
  },
  {
    "part": "Fan",
    "problem": "Uneven baking"
  },
  {
    "part": "Motor",
    "problem": "The fan does not spin"
  },
  {
    "part": "Programmer",
    "problem": "Problem with programs"
  },
  {
    "part": "Electronic module",
    "problem": "The oven does not start or interrupts"
  },
  {
    "part": "Hinges",
    "problem": "The door does not close properly"
  },
  {
    "part": "Gasket",
    "problem": "Heat loss"
  }
];

const pricingRows = [
  {
    "service": "Visit and diagnostics",
    "price": "30 €"
  },
  {
    "service": "The oven does not heat up",
    "price": "After diagnostics"
  },
  {
    "service": "Heater problem",
    "price": "After diagnostics"
  },
  {
