    "price": "Upon agreement"
  },
  {
    "service": "Dismantling",
    "price": "Upon agreement"
  }
];

const realCases = [
  {
    "brand": "Beko",
    "problem": "The oven is not working.",
    "area": "Shooting range",
    "diagnosis": "After measuring the oven heater, it turned out to be burnt out.",
    "repair": "After replacing the heater, the oven works.",
    "image": "/img/services/ремонт-на-фурна-софия-случай-1.webp",
    "alt": "Beko oven repair in Strelbishte, Sofia"
  },
  {
    "brand": "Gorenje",
    "problem": "The oven does not heat up.",
    "area": "Sheep trough",
    "diagnosis": "An insulation test on the heater found that it was penetrating the housing and collecting the main fuse on the apartment panel.",
    "repair": "It has been replaced with a new heater.",
    "image": "/img/services/ремонт-на-фурна-софия-случай-2.webp",
    "alt": "Gorenje oven repair in Ovcha Kupel, Sofia"
  },
  {
    "brand": "Bosch",
    "problem": "Two of the heaters work continuously even when the oven is off.",
    "area": "Peeled off",
    "diagnosis": "Control board problem.",
    "repair": "The board has been repaired successfully.",
    "image": "/img/services/ремонт-на-фурна-софия-случай-3.webp",
    "alt": "Bosch oven repair in Obelya, Sofia"
  }
];

const processSteps = [
  {
    "step": 1,
    "title": "You are contacting RotoRem",
    "text": "You describe the problem, make and model.",
    "circleClass": "bg-gradient-to-r from-orange-500 to-orange-600"
  },
  {
    "step": 2,
    "title": "We arrange a visit",
    "text": "A technician comes to the address.",
    "circleClass": "bg-gradient-to-r from-amber-500 to-amber-600"
  },
  {
    "step": 3,
    "title": "Diagnosis",
    "text": "The components associated with the symptom are checked.",
    "circleClass": "bg-gradient-to-r from-red-500 to-red-600"
  },
  {
    "step": 4,
    "title": "Repair information",
    "text": "You get information about what was found.",
    "circleClass": "bg-gradient-to-r from-violet-500 to-violet-600"
  },
  {
    "step": 5,
    "title": "Repair and test",
    "text": "After the repair, the functions of the oven are checked.",
    "circleClass": "bg-gradient-to-r from-orange-600 to-orange-800"
  }
];

const brands = ["Gorenje","Bosch","Whirlpool","Beko","Indesit","Electrolux","Ariston"];

const faqs = getServiceFaqItems('/en/services/sofia/oven-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="oven-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Oven repair at an address in Sofia"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-orange-950/85 via-orange-900/75 to-orange-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Service at an address in Sofia
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Repair of ovens in Sofia
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            The oven does not heat up, does not maintain temperature, bakes unevenly, the fan does not work, the door does not close or the appliance does not start at all?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            RotoRem carries out diagnostics and repair of ovens in homes in Sofia and settlements around the city. A technician visits the address, checks the appliance and determines the cause of the problem. We work with built-in, free-standing and convection electric ovens from various manufacturers.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Visit and diagnostics</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call for a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Diagnosis and repair of ovens at address</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>When the oven stops working normally, the visible problem does not always directly indicate which part is damaged.</p>
            <p>If the appliance does not heat up, the cause may be related to the heater, thermostat, temperature sensor, electrical connection or electronic control. For uneven baking, check the heaters, fan, temperature control and heat distribution.</p>
            <p>After the diagnostics, the customer receives information about what was found and what repairs are needed. Oven repair is part of RotoRem's services for <a href="/en/services/sofia/" class="text-orange-700 font-medium hover:underline">repair of household appliances in Sofia</a>.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Oven diagnostics and repair in Sofia"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Фурна" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What oven problems do we repair?</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-orange-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven does not heat up</h3>
                <p class="text-gray-800 leading-relaxed">The heaters, thermostat, temperature sensor, electrical connections and controls are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven heats up weakly</h3>
                <p class="text-gray-800 leading-relaxed">The cause could be a faulty heater, a problem with the temperature control, or another part of the heating system.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven bakes unevenly</h3>
                <p class="text-gray-800 leading-relaxed">Heaters, fan, temperature sensor and hot air movement are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-rose-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven does not maintain temperature</h3>
                <p class="text-gray-800 leading-relaxed">The thermostat, temperature sensor and electronic control are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The fan is not working</h3>
                <p class="text-gray-800 leading-relaxed">The fan motor, power supply and control components are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-yellow-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven does not turn on</h3>
                <p class="text-gray-800 leading-relaxed">The power supply, electrical connections, safety components and controls are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-teal-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven switches off during operation</h3>
                <p class="text-gray-800 leading-relaxed">It checks when the problem occurs and which components are running at that moment.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-600">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven turns off the fuse</h3>
                <p class="text-gray-800 leading-relaxed">The cause could be an electrical defect, heater, wiring, or other component.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-orange-600">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The door does not close properly</h3>
                <p class="text-gray-800 leading-relaxed">The hinges, lock, seal and mechanical parts of the door are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-slate-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The oven displays an error code</h3>
                <p class="text-gray-800 leading-relaxed">The code is used as a diagnostic aid.</p>
              </div>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What we check during diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">Depending on the problem, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>top heater</li>
            <li>bottom heater</li>
            <li>grill heater</li>
            <li>circular heater</li>
            <li>thermostat</li>
            <li>temperature sensor</li>
            <li>thermal protection</li>
            <li>ventilator</li>
            <li>fan motor</li>
            <li>programmer</li>
            <li>timer</li>
            <li>display</li>
            <li>electronic module</li>
            <li>electrical connections</li>
            <li>door</li>
            <li>hinges</li>
            <li>seal</li>
            <li>error codes</li>
          </ul>
          <p>First, the cause of the specific malfunction is determined, and then the necessary repair is determined.</p>
          <p class="font-semibold text-gray-900">Visit and diagnostics: {diagnosticPrice}</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Oven parts we check and repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">A part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every failure needs to result in part replacement. In many cases, diagnostics indicate another problem in the system, so the specific repair is determined after inspection.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The oven does not heat up</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>The electric oven can use several separate heaters according to the selected mode.</p>
          <p>In the absence of heating, it is checked which component should work during the specific program.</p>
          <p>The bottom heater, top heater, grill heater, circle heater, electrical connections and controls are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The oven does not maintain the correct temperature</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>If the set temperature differs significantly from the actual temperature, the components that measure and control the heating are checked.</p>
          <p>The thermostat, temperature sensor, heaters and electronic control are checked.</p>
          <p>Before replacing a component, determine which part is causing the deviation.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The oven bakes unevenly</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>In convection ovens, the fan helps distribute the hot air.</p>
          <p>If the fan does not work or the air movement is disturbed, the food may cook unevenly.</p>
          <p>The fan, motor, circuit heater, electrical connections and controls are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Oven door problems</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>If the door does not close properly, some of the heat may escape outside the chamber.</p>
          <p>The hinges, the door mechanism, the seal, the lock and the position of the door are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Common problems with Gorenje ovens</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>At <a href="/en/blog/the-most-common-gorenje-oven-problems/" class="text-orange-700 font-medium hover:underline">Gorenje ovens</a> problems with heating, door lock, control panel, programs or fan may be encountered.</p>
          <p>With a code or symbol on the display, it is first checked whether it is an activated function or a real technical malfunction.</p>
          <p>RotoRem diagnoses and repairs Gorenje ovens in Sofia.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Installation and dismantling of ovens in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <p>RotoRem installs and dismantles electric ovens.</p>
          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Installation of an oven</h3>
            <ul class="list-disc pl-5 space-y-2">
              <li>positioning;</li>
              <li>connection;</li>
              <li>power check;</li>
              <li>ventilation check;</li>
              <li>function test.</li>
            </ul>
            <p class="mt-4">For a built-in oven, the dimensions of the kitchen unit and the ventilation requirements must be taken into account.</p>
          </div>
          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Other kitchen appliances</h3>
            <p>If the problem is with another kitchen appliance, RotoRem also performs <a href="/en/services/sofia/dishwasher-repair/" class={`${accentLink} font-medium hover:underline`}>repair of dishwashers in Sofia</a> at address.</p>
          </div>
        </div>
      </section>

      <section class={sectionClass} aria-labelledby="sofia-oven-pricing">
        <div class="text-center mb-10">
          <h2 id="sofia-oven-pricing" class="text-3xl font-bold text-gray-900 mb-4">Prices for repairing ovens in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg max-w-3xl mx-auto`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Service</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Price</th>
              </tr>
            </thead>
            <tbody>
              {pricingRows.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.service}</td>
