    "text": "The hinges, lock, seal and mechanical parts of the door are checked.",
    "border": "border-orange-600"
  },
  {
    "title": "The oven displays an error code",
    "text": "The code is used as a diagnostic aid.",
    "border": "border-slate-500"
  }
];

const partsTable = [
  {
    "part": "Bottom heater",
    "problem": "The oven does not heat up from below"
  },
  {
    "part": "Top heater",
    "problem": "Top heating problem"
  },
