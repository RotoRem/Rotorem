---
import Layout from '../../../../layouts/Base.astro';
import Reviews from '../../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../../lib/jsonldOverrides';
const title = 'Oven Repair in Sofia | At Your Home | RotoRem';
const description =
  'At-home oven repair and diagnostics in Sofia. Heating elements, temperature, fan, door, and electronics faults. Diagnostics 30 €.';

const heroImage = '/img/services/ремонт-на-фурна-софия-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-фурна-софия-диагностика.webp';
const diagnosticPrice = '30 €';

const accentBar = 'bg-orange-500';
const accentLink = 'text-orange-700';
const accentShell = 'from-orange-50 via-white to-amber-50 border-orange-100';
const accentBorder = 'border-orange-100';
const tableHeader = 'bg-orange-600';

const problems = [
  {
    "title": "The oven does not heat up",
    "text": "The heaters, thermostat, temperature sensor, electrical connections and controls are checked.",
    "border": "border-orange-500"
  },
  {
    "title": "The oven heats up weakly",
    "text": "The cause could be a faulty heater, a problem with the temperature control, or another part of the heating system.",
