---
import Layout from '../../../../layouts/Base.astro';

const title = 'Dryer Repair in Sofia | Fast Home Service by RotoRem';
const description = 'Professional dryer repair in Sofia for no-heat, drum, sensor, and control-board issues. On-site service with warranty.';
---

<Layout title={title} description={description}>
  <article>
    <section class="bg-gradient-to-r from-indigo-600 to-indigo-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Dryer Repair in Sofia</h1>
        <p class="text-xl md:text-2xl text-indigo-100 max-w-3xl mx-auto mb-8">
          In-home dryer diagnostics and repair across Sofia for all major brands.
        </p>
        <a href="tel:+359 89 834 0982" class="bg-white text-indigo-700 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg inline-flex">📞 089 834 0982</a>
      </div>
    </section>

    <div class="container max-w-4xl">
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Most common dryer faults</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">No heat or weak drying</h3>
            <p class="text-gray-700">Heater, thermostat, and airflow diagnostics with precise repairs.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-emerald-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Drum not turning</h3>
            <p class="text-gray-700">Drive belt, motor, and roller inspection with reliable replacement parts.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Unexpected stop during cycle</h3>
            <p class="text-gray-700">Control board and safety sensor troubleshooting for stable operation.</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Noise or vibration</h3>
            <p class="text-gray-700">Mechanical checks and balancing to remove abnormal sounds and shaking.</p>
          </div>
        </div>
      </section>
    </div>
  </article>
</Layout>
