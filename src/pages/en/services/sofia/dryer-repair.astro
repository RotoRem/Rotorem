---
import Layout from '../../../../layouts/Base.astro';
import Reviews from '../../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../../lib/jsonldOverrides';

const title = 'Dryer Repair in Sofia | At Your Home | RotoRem';
const description =
  'At-home dryer repair and diagnostics in Sofia. Heating, drying, drum, belt, condensate, and other faults. Diagnostics 30 €.';

const heroImage = '/img/services/ремонт-на-сушилня-софия-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-сушилня-софия-диагностика.webp';
const diagnosticPrice = '30 €';

const accentBar = 'bg-fuchsia-500';
const accentLink = 'text-fuchsia-700';
const accentShell = 'from-fuchsia-50 via-white to-purple-50 border-fuchsia-100';
const accentBorder = 'border-fuchsia-100';
const tableHeader = 'bg-fuchsia-600';

const problems = [
  { title: 'The dryer does not heat up', text: 'If the drum rotates, but the clothes remain cold and damp, check the components and systems that provide the necessary temperature.', border: 'border-fuchsia-500' },
  { title: 'The dryer does not dry well', text: 'The cause may be related to filters, airflow, heating, temperature sensors, humidity sensors, or another part of the drying process.', border: 'border-purple-500' },
  { title: 'The drum does not rotate', text: 'The belt, motor, pulleys, drum and related mechanical components are checked.', border: 'border-pink-500' },
  { title: 'The dryer does not turn on', text: 'The power supply and components related to starting and controlling the unit are checked.', border: 'border-violet-500' },
  { title: 'The dryer does not start the program', text: 'The door, lock, control and other conditions necessary for starting are checked.', border: 'border-rose-500' },
  { title: 'The dryer stops during operation', text: 'It is checked when the machine interrupts the program and if there is a change in temperature, drum rotation or display behavior.', border: 'border-indigo-500' },
  { title: 'The dryer is running too long', text: 'The cause could be restricted airflow, dirty filters, a heating problem, a sensor, or another component.', border: 'border-teal-500' },
  { title: 'The dryer makes a loud noise', text: 'A grinding, knocking, hissing or other unusual noise may be associated with the drum, pulleys, belt, motor or other moving component.', border: 'border-red-500' },
  { title: 'The dryer vibrates', text: 'The placement and stability of the machine, drum and mechanical components are checked.', border: 'border-orange-500' },
  { title: 'The dryer does not collect water in the container', text: 'The condensate drain system, pump, hoses and related components are checked.', border: 'border-amber-500' },
  { title: "The door doesn't close", text: 'The mechanical closing, the locking mechanism and the reading of the state of the door are checked.', border: 'border-lime-600' },
  { title: 'The dryer displays an error code', text: 'The code is considered along with the symptoms and the actual behavior of the machine.', border: 'border-slate-500' },
];

const partsTable = [
  { part: 'Strap', problem: 'The drum does not rotate' },
  { part: 'Engine', problem: 'Rotation problem' },
  { part: 'Rollers', problem: 'Noise or movement problem' },
  { part: 'Heating system', problem: 'The dryer does not heat up' },
  { part: 'Temperature sensors', problem: 'Incorrect temperature' },
  { part: 'Humidity sensors', problem: 'Incorrect reading of drying' },
  { part: 'Filters', problem: 'Reduced airflow' },
  { part: 'Air system', problem: 'Slow or ineffective drying' },
  { part: 'Condensation pump', problem: 'Water drainage problem' },
  { part: 'Condensation system', problem: 'Water collection problem' },
  { part: 'Heat pump system', problem: 'Heating or drying problem' },
  { part: 'Compressor', problem: 'Problem in the heat pump system' },
  { part: 'Door lock', problem: 'The program does not start' },
  { part: 'Electronic management', problem: 'A problem with programs or performance' },
];

const pricingRows = [
  { service: 'Visit and diagnostics', price: '30 €' },
  { service: 'The dryer does not heat up', price: 'After diagnostics' },
  { service: 'The dryer does not dry well', price: 'After diagnostics' },
  { service: 'The drum does not rotate', price: 'After diagnostics' },
  { service: 'Belt problem', price: 'After diagnostics' },
  { service: 'Condensation problem', price: 'After diagnostics' },
  { service: 'Door problem', price: 'After diagnostics' },
  { service: 'Electronics repair', price: 'After diagnostics' },
  { service: 'Installation', price: 'Upon agreement' },
  { service: 'Removal', price: 'Upon agreement' },
];

const realCases = [
  {
    brand: 'LG',
    problem: 'The dryer made a loud noise when spinning',
    area: 'Central',
    diagnosis: 'It turned out to be the rollers.',
    repair: 'Replaced and works great with no noise.',
    image: '/img/services/ремонт-на-сушилня-софия-случай-1.webp',
    alt: 'LG dryer repair in the center, Sofia',
  },
  {
    brand: 'BEKO',
    problem: 'The dryer did not spin the drum',
    area: 'Lyulin',
    diagnosis: 'It turned out to be a problem with the belt.',
    repair: 'Replaced it, now working normally.',
    image: '/img/services/ремонт-на-сушилня-софия-случай-2.webp',
    alt: 'Repair of a BEKO dryer in Lyulin, Sofia',
  },
  {
    brand: 'Whirlpool',
    problem: "It didn't spin the drum",
    area: 'Lozenets',
    diagnosis: 'It turned out to be a problem with the start capacitor of the motor turning the drum.',
    repair: 'Replaced it with a new one and works normally now.',
    image: '/img/services/ремонт-на-сушилня-софия-случай-3.webp',
    alt: 'Whirlpool dryer repair in Lozenets, Sofia',
  },
];

const processSteps = [
  { step: 1, title: 'You are contacting RotoRem', text: 'You describe the problem, the make and model of the dryer.', circleClass: 'bg-gradient-to-r from-fuchsia-500 to-fuchsia-600' },
  { step: 2, title: 'We arrange a visit', text: 'A technician visits the specified address.', circleClass: 'bg-gradient-to-r from-purple-500 to-purple-600' },
  { step: 3, title: 'We check the dryer', text: 'The systems and components associated with the particular symptom are checked.', circleClass: 'bg-gradient-to-r from-pink-500 to-pink-600' },
  { step: 4, title: 'You receive information about the repair', text: 'We explain what was found and what repairs are needed.', circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600' },
  { step: 5, title: 'Repair and test', text: 'After the repair, the operation of the dryer is checked.', circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600' },
];

const brands = ['Bosch', 'Siemens', 'AEG', 'Electrolux', 'Gorenje', 'Samsung', 'LG', 'Beko', 'Whirlpool'];

const faqs = getServiceFaqItems('/en/services/sofia/dryer-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dryer-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Repair of a dryer at an address in Sofia"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-purple-950/85 via-fuchsia-900/75 to-purple-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Service at an address in Sofia
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Repair of dryers in Sofia
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            The dryer does not heat up, does not dry well, the drum does not spin, stops during the program or makes an unusual noise?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-5 leading-relaxed max-w-2xl mx-auto">
            RotoRem carries out diagnostics and repairs of dryers in homes in Sofia and settlements around the city. A technician visits the address, checks the appliance and determines the cause of the problem.
          </p>
          <p class="text-base md:text-lg text-white/85 mb-8 leading-relaxed max-w-2xl mx-auto">
            We work with condensation dryers, heat pump dryers and other basic types of dryers.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Visit and diagnostics</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call for a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Diagnosis and repair of dryers at address</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>
              When the dryer stops working normally, the visible problem does not always directly indicate which part is damaged.
            </p>
            <p>
              If the clothes remain damp, the cause may be related to the heating, air movement, filters, temperature sensors, heat pump system or another component depending on the design of the unit.
            </p>
            <p>
              For a dryer that does not spin, the drive, belt, motor and associated mechanical parts are checked. The technician starts with the specific symptom and checks the systems that may be causing it.
            </p>
            <p>
              After diagnostics, the customer is told what was found and what repair is needed. Dryer repair is part of RotoRem's{' '}
              <a href="/en/services/sofia/" class={`${accentLink} font-medium hover:underline`}>home appliance repair services in Sofia</a>, carried out at customers' homes.
            </p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Diagnostics and repair of a dryer in Sofia"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Сушилня" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What dryer problems do we repair?</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Diagnostics checklist -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What we check during diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">Depending on the type of dryer and the problem, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>the power supply;</li>
            <li>the drum;</li>
            <li>the strap;</li>
            <li>the rollers;</li>
            <li>the engine;</li>
            <li>the filters;</li>
            <li>air flow;</li>
            <li>the heating system;</li>
            <li>temperature sensors;</li>
            <li>humidity sensors;</li>
            <li>the condensation system;</li>
            <li>the condensation pump;</li>
            <li>the heat pump system;</li>
            <li>the compressor;</li>
            <li>the door and the lock;</li>
            <li>electrical connections;</li>
            <li>electronic management;</li>
            <li>the error codes.</li>
          </ul>
          <p>First, the cause of the specific malfunction is determined, and then the necessary repair is determined.</p>
          <p class="font-semibold text-gray-900">Visit and diagnostics: {diagnosticPrice}</p>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer parts and systems we inspect and repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">A part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every failure needs to result in part replacement. In many cases, diagnostics indicate another problem in the system, so the specific repair is determined after inspection.
        </p>
      </section>

      <!-- Heating -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The dryer does not heat up</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>When the dryer is running but not reaching the required temperature, clothes can remain damp even after a full cycle.</p>
          <p class="font-medium text-gray-900">Depending on the type and model, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>the heating components;</li>
            <li>temperature sensors;</li>
            <li>air flow;</li>
            <li>electrical connections;</li>
            <li>the heat pump system;</li>
            <li>management.</li>
          </ul>
          <p>Before replacing a part, determine whether the component itself is damaged or the problem is coming from another system.</p>
        </div>
      </section>

      <!-- Heat pump -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Repair of heat pump dryers</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>RotoRem diagnoses and repairs the main types of heat pump dryers.</p>
          <p>
            If there is a problem with temperature or drying time, the airflow, temperature sensors, heat exchange system, compressor and other components related to the heat pump system can be checked.
          </p>
          <p>A poor drying result does not automatically mean a failure of the heat pump. All systems that may cause the same symptom are checked.</p>
        </div>
      </section>

      <!-- Airflow -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">When the dryer dries slowly</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>For normal drying, the air must pass properly through the clothes and the machine system.</p>
          <p>Dirty filters or restricted air movement can increase the drying time and worsen the result.</p>
          <p class="font-medium text-gray-900">The following are checked:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>the filters;</li>
            <li>air ducts;</li>
            <li>the accessible parts of the heat exchange system;</li>
            <li>the components that support air movement.</li>
          </ul>
          <p>Regular cleaning of the accessible filters according to the manufacturer's instructions is an important part of dryer maintenance.</p>
        </div>
      </section>

      <!-- Belt and drum -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The dryer drum does not spin</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>When the drum remains stationary, the mechanical system that drives it is checked.</p>
          <p class="font-medium text-gray-900">Depending on the model, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>the strap;</li>
            <li>the engine;</li>
            <li>the rollers;</li>
            <li>the drum;</li>
            <li>the associated mechanical elements.</li>
          </ul>
          <p>If the belt has broken or fallen, it is checked that there is no other mechanical cause that led to the problem.</p>
        </div>
      </section>

      <!-- Condensate -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Problems with condensation and water collection</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>In the case of condensation dryers and models with a heat pump, the moisture from the clothes must be removed in the way provided for the machine.</p>
          <p>If the dryer does not collect the water in the container, water appears in the wrong place, or the machine reports a problem, the container, condensate pump, hoses, water drainage paths and related sensors can be checked.</p>
          <p>
            For common causes of a similar symptom, see also{' '}
            <a href="/en/blog/dryer-not-collecting-water-common-container-reservoir-problems/" class={`${accentLink} font-medium hover:underline`}>when the dryer does not collect water in the container</a>.
          </p>
        </div>
      </section>

      <!-- Installation -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Installation and dismantling of dryers in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <p>RotoRem installs and dismantles dryers in Sofia.</p>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Installation of a dryer</h3>
            <ul class="list-disc pl-5 space-y-2">
              <li>positioning;</li>
              <li>leveling;</li>
              <li>checking the required space;</li>
              <li>connection according to the type of dryer;</li>
              <li>pre-employment screening;</li>
              <li>device test.</li>
            </ul>
          </div>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Installation on a washing machine</h3>
            <p>
              When the dryer needs to be{' '}
              <a href="/en/services/sofia/washing-machine-repair/" class={`${accentLink} font-medium hover:underline`}>placed on a washing machine</a>, it is checked whether the two devices and the connection kit used allow such a configuration. The dryer should not be placed on top of a washing machine without a suitable solution for the specific models.
            </p>
          </div>

          <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-lg border ${accentBorder}`}>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Dismantling a dryer</h3>
            <p>If necessary, the unit can be disconnected and prepared for moving or replacement.</p>
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section class={sectionClass} aria-labelledby="sofia-dryer-pricing">
        <div class="text-center mb-10">
          <h2 id="sofia-dryer-pricing" class="text-3xl font-bold text-gray-900 mb-4">Prices for repair of dryers in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg max-w-3xl mx-auto`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Service</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Price</th>
              </tr>
            </thead>
            <tbody>
              {pricingRows.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.service}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          The final price depends on the damage found, the work required and the spare parts used.
        </p>
      </section>

      <!-- Brands -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dryer brands we service</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">
            RotoRem diagnoses and repairs dryers from various manufacturers, including:
          </p>
          <p class="text-gray-800 leading-relaxed mb-6 text-center font-medium">
            Bosch, Siemens, AEG, Electrolux, Gorenje, Samsung, LG, Beko, Whirlpool and other brands served.
          </p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
