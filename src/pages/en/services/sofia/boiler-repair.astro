---
import Layout from '../../../../layouts/Base.astro';
import Reviews from '../../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../../lib/jsonldOverrides';
const title = 'Water Heater Repair in Sofia | At Your Home | RotoRem';
const description =
  'Water heater repair, diagnostics, installation, and removal in Sofia. Heating elements, thermostats, leaks, noise, and other faults. Diagnostics 30 €.';

const heroImage = '/img/services/ремонт-на-бойлер-софия-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-бойлер-софия-диагностика.webp';
const diagnosticPrice = '30 €';

const accentBar = 'bg-teal-500';
const accentLink = 'text-teal-700';
const accentShell = 'from-teal-50 via-white to-teal-50 border-teal-100';
const accentBorder = 'border-teal-100';
const tableHeader = 'bg-teal-600';

const problems = [
  {
    "title": "The boiler does not heat up",
    "text": "The heater, thermostat, thermal protection and control are checked.",
    "border": "border-teal-500"
  },
  {
    "title": "The boiler heats up slowly",
    "text": "The cause may be related to the heater, build-up or temperature control.",
    "border": "border-emerald-500"
  },
  {
    "title": "The boiler is leaking",
    "text": "The flange, gaskets, connections and water reservoir are checked.",
    "border": "border-amber-500"
  },
  {
    "title": "The boiler trips the fuse",
    "text": "Electrical components and insulation are checked.",
    "border": "border-red-500"
  },
  {
    "title": "The boiler makes noise or crackling",
    "text": "The reason may be related to accumulations, heating or another technical problem.",
    "border": "border-cyan-500"
  },
  {
    "title": "Not enough hot water",
    "text": "The heater, thermostat and settings are checked.",
    "border": "border-indigo-500"
  },
  {
    "title": "The boiler does not turn on",
    "text": "The power supply, thermal protection and electrical components are checked.",
    "border": "border-slate-500"
  }
];

const partsTable = [
  {
    "part": "Heater",
    "problem": "It doesn't heat up"
  },
  {
    "part": "Thermostat",
    "problem": "Incorrect temperature"
  },
  {
    "part": "Thermal protection",
    "problem": "The device is not working"
  },
  {
    "part": "Flange",
    "problem": "Current"
  },
  {
    "part": "Gasket",
    "problem": "Current"
  },
  {
    "part": "Safety valve",
    "problem": "Pressure or water problem"
  },
  {
    "part": "Magnesium anode",
    "problem": "Aquifer protection"
  },
  {
    "part": "Electrical connections",
    "problem": "Power problem"
  },
  {
    "part": "Management",
    "problem": "Wrong job"
  }
];

const pricingRows = [
  {
    "service": "Visit and diagnostics",
    "price": "30 €"
  },
  {
    "service": "The boiler does not heat up",
    "price": "After diagnostics"
  },
  {
    "service": "Heater replacement",
    "price": "After diagnostics"
  },
  {
    "service": "Thermostat problem",
    "price": "After diagnostics"
  },
  {
    "service": "Current",
    "price": "After diagnostics"
  },
  {
    "service": "Fuse problem",
    "price": "After diagnostics"
  },
  {
    "service": "Cleaning",
    "price": "After diagnostics"
  },
  {
    "service": "Assembly",
    "price": "Upon agreement"
  },
  {
    "service": "Dismantling",
    "price": "Upon agreement"
  }
];

const realCases = [
  {
    "brand": "Water heater",
    "problem": "Lack of power supply to outlet, water heater switch and light switch.",
    "area": "Center",
    "diagnosis": "The inspection found burnt wires caused by loose electrical connections.",
    "repair": "The damaged socket, water heater switch and light switch were replaced and the electrical connections were restored.",
    "image": "/img/services/ремонт-на-бойлер-софия-случай-1.webp",
    "alt": "Repair of socket, water heater switch and light switch in case of lack of power supply in Center, Sofia"
  },
  {
    "brand": "Water heater",
    "problem": "Need to replace an old water heater with a problem in the switch and wiring.",
    "area": "Sheep trough",
    "diagnosis": "During the inspection, burnt wires and a faulty switch for turning the water heater on and off were found.",
    "repair": "The old water heater was dismantled and replaced with a new one. Rewired and new switch installed.",
    "image": "/img/services/ремонт-на-бойлер-софия-случай-2.webp",
    "alt": "Replacement and installation of a boiler with repair of electrical wiring in Ovcha Kupel, Sofia"
  },
  {
    "brand": "Water heater",
    "problem": "The boiler does not heat normally and periodically turns off the fuse.",
    "area": "Friendship",
    "diagnosis": "A defective heater with significant limescale build-up was found.",
    "repair": "The damaged heater was dismantled and replaced with a new one. After the replacement, the water heater works normally.",
    "image": "/img/services/ремонт-на-бойлер-софия-случай-3.webp",
    "alt": "Replacement of a defective boiler heater in Druzhba, Sofia"
  }
];

const processSteps = [
  {
    "step": 1,
    "title": "You are contacting RotoRem",
    "text": "You describe the symptom — no hot water, leak, noise, or other problem.",
    "circleClass": "bg-gradient-to-r from-teal-500 to-teal-600"
  },
  {
    "step": 2,
    "title": "We arrange a visit",
    "text": "A technician visits the specified address.",
    "circleClass": "bg-gradient-to-r from-emerald-500 to-emerald-600"
  },
  {
    "step": 3,
    "title": "Diagnosis",
    "text": "The components related to the specific problem are checked.",
    "circleClass": "bg-gradient-to-r from-amber-500 to-amber-600"
  },
  {
    "step": 4,
    "title": "Repair information",
    "text": "We explain what was found and what repairs are needed.",
    "circleClass": "bg-gradient-to-r from-cyan-500 to-cyan-600"
  },
  {
    "step": 5,
    "title": "Repair and test",
    "text": "After the repair, the boiler is checked for normal and safe operation.",
    "circleClass": "bg-gradient-to-r from-teal-600 to-teal-700"
  }
];

const brands = ["TESY","Ariston","Atlantic","Eldom","Diplomat","Gorenje","AEG","Beko"];

const faqs = getServiceFaqItems('/en/services/sofia/boiler-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="boiler-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Boiler repair at an address in Sofia"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-teal-950/85 via-teal-900/75 to-teal-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Service at an address in Sofia
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Boiler repair in Sofia
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Is the water heater not heating, heating slowly, leaking, tripping the fuse or making an unusual noise?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            RotoRem carries out diagnostics, repair, installation and dismantling of electric water heaters in homes in Sofia and around the city.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Visit and diagnostics</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call for a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Diagnostics and repair of boilers</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>Before replacing a part, determine the cause of the problem.</p>
            <p>In the absence of hot water, the heater, thermostat, thermal protection and electrical connections can be checked. In case of leakage, check the flange, gaskets, connections and condition of the unit.</p>
            <p>Boiler repair is part of RotoRem's services for <a href="/en/services/sofia/" class="text-teal-700 font-medium hover:underline">repair of household appliances in Sofia</a>.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Boiler diagnostics in Sofia"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Бойлер" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What boiler problems do we repair?</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-teal-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The boiler does not heat up</h3>
                <p class="text-gray-800 leading-relaxed">The heater, thermostat, thermal protection and control are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-emerald-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The boiler heats up slowly</h3>
                <p class="text-gray-800 leading-relaxed">The cause may be related to the heater, build-up or temperature control.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The boiler is leaking</h3>
                <p class="text-gray-800 leading-relaxed">The flange, gaskets, connections and water reservoir are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The boiler trips the fuse</h3>
                <p class="text-gray-800 leading-relaxed">Electrical components and insulation are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-cyan-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The boiler makes noise or crackling</h3>
                <p class="text-gray-800 leading-relaxed">The reason may be related to accumulations, heating or another technical problem.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Not enough hot water</h3>
                <p class="text-gray-800 leading-relaxed">The heater, thermostat and settings are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-slate-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The boiler does not turn on</h3>
                <p class="text-gray-800 leading-relaxed">The power supply, thermal protection and electrical components are checked.</p>
              </div>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What we check during diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">Depending on the symptom, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>the heater</li>
            <li>the thermostat</li>
            <li>thermal protection</li>
            <li>the flange</li>
            <li>the seals</li>
            <li>the safety valve</li>
            <li>electrical connections</li>
            <li>the power supply</li>
            <li>management</li>
            <li>the magnesium anode</li>
            <li>the condition of the aquifer</li>
          </ul>
          <p>First, the cause of the specific malfunction is determined, and then the necessary repair is determined.</p>
          <p class="font-semibold text-gray-900">Visit and diagnostics: {diagnosticPrice}</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water heater parts and systems we inspect and repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">A part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every failure needs to result in part replacement. In many cases, diagnostics indicate another problem in the system, so the specific repair is determined after inspection.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The boiler does not heat the water</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>In the absence of hot water, it is not automatically assumed that the heater has burned out.</p>
          <p>The heater, thermostat, thermal protection, electrical connections and power supply are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Water heater leak</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p><a href="/en/blog/when-is-a-water-heater-dangerous/" class="text-teal-700 font-medium hover:underline">The leak</a> should be checked as soon as possible.</p>
          <p>Water can come from the flange, gasket, relief valve, connections, or water reservoir.</p>
          <p>In the case of some damages, it must be assessed whether the repair is safe and economically justified.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Strange noise or crackling from the water heater</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>Unusual noise during heating can be related to accumulations, heater operation, water movement or other technical reason.</p>
          <p>If the water heater starts leaking <a href="/en/blog/water-heater-popping-noises-causes-and-warning-signs/" class="text-teal-700 font-medium hover:underline">strange noise or popping noise</a>, the change in device behavior should not be ignored.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Accumulations in the water heater</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>When opening the water heater, the condition of the heater and the presence of accumulations can be checked.</p>
          <p>If necessary, cleaning is carried out according to the condition of the device.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Installation and dismantling of boilers in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>RotoRem installs and dismantles boilers. During installation, the position, fastening, water connections, electrical connection and operation after installation are checked.</p>
        </div>
      </section>
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Another tech problem at home?</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border max-w-4xl mx-auto text-gray-800 leading-relaxed`}>
          <p>RotoRem performs and <a href="/en/services/sofia/oven-repair/" class={`${accentLink} font-medium hover:underline`}>repair of ovens in Sofia</a> at address.</p>
        </div>
      </section>

      <section class={sectionClass} aria-labelledby="sofia-boiler-pricing">
        <div class="text-center mb-10">
          <h2 id="sofia-boiler-pricing" class="text-3xl font-bold text-gray-900 mb-4">Boiler repair prices in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg max-w-3xl mx-auto`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Service</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Price</th>
              </tr>
            </thead>
            <tbody>
              {pricingRows.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.service}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          The final price depends on the damage found, the work required and the spare parts used.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Boilers we service</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">RotoRem works with vertical, horizontal and compact electric water heaters.</p>
          <p class="text-gray-800 leading-relaxed mb-6 text-center font-medium">Eldom, Ariston, TESY, Diplomat, Bosch and other brands served.</p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            When calling, it's a good idea to state the make, model, and how the problem occurs.
          </p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real boiler repairs in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full md:w-2/5 lg:w-5/12 object-cover min-h-[220px] md:min-h-[280px]"
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.brand} – Water heater</h3>
                  <p class="text-gray-800"><span class="font-semibold">Problem:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">District:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Determined Cause:</span> {item.diagnosis}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {item.repair}</p>
                </div>
              </article>
            ))}
          </div>

          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow max-w-5xl mx-auto">
            <img
              src={realCases[2].image}
              alt={realCases[2].alt}
              class="w-full lg:w-2/5 object-cover min-h-[240px] lg:min-h-[300px]"
              loading="lazy"
              width="560"
              height="400"
            />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].brand} – Water heater</h3>
              <p class="text-gray-800"><span class="font-semibold">Problem:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">District:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Determined Cause:</span> {realCases[2].diagnosis}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair performed:</span> {realCases[2].repair}</p>
            </div>
          </article>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How to repair a water heater</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-8">
          {processSteps.slice(0, 3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {processSteps.slice(3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Boiler repair in Sofia and around Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto`}>
          <p>RotoRem serves Sofia and the surrounding area, including Center, Lozenets, Ivan Vazov, Krasno Selo, Mladost, Darvenitsa, Dianabad, Strelbishte, Lyulin, Obelya, Ovcha Kupel and Gotse Delchev.</p>
        </div>
      </section>

      <section class={sectionClass} id="faq">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Frequently asked questions</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((faq) => (
            <div class="bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
              <details class="group">
                <summary class="flex justify-between items-center p-5 cursor-pointer">
                  <h3 class="text-lg font-semibold text-gray-900 pr-4">{faq.q}</h3>
                  <div class="flex-shrink-0 text-gray-600 transition-transform duration-300 group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </summary>
                <div class="p-5 pt-0 text-gray-800 border-t border-gray-100">
                  <p class="leading-relaxed">{faq.a}</p>
                </div>
              </details>
            </div>
          ))}
        </div>
      </section>
    </div>
  </article>

  <div class="container max-w-5xl mb-28">
    <section class="text-center bg-gradient-to-r from-teal-600 to-teal-800 text-white p-12 md:p-14 rounded-2xl shadow-2xl">
      <h2 class="text-3xl font-bold mb-4">Water heater problem?</h2>
      <p class="text-lg md:text-xl mb-4 text-white/90 max-w-3xl mx-auto leading-relaxed">
        Contact RotoRem for boiler diagnostics and repair at an address in Sofia.
      </p>
      <p class="text-lg mb-2 text-white/90">Diagnosis: {diagnosticPrice}</p>
      <p class="text-lg mb-8">Telephone: <a href="tel:0898340982" class="font-semibold text-white hover:underline">089 834 0982</a></p>
      <a href="tel:0898340982" class="inline-block bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
        Call for a visit
      </a>
    </section>
  </div>
</Layout>

