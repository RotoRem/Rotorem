---
import Layout from '../../../../layouts/Base.astro';
import Reviews from '../../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../../lib/jsonldOverrides';
const title = 'Dishwasher Repair in Sofia | At Your Home | RotoRem';
const description =
  'At-home dishwasher repair and diagnostics in Sofia. Drainage, filling, heating, leaks, and other faults. Diagnostics 30 €.';

const heroImage = '/img/services/ремонт-на-съдомиялна-софия-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-съдомиялна-софия-диагностика.webp';
const diagnosticPrice = '30 €';

const accentBar = 'bg-emerald-500';
const accentLink = 'text-emerald-700';
const accentShell = 'from-emerald-50 via-white to-teal-50 border-emerald-100';
const accentBorder = 'border-emerald-100';
const tableHeader = 'bg-emerald-600';

const problems = [
  {
    "title": "The dishwasher does not drain",
    "text": "The filter, pump and drain hose are checked.",
    "border": "border-emerald-500"
  },
  {
