  },
  {
    "part": "Temperature sensor",
    "problem": "Temperature problem"
  },
  {
    "part": "Inlet valve",
    "problem": "Do not fill water"
  },
  {
    "part": "Gasket",
    "problem": "Current"
  },
  {
    "part": "Lock",
    "problem": "It doesn't start"
  },
  {
    "part": "Dispenser",
    "problem": "A problem with the preparation"
  },
  {
    "part": "Electronic management",
    "problem": "Problem with programs"
  }
];

const pricingRows = [
  {
    "service": "Visit and diagnostics",
    "price": "30 €"
  },
  {
    "service": "Does not drain",
    "price": "After diagnostics"
  },
  {
    "service": "Do not fill water",
    "price": "After diagnostics"
  },
  {
    "service": "It doesn't heat up",
    "price": "After diagnostics"
  },
  {
