    "price": "After diagnostics"
  },
  {
    "service": "Door problem",
    "price": "After diagnostics"
  },
  {
    "service": "Electronics",
    "price": "After diagnostics"
  },
  {
    "service": "Assembly",
    "price": "Upon agreement"
  },
  {
    "service": "Dismantling",
    "price": "Upon agreement"
  }
];

const realCases = [
  {
    "brand": "Samsung",
    "problem": "The dishwasher was not heating the water.",
    "area": "Vitosha",
    "diagnosis": "It turned out to be a burnt out heater.",
    "repair": "It was replaced and now works and heats normally.",
    "image": "/img/services/ремонт-на-съдомиялна-софия-случай-1.webp",
    "alt": "Samsung dishwasher repair in Vitosha, Sofia"
  },
  {
    "brand": "Bosch",
    "problem": "The dishwasher was not draining.",
    "area": "Sheep trough",
    "diagnosis": "It turned out that the drain pump had burned out.",
    "repair": "Replaced it with a new one and now drains and works normally.",
    "image": "/img/services/ремонт-на-съдомиялна-софия-случай-2.webp",
    "alt": "Repair of a Bosch dishwasher in Ovcha Kupel, Sofia"
  },
  {
    "brand": "Miele",
    "problem": "The dishwasher would not start the wash cycle.",
    "area": "Slatina",
    "diagnosis": "It turned out that the motor that throws water through the fins inside the machine wouldn't start.",
    "repair": "Replaced motor start capacitor - now running normally.",
    "image": "/img/services/ремонт-на-съдомиялна-софия-случай-3.webp",
    "alt": "Miele dishwasher repair in Slatina, Sofia"
  }
];

const processSteps = [
  {
    "step": 1,
    "title": "You are contacting RotoRem",
    "text": "You describe how the problem occurs and an error code, if any.",
    "circleClass": "bg-gradient-to-r from-emerald-500 to-emerald-600"
  },
  {
    "step": 2,
    "title": "We arrange a visit",
    "text": "A technician visits the specified address.",
    "circleClass": "bg-gradient-to-r from-teal-500 to-teal-600"
  },
  {
    "step": 3,
    "title": "Diagnosis",
    "text": "The systems associated with the particular symptom are checked.",
    "circleClass": "bg-gradient-to-r from-green-500 to-green-600"
  },
  {
    "step": 4,
    "title": "Repair information",
    "text": "We explain what was found and what repairs are needed.",
    "circleClass": "bg-gradient-to-r from-cyan-500 to-cyan-600"
  },
  {
    "step": 5,
    "title": "Repair and test",
    "text": "After the repair, the machine is tested.",
    "circleClass": "bg-gradient-to-r from-emerald-600 to-teal-700"
  }
];

const brands = ["Bosch","Siemens","Electrolux","Whirlpool","Indesit","Candy","Miele"];

const faqs = getServiceFaqItems('/en/services/sofia/dishwasher-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dishwasher-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Repair of a dishwasher at an address in Sofia"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/85 via-emerald-900/75 to-emerald-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Service at an address in Sofia
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Repair of dishwashers in Sofia
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Dishwasher not draining, not filling, not heating, not washing well, running or not starting?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            RotoRem carries out diagnostics, repair, installation and dismantling of dishwashers in homes in Sofia and around the city.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Visit and diagnostics</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call for a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Diagnostics and repair of dishwashers</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>The same symptom can have different causes. If water remains after the program, the problem may be in the filter, drain hose, pump or another part of the system.</p>
            <p>In the case of poor washing, the circulation, spray arms, filters, heating and other components involved in the program are checked.</p>
            <p>Dishwasher repair is part of RotoRem's services for <a href="/en/services/sofia/" class="text-emerald-700 font-medium hover:underline">repair of household appliances in Sofia</a>.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Diagnostics of a dishwasher in Sofia"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Съдомиялна" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What dishwasher problems do we repair?</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-emerald-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher does not drain</h3>
                <p class="text-gray-800 leading-relaxed">The filter, pump and drain hose are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-teal-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher does not fill with water</h3>
                <p class="text-gray-800 leading-relaxed">The water supply, inlet hose and valve are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-green-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher does not heat up</h3>
                <p class="text-gray-800 leading-relaxed">The heating system, sensors and control are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-lime-600">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher does not wash well</h3>
                <p class="text-gray-800 leading-relaxed">Filters, circulation, spray arms and temperature are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher is running</h3>
                <p class="text-gray-800 leading-relaxed">Hoses, seals, connections and pumps are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-cyan-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher won't start</h3>
                <p class="text-gray-800 leading-relaxed">The door, lock, water supply and controls are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The program stops during operation</h3>
                <p class="text-gray-800 leading-relaxed">It is checked at which stage it interrupts the program.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-violet-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The dishwasher does not dry well</h3>
                <p class="text-gray-800 leading-relaxed">The heating and drying methods for the particular model are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-orange-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">The tablet does not dissolve</h3>
                <p class="text-gray-800 leading-relaxed">The dispenser, circulation, temperature and program are checked.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-slate-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">It shows an error</h3>
                <p class="text-gray-800 leading-relaxed">The code is used as part of the diagnostics.</p>
              </div>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What we check during diagnostics</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">Depending on the problem, the following can be checked:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>water supply</li>
            <li>inlet valve</li>
            <li>filters</li>
            <li>circulation pump</li>
            <li>drain pump</li>
            <li>drain hose</li>
            <li>heating system</li>
            <li>temperature sensors</li>
            <li>spreading arms</li>
            <li>dispenser</li>
            <li>door</li>
            <li>lock</li>
            <li>gaskets</li>
            <li>electrical connections</li>
            <li>electronic management</li>
            <li>error codes</li>
          </ul>
          <p>First, the cause of the specific malfunction is determined, and then the necessary repair is determined.</p>
          <p class="font-semibold text-gray-900">Visit and diagnostics: {diagnosticPrice}</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher parts and systems we inspect and repair</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">A part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Related problem</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every failure needs to result in part replacement. In many cases, diagnostics indicate another problem in the system, so the specific repair is determined after inspection.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The dishwasher does not drain</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>If water remains after the program, the filter, pump, hose, internal connections and pump control are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The dishwasher does not wash well</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>For normal washing, the water must enter, circulate and reach the dishes at the appropriate pressure and temperature.</p>
          <p>Filters, circulation pump, spray arms, heating, water supply and dispenser are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Heating problems</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>The heating system, temperature sensor, electrical connections and electronic control are checked.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">The dishwasher is running</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>Check the inlet hose, drain hose, seals, pumps, internal connections and the area around the door.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Installation and dismantling of dishwashers in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="space-y-5 text-gray-800 leading-relaxed">
          <p>RotoRem installs and dismantles freestanding and built-in dishwashers. Positioning, leveling, water and drainage connections, connection checks and tests can be performed during installation.</p>
          <p>Appliances connected to water and sewerage include laundry rooms. In case of a problem with such a device, RotoRem performs <a href="/en/services/sofia/washing-machine-repair/" class={`${accentLink} font-medium hover:underline`}>repair of washing machines in Sofia</a>.</p>
        </div>
      </section>
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Repair of other kitchen appliances</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border max-w-4xl mx-auto text-gray-800 leading-relaxed`}>
          <p>If the problem is with the oven, RotoRem also performs <a href="/en/services/sofia/oven-repair/" class={`${accentLink} font-medium hover:underline`}>repair of ovens in Sofia</a> at address.</p>
        </div>
      </section>

      <section class={sectionClass} aria-labelledby="sofia-dishwasher-pricing">
        <div class="text-center mb-10">
          <h2 id="sofia-dishwasher-pricing" class="text-3xl font-bold text-gray-900 mb-4">Prices for repairing dishwashers in Sofia</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg max-w-3xl mx-auto`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Service</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Price</th>
              </tr>
            </thead>
            <tbody>
              {pricingRows.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.service}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          The final price depends on the damage found, the work required and the spare parts used.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher brands we service</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">RotoRem works with various brands of dishwashers, including:</p>
          <p class="text-gray-800 leading-relaxed mb-6 text-center font-medium">Bosch, Siemens, Whirlpool, Electrolux, Beko and other manufacturers served.</p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-2xl mx-auto">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
