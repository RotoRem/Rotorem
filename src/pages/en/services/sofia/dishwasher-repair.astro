---
import Layout from '../../../../layouts/Base.astro';
import ServicePricing from '../../../../components/ServicePricing.astro';
import { getServicePricing } from '../../../../data/service-prices';
import { getLangFromUrl, useTranslations } from '../../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pricing = getServicePricing('dishwasher', 'sofia', lang);

const title = 'Dishwasher Repair & Installation in Sofia | RotoRem';
const description = 'In-home dishwasher repair and installation service in Sofia - Quality guarantee - All brands - Same-day repair - Call 089 834 0982!';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Dishwasher Repair and Installation in Sofia
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
          Expert dishwasher repair throughout Sofia - diagnostics, replacement parts, and full restoration carried out at your address.
        </p>
        <p class="text-base md:text-lg text-blue-100 max-w-2xl mx-auto mb-8">
          Visit and diagnostics in Sofia - 30 EUR
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Send Email
          </a>
          <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Call 089 834 0982
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">

      <!-- Benefits Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What you get with our dishwasher repair in Sofia</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-blue-200">
            <div class="w-12 h-12 bg-blue-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 4H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z"></path>
                <path d="M3 10h18"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-blue-900 mb-3">Convenient on-site service</h3>
            <p class="text-blue-800">Avoid uninstalling your appliance. We troubleshoot, repair, and test your dishwasher directly at your home or office.</p>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-green-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-green-200">
            <div class="w-12 h-12 bg-green-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 1v22"></path>
                <path d="M5 5h14"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-green-900 mb-3">Genuine replacement parts</h3>
            <p class="text-green-800">We fit genuine or OEM parts for Bosch, Siemens, Whirlpool, Electrolux, Beko, Samsung, and other leading brands.</p>
          </div>

          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Full workmanship warranty</h3>
            <p class="text-amber-800">Enjoy peace of mind with clear paperwork that covers both labour and the parts we install.</p>
          </div>

          <div class="bg-gradient-to-br from-lime-50 to-lime-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-lime-200">
            <div class="w-12 h-12 bg-lime-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-lime-900 mb-3">Fair prices</h3>
            <p class="text-lime-800">Visit and diagnostics in Sofia - 30 EUR. Transparent pricing with no hidden fees.</p>
          </div>
        </div>
      </section>

      <!-- Common Issues Section -->
      <section class="mb-16">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Common dishwasher faults we fix</h2>
          <div class="grid md:grid-cols-2 gap-8">
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">1</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Dishwasher will not start</h3>
                  <p class="text-gray-600">We check the control module, start button, wiring, and door lock assembly before replacing faulty components.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">2</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Dishes come out dirty</h3>
                  <p class="text-gray-600">Blocked spray arms, dirty filters, failing pumps, or incorrect dosing are quickly diagnosed and corrected.</p>
                </div>
              </div>
            </div>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">3</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Water remains in the tub</h3>
                  <p class="text-gray-600">We clear clogs, replace drain pumps, and inspect hoses for kinks or blockages.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">4</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Error codes and beeping alarms</h3>
                  <p class="text-gray-600">Error diagnostics pinpoint faulty sensors, heaters, circulation pumps, or control boards that require repair or replacement.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {pricing && <ServicePricing pricing={pricing} accent="blue" />}

      <!-- Repair Process Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Dishwasher repair process in Sofia</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">1</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">You call us</h3>
              <p class="text-gray-700">Call 089 834 0982 to book dishwasher repair in Sofia.</p>
            </div>
          </div>

          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">We come to you</h3>
              <p class="text-gray-700">Our technician arrives on time with all required tools and parts.</p>
            </div>
          </div>

          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">3</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">We repair</h3>
              <p class="text-gray-700">We diagnose the issue and repair your dishwasher the same day whenever possible.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Service Areas Section -->
      <section class="mb-16 bg-gray-50 border border-gray-200 rounded-2xl p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">We cover the whole of Sofia</h2>
        <p class="text-gray-700 text-center max-w-3xl mx-auto mb-8">
          From central Sofia to suburban zones such as Manastirski Livadi, Boyana, Simeonovo, Druzhba, and Vitosha - our technicians visit you wherever you are.
        </p>
        <div class="grid md:grid-cols-3 gap-6 text-gray-700">
          <ul class="space-y-2">
            <li>Lozenets</li>
            <li>Manastirski Livadi</li>
            <li>Buxton</li>
            <li>Pavlovo</li>
          </ul>
          <ul class="space-y-2">
            <li>Mladost</li>
            <li>Druzhba</li>
            <li>Reduta</li>
            <li>Slatina</li>
          </ul>
          <ul class="space-y-2">
            <li>Boyana</li>
            <li>Simeonovo</li>
            <li>Suhata Reka</li>
            <li>Poduyane</li>
          </ul>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="text-center bg-gradient-to-r from-blue-600 to-blue-800 text-white p-12 rounded-2xl shadow-2xl">
        <h2 class="text-3xl font-bold mb-4">Need dishwasher repair in Sofia?</h2>
        <p class="text-xl mb-8 text-blue-100">Call now for fast on-site repair!</p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Send Email
          </a>
          <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Call 089 834 0982
          </a>
        </div>

        <div class="text-blue-100">
          <p class="text-sm">
            Visit and diagnostics: Sofia - 30 EUR | Quality guarantee | Service in Sofia
          </p>
        </div>
      </section>
    </div>
  </article>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
      <p dir="ltr">Is your dishwasher not starting, not cleaning properly, or leaking? These situations disrupt daily life and require quick action. RotoRem provides in-home dishwasher repair in Sofia directly at your address, without requiring you to transport the appliance to a workshop. We offer diagnostics, installation, and repair with attention to detail in both central and outer districts.</p>
      <h2 dir="ltr">What dishwasher problems we repair in Sofia</h2>
      <p dir="ltr">Most requests for dishwasher repair come when the appliance starts operating unstably or stops completely. We handle cases where the dishwasher does not drain, does not heat, or does not complete programs. Sometimes dishes remain dirty despite a full cycle, often indicating issues with spray arms or the heater.</p>
      <p dir="ltr">Other common cases include cabinet leaks, unusual operating noise, or display error codes. In these situations, accurate diagnostics are essential because the root cause may be mechanical or electronic. We also install new units, including built-in dishwasher installation, leveling, and proper plumbing connection.</p>
      <p dir="ltr">Besides dishwasher repair, you can rely on us for other appliances as well. If you have a washer problem, see our <a href="https://www.rotorem.bg/en/services/sofia/washing-machine-repair/" style="text-decoration:none;">washing machine repair</a> service. If you need oven support, check <a href="https://www.rotorem.bg/en/services/sofia/oven-repair/" style="text-decoration:none;">cooker and oven repair</a>, and view all solutions on our <a href="https://www.rotorem.bg/en/services/sofia/" style="text-decoration:none;">Sofia white goods services page</a>.</p>
      <h2 dir="ltr">Dishwasher brands we service</h2>
      <p dir="ltr">We perform repair and installation for all major dishwasher brands. We work with Bosch, Whirlpool, Samsung, Indesit, Electrolux, Miele, and other manufacturers. We know the specifics of different models, including built-in systems and modern electronics. This helps us identify faults faster and deliver effective repairs without unnecessary delays.</p>
      <h2 dir="ltr">Sofia areas we cover</h2>
      <p dir="ltr">We cover all city districts and nearby areas up to 20 km. We work in Lyulin, Mladost, Druzhba, Nadezhda, Obelya, Studentski Grad, Lozenets, Manastirski Livadi, Borovo, Krasno Selo, and central locations. We also accept requests for nearby settlements and aim to respond as quickly as possible based on schedule availability.</p>
      <h2 dir="ltr">How dishwasher repair works</h2>
      <p dir="ltr">The process starts with your request and scheduling a convenient visit time. The technician arrives on-site and performs diagnostics to identify the exact cause. You then receive a clear quote for repair or installation based on the appliance condition.</p>
      <p dir="ltr">After approval, we proceed with the work: component replacement, adjustments, or installation. Final testing confirms that the dishwasher works correctly and safely. For built-in units, we pay special attention to leveling and secure fitting.</p>
      <h2 dir="ltr">Why choose RotoRem for dishwasher repair</h2>
      <p dir="ltr">When you need reliable dishwasher repair in Sofia, real experience and fair service matter. RotoRem has over 15 years of practice in white goods repair and provides on-site service without complications. We work with trusted parts and provide warranty for completed work.</p>
      <p dir="ltr">Prices are agreed in advance with no hidden fees. Each case is treated individually so you receive an effective long-term solution. Send an inquiry or <a href="https://www.rotorem.bg/en/contact/" style="text-decoration:none;">contact us</a> to schedule a convenient visit.</p>
    </div>
  </div>
</Layout>


