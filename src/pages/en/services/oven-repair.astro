---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';
const lang = 'en';
const pricing = getServicePricing('oven', 'varna', lang);

const title = 'Oven Repair in Varna | In-Home Service | RotoRem';
const description =
  'In-home oven repair and diagnostics in Varna. Heating element, temperature, fan, door, program selector and electronics problems. RotoRem.';

const heroImage = '/img/services/ремонт-на-фурна-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-фурна-варна-диагностика.webp';

const problems = [
  {
    title: 'Oven does not heat',
    text: 'When the oven turns on but stays cold, the heating system and the components that control temperature need to be checked. Depending on the model, the cause may be the bottom or top heating element, the grill element, the circular element in convection models, the thermostat, a temperature sensor or the electronic control. Before any part is replaced, we establish which component is actually causing the problem.',
    border: 'border-orange-500',
  },
  {
    title: 'Oven does not reach the set temperature',
    text: 'If the appliance heats up but the temperature stays below the set value, or reaching it takes unusually long, the heating elements and the temperature control system need to be checked. It is also important to find out whether the problem occurs in all modes or only with a particular function.',
    border: 'border-amber-500',
  },
  {
    title: 'Oven bakes unevenly',
    text: 'When food burns on top, stays undercooked on the bottom or different parts of the cavity heat unevenly, the cause may be a heating element, the fan or temperature control. In convection models, we also check that the heated air circulates properly.',
    border: 'border-red-500',
  },
  {
    title: 'Oven overheats',
    text: 'When the temperature rises well above the set value, the system that measures and controls heating needs to be checked. Possible causes include the thermostat, a temperature sensor, the electronic control or another related component. In case of uncontrolled overheating, the appliance should not be used until it has been inspected.',
    border: 'border-rose-500',
  },
  {
    title: 'Oven does not turn on',
    text: 'When the display does not respond or the oven does not start at all, the problem may be related to the power supply, the electrical connections, the program selector, the function selector, the thermal protection or the electronic module. Diagnostics are carried out according to the specific behavior of the appliance.',
    border: 'border-yellow-500',
  },
  {
    title: 'Oven trips the circuit breaker',
    text: 'If the circuit breaker trips when the oven is switched on or when a particular mode is selected, the appliance must be inspected before it is used again. The cause may be a heating element, an electrical connection, the insulation of a component or another electrical fault. RotoRem has a real case in Varna with a Whirlpool oven where this symptom was caused by the bottom heating element.',
    border: 'border-red-600',
    extra: 'If the problem is with the electrical installation or the circuit breaker, you may also need our ',
    link: { href: '/en/services/electrical-services/', label: 'in-home electrical services' },
  },
  {
    title: 'Oven fan does not work',
    text: 'In convection ovens, the fan distributes the heated air. If it does not turn, runs intermittently or makes unusual noise, we can check the fan blade, the motor, the power supply and the related control components.',
    border: 'border-indigo-500',
  },
  {
    title: 'Oven makes unusual noise',
    text: 'The noise may occur only when the fan is running, in a particular mode or after a certain temperature is reached. This helps determine which system needs to be checked. In convection models, the cause may be the fan, the motor or a mechanical problem around the fan blade.',
    border: 'border-purple-500',
  },
  {
    title: 'Oven switches off during operation',
    text: 'When the oven starts normally but cuts out after a while, we can check the temperature control, the thermal protection, the electronics and the other systems related to the specific symptom. It is helpful to tell us how long it takes for the problem to appear and whether the oven can be switched on again after it cools down.',
    border: 'border-teal-500',
  },
  {
    title: 'Oven door does not close properly',
    text: 'Improper closing can lead to heat loss and difficulty maintaining the temperature. We check the hinges, the door mechanism, the seal and the positioning relative to the oven body.',
    border: 'border-orange-600',
  },
  {
    title: 'Oven light does not work',
    text: 'The cause may be a burnt-out bulb, a socket, an electrical connection or another component of the lighting system. The problem is checked together with the appliance\'s other symptoms to determine whether it is isolated or part of a broader fault.',
    border: 'border-amber-600',
  },
  {
    title: 'Timer or program selector does not work',
    text: 'In electronically controlled ovens, a problem with the timer, the display or the program selector can prevent certain functions or stop the appliance from starting. We check whether the problem is in the control itself or the result of another fault.',
    border: 'border-slate-500',
  },
  {
    title: 'Oven shows an error code',
    text: 'An error code can point the diagnostics toward a particular system, but it does not automatically prove which part must be replaced. The technician compares the code with the behavior of the oven and checks the relevant components.',
    border: 'border-gray-500',
  },
];

const partsTable = [
  { part: 'Bottom heating element', problem: 'Poor baking on the bottom / no heating' },
  { part: 'Top heating element', problem: 'Insufficient heating on top' },
  { part: 'Grill element', problem: 'Grill function does not work' },
  { part: 'Circular (fan) heating element', problem: 'Problem in fan mode' },
  { part: 'Thermostat', problem: 'Incorrect temperature' },
  { part: 'Temperature sensor', problem: 'Overheating or insufficient heating' },
  { part: 'Thermal protection', problem: 'Oven cuts out or does not start' },
  { part: 'Fan', problem: 'Uneven baking' },
  { part: 'Fan motor', problem: 'Fan does not work / is noisy' },
  { part: 'Function selector', problem: 'A certain mode does not work' },
  { part: 'Program selector', problem: 'Problem with starting or programs' },
  { part: 'Timer / display', problem: 'Control problem' },
  { part: 'Electronic module', problem: 'Appliance does not respond or cuts out' },
  { part: 'Hinges', problem: 'Door does not close' },
  { part: 'Seal', problem: 'Heat loss' },
  { part: 'Lighting', problem: 'Light does not work' },
];

const realCases = [
  {
    brand: 'Whirlpool',
    problem: 'Oven was not baking on the bottom',
    area: 'Chaika',
    diagnosis: 'We found a problem with the oven\'s bottom heating element.',
    repair: 'After the heating element was replaced, the oven works normally.',
    image: '/img/services/ремонт-на-фурна-варна-случай-1.webp',
    alt: 'Whirlpool oven repair: no heat on the bottom, faulty bottom heating element replaced in the Chaika district, Varna.',
  },
  {
    brand: 'Samsung',
    problem: 'Oven would not turn on and tripped the circuit breaker',
    area: 'Vazrazhdane',
    diagnosis: 'We found a problem with the main board.',
    repair: 'After receiving the quote, the customer chose not to go ahead with the repair; for similar faults, replacing the board can restore normal operation of the oven.',
    image: '/img/services/ремонт-на-фурна-варна-случай-2.webp',
    alt: 'Samsung oven repair: oven not turning on and tripping the circuit breaker, main board fault diagnosed in the Vazrazhdane district, Varna.',
  },
  {
    brand: 'Bosch',
    problem: 'Oven was not heating from the top',
    area: 'Mladost',
    diagnosis: 'We found a problem with the top heating element.',
    repair: 'After the element was replaced, the oven works normally.',
    image: '/img/services/ремонт-на-фурна-варна-случай-3.webp',
    alt: 'Bosch oven repair: no heat from the top, faulty top heating element replaced in the Mladost district, Varna.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Contact RotoRem',
    text: 'Describe how the oven problem shows up. If a particular function does not work or the display shows an error code, mention it when you book.',
    circleClass: 'bg-gradient-to-r from-orange-500 to-orange-600',
  },
  {
    step: 2,
    title: 'We schedule a visit',
    text: 'A technician visits your address in Varna at the agreed time.',
    circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600',
  },
  {
    step: 3,
    title: 'We run diagnostics',
    text: 'The components and systems related to the specific symptom are inspected.',
    circleClass: 'bg-gradient-to-r from-red-500 to-red-600',
  },
  {
    step: 4,
    title: 'You get repair information',
    text: 'We explain what was found and what repair is recommended.',
    circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600',
  },
  {
    step: 5,
    title: 'Repair and test',
    text: 'Where possible, the repair is carried out on site and the oven is tested before the visit ends.',
    circleClass: 'bg-gradient-to-r from-orange-600 to-orange-800',
  },
];

const brands = ['Bosch', 'Siemens', 'Electrolux', 'Whirlpool', 'Beko', 'Indesit', 'Gorenje'];

const faqs = getServiceFaqItems('/en/services/oven-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="oven-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="In-home oven repair in Varna"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-orange-950/85 via-orange-900/75 to-orange-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.2),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            In-home service in Varna
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            In-Home Oven Repair in Varna
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Oven not heating, not reaching the set temperature, baking unevenly or switching off during use? RotoRem provides in-home diagnostics and repair of ovens in Varna. We find the cause of the specific problem before any heating element, thermostat, sensor, fan, electronic component or other part is replaced.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            We work with built-in and freestanding electric ovens and carry out the repair at your address when the fault allows it.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Diagnostics in Varna</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Call to book a visit
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">In-Home Oven Repair and Diagnostics</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            With ovens, the same symptom can be caused by different components. An oven that does not heat, for example, may have a faulty heating element, but the cause may also be the thermostat, the temperature sensor, the thermal protection, the electronic control or another part of the system.
          </p>
          <p>
            With uneven baking, the problem may be related to an individual heating element, the fan or the temperature control. That is why every repair starts with diagnostics. Depending on the specific symptom, the technician checks the components and systems that could cause it.
          </p>
          <p>
            After the inspection, you receive information about what was found and what repair is recommended. When the nature of the fault allows it, the repair is carried out at your address in Varna. You can also read <a href="/en/reviews/" class="text-orange-700 font-medium hover:underline">RotoRem customer reviews</a>, including reviews of oven repairs in Varna.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="RotoRem customer reviews" prioritizeAppliance="Фурна" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Oven Faults We Repair</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-orange-50 via-white to-orange-50 p-6 md:p-8 rounded-2xl shadow-xl border border-orange-100">
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
                {item.extra && item.link && (
                  <p class="mt-3 text-gray-800 leading-relaxed">
                    {item.extra}
                    <a href={item.link.href} class="font-semibold text-orange-700 hover:underline">{item.link.label}</a>.
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="orange" /></div>}

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Oven Diagnostics in Varna</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Diagnostics aim to establish the specific cause of the problem before any parts are replaced.
            </p>
            <p class="font-medium text-gray-900">Depending on the symptom, we may check:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>the bottom, top, grill and circular heating elements;</li>
              <li>the thermostat, temperature sensor and thermal protection;</li>
              <li>the fan and fan motor;</li>
              <li>the function selector, program selector, timer and display;</li>
              <li>the electronic module and control board;</li>
              <li>electrical connections, door, hinges, seal and lighting;</li>
              <li>error codes.</li>
            </ul>
            <p>After the inspection, you receive information about what was found and what repair is needed.</p>
            <p class="font-semibold text-gray-900">Visit and diagnostics in Varna: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Oven diagnostics in Varna"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Oven Parts and Systems We Inspect and Repair</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-orange-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-orange-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-orange-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Part or system</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Commonly related symptom</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Not every symptom means a faulty part. The same problem can be caused by different components, so the exact repair is determined after diagnostics.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Heating Elements and Heating Problems</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-orange-50 via-white to-orange-50 p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>An electric oven may use several heating elements, each with a different function.</p>
          <p><strong class="text-gray-900">Bottom heating element</strong> — provides heating from the bottom of the cavity. If it fails, food may stay undercooked on the bottom even though other functions keep working.</p>
          <p><strong class="text-gray-900">Top heating element</strong> — provides heating in the upper part and is used in different modes depending on the model.</p>
          <p><strong class="text-gray-900">Grill element</strong> — used for intense heat from above and for the grill function.</p>
          <p><strong class="text-gray-900">Circular (fan) heating element</strong> — in many convection ovens it is located around the fan and provides heating in the air circulation mode.</p>
          <p>If a particular mode does not work properly, it is not necessary to replace all the heating elements automatically. We check which component is related to the specific problem.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Thermostat, Sensors and Temperature Control</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-orange-50 via-white to-orange-50 p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>To bake properly, an oven must not only produce heat but also measure and control the temperature.</p>
          <p>Depending on the model, a mechanical thermostat, a temperature sensor, an electronic module and thermal protection may all be involved in this process.</p>
          <p>When there is a problem, the oven may heat insufficiently, overheat, cut out or hold the temperature incorrectly. That is why a temperature problem does not automatically mean a faulty heating element.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Fan and Convection</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-orange-50 via-white to-orange-50 p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>Convection ovens use a fan to circulate the heated air.</p>
          <p>When there is a problem, you may notice uneven baking, unusual noise, a mode that does not work or incorrect temperature distribution.</p>
          <p>During diagnostics we can check the fan, the motor, the fan blade, the circular heating element and the electronic control.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Door, Hinges and Seal</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-orange-50 via-white to-orange-50 p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>The door must fit tightly against the oven body so that the temperature is kept inside the cavity.</p>
          <p>When there is a problem, we can check the hinges, the closing mechanism, the seal, the position of the door and how it is fastened.</p>
          <p>Worn hinges can prevent the door from closing properly, and a damaged seal can allow heat to escape.</p>
        </div>
      </section>

      <section class={sectionClass} id="kotloni">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Built-In and Freestanding Ovens</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Built-in ovens</h3>
            <p>
              For some repairs, the appliance may need to be partially pulled out of the kitchen cabinet to reach the components. We check how it is installed, the electrical connections and access to the required parts.
            </p>
          </div>
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Freestanding ovens</h3>
            <p>
              In freestanding models, the construction and access to the components can differ. Diagnostics are again carried out according to the specific symptom and model.
            </p>
          </div>
          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-orange-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Convection ovens and ovens with a grill</h3>
            <p class="mb-4">
              In convection models, special attention is paid to the fan, the motor, the circular heating element and the heat distribution system. If there is a problem with the grill function, we check the relevant heating element and control components.
            </p>
            <p>
              If the problem is with the heating zones or the controls of the kitchen hob, see <a href="/en/services/oven-repair/#kotloni" class="text-orange-700 font-medium hover:underline">hob repair in Varna</a> — information provided on this page until there is a separate hob service.
            </p>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Oven Brands We Service</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">
            RotoRem diagnoses and repairs ovens from many manufacturers, including:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            Construction, heating systems, electronics and error codes can differ depending on the manufacturer and model. When you call, it is helpful to give the brand and model of the oven, as well as the error code, if one is displayed.
          </p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Real Oven Repairs in Varna</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>

        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full md:w-2/5 lg:w-5/12 object-cover min-h-[220px] md:min-h-[280px]"
                  loading="lazy"
                  width="480"
