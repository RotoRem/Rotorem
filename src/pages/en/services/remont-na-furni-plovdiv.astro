---
import Layout from '../../../layouts/Base.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';

const title = 'Oven Repair in Plovdiv | RotoRem';
const description = 'Oven repair in Plovdiv - on-site diagnostics and replacement of heaters, thermostats and hobs, without transporting the appliance. Call RotoRem.';

const heroImage = '/img/services/ремонт-на-фурни-пловдив-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-фурни-пловдив-диагностика.webp';
const accentBar = 'bg-orange-500';
const accentLink = 'text-orange-700';
const accentShell = 'from-orange-50 via-white to-amber-50 border-orange-100';
const accentBorder = 'border-orange-100';
const tableHeader = 'bg-orange-600';

const problems = [
  { title: 'The oven does not heat at all, even though it switches on', text: 'The lamp and the display light up, but the cavity stays cold. The cause can be the bottom, top, grill or circular heater, but also the thermostat, the thermal cut-out or the electronics. The technician checks which of them is not working before suggesting a replacement.', border: 'border-orange-500' },
  { title: 'The temperature rises out of control', text: 'The thermostat does not stop the heating in time and the oven overheats. Food burns, and the appliance itself gets hot on the outside. The temperature sensor and the controls are checked as well as the thermostat. Until the repair the oven should not be used.', border: 'border-red-500' },
  { title: 'The oven does not reach the set temperature', text: 'It heats, but stays below the set degrees or heats unusually slowly. Often one of the heaters has stopped working while the others continue. It helps to note whether the problem is on every mode or only on one.', border: 'border-amber-500' },
  { title: 'Baking is uneven, with burning on one side', text: 'One part of the food burns and another stays raw. The cause is usually a faulty top or bottom heater, or a fan that does not distribute the heat. On convection ovens the circular heater around the fan is checked as well.', border: 'border-rose-500' },
  { title: 'The appliance does not switch on or the indicators do not light', text: 'The oven does not respond at all. The power supply, the connections, the thermal cut-out, the programmer and the board are checked. Sometimes the interruption is a burnt thermal cut-out that tripped because of another problem.', border: 'border-yellow-600' },
  { title: 'The oven trips the breaker', text: 'The breaker trips when the oven is switched on or on a particular mode. The most common cause is a heater with broken insulation. The oven should be checked before it is switched on again.', border: 'border-red-600' },
  { title: 'The fan does not work or is noisy', text: 'On convection ovens the fan distributes the hot air. If it stops or is noisy, baking becomes uneven. The blade, the motor and its power supply are checked.', border: 'border-indigo-500' },
  { title: 'The oven stops during operation', text: 'It starts normally, but switches off after a while. The cause can be the thermal cut-out, the temperature control or the electronics. It helps to say after how long it stops and whether it starts again after it has cooled.', border: 'border-teal-500' },
  { title: 'The door does not close tightly', text: 'Heat escapes and the oven has trouble holding the temperature. The hinges, the seal and the position of the door are checked.', border: 'border-orange-600' },
  { title: 'The timer, display or light does not work', text: 'On electronic ovens a problem with the timer or the display can stop certain functions. A burnt lamp or lampholder is checked together with the other symptoms.', border: 'border-slate-500' },
  { title: 'The oven shows an error code', text: 'The code points the diagnostics toward a particular system, but by itself it does not prove which part needs replacing. The technician compares it with the actual check.', border: 'border-stone-500' },
];

const checks = [
  'the bottom, top, grill and circular heaters;',
  'the thermostat, the temperature sensor and the thermal cut-out;',
  'the fan and its motor;',
  'the selector, the programmer, the timer and the display;',
  'the electronic module and the board;',
  'the electrical connections, the door, the hinges and the seal',
];

const partsTable = [
  { part: 'Bottom heater', problem: 'Does not bake from below' },
  { part: 'Top heater', problem: 'Does not bake from above' },
  { part: 'Grill heater', problem: 'The grill does not work' },
  { part: 'Circular heater', problem: 'Does not heat on fan mode' },
  { part: 'Thermostat', problem: 'Incorrect temperature or overheating' },
  { part: 'Temperature sensor', problem: 'Heats too much or too little' },
  { part: 'Thermal cut-out', problem: 'The oven stops or will not switch on' },
  { part: 'Fan and motor', problem: 'Uneven baking, noise' },
  { part: 'Function selector', problem: 'A particular mode does not work' },
  { part: 'Programmer, timer, display', problem: 'A control problem' },
  { part: 'Electronic module', problem: 'Does not respond or cuts out' },
  { part: 'Hinges and seal', problem: 'The door does not close, loses heat' },
  { part: 'Lighting', problem: 'The lamp does not light' },
];

const priceRows = [
  { service: 'Visit and diagnostics', price: '25 €' },
  { service: 'Installation of a freestanding oven', price: 'from 40 €' },
  { service: 'Installation of a built-in oven', price: 'from 50 €' },
  { service: 'Removal of an old appliance', price: 'from 15 €' },
  { service: 'Problem with the oven fan', price: 'from 20 €' },
  { service: 'The oven does not heat', price: 'from 26 €' },
  { service: 'The appliance does not switch on / does not start', price: 'from 31 €' },
];

const brands = ['Bosch', 'Siemens', 'Electrolux', 'Whirlpool', 'Beko', 'Indesit', 'Gorenje'];
const realCases = [
  { brand: 'Gorenje', problem: 'The oven was not switching correctly between the different operating modes.', area: 'Karshiaka, Plovdiv', diagnosis: 'A fault was found in the selector switch for choosing the programmes.', repair: 'Replacement of the selector switch and a test of all modes. After the repair the oven works normally.', image: '/img/services/ремонт-на-фурни-пловдив-случай-1.webp', alt: 'Repair of a Gorenje oven with a faulty programme selector switch in Karshiaka, Plovdiv.' },
  { brand: '', problem: 'The oven was not heating enough and had trouble reaching the set temperature.', area: 'Trakia, Plovdiv', diagnosis: 'Measuring the heater showed that it was not working within normal values and was the cause of the heating problem.', repair: 'The faulty heater was replaced and the oven was tested. After the repair the appliance heats normally.', image: '/img/services/ремонт-на-фурни-пловдив-случай-2.webp', alt: 'Measuring and repair of a heater on a Bosch oven that does not heat correctly, in Trakia, Plovdiv.' },
  { brand: 'Bosch', problem: 'The oven was not working correctly when switching between the different modes.', area: 'Hristo Smirnenski, Plovdiv', diagnosis: 'A fault was found in the selector switch, which was not sending the command correctly to the selected oven functions.', repair: 'The selector switch was replaced and all operating modes were tested. After the repair the oven works normally.', image: '/img/services/ремонт-на-фурни-пловдив-случай-3.webp', alt: 'Repair of a Bosch oven with a faulty selector switch and a problem switching modes in Hristo Smirnenski, Plovdiv.' },
];
const processSteps = [
  { step: 1, text: 'You contact RotoRem and describe the problem. If a mode does not work or there is an error code, mention that as well.', circleClass: 'bg-gradient-to-r from-orange-500 to-orange-600' },
  { step: 2, text: 'We arrange a visit to the address in Plovdiv.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 3, text: 'The technician carries out diagnostics.', circleClass: 'bg-gradient-to-r from-red-500 to-red-600' },
  { step: 4, text: 'You are told what the fault is and what will be repaired.', circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600' },
  { step: 5, text: 'Repair and test of the oven on site.', circleClass: 'bg-gradient-to-r from-orange-600 to-orange-800' },
];
const faqs = getServiceFaqItems('/en/services/remont-na-furni-plovdiv/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} image={heroImage} hideServiceFaq={true}>
  <article>
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img src={heroImage} alt="Oven repair at an address in Plovdiv" class="absolute inset-0 w-full h-full object-cover object-center scale-105" loading="eager" fetchpriority="high" width="1600" height="900" />
      <div class="absolute inset-0 bg-gradient-to-b from-orange-950/85 via-orange-900/75 to-orange-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>
      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">At-home oven repair in Plovdiv</h1>
          <p class="text-lg md:text-xl text-white/95 mb-8 leading-relaxed">RotoRem Plovdiv repairs ovens at the address, with on-site diagnostics and replacement of worn parts such as heaters and thermostats, without the appliance having to be transported. The service covers built-in and freestanding ovens, electric models, for faults that stop cooking in the household.</p>
          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md"><p class="text-xl font-bold text-white">Diagnostics in Plovdiv -  25 €</p></div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-sm text-white/80 mb-1">Phone</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>
          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">Call for a visit</a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">At-home oven repair and diagnostics</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>An oven is a heavy appliance to move, and taking it out and fitting it back often carries its own risk of damage. That is why RotoRem works in customers' homes in Plovdiv, instead of requiring the appliance to be taken to a workshop.</p>
            <p>The technician comes to the given address in Plovdiv with the tools needed and carries out diagnostics on site. The oven is checked in its installed position, without having to be removed for transport to a workshop. This saves time and removes the risk of extra damage when a built-in appliance is transported.</p>
            <p>After the fault is found the customer is told exactly what has to be replaced, before the repair continues.</p>
            <p>Besides oven repair, RotoRem Plovdiv also provides <a href="/en/services/remont-na-sadomiyalni-plovdiv/" class={`${accentLink} font-medium hover:underline`}>dishwasher repair</a> and <a href="/en/services/remont-na-boileri-plovdiv/" class={`${accentLink} font-medium hover:underline`}>water heater repair</a> at the address, with the same approach of diagnostics and repair in the customer's home.</p>
          </div>
          <img src={diagnosticImage} alt="oven diagnostics in Plovdiv" class="w-full rounded-2xl shadow-lg object-cover" loading="lazy" width="600" height="450" />
        </div>
      </section>
    </div>

    <Reviews title="Customer reviews" prioritizeAppliance="Фурна" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12"><h2 class="text-3xl font-bold text-gray-900 mb-4">Oven faults we repair</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <p class="text-center text-gray-800 leading-relaxed mb-8 max-w-3xl mx-auto">The most common reasons customers call are related to the oven's heating or controls.</p>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}><h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3><p class="text-gray-800 leading-relaxed">{item.text}</p></div>
            ))}
          </div>
        </div>
        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">In each of these cases oven repair starts by finding the exact component that has failed, before any replacement.</p>
      </section>

      <section class={sectionClass} aria-labelledby="plovdiv-oven-pricing-en">
        <div class="text-center mb-8"><h2 id="plovdiv-oven-pricing-en" class="text-3xl font-bold text-gray-900 mb-4">Oven repair prices in Plovdiv</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <p class="max-w-4xl mx-auto text-gray-800 leading-relaxed mb-8">The prices are a guide for labour and do not include the cost of spare parts.</p>
        <div class={`bg-gradient-to-r ${accentShell} p-4 sm:p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="md:hidden space-y-3">{priceRows.map((row) => (<div class={`rounded-xl border ${accentBorder} bg-white p-4 shadow-sm`}><p class="font-medium text-gray-900 mb-2">{row.service}</p><p class="text-xl font-bold text-orange-700">{row.price}</p></div>))}</div>
          <div class="hidden md:block overflow-hidden rounded-xl border border-white/60 bg-white shadow-md">
            <table class="w-full text-left">
              <thead><tr class={`${tableHeader} text-white`}><th scope="col" class="px-5 py-4 text-sm font-semibold">Service / problem</th><th scope="col" class="px-5 py-4 text-sm font-semibold text-right">Price (EUR)</th></tr></thead>
              <tbody>
                {priceRows.map((row, index) => (
                  <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}><td class="px-5 py-4 text-sm text-gray-800">{row.service}</td><td class="px-5 py-4 text-sm font-bold text-orange-700 text-right whitespace-nowrap">{row.price}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Oven diagnostics in Plovdiv</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p>The team offers a separate oven diagnostic for cases in which the symptom does not clearly point to a specific fault and an initial check is needed before a repair decision. Depending on the symptom, the following are checked:</p>
          <ul class="list-disc pl-5 space-y-2">{checks.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Oven parts and systems we check and repair</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class="md:hidden space-y-4">{partsTable.map((row) => (<div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}><p class="font-semibold text-gray-900 mb-2">{row.part}</p><p class="text-gray-800">{row.problem}</p></div>))}</div>
        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead><tr class={`${tableHeader} text-white`}><th scope="col" class="px-5 py-4 text-sm font-semibold">Part or system</th><th scope="col" class="px-5 py-4 text-sm font-semibold">The problem it most often causes</th></tr></thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}><td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td><td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-8 space-y-5 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          <p>Sometimes the oven stops because of a loose contact or a protection that has tripped, not because of a damaged part. What will be replaced is therefore decided after the check.</p>
          <p>Most often replaced parts: bottom heater, selector switch, thermostat, repair of the main and/or display board)</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Heaters, thermostat and temperature control</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>When diagnostics show a worn or burnt component, RotoRem replaces an oven heater or an oven thermostat according to the specific fault. Both jobs are done on site, without the appliance having to leave the home.</p>
          <p>An oven usually has several heaters: bottom, top, grill and, on convection models, a circular one around the fan. When only one mode does not work, only the corresponding heater is replaced, not all of them.</p>
          <p>The temperature is monitored by the thermostat or the sensor, and most models also have a thermal cut-out. An oven that does not heat or that overheats does not always have a faulty heater.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Fan, door and seal</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>On convection ovens the fan distributes the hot air. When it stops, is noisy or works intermittently, baking becomes uneven. The blade, the motor and the circular heater are checked.</p>
          <p>The door has to close tightly so heat does not escape. Worn hinges or a cracked seal are a common reason an oven does not hold its temperature.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Built-in and freestanding ovens</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border text-gray-800 leading-relaxed max-w-4xl mx-auto`}><p>RotoRem repairs built-in and freestanding electric ovens. On built-in models the oven is sometimes pulled partly out of the cabinet to reach the parts. When you call, it helps to say whether the oven is built in, and to give the brand and model.</p></div>
      </section>
      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Oven installation</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border text-gray-800 leading-relaxed max-w-4xl mx-auto`}><p>Besides repair, the team also installs ovens for customers who buy a new appliance and need it fitted.</p></div>
      </section>
      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Hobs</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border text-gray-800 leading-relaxed max-w-4xl mx-auto`}><p>RotoRem Plovdiv also repairs built-in hobs - electric and induction - as part of the oven repair service. The most common cases are a heating coil that does not heat on electric models, an induction hob that does not recognise the pan and does not start, or a hob that does not switch on and cuts out during cooking. Diagnostics and repair are carried out at the customer's address, in the same way as for ovens.</p></div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12"><h2 class="text-3xl font-bold text-gray-900 mb-4">Oven brands we service</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">Bosch, Siemens, Electrolux, Whirlpool, Beko, Indesit, Gorenje.</p>
          <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">{brands.map((brand) => (<li class="bg-white border border-gray-200 rounded-lg shadow-sm h-full min-h-[4.5rem] px-4 py-4 flex items-center justify-center text-center font-semibold text-gray-900">{brand}</li>))}</ul>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">Construction and error codes differ by manufacturer. If you say the brand, the model and which mode does not work when you call, the technician will know what to check first.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12"><h2 class="text-3xl font-bold text-gray-900 mb-4">Real oven repairs in Plovdiv</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
                <img src={item.image} alt={item.alt} class="w-full md:w-2/5 lg:w-5/12 h-64 md:h-auto object-cover md:min-h-[280px]" loading="lazy" width="480" height="360" />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  {item.brand && <h3 class="text-xl font-bold text-gray-900">Brand / model: {item.brand}</h3>}
                  <p class="text-gray-800"><span class="font-semibold">Problem:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">Area:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Diagnostics:</span> {item.diagnosis}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair:</span> {item.repair}</p>
                </div>
              </article>
            ))}
          </div>
          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden max-w-5xl mx-auto">
            <img src={realCases[2].image} alt={realCases[2].alt} class="w-full lg:w-2/5 h-72 lg:h-auto object-cover lg:min-h-[300px]" loading="lazy" width="560" height="400" />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">Brand / model: {realCases[2].brand}</h3>
              <p class="text-gray-800"><span class="font-semibold">Problem:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Area:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Diagnostics:</span> {realCases[2].diagnosis}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Repair:</span> {realCases[2].repair}</p>
            </div>
          </article>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12"><h2 class="text-3xl font-bold text-gray-900 mb-4">How the repair works</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          {processSteps.slice(0, 3).map((item) => (
            <div class="text-center"><div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}><span class="text-xl font-bold">{item.step}</span></div><div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100"><p class="text-gray-900 font-semibold leading-relaxed">{item.text}</p></div></div>
          ))}
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {processSteps.slice(3).map((item) => (
            <div class="text-center"><div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}><span class="text-xl font-bold">{item.step}</span></div><div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100"><p class="text-gray-900 font-semibold leading-relaxed">{item.text}</p></div></div>
          ))}
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Oven repair in different areas of Plovdiv</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto`}>
          <p>RotoRem provides an at-home service across Plovdiv and nearby. For addresses outside the city there is a surcharge of 2 € per kilometre.</p>
          <p>Neighbourhoods we cover: Centre, Smirnenski, Karshiaka, Marasha, Kyuchuk Paris, Kamenitsa, Gagarin, Zaharna Fabrika, Filipovo, Proslav, Komatevo, Ostromila, Belomorski</p>
          <p>RotoRem offers oven repair in the same way in <a href="/en/services/oven-repair/" class={`${accentLink} font-medium hover:underline`}>Varna</a> and <a href="/en/services/sofia/oven-repair/" class={`${accentLink} font-medium hover:underline`}>Sofia</a>.</p>
        </div>
      </section>

      <section class={sectionClass} id="faq">
        <div class="text-center mb-10"><h2 class="text-3xl font-bold text-gray-900 mb-4">Frequently asked questions</h2><div class={`w-20 h-1 ${accentBar} mx-auto`}></div></div>
        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((faq) => (
            <div class="bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
              <details class="group"><summary class="flex justify-between items-center p-5 cursor-pointer"><h3 class="text-lg font-semibold text-gray-900 pr-4">{faq.q}</h3></summary><div class="p-5 pt-0 text-gray-800 border-t border-gray-100"><p class="leading-relaxed">{faq.a}</p></div></details>
            </div>
          ))}
        </div>
      </section>
    </div>
  </article>
  <div class="container max-w-5xl mb-28">
    <section class="text-center bg-gradient-to-r from-orange-600 to-orange-800 text-white p-12 md:p-14 rounded-2xl shadow-2xl">
      <h2 class="text-3xl font-bold mb-4">Problem with the oven?</h2>
      <p class="text-lg md:text-xl mb-8 text-white/90 max-w-3xl mx-auto leading-relaxed">Call 089 834 0982 now for fast on-site diagnostics in Plovdiv and book a repair.</p>
      <a href="tel:0898340982" class="inline-block bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">089 834 0982</a>
    </section>
  </div>
</Layout>
