---
import Layout from '../../layouts/Base.astro';

const title = 'Careers at RotoRem | Join Our Appliance Repair Team';
const description = 'Join RotoRem in Varna and Sofia. Discover our team culture, career growth opportunities, and how to apply for future openings.';
---

<Layout title={title} description={description}>
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-16">
    <div class="container max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Careers at RotoRem</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto">
        We are building a strong service team for Varna and Sofia and are always happy to meet skilled, motivated professionals.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container max-w-4xl">
      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <article class="bg-gray-50 border border-gray-200 rounded-xl p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-3">What we value</h2>
          <p class="text-gray-700">Professionalism, responsibility, clear communication, and respect for each customer home.</p>
        </article>
        <article class="bg-gray-50 border border-gray-200 rounded-xl p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-3">What we offer</h2>
          <p class="text-gray-700">Stable workload, supportive team environment, and opportunities to grow your technical skills.</p>
        </article>
        <article class="bg-gray-50 border border-gray-200 rounded-xl p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Who we seek</h2>
          <p class="text-gray-700">Technicians with experience in appliance repair, diagnostics, and safe electrical work.</p>
        </article>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-3">No open roles right now</h2>
        <p class="text-gray-700 mb-6">
          We still accept CVs for future opportunities in Varna and Sofia.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="btn-primary inline-flex items-center justify-center">Send your CV</a>
          <a href="/en/contact/" class="btn-cta inline-flex items-center justify-center">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
