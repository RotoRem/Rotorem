---
import Layout from '../../../layouts/Base.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEN = lang === 'en';

const title = 'Tips and Guides for Appliance Repairs from RotoRem';
const description = 'Learn how to extend the life of your appliances ✓ Helpful maintenance and appliance repair tips from the experts at RotoRem';

const heading = isEN ? 'Appliance Repair Blog' : 'Blog';
const subheading = isEN
  ? 'Updates and guides from the RotoRem team.'
  : 'Updates and guides from the RotoRem team.';
const emptyMessage = isEN
  ? 'There are no published articles at the moment.'
  : 'There are no published articles at the moment.';
---

<Layout title={title} description={description}>
  <section class="py-16">
    <div class="container max-w-3xl">
      <header class="text-center mb-10">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{heading}</h1>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-xl text-gray-600">{subheading}</p>
      </header>

      <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-700">
        <p class="text-lg">{emptyMessage}</p>
      </div>
    </div>
  </section>
</Layout>
