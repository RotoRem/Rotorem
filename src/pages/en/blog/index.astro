---
import Layout from '../../../layouts/Base.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEN = lang === 'en';

const title = 'Tips and Guides for Appliance Repairs from RotoRem';
const description = 'Learn how to extend the life of your appliances ✓ Helpful maintenance and appliance repair tips from the experts at RotoRem';

const heading = isEN ? 'Appliance Repair Blog' : 'Blog';
const subheading = isEN
  ? 'Updates and guides from the RotoRem team.'
  : 'Updates and guides from the RotoRem team.';

interface BlogPost {
  slug: string;
  title: string;
  excerpt: string;
  image: string;
  publishDate: string;
}

const blogPosts: BlogPost[] = [
  {
    slug: 'how-to-clean-a-washing-machine-professionally',
    title: 'How to Clean a Washing Machine Professionally: A Complete Guide to Removing Mould and Limescale',
    excerpt: 'Wondering how to clean your washing machine and remove mould, limescale and unpleasant odours? Discover RotoRem\'s professional tips for spotless results.',
    image: '/img/blog/close-up-detail-of-modern-washing-machine-interior.jpg',
    publishDate: '2026-07-16'
  },
  {
    slug: 'the-most-common-gorenje-oven-problems',
    title: 'Gorenje Oven: The Most Common Problems and How to Fix Them',
    excerpt: 'Is your oven locked? Learn how to resolve common Gorenje oven issues, including the "Loc" code, and follow the steps for quick and safe unlocking.',
    image: '/img/blog/baking-homemade-pizza-in-a-modern-oven.jpg',
    publishDate: '2026-07-16'
  },
  {
    slug: 'water-heater-popping-noises-causes-and-warning-signs',
    title: 'Water Heater Popping Noises: Causes, Fixes & Warning Signs',
    excerpt: 'Discover why your water heater makes popping, clicking, or banging noises, what causes them, and when they signal a serious fault.',
    image: '/img/blog/man-repairing-water-heater-for-a-woman-at-home.jpg',
    publishDate: '2026-06-24'
  },
  {
    slug: 'dryer-not-collecting-water-common-container-reservoir-problems',
    title: 'Why Your Dryer Is Not Collecting Water: 5 Common Causes of Container and Reservoir Problems',
    excerpt: 'Learn why your dryer is not collecting water, how to troubleshoot safely, and when to call a professional repair technician.',
    image: '/img/blog/appliance-technician-maintaining-dryer-s-lint-trap.jpg',
    publishDate: '2026-06-21'
  },
  {
    slug: 'washing-machine-wont-spin-causes',
    title: 'The Washing Machine Won\'t Spin: What Are the Causes and How to Recognise the Fault',
    excerpt: 'Find out the most common reasons a washing machine won\'t spin, what spin-cycle noise means, and when to call a technician.',
    image: '/img/blog/man-repairing-washing-machine-with-cloth-in-home.jpg',
    publishDate: '2026-05-20'
  },
  {
    slug: 'when-is-a-water-heater-dangerous',
    title: 'When Is a Water Heater Dangerous? Complete Safety and Prevention Guide',
    excerpt: 'Learn how to identify dangerous leak and pressure signs, protect your home, and decide when to repair or replace your water heater.',
    image: '/img/blog/man-repairing-water-heater.jpg',
    publishDate: '2026-05-20'
  }
];
---

<Layout title={title} description={description}>
  <section class="py-16">
    <div class="container max-w-6xl">
      <header class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{heading}</h1>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-xl text-gray-600">{subheading}</p>
      </header>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map(post => (
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="aspect-video overflow-hidden">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
                width="1280"
                height="720"
                onerror="this.onerror=null;this.src='/img/blog/default.webp';"
              />
            </div>
            <div class="p-6">
              <h2 class="text-xl font-semibold text-gray-900 mb-3 line-clamp-2">
                <a href={`/en/blog/${post.slug}/`} class="hover:text-primary transition-colors">{post.title}</a>
              </h2>
              <p class="text-sm text-gray-500 mb-3">{post.publishDate}</p>
              <p class="text-gray-600 mb-4 line-clamp-3">{post.excerpt}</p>
              <a href={`/en/blog/${post.slug}/`} class="text-primary font-medium hover:text-primary-dark transition-colors">
                Read more →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
