---
import Layout from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import Map from '../../components/Map.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'Контакти | РотоРем';
const description = 'Свържете се с РотоРем за професионален ремонт на битова техника ✓ Обслужваме София и Варна и околните райони ✓ Свържете се с нас на ☎ 089 834 0982!';
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-indigo-600 to-purple-700 text-white py-16">
    <div class="container max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Свържете се с нас
      </h1>
      <p class="text-xl md:text-2xl text-indigo-100 max-w-3xl mx-auto mb-8">
        Имате повреден уред? Свържете се с нас за професионален ремонт на битова техника във Варна, София и околните населени места.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-indigo-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Изпратете имейл
        </a>
        <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
          Обади се на 089 834 0982
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Contact Cards -->
  <section class="py-16 bg-gradient-to-b from-white to-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Как можете да се свържете с нас</h2>
        <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <!-- Phone -->
        <a href="tel:+359 89 834 0982" class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all border border-gray-100 text-center group hover:-translate-y-2">
          <div class="w-16 h-16 bg-green-500 text-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Обадете се</h3>
          <p class="text-gray-600 mb-2">089 834 0982</p>
          <p class="text-sm text-green-600 font-medium">Най-бърз начин за връзка</p>
        </a>

        <!-- Email -->
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all border border-gray-100 text-center group hover:-translate-y-2">
          <div class="w-16 h-16 bg-blue-500 text-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Имейл</h3>
          <p class="text-gray-600 mb-2 text-sm">n.ivanov.ivanov@abv.bg</p>
          <p class="text-sm text-blue-600 font-medium">За писмени запитвания</p>
        </a>

        <!-- Phone Booking -->
        <a href="tel:+359 89 834 0982" class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-all border border-gray-100 text-center group hover:-translate-y-2">
          <div class="w-16 h-16 bg-amber-500 text-white rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Телефонно записване</h3>
          <p class="text-gray-600 mb-2">089 834 0982</p>
          <p class="text-sm text-amber-600 font-medium">Достъпни всеки ден</p>
        </a>

        <!-- Emergency -->
        <div class="bg-white p-6 rounded-xl shadow-lg border border-red-200 text-center">
          <div class="w-16 h-16 bg-red-500 text-white rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Спешни случаи</h3>
          <p class="text-gray-600 mb-2">089 834 0982</p>
          <p class="text-sm text-red-600 font-medium">При аварийни ситуации</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Contact Component -->
  <Contact />

  <!-- Working Hours & Service Info -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Работно време и услуги</h2>
        <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Working Hours -->
        <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 p-8 rounded-2xl shadow-lg border border-indigo-200">
          <h3 class="text-2xl font-semibold text-indigo-900 mb-6 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mr-3 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            Работно време
          </h3>
          
          <div class="space-y-4">
            <div class="flex justify-between items-center bg-white/70 p-4 rounded-lg">
              <span class="font-medium text-indigo-900">Понеделник - Петък</span>
              <span class="font-bold text-indigo-700 bg-white px-3 py-1 rounded-full shadow-sm border border-gray-100">08:00 - 18:00</span>
            </div>
            <div class="flex justify-between items-center bg-white/70 p-4 rounded-lg">
              <span class="font-medium text-indigo-900">Събота</span>
              <span class="font-bold text-indigo-700 bg-white px-3 py-1 rounded-full shadow-sm border border-gray-100">Почивен ден</span>
            </div>
            <div class="flex justify-between items-center bg-white/70 p-4 rounded-lg">
              <span class="font-medium text-indigo-900">Неделя</span>
              <span class="font-bold text-red-600 bg-white px-3 py-1 rounded-full shadow-sm border border-gray-100">Затворено</span>
            </div>
          </div>
          
          <div class="mt-6 p-4 bg-white/50 rounded-lg">
            <p class="text-sm text-indigo-800">
              💡 <strong>Съвет:</strong> За най-бърз отговор се обадете в работните часове на 089 834 0982.
            </p>
          </div>
        </div>

        <!-- Service Information -->
        <div class="bg-gradient-to-br from-green-50 to-green-100 p-8 rounded-2xl shadow-lg border border-green-200">
          <h3 class="text-2xl font-semibold text-green-900 mb-6 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mr-3 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Информация за услугите
          </h3>
          
          <div class="space-y-4">
            <div class="bg-white/70 p-4 rounded-lg">
              <h4 class="font-semibold text-green-900 mb-2">Диагностика</h4>
              <p class="text-sm text-green-800">Само Варна - 20,46 € (40лв) | София - 25,57 € (50лв) включително посещение на място</p>
            </div>
            
            <div class="bg-white/70 p-4 rounded-lg">
              <h4 class="font-semibold text-green-900 mb-2">Време за реакция</h4>
              <p class="text-sm text-green-800">В повечето случаи - същия ден</p>
            </div>
            
            <div class="bg-white/70 p-4 rounded-lg">
              <h4 class="font-semibold text-green-900 mb-2">🛡️ Гаранция</h4>
              <p class="text-sm text-green-800">Гаранция за всички ремонти</p>
            </div>
            
            <div class="bg-white/70 p-4 rounded-lg">
              <h4 class="font-semibold text-green-900 mb-2">📍 Обслужване</h4>
              <p class="text-sm text-green-800">Варна, София и околностите (до 20км)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Component -->
  <Map />

  <!-- FAQ Section -->
  <section class="py-16 bg-gradient-to-b from-gray-50 to-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Често задавани въпроси</h2>
        <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
      </div>
      
      <div class="max-w-3xl mx-auto">
        <div class="space-y-4">
          <details class="group bg-white p-6 rounded-lg shadow-md border border-gray-200">
            <summary class="flex justify-between items-center cursor-pointer">
              <h3 class="text-lg font-semibold text-gray-900">Как мога да запазя час за ремонт?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mt-4 text-gray-700">
              <p>Можете да се свържете с нас по няколко начина:</p>
              <ul class="mt-2 list-disc list-inside space-y-1">
                <li>Обадете се на 089 834 0982 за записване</li>
                <li>Изпратете имейл на n.ivanov.ivanov@abv.bg за въпроси</li>
              </ul>
            </div>
          </details>

          <details class="group bg-white p-6 rounded-lg shadow-md border border-gray-200">
            <summary class="flex justify-between items-center cursor-pointer">
              <h3 class="text-lg font-semibold text-gray-900">Колко време отнема да дойдете на място?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mt-4 text-gray-700">
              <p>В повечето случаи можем да дойдем в същия ден, в който се обадите. За спешни случаи се опитваме да реагираме в рамките на 2-4 часа.</p>
            </div>
          </details>

          <details class="group bg-white p-6 rounded-lg shadow-md border border-gray-200">
            <summary class="flex justify-between items-center cursor-pointer">
              <h3 class="text-lg font-semibold text-gray-900">Обслужвате ли в уикендите?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mt-4 text-gray-700">
              <p>{t('contact.weekendClosedMessage')}</p>
            </div>
          </details>

          <details class="group bg-white p-6 rounded-lg shadow-md border border-gray-200">
            <summary class="flex justify-between items-center cursor-pointer">
              <h3 class="text-lg font-semibold text-gray-900">Какви са вашите цени?</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="mt-4 text-gray-700">
              <p>Диагностиката струва Варна - 20,46 € (40лв) | София - 25,57 € (50лв) и включва посещение на място, инспекция и диагностициране на проблема. Цената за ремонта се обсъжда след диагностиката.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-gradient-to-r from-indigo-600 to-purple-700 text-white">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-4">Готови сте да се свържете с нас?</h2>
      <p class="text-xl mb-8 text-indigo-100">Нуждаете се от ремонт? Не чакайте - свържете се с нас сега!</p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+359 89 834 0982" class="bg-white text-indigo-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          📞 089 834 0982
        </a>
        <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
          Обади се на 089 834 0982
        </a>
      </div>
      
      <p class="mt-6 text-indigo-200">
        Професионален сервиз • Гаранция за качество • Обслужване във Варна и София
      </p>
    </div>
  </section>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
      <h2>Ремонт на битова техника във Варна – експресен сервиз на място</h2>
      <p>Контакти за ремонт на битова техника във Варна – най-бързият начин да получите помощ за вашите домакински уреди. Ако търсите професионално обслужване и качествен ремонт на електроуреди, вие сте на правилното място. Ние от РотоРем Варна знаем колко е неприятно, когато техниката ви се повреди, затова ви осигуряваме бърза и лесна връзка с нас.</p>

      <h2>Лесни начини за контакт с нашия сервиз във Варна</h2>
      <p>Предлагаме ви различни удобни възможности, за да се свържете с нас и да получите помощ веднага:</p>
      <ul>
        <li><strong>Телефон за връзка:</strong> 089 834 0982 – винаги най-бързият начин за контакт с нашите специалисти;</li>
        <li><strong>Имейл за запитвания:</strong> n.ivanov.ivanov@abv.bg – при предпочитания за писмена комуникация;</li>
        <li><strong>Контактна форма за имейл запитвания</strong> – попълнете я и ще ви върнем обаждане за потвърждение.</li>
      </ul>

      <h2>Предимствата на контактите с РотоРем Варна</h2>
      <p>Когато се свържете с нашия екип, вие можете да разчитате на:</p>
      <ul>
        <li>Бърза и ефективна диагностика на проблема;</li>
        <li>Качествен ремонт на битовата техника още в деня на посещението;</li>
        <li>Прозрачност в ценообразуването и яснота на процеса;</li>
        <li>Удобство – нашите техници ще дойдат на място във вашия дом;</li>
        <li>Професионална грижа с гаранция за извършената работа.</li>
      </ul>

      <h2>Професионален ремонт и електроуслуги на ваше разположение</h2>
      <p>Освен ремонт на домакински електроуреди като <a title="Ремонт на перални машини Варна – експертен сервиз" href="/services/washing-machine-repair">Ремонт на перални машини Варна</a>, <a title="Ремонт на съдомиялни машини Варна – професионално обслужване" href="/services/dishwasher-repair">Ремонт на съдомиялни машини Варна</a> и <a title="Ремонт на фурни Варна – надежден ремонт на място" href="/services/oven-repair">Ремонт на фурни Варна</a>, предлагаме също и висококачествени <a title="Електроуслуги Варна – сертифицирани специалисти" href="/services/electrical-services">Електроуслуги Варна</a>. Нашите сертифицирани техници се грижат за електрическата безопасност на вашия дом.</p>

      <h2>Обслужване на Варна и околни райони – първа част от населените места</h2>
      <p>Нашият екип предоставя професионално обслужване на територията на град Варна, както и в близките населени места, включително Златни пясъци, Св. Константин и Елена, с. Кранево, с. Осеново, с. Генерал Кантарджиево, с. Орешак, с. Куманово, с. Яребична, с. Въглен и с. Каменар. Независимо къде точно се намирате в региона, можете да разчитате на бърза реакция и експертно обслужване от нашите техници.</p>

      <h2>Удобство и лекота при записване на ремонтни услуги</h2>
      <p>За ваше удобство сме създали изключително лесен процес на заявяване на услугите ни. Достатъчно е да ни позвъните на 089 834 0982 или да ни изпратите имейл. Така вашият уред ще бъде отремонтиран в удобно за вас време и без допълнителни затруднения.</p>

      <h2>Свържете се с нас още днес!</h2>
      <p>Не отлагайте повече! Ако имате нужда от ремонт на битови уреди, свържете се веднага с РотоРем Варна. Нашите техници са готови да ви помогнат и да осигурят комфорт и сигурност за дома ви. Изберете удобния за вас начин за контакт и уговорете посещение по телефона още днес!</p>

      <h2>Бърз контакт за сервиз на техника Варна – решение за спокойствие у дома</h2>
      <p>Когато уредите вкъщи внезапно спрат да работят, най-важно е да имате под ръка контактите на доверен сервиз за битова техника във Варна. Ние от РотоРем Варна сме на разположение, за да реагираме незабавно и професионално на всяко ваше запитване. Нашите опитни техници бързо отстраняват повредите, за да върнете комфорта в дома си без излишен стрес.</p>

      <h2>Няколко причини да се доверите именно на нас</h2>
      <ul>
        <li>Професионализъм – нашите техници са сертифицирани експерти с богат опит;</li>
        <li>Бърза реакция – при спешни ситуации реагираме в рамките на същия ден;</li>
        <li>Достъпност – удобни възможности за контакт и записване на час по телефон;</li>
        <li>Гаранция – всяка извършена услуга е с гарантирано качество и дълготраен резултат.</li>
      </ul>

      <h2>Допълнителни услуги за пълно обслужване на дома ви</h2>
