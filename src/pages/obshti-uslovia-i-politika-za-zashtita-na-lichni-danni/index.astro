              <tr class="bg-gray-50"><th class="text-left p-3 font-semibold border-b">Уебсайт</th><td class="p-3 border-b">https://www.rotorem.bg/</td></tr>
              <tr><th class="text-left p-3 font-semibold border-b">Телефон за контакт</th><td class="p-3 border-b">089 834 0982</td></tr>
