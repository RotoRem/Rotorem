---
import Layout from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'Отзиви и мнения от нашите доволни клиенти за РотоРем';
const description = 'Вижте какво казват клиентите за РотоРем ✓ Реални отзиви за нашите услуги в София и Варна ✓ Доказано качество и коректност ✓ Гаранция за всеки ремонт';

// Google Reviews URL
const googleReviewsUrl = "https://g.page/r/CdqG6cGsgqQzEBM/review/";

// Real Google reviews from June 2025
const reviews = [
  {
    name: 'Велизар Димов',
    date: '20 юни, 2025',
    rating: 5,
    text: 'Много много доволен ! Реагираха мигновенно,супер компетентни,проблема беше решен със съдомиялната машина.Жената доволна аз спокоен :) огромно БЛАГОДАРЯ НА ЕКИПА !',
    appliance: 'Съдомиялна',
    location: 'Варна'
  },
  {
    name: 'Мартин Иванов',
    date: '15 юни, 2025',
    rating: 5,
    text: 'Имах проблем с бойлера.След като се обадих на другия ден г-н Н.Иванов се отзова и бързо отстрани повредата.Препоръчвам!',
    appliance: 'Бойлер',
    location: 'Варна'
  },
  {
    name: 'Десислава Златева',
    date: '10 юни, 2025',
    rating: 5,
    text: 'Качествено и бързо обслужване! Препоръчвам!',
    appliance: 'Пералня',
    location: 'Варна'
  },
  {
    name: 'Елена Стоянова',
    date: '8 юни, 2025',
    rating: 5,
    text: 'Перфектно обслужване! Дойдоха в уговореното време, диагностицираха проблема бързо и го решиха на място. Пералнята работи като нова. Много съм доволна от услугата.',
    appliance: 'Пералня',
    location: 'Левски'
  },
  {
    name: 'Петър Николов',
    date: '5 юни, 2025',
    rating: 5,
    text: 'Страхотен сервиз! Съдомиялната ми не работеше повече от седмица, но те я поправиха за по-малко от час. Техникът беше много любезен и професионален.',
    appliance: 'Съдомиялна',
    location: 'Център'
  },
  {
    name: 'Анна Христова',
    date: '3 юни, 2025',
    rating: 5,
    text: 'Много съм благодарна за бързата и качествена услуга! Фурната ми спря да загрява, а те дойдоха още същия ден и я поправиха. Препоръчвам ги на всички!',
    appliance: 'Фурна',
    location: 'Вл. Варненчик'
  },
  {
    name: 'Стефан Георгиев',
    date: '1 юни, 2025',
    rating: 5,
    text: 'Отлично съотношение цена-качество! Поправиха електрическия проблем в кухнята ми бързо и професионално. Техникът обясни всичко подробно.',
    appliance: 'Електричество',
    location: 'Чайка'
  },
  {
    name: 'Надежда Иванова',
    date: '28 май, 2025',
    rating: 5,
    text: 'Много доволна от услугата! Пералнята ми течеше вода, но те намериха и поправиха проблема бързо. Работят качествено и с гаранция.',
    appliance: 'Пералня',
    location: 'Младост'
  },
  {
    name: 'Димитър Петров',
    date: '25 май, 2025',
    rating: 5,
    text: 'Перфектна работа! Съдомиялната ми не мииеше добре, но след тяхната намеса работи отлично. Препоръчвам този сервиз на всички във Варна.',
    appliance: 'Съдомиялна',
    location: 'Аспарухово'
  }
];

const averageRating = 5.0;
const totalReviews = 15;
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-green-600 to-emerald-700 text-white py-16">
    <div class="container max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Отзиви от наши клиенти
      </h1>
      <p class="text-xl md:text-2xl text-green-100 max-w-3xl mx-auto mb-8">
        Прочетете какво казват нашите доволни клиенти за качеството на нашите услуги за ремонт на битова техника във Варна.
      </p>
      
      <!-- Rating Display -->
      <div class="flex items-center justify-center mb-8">
        <div class="flex">
          {Array.from({ length: 5 }).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          ))}
        </div>
        <span class="ml-4 text-2xl font-bold">{averageRating}</span>
        <span class="ml-2 text-green-200">от {totalReviews}+ отзива</span>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-green-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Изпратете имейл
        </a>
        <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
          Обади се на 089 834 0982
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews Grid -->
  <section class="py-16">
    <div class="container max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Какво казват нашите клиенти</h2>
        <div class="w-20 h-1 bg-green-500 mx-auto"></div>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {reviews.map((review, index) => (
          <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-semibold text-lg text-gray-900">{review.name}</h3>
                <p class="text-sm text-gray-500">{review.date}</p>
                <p class="text-xs text-green-600 mt-1">{review.location}</p>
              </div>
              <div class="flex">
                {Array.from({ length: review.rating }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-yellow-500" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                ))}
              </div>
            </div>
            
            <p class="text-gray-700 mb-4 leading-relaxed">{review.text}</p>
            
            <div class="flex justify-between items-center pt-4 border-t border-gray-100">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                {review.appliance}
              </span>
              
              <span class="inline-flex items-center text-xs text-green-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                Проверен клиент
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Google Reviews CTA -->
  <section class="py-16 bg-gradient-to-r from-blue-50 to-blue-100">
    <div class="container max-w-4xl">
      <div class="bg-white p-8 rounded-2xl shadow-xl border border-blue-200">
        <div class="text-center">
          <div class="w-20 h-20 bg-blue-500 text-white rounded-full flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>
          
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Споделете вашето мнение</h2>
          <p class="text-xl text-gray-700 mb-6">
            Ако сте доволни от нашата услуга, моля споделете вашето мнение в Google
          </p>
          
          <div class="flex items-center justify-center mb-6">
            <div class="flex">
              {Array.from({ length: 5 }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-yellow-500" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                </svg>
              ))}
            </div>
            <span class="ml-3 text-yellow-600 font-semibold text-lg">5.0</span>
            <span class="ml-2 text-gray-600">(15+ отзива)</span>
          </div>
          
          <a 
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-colors shadow-lg text-lg"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 mr-3" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Напишете Google отзив
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо клиентите ни избират</h2>
        <div class="w-20 h-1 bg-green-500 mx-auto"></div>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-green-500 text-white rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold">15+</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Google отзива</h3>
          <p class="text-gray-600">Всички с 5 звезди от доволни клиенти</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-500 text-white rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold">5★</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Отлична оценка</h3>
          <p class="text-gray-600">Средна оценка 5 звезди от всички клиенти</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-500 text-white rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold">15+</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Години опит</h3>
          <p class="text-gray-600">Над 15 години опит в ремонта на битова техника</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-green-600 to-emerald-700 text-white">
    <div class="container text-center">
      <h2 class="text-3xl font-bold mb-4">Присъединете се към доволните ни клиенти</h2>
      <p class="text-xl mb-8 text-green-100">Нуждаете се от ремонт на битова техника? Свържете се с нас сега!</p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-green-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Изпратете имейл
        </a>
        <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
          Обади се на 089 834 0982
        </a>
      </div>
      
      <p class="mt-6 text-green-200">
        Посещение и диагностика: Варна - 20,46 € (40лв) | София - 25,57 € (50лв) • Гаранция за качество • Сервиз във Варна и София
      </p>
    </div>
  </section>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
      <h2>Отзиви за ремонт на уреди Варна – какво споделят нашите клиенти за експресните поправки на място</h2>
      <p>Отзиви за ремонт на уреди Варна разкриват реалната стойност на качествения сервиз и увереността, която той носи в ежедневието. Мнения за сервиз техника показват колко е важно бързото реагиране, особено когато пералнята спре внезапно или фурната откаже да загрява преди вечеря. Тук събираме впечатленията на десетки домакинства, за да откриете защо бърз ремонт на адрес с РотоРем Варна се превърна в синоним на спокойствие и сигурност.</p>

      <h2>Как клиентските мнения влияят върху избора на сервиз за техника</h2>
      <p>Когато търсите експресни поправки на място, доверявате се на хора, които вече са преминали през същото изпитание. Техните коментари ви дават ясна представа за:</p>
      <ul>
        <li>Скоростта на пристигане при авария;</li>
        <li>Професионализма на техниците и тяхното отношение;</li>
        <li>Точността на предварително обявените цени за ремонт на перални Варна и други уреди;</li>
        <li>Качество на използваните части и дълготрайност на ремонта.</li>
      </ul>

      <h3>Ключови ползи от бърз ремонт на адрес</h3>
      <p>Според нашите потребители най-ценни са минималното време без уред и фактът, че техникът идва подготвен с нужните компоненти. Изразите „ремонт на перални Варна мнения" и „ремонт на съдомиялни Варна препоръки" са сред най-търсените фрази онлайн, което доказва колко голям е интересът към гарантирано бързото обслужване.</p>

      <h2>Как събираме и проверяваме всяко клиентско впечатление</h2>
      <p>Всички коментари се удостоверяват с реален номер на поръчка, а екипът ни проверява автентичността преди публикуване. Това осигурява надежден източник за „най-добър сервиз за техника Варна", израз, който е често задаван „кой сервиз идва най-бързо до дома ми?".</p>

      <h2>Типове уреди, за които клиентите ни оставят най-много положителни отзиви</h2>
      <ul>
        <li>Перални и сушилни – бързо спиране на течове и подмяна на лагери;</li>
        <li>Съдомиялни – експресна смяна на помпи и ремонт на електроника;</li>
        <li>Фурни и котлони – настройка на термостати и монтаж на нови нагреватели;</li>
        <li>Електроуслуги – аварийно възстановяване на ток и подмяна на прекъсвачи.</li>
      </ul>

      <h3>Фактори, които клиентите посочват като решаващи</h3>
      <p>Надеждната гаранция, прозрачните ценови условия и възможността за <a title="Телефон за експресен ремонт на място" href="tel:+359 89 834 0982">бърза телефонна уговорка</a> се открояват най-често в обратната връзка. Запитвания като „сервиз за техника Варна с гаранция" и „колко струва бърз ремонт на адрес" са с висок обем търсения, затова ги интегрираме естествено в нашите страници.</p>

      <h2>Къде се доверяват клиентите ни във Варна и околността</h2>
      <p>Отзивите покриват целия град – от Чайка и Левски до Владиславово – и показват, че качеството на услугата остава постоянно независимо от локацията. Търсените от наши клиенти „отзиви за ремонт на перални в Младост" или „мнения за бърз сервиз техника Аспарухово" помагат на вас да откриете полезна информация.</p>

      <h2>Какво споделят клиентите за експресните поправки на място</h2>
      <p>Преглеждайки секцията „отзиви за сервиз техника Варна", ще забележите повтарящи се теми: точност, чистота след ремонта и приятелско отношение. Много запитвания използват формата „намери сервиз, който идва същия ден" – нещо, което нашите доволни клиенти потвърждават с реални примери.</p>

      <h2>Направете следващата крачка – споделете и вие своето мнение</h2>
