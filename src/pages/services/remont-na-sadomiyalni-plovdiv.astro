---
import Layout from '../../layouts/Base.astro';
import Reviews from '../../components/Reviews.astro';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';

const title = 'Ремонт на съдомиялни в Пловдив | РотоРем';
const description = 'Ремонт на съдомиялни в Пловдив на адрес, с диагностика на място и прозрачно ценообразуване. Смяна на помпа и нагревател. Обадете се на 089 834 0982.';

const heroImage = '/img/services/ремонт-на-съдомиялни-пловдив-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-съдомиялна-пловдив-диагностика.webp';

const accentBar = 'bg-emerald-500';
const accentLink = 'text-emerald-700';
const accentShell = 'from-emerald-50 via-white to-teal-50 border-emerald-100';
const accentBorder = 'border-emerald-100';
const tableHeader = 'bg-emerald-600';

const problems = [
  {
    title: 'Съдомиялната не загрява водата',
    text: 'Когато машината пуска вода, но тя остава студена и съдовете излизат мръсни, причината често е в нагревателния елемент. Студена вода не разтваря добре мазнините и препарата, затова съдовете излизат с петна или мазни. Освен нагревателя се проверяват температурният датчик и управлението, защото и те дават същия симптом.',
    border: 'border-emerald-500',
  },
  {
    title: 'Съдомиялната не източва водата',
    text: 'Когато водата не се източва и остава на дъното след цикъл, проблемът обикновено е в помпата. Преди смяна обаче се проверява филтърът на дъното, който често е запушен с остатъци от храна. Прегънат или запушен дренажен маркуч също спира източването.',
    border: 'border-teal-500',
  },
  {
    title: 'Съдомиялната не пълни вода',
    text: 'Програмата тръгва, но вода не влиза или влиза съвсем малко. Проверяват се кранът и входящият маркуч, филтърът на входа и входящият клапан. Причината може да е и в датчика, който следи нивото на водата.',
    border: 'border-cyan-500',
  },
  {
    title: 'Съдовете не се измиват добре',
    text: 'Остатъци от храна и петна по съдовете невинаги означават повреда. Често са запушени филтрите или дюзите на разпръскващите рамена, а варовикът също намалява налягането. Ако след почистване проблемът остава, се проверява циркулационната помпа.',
    border: 'border-green-500',
  },
  {
    title: 'Съдомиялната тече',
    text: 'Вода под машината или около вратата. Най-често е износено уплътнение на вратата, но течът може да идва и от маркуч, връзка или помпа. До ремонта е по-добре машината да не се пуска, за да не се повредят кухненските шкафове и пода.',
    border: 'border-red-500',
  },
  {
    title: 'Съдомиялната не стартира',
    text: 'Има случаи, в които уредът изобщо не стартира. Проверяват се захранването, заключването на вратата и електрониката. При вградените модели понякога вратата не се затваря докрай заради фасадата или монтажа.',
    border: 'border-amber-500',
  },
  {
    title: 'Програмата спира по средата на цикъла',
    text: 'Машината прекъсва програмата и не я завършва. Причината може да е при пълненето, източването, нагряването или в датчик. Помага да се отбележи на кой етап спира и дали излиза код за грешка.',
    border: 'border-indigo-500',
  },
  {
    title: 'Съдомиялната издава необичаен шум',
    text: 'Бучене, тракане или стържене по време на работа най-често идва от помпата или от чужд предмет, попаднал под рамото или във филтъра. Звукът и моментът, в който се появява, насочват техника към конкретната част.',
    border: 'border-purple-500',
  },
  {
    title: 'Вратата не се затваря или заключва',
    text: 'Без затворена врата програмата не тръгва. Проверяват се механизмът на заключване, пантите и пружините, а при вградените модели и монтажът на фасадата.',
    border: 'border-orange-500',
  },
  {
    title: 'Съдомиялната показва код за грешка',
    text: 'Кодът насочва диагностиката към определена система, но сам по себе си не казва коя част е за смяна. Затова техникът го съпоставя с реалната проверка на машината.',
    border: 'border-slate-500',
  },
];

const checks = [
  'филтрите и дренажната система;',
  'помпата за източване и циркулационната помпа;',
  'входящият клапан и маркучите;',
  'нагревателят и температурните датчици;',
  'разпръскващите рамена и дюзите;',
  'уплътненията и заключването на вратата;',
  'електронният модул и кодовете за грешка.',
];

const partsTable = [
  { part: 'Помпа за източване', problem: 'Водата остава на дъното' },
  { part: 'Циркулационна помпа', problem: 'Слабо измиване, вода не се разпръсква' },
  { part: 'Филтър', problem: 'Мръсни съдове, бавно източване' },
  { part: 'Дренажен маркуч', problem: 'Машината не източва' },
  { part: 'Входящ клапан', problem: 'Не пълни вода' },
  { part: 'Нагревателен елемент', problem: 'Водата остава студена' },
  { part: 'Температурен датчик', problem: 'Неправилно нагряване' },
  { part: 'Разпръскващи рамена и дюзи', problem: 'Съдовете се мият неравномерно' },
  { part: 'Уплътнение на вратата', problem: 'Теч около вратата' },
  { part: 'Заключване на вратата', problem: 'Програмата не тръгва' },
  { part: 'Електронен модул и платка', problem: 'Прекъсване, грешки, не стартира' },
];

const priceRows = [
  { service: 'Посещение и диагностика', price: '25 €' },
  { service: 'Монтаж на свободностояща съдомиялна', price: 'от 45 €' },
  { service: 'Монтаж на вградена съдомиялна', price: 'от 60 €' },
  { service: 'Демонтаж на стар уред', price: 'от 15 €' },
  { service: 'Съдомиялната не загрява водата', price: 'от 20 €' },
  { service: 'Проблем със затварянето на вратата', price: 'от 20 €' },
  { service: 'Съдомиялната не пълни вода', price: 'от 26 €' },
  { service: 'Съдомиялната не източва водата', price: 'от 26 €' },
];

const brands = ['Bosch', 'Siemens', 'Electrolux', 'Whirlpool', 'Indesit', 'Candy', 'Miele'];

const realCases = [
  {
    brand: 'Bosch',
    problem: 'Съдомиялната Bosch не източваше водата.',
    area: 'кв. Кючук Париж, Пловдив',
    diagnosis: 'Помпата за източване беше изправна, но при перката ѝ беше открито парче от счупена чаша, което блокираше работата.',
    repair: 'Отстранено е чуждото тяло и помпата е почистена. След ремонта съдомиялната източва и работи нормално.',
    image: '/img/services/ремонт-на-съдомиялна-пловдив-случай-1.webp',
    alt: 'Ремонт на съдомиялна Bosch, която не източва, с диагностика и почистване на блокирана дренажна помпа в кв. Кючук Париж, Пловдив.',
  },
  {
    brand: 'Bosch',
    problem: 'Съдомиялната не източваше водата правилно.',
    area: 'Кючук Париж, Пловдив',
    diagnosis: 'Уредът беше наклонен, за да се осигури достъп до помпата, маркучите и останалите компоненти в долната част. При проверката беше установено частично запушване в системата за източване.',
    repair: 'Извършено е почистване на системата за източване и проверка на помпата и връзките. След ремонта съдомиялната източва водата и работи нормално.',
    image: '/img/services/ремонт-на-съдомиялна-пловдив-случай-2.webp',
    alt: 'Диагностика и ремонт на съдомиялна Bosch, наклонена за достъп до помпата и вътрешните компоненти, в кв. Кючук Париж, Пловдив.',
  },
  {
    brand: 'Bosch',
    problem: 'Съдомиялната работеше, но съдовете оставаха недобре измити след края на програмата.',
    area: 'Тракия, Пловдив',
    diagnosis: 'При проверката беше установен проблем в електрическото захранване към циркулационната помпа, което пречеше на нормалната циркулация на водата по време на измиване.',
    repair: 'Възстановено е захранването към циркулационната помпа и е направен тест на уреда. След ремонта съдомиялната работи нормално и измива съдовете коректно.',
    image: '/img/services/ремонт-на-съдомиялна-пловдив-случай-3.webp',
    alt: 'Ремонт на съдомиялна Bosch с проблем в захранването на циркулационната помпа в кв. Христо Ботев, Пловдив.',
  },
];

const processSteps = [
  { step: 1, text: 'Свързвате се с РотоРем и описвате проблема. Ако има код за грешка, кажете и него.', circleClass: 'bg-gradient-to-r from-emerald-500 to-emerald-600' },
  { step: 2, text: 'Уговаряме посещение на адреса в Пловдив.', circleClass: 'bg-gradient-to-r from-teal-500 to-teal-600' },
  { step: 3, text: 'Техникът прави диагностика.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 4, text: 'Получавате информация каква е повредата и какво ще се ремонтира.', circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600' },
  { step: 5, text: 'Ремонт и тест на съдомиялната на място.', circleClass: 'bg-gradient-to-r from-emerald-600 to-teal-700' },
];

const faqs = getServiceFaqItems('/services/remont-na-sadomiyalni-plovdiv/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} image={heroImage} hideServiceFaq={true}>
  <article>
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на съдомиялна на адрес в Пловдив"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/85 via-emerald-900/75 to-emerald-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на съдомиялни по домовете в Пловдив
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-8 leading-relaxed">
            РотоРем Пловдив извършва ремонт на съдомиялни машини на адрес, с диагностика на място и смяна на компоненти като нагревателен елемент и помпа, без да се налага превозване на уреда до сервиз. Екипът идва в дома или офиса, установява повредата и обяснява на място какво трябва да се направи. Обадете се на <a href="tel:0898340982" class="font-semibold text-white hover:underline">089 834 0982</a> за диагностика на място в Пловдив.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xl font-bold text-white">Диагностика в Пловдив - 25 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-sm text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт и диагностика на съдомиялни на адрес</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>Съдомиялните машини са тежки и трудни за пренасяне, а демонтажът и превозването им до сервиз често отнемат повече време от самия ремонт. Затова РотоРем работи по домовете в Пловдив, като диагностиката се извършва директно на адреса на клиента.</p>
            <p>РотоРем предлага професионален ремонт на съдомиялни като част от услугите си за <a href="/services/plovdiv/" class={`${accentLink} font-medium hover:underline`}>сервиз за бяла техника в Пловдив</a>.</p>
            <p>Освен ремонт на съдомиялни, РотоРем Пловдив извършва и <a href="/services/remont-na-furni-plovdiv/" class={`${accentLink} font-medium hover:underline`}>ремонт на фурни</a> на адрес, със същия подход на диагностика и ремонт в дома на клиента.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на съдомиялни в Пловдив"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти" prioritizeAppliance="Съдомиялна" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви повреди на съдомиялни ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <p class="text-center text-gray-800 leading-relaxed mb-8 max-w-3xl mx-auto">Съдомиялната спира да работи по различни причини и симптомите обикновено подсказват къде е проблемът.</p>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">Всеки от тези симптоми изисква отделен оглед, защото една и съща повреда може да се дължи на различни причини при различни модели.</p>
      </section>

      <section class={sectionClass} aria-labelledby="plovdiv-dw-pricing">
        <div class="text-center mb-8">
          <h2 id="plovdiv-dw-pricing" class="text-3xl font-bold text-gray-900 mb-4">Цени за ремонт на съдомиялни в Пловдив</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-gray-800 leading-relaxed mb-8">
          <p>Цената на ремонта се съобщава след диагностика на място, преди да започне каквато и да е работа по уреда.</p>
          <p>Цените са ориентировъчни за труд и не включват стойността на резервните части.</p>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-4 sm:p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="md:hidden space-y-3">
            {priceRows.map((row) => (
              <div class={`rounded-xl border ${accentBorder} bg-white p-4 shadow-sm`}>
                <p class="font-medium text-gray-900 mb-2">{row.service}</p>
                <p class="text-xl font-bold text-emerald-700">{row.price}</p>
              </div>
            ))}
          </div>
          <div class="hidden md:block overflow-hidden rounded-xl border border-white/60 bg-white shadow-md">
            <table class="w-full text-left">
              <thead>
                <tr class={`${tableHeader} text-white`}>
                  <th scope="col" class="px-5 py-4 text-sm font-semibold">Услуга / проблем</th>
                  <th scope="col" class="px-5 py-4 text-sm font-semibold text-right">Цена (EUR)</th>
                </tr>
              </thead>
              <tbody>
                {priceRows.map((row, index) => (
                  <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                    <td class="px-5 py-4 text-sm text-gray-800">{row.service}</td>
                    <td class="px-5 py-4 text-sm font-bold text-emerald-700 text-right whitespace-nowrap">{row.price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика на съдомиялни в Пловдив</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p>Диагностиката има за цел да открие причината, преди да се сменя каквото и да е. В зависимост от симптома се проверяват:</p>
          <ul class="list-disc pl-5 space-y-2">
            {checks.map((item) => <li>{item}</li>)}
          </ul>
          <p>След проверката клиентът научава каква е повредата и какъв ремонт е нужен.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на съдомиялната, които проверяваме и ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <p class="text-gray-800 leading-relaxed text-center max-w-4xl mx-auto mb-8">След диагностиката екипът подменя износените или повредени части. Най-честите намеси при съдомиялни машини са смяна на нагревателен елемент на съдомиялна, когато уредът не загрява вода, и смяна на помпа на съдомиялна, когато водата не се източва правилно. И двете операции се извършват на място, без да се налага машината да напуска дома на клиента.</p>
        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>
        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Какъв проблем причинява най-често</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
