      <!-- Common Problems Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Най-чести електрически проблеми във Варна</h2>
          <div class="w-20 h-1 bg-yellow-500 mx-auto"></div>
        </div>
        
        <div class="bg-gradient-to-r from-red-50 via-white to-red-50 p-8 rounded-2xl shadow-xl border border-red-100">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
              <h3 class="text-lg font-semibold text-red-900 mb-3">Няма ток в стаята</h3>
              <p class="text-red-800">Изгорели предпазители, прекъснати автомати или повреди в инсталацията. Бърза диагностика и решаване.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-yellow-500">
              <h3 class="text-lg font-semibold text-yellow-900 mb-3">Не работят прекъсвачи</h3>
              <p class="text-yellow-800">Повредени прекъсвачи, контакти или окабеляване. Смяна и ремонт с качествени материали.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
