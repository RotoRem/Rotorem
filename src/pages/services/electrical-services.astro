---
import Layout from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'Електроуслуги Варна | Професионален сервиз | RotoRem';
const description = 'Електроуслуги във Варна ✓ Монтаж и ремонт ✓ Сертифицирани инженери ✓ Обслужване в същия ден ✓ Всички видове работи ✓ Електротехник Варна ☎ 089 834 0982';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-yellow-600 to-amber-700 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Електроуслуги Варна
        </h1>
        <p class="text-xl md:text-2xl text-yellow-100 max-w-3xl mx-auto mb-8">
          Професионални електроуслуги във Варна от сертифицирани инженери. Монтаж, ремонт и поддръжка на електрически инсталации.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+359 89 834 0982" class="bg-white text-yellow-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            📞 089 834 0982
          </a>
          <a href="tel:+359 89 834 0982" class="bg-orange-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-orange-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">
      <!-- Schema for Service Page -->
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Електроуслуги Варна",
        "description": "Професионални електроуслуги във Варна - монтаж и ремонт на електрически инсталации, контакти, прекъсвачи и осветление.",
        "url": "https://www.rotorem.bg/услуги/електроуслуги",
        "provider": {
          "@type": "LocalBusiness",
          "name": "РотоРем Варна",
          "telephone": "+359 89 834 0982",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Варна",
            "addressCountry": "BG"
          }
        },
        "areaServed": [
          {"@type": "City", "name": "Варна"},
          {"@type": "Place", "name": "Чайка"},
          {"@type": "Place", "name": "Младост"},
          {"@type": "Place", "name": "Аспарухово"}
        ],
        "serviceType": "Electrical Service",
        "offers": {
          "@type": "Offer",
          "price": "30",
          "priceCurrency": "BGN",
          "description": "Оглед такса"
        }
      }
      </script>

      <!-- Why Choose Us Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете нашите електроуслуги във Варна?</h2>
          <div class="w-20 h-1 bg-yellow-500 mx-auto"></div>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-yellow-200">
            <div class="w-12 h-12 bg-yellow-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <line x1="3" x2="21" y1="9" y2="9"/>
                <line x1="9" x2="9" y1="21" y2="9"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-yellow-900 mb-3">Сертифицирани инженери</h3>
            <p class="text-yellow-800">Всички електроуслуги се извършват от сертифицирани електроинженери с многогодишен опит във Варна.</p>
          </div>

          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Бързо обслужване</h3>
            <p class="text-amber-800">В повечето случаи извършваме електроуслугите в същия ден във Варна. Бързо и качествено изпълнение.</p>
          </div>

          <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-orange-200">
            <div class="w-12 h-12 bg-orange-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-orange-900 mb-3">Безопасност и гаранция</h3>
            <p class="text-orange-800">Всички електроуслуги във Варна се извършват по стандартите за безопасност с гаранция за качество.</p>
          </div>

          <div class="bg-gradient-to-br from-lime-50 to-lime-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-lime-200">
            <div class="w-12 h-12 bg-lime-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-lime-900 mb-3">Обслужваме цяла Варна</h3>
            <p class="text-lime-800">Предоставяме електроуслуги в кварталите: Чайка, Младост, Аспарухово, Левски, Владислав Варненчик и центъра.</p>
          </div>

          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-emerald-200">
            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14.5 4h-5L7 12h4l-1 8 6-11h-4l2-5z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-emerald-900 mb-3">Всички видове работи</h3>
            <p class="text-emerald-800">Извършваме всички видове електроуслуги - от смяна на контакт до цялостни инсталации.</p>
          </div>

