---
import Layout from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'Електроуслуги и аварийни ел. ремонти във Варна';
const description = 'Ел услуги във Варна от опитни техници ✓ Ремонт на ел инсталация ✓ Монтаж на контакти и осветителни тела ✓ Гаранция за сигурност ✓ Позвънете на ☎ 089 834 0982!';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-yellow-600 to-amber-700 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Електроуслуги Варна
