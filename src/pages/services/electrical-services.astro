      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Електроуслуги, които предлагаме във Варна</h2>
          <div class="w-20 h-1 bg-yellow-500 mx-auto"></div>
        </div>
        
