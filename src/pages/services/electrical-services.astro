                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Диагностика:</span> {item.diagnosis}</p>
                  {item.repair && (
                    <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Ремонт:</span> {item.repair}</p>
                  )}
                </div>
              </article>
            ))}
          </div>
          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden max-w-5xl mx-auto">
            <img src={realCases[2].image} alt={realCases[2].alt} class="w-full lg:w-2/5 object-cover min-h-[240px]" loading="lazy" width="560" height="400" />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].title}</h3>
              <p class="text-gray-800"><span class="font-semibold">Проблем:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Район:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Диагностика:</span> {realCases[2].diagnosis}</p>
              {realCases[2].repair && (
                <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Ремонт:</span> {realCases[2].repair}</p>
