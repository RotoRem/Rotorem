---
import Layout from '../../layouts/Base.astro';
import Reviews from '../../components/Reviews.astro';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const title = 'Електро услуги във Варна | Електротехник на адрес | РотоРем';
const description = 'Електро услуги във Варна на адрес – диагностика, контакти, ключове, осветление, ел. табла, кабели и отстраняване на електрически повреди. РотоРем.';

const heroImage = '/img/services/ремонт-на-ел-услуги-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-ел-услуги-варна-диагностика.webp';

const serviceCategories = [
  {
    title: 'Контакти и прекъсвачи',
    text: 'Монтаж на нови прекъсвачи и контакти, смяна на стари или повредени механизми и ремонт при разхлабен, искрящ или неработещ контакт. Преди подмяна се проверяват връзките и проводниците.',
    items: ['монтаж на нови прекъсвачи', 'смяна на стари прекъсвачи', 'поставяне на контакти', 'ремонт на контакти и прекъсвачи'],
    border: 'border-amber-500',
  },
  {
    title: 'Осветление',
    text: 'Монтаж на полилеи и LED осветление, външно и аварийно осветление. При проблем се проверяват връзката, драйверът при LED система и ключът.',
    items: ['монтаж на полилеи', 'LED осветление', 'външно осветление', 'аварийно осветление'],
    border: 'border-yellow-500',
  },
  {
    title: 'Домашни инсталации',
    text: 'Изграждане на нови електрически инсталации, ремонт на съществуващи, смяна на кабели и работа по електрическото табло.',
    items: ['нови електрически инсталации', 'ремонт на инсталации', 'смяна на кабели', 'електрически табла'],
    border: 'border-orange-500',
  },
  {
    title: 'Малки уреди',
    text: 'Ремонт на малки електроуреди, смяна на захранващи кабели и щепсели и диагностика преди ремонт или подмяна на компонент.',
    items: ['ремонт на малки уреди', 'смяна на кабели', 'ремонт на щепсели', 'диагностика на устройства'],
    border: 'border-lime-600',
  },
  {
    title: 'Аварийни ремонти',
    text: 'Спешни електрически ремонти при късо съединение, липса на ток или проблем с таблото. Засегнатата верига остава изключена до проверката, когато това може да бъде направено безопасно.',
    items: ['спешни електрически ремонти', 'отстраняване на къси съединения', 'възстановяване на тока', 'аварийни ремонти на табла'],
    border: 'border-red-500',
  },
];

const pricingRows = [
  { service: 'Посещение и диагностика във Варна', eur: '20 €', featured: true },
  { service: 'Смяна на контакт', eur: 'По договаряне' },
  { service: 'Монтаж на контакт', eur: 'По договаряне' },
  { service: 'Смяна на ключ', eur: 'По договаряне' },
  { service: 'Монтаж на ключ', eur: 'По договаряне' },
  { service: 'Монтаж на осветително тяло', eur: 'По договаряне' },
  { service: 'Смяна на автоматичен прекъсвач', eur: 'По договаряне' },
  { service: 'Диагностика на електрическо табло', eur: 'По договаряне' },
  { service: 'Откриване на късо съединение', eur: 'По договаряне' },
  { service: 'Частична подмяна на кабел', eur: 'По договаряне' },
];

const partsTable = [
  { part: 'Контакт', problem: 'Няма ток, загрява или искри' },
  { part: 'Ключ', problem: 'Осветлението не работи' },
  { part: 'Автоматичен прекъсвач', problem: 'Изключва или не подава ток' },
  { part: 'ДТЗ', problem: 'Изключва при утечка' },
  { part: 'Електрическо табло', problem: 'Прекъсване, нагряване или повредена връзка' },
  { part: 'Кабел / проводник', problem: 'Прекъсване или прегряване' },
  { part: 'Клема / връзка', problem: 'Лош контакт или нагряване' },
  { part: 'Разклонителна кутия', problem: 'Проблем с връзките' },
  { part: 'Осветителна верига', problem: 'Лампите не работят или мигат' },
  { part: 'LED драйвер', problem: 'LED осветлението работи неправилно' },
];

const realCases = [
  {
    title: 'Контакт без ток',
    problem: 'Контактът няма ток / пада предпазителят',
    area: 'Център',
    diagnosis: 'Контактът няма ток / пада предпазителят',
    repair: undefined as string | undefined,
    image: '/img/services/ремонт-на-ел-услуги-варна-случай-1.webp',
    alt: 'Контактът няма ток в Център, Варна',
  },
  {
    title: 'Напрежение на контакт и ключове',
    problem: 'Липса на напрежение на контакт, ключ за бойлер и ключ за осветление',
    area: 'Чайка',
    diagnosis: 'Оказаха се нагорели кабели вследствие на лоша/разхлабена връзка.',
    repair: 'Подменени са контактът, ключът за бойлер и ключът за осветление.',
    image: '/img/services/ремонт-на-ел-услуги-варна-случай-2.webp',
    alt: 'Проблем с липса на напрежение на контакт, ключ за бойлер и ключ за осветление в Чайка, Варна',
  },
  {
    title: 'Липса на електрозахранване',
    problem: 'Липса на електрозахранване към контакт, бойлерен ключ и ключ за осветление',
    area: 'Левски',
    diagnosis: 'При проверката бяха установени прегорели проводници, причинени от разхлабени електрически връзки.',
    repair: 'Подменени са повредените контакт, бойлерен ключ и ключ за осветление и са възстановени електрическите връзки.',
    image: '/img/services/ремонт-на-ел-услуги-варна-случай-3.webp',
    alt: 'Ремонт на контакт, бойлерен ключ и ключ за осветление при липса на електрозахранване в кв. Левски, Варна.',
  },
];

const processSteps = [
  { step: 1, title: 'Свързвате се с РотоРем', text: 'Опишете проблема по телефона.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 2, title: 'Уговаряме посещение', text: 'Техник посещава посочения адрес във Варна според уговорката.', circleClass: 'bg-gradient-to-r from-yellow-500 to-yellow-600' },
  { step: 3, title: 'Диагностика и измерване', text: 'Проверява се съответната електрическа верига и се локализира причината.', circleClass: 'bg-gradient-to-r from-orange-500 to-orange-600' },
  { step: 4, title: 'Получавате информация', text: 'Обясняваме какъв проблем е установен и каква работа е необходима.', circleClass: 'bg-gradient-to-r from-amber-600 to-amber-700' },
  { step: 5, title: 'Ремонт или монтаж', text: 'Извършва се необходимата работа и системата се проверява след ремонта.', circleClass: 'bg-gradient-to-r from-yellow-600 to-yellow-700' },
];

const faqs = getServiceFaqItems('/services/electrical-services/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="el-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Електротехник на адрес във Варна"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-amber-950/85 via-amber-900/75 to-yellow-900/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Електро услуги на адрес във Варна
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Електро услуги по домовете във Варна
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Нямате ток в част от жилището, контактът искри, осветлението прекъсва или предпазителят изключва? РотоРем предлага електро услуги във Варна за диагностика, ремонт и монтаж по домашни електрически инсталации.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            Проверяваме причината за проблема преди смяна на контакт, ключ, автоматичен прекъсвач, кабел или друг компонент.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Диагностика във Варна</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика и електро услуги на адрес</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>Преди ремонт трябва да бъде установено къде действително се намира проблемът. Диагностиката може да включва проверка за наличие на напрежение, измерване, проверка на контакти, ключове, осветителни вериги, автоматични прекъсвачи, табло, токови кръгове, връзки, късо съединение и кабели.</p>
            <p class="font-semibold text-gray-900">Посещение и диагностика във Варна: 20 €</p>
          </div>
          <div>
            <img src={diagnosticImage} alt="Диагностика на електрическа инсталация във Варна" class="w-full rounded-2xl shadow-lg object-cover" loading="lazy" width="600" height="450" />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви ел услуги извършваме</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {serviceCategories.map((cat) => (
            <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${cat.border}`}>
              <h3 class="text-lg font-semibold text-gray-900 mb-3">{cat.title}</h3>
              <p class="text-gray-800 leading-relaxed mb-3">{cat.text}</p>
              <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
                {cat.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <section class={sectionClass} aria-labelledby="el-pricing-heading">
        <div class="text-center mb-10">
          <h2 id="el-pricing-heading" class="text-3xl font-bold text-gray-900 mb-4">Цени за електро услуги във Варна</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {pricingRows.map((row) => (
            <div class:list={['rounded-xl border p-5 shadow-sm', row.featured ? 'border-amber-300 bg-amber-50/50' : 'border-gray-200 bg-white']}>
              <p class="font-semibold text-gray-900 mb-1">{row.service}</p>
              <p class="text-gray-800">{row.eur}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-amber-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-amber-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Услуга</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Цена</th>
              </tr>
            </thead>
            <tbody>
              {pricingRows.map((row, index) => (
                <tr class:list={['border-t border-gray-100', row.featured ? 'bg-amber-50/80' : index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.service}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.eur}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Важно: Крайната цена зависи от конкретната повреда, необходимата работа, достъпа до инсталацията и използваните материали. След проверката клиентът получава информация за необходимата работа и цената.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на електрическата инсталация</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-amber-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>
        <div class="hidden md:block overflow-hidden rounded-xl border border-amber-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-amber-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част / система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Често свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          При електрическите повреди видимият симптом невинаги показва директно кой компонент е проблемен. Причината се определя чрез проверка и измерване.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Монтаж и ремонт на контакти</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>РотоРем извършва диагностика, монтаж и подмяна на домашни контакти. При физическа повреда, разхлабен механизъм или следи от прегряване се проверяват и проводниците зад контакта преди поставяне на нов.</p>
          <p>При монтаж на нов контакт първо се преценява съществуващата инсталация и откъде може правилно да бъде захранена новата точка. При контакти с проблем при голям товар загряването не трябва да се приема като нормално.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ключове и осветление</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>При повреден ключ за осветление могат да бъдат проверени механизмът, връзките, проводниците и осветителната линия. При монтаж на осветителни тела се проверяват електрическите връзки, механичното закрепване и работата след монтажа.</p>
          <p>При LED осветление проблемът невинаги е в самата лампа – проверяват се LED модулът, драйверът, захранването, връзките и ключът.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Електрически табла и защитни устройства</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>Електрическото табло разпределя и защитава различните токови кръгове. При проблем могат да бъдат проверени автоматичните прекъсвачи, ДТЗ, връзки, клеми, проводници и отделни кръгове.</p>
          <p>Автоматичен прекъсвач не се сменя с по-голям само защото изключва – първо се установява защо защитата се задейства. При многократно изключване на защита се локализира причината преди подмяна.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Късо съединение, кабели и аварийни проблеми</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-amber-50 via-white to-amber-50 p-6 md:p-8 rounded-2xl shadow-lg border border-amber-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>При съмнение за късо съединение се проверява съответната верига, докато бъде локализирано мястото или компонентът, който причинява проблема. Когато няма ток, но предпазителите са включени, причината може да бъде в прекъсната връзка, проводник, защитно устройство или точка в таблото.</p>
          <p>При миризма на изгоряло, видимо искрене, силно загряващ контакт или многократно изключващ предпазител, засегнатата верига трябва да остане изключена до проверката, когато това може да бъде направено безопасно.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Реални електрически ремонти във Варна</h2>
          <div class="w-20 h-1 bg-amber-500 mx-auto"></div>
        </div>
        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
                <img src={item.image} alt={item.alt} class="w-full md:w-2/5 object-cover min-h-[220px]" loading="lazy" width="480" height="360" />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.title}</h3>
