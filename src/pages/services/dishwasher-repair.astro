---
import Layout from '../../layouts/Base.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import Reviews from '../../components/Reviews.astro';
import { getServicePricing } from '../../data/service-prices';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const pricing = getServicePricing('dishwasher', 'varna', lang);

const title = 'Ремонт на съдомиялни във Варна | Сервиз на адрес | РотоРем';
const description =
  'Ремонт и диагностика на съдомиялни по домовете във Варна. Проблеми с източване, пълнене, нагряване, течове, помпи, врата и електроника. РотоРем.';

const heroImage = '/img/services/ремонт-на-съдомиялна-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-съдомиялна-варна-диагностика.webp';
const builtInImage = '/img/services/ремонт-на-съдомиялна-варна-вградена.webp';
const freestandingImage = '/img/services/ремонт-на-съдомиялна-варна-свободностояща.webp';

const accentBar = 'bg-emerald-500';
const accentLink = 'text-emerald-700';
const accentShell = 'from-emerald-50 via-white to-teal-50 border-emerald-100';
const accentBorder = 'border-emerald-100';
const tableHeader = 'bg-emerald-600';

const problems = [
  {
    title: 'Съдомиялната не източва водата',
    text: 'Ако след края на програмата на дъното на съдомиялната остава вода, причината може да бъде запушен филтър, проблем по дренажния път, прегънат или запушен маркуч или неизправност на помпата за източване. При диагностиката първо се установява откъде идва проблемът, вместо директно да се пристъпва към смяна на помпа.',
    border: 'border-emerald-500',
  },
  {
    title: 'Съдомиялната не пълни вода',
    text: 'Когато програмата стартира, но в машината не постъпва достатъчно вода, се проверяват водоподаването и компонентите, които контролират пълненето. Причината може да бъде свързана с входящия маркуч, филтър, входящ клапан, датчик или друга част от системата.',
    border: 'border-teal-500',
  },
  {
    title: 'Съдомиялната не загрява водата',
    text: 'Ако съдовете остават студени или мокри след програмата, трябва да бъде проверена нагревателната система. В зависимост от модела проблемът може да бъде свързан с нагревателя, температурен датчик, електронното управление или друг компонент, участващ в контрола на температурата. Диагностиката показва дали действително е необходима подмяна на нагревател или причината е друга.',
    border: 'border-green-500',
  },
  {
    title: 'Съдомиялната не мие добре',
    text: 'Остатъци от храна, петна или недобре измити съдове невинаги означават сериозна повреда. Проверяват се филтрите, разпръскващите рамена и дюзите, циркулацията на водата и други компоненти, които влияят върху измиването. Натрупванията от мазнини и варовик също могат да повлияят на работата на машината.',
    border: 'border-lime-600',
  },
  {
    title: 'Съдомиялната тече',
    text: 'Водата може да се появи под машината, около вратата или при определен етап от програмата. Причината може да бъде свързана с уплътнението на вратата, маркуч, връзка, помпа или друг компонент от водната система. При видим теч е добре използването на машината да бъде прекратено до установяване на причината.',
    border: 'border-red-500',
  },
  {
    title: 'Съдомиялната не стартира',
    text: 'Когато машината има захранване, но програмата не започва, се проверяват компонентите, които участват в стартирането и управлението на цикъла. Проблемът може да бъде свързан със заключването на вратата, електронното управление, захранването или друг електрически компонент.',
    border: 'border-cyan-500',
  },
  {
    title: 'Програмата спира преди да завърши',
    text: 'Прекъсването по средата на програмата може да бъде свързано с проблем при пълненето, източването, нагряването, датчик или електронното управление. Важно е да се установи в кой момент от цикъла машината спира, защото това помага при диагностиката.',
    border: 'border-indigo-500',
  },
  {
    title: 'Съдомиялната издава необичаен шум',
    text: 'Шумът може да идва от циркулационната или дренажната помпа, разпръскващо рамо, чужд предмет или друг движещ се компонент. Видът и моментът на появата на шума помагат да се определи коя система трябва да бъде проверена.',
    border: 'border-violet-500',
  },
  {
    title: 'Вратата не се затваря или заключва',
    text: 'Проблем със затварянето може да попречи на машината изобщо да стартира. Проверяват се механизмът на вратата, заключването, пантите и правилното позициониране на уреда. При вградените съдомиялни трябва да се провери и дали монтажът и мебелната фасада не пречат на правилното затваряне.',
    border: 'border-orange-500',
  },
  {
    title: 'Съдомиялната показва код за грешка',
    text: 'Кодът за грешка дава важна насока при диагностиката, но не означава автоматично, че определена част трябва да бъде сменена. Техникът съпоставя кода със симптомите на машината и проверява съответната система, преди да се определи необходимият ремонт.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Помпа за източване', problem: 'В машината остава вода' },
  { part: 'Циркулационна помпа', problem: 'Слаба или липсваща циркулация' },
  { part: 'Филтър', problem: 'Лошо измиване или проблем с източването' },
  { part: 'Дренажен маркуч', problem: 'Машината не източва правилно' },
  { part: 'Входящ клапан', problem: 'Съдомиялната не пълни вода' },
  { part: 'Нагревателна система', problem: 'Водата не загрява' },
  { part: 'Температурен датчик', problem: 'Неправилно нагряване' },
  { part: 'Разпръскващи рамена', problem: 'Съдовете не се измиват равномерно' },
  { part: 'Дюзи', problem: 'Намалена циркулация на водата' },
  { part: 'Уплътнение на вратата', problem: 'Теч около вратата' },
  { part: 'Заключване на вратата', problem: 'Машината не стартира' },
  { part: 'Електронен модул', problem: 'Програмата прекъсва или не стартира' },
  { part: 'Управляваща платка', problem: 'Различни проблеми при управлението' },
];

const realCases = [
  {
    brand: 'Miele',
    problem: 'Съдомиялната не се включваше',
    area: 'Левски',
    diagnosis: 'Установихме проблем с основната платка на машината.',
    repair: 'След смяна на платката машината работи нормално.',
    image: builtInImage,
    alt: 'Ремонт на съдомиялна Miele, която не се включва поради повреда в основната платка, с подмяна на платката в кв. Левски, Варна.',
  },
  {
    brand: 'Bosch',
    problem: 'Съдомиялната не измиваше съдовете',
    area: 'Христо Ботев',
    diagnosis: 'Проблем със захранването на циркулационната помпа на машината.',
    repair: 'Ново захранване беше монтирано.',
    image: diagnosticImage,
    alt: 'Ремонт на съдомиялна Bosch, която не измива съдовете поради проблем със захранването на циркулационната помпа, в кв. Христо Ботев, Варна.',
  },
  {
    brand: 'Bosch',
    problem: 'Съдомиялната показваше грешка „Communication Error“',
    area: 'Христо Ботев',
    diagnosis: 'Проблем в една от платките на машината.',
    repair: 'Платката беше отремонтирана успешно и сега машината работи нормално.',
    image: '/img/services/ремонт-на-съдомиялна-варна-случай-3.webp',
    alt: 'Ремонт на съдомиялна Bosch с грешка „Communication Error“, причинена от проблем в електронна платка, в кв. Христо Ботев, Варна.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Свързвате се с РотоРем',
    text: 'Опишете как се проявява проблемът. Ако машината показва код за грешка, кажете и него.',
    circleClass: 'bg-gradient-to-r from-emerald-500 to-emerald-600',
  },
  {
    step: 2,
    title: 'Уговаряме посещение',
    text: 'Техник посещава адреса във Варна според уговорката.',
    circleClass: 'bg-gradient-to-r from-teal-500 to-teal-600',
  },
  {
    step: 3,
    title: 'Диагностика',
    text: 'Проверяват се системите и компонентите, които могат да причинят конкретния симптом.',
    circleClass: 'bg-gradient-to-r from-green-500 to-green-600',
  },
  {
    step: 4,
    title: 'Получавате информация за ремонта',
    text: 'Обясняваме какво е установено и какво трябва да бъде ремонтирано или подменено.',
    circleClass: 'bg-gradient-to-r from-cyan-500 to-cyan-600',
  },
  {
    step: 5,
    title: 'Ремонт и тест',
    text: 'При възможност ремонтът се извършва на място. След приключване машината се тества.',
    circleClass: 'bg-gradient-to-r from-emerald-600 to-teal-700',
  },
];

const brands = ['Bosch', 'Siemens', 'Electrolux', 'Whirlpool', 'Indesit', 'Candy', 'Miele'];

const faqs = getServiceFaqItems('/services/dishwasher-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dishwasher-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на съдомиялна на адрес във Варна"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-950/85 via-emerald-900/75 to-emerald-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес във Варна
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на съдомиялни по домовете във Варна
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Съдомиялната не източва, не загрява водата, не стартира или съдовете остават мръсни след програмата?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            РотоРем извършва диагностика и ремонт на съдомиялни по домовете във Варна. Техник посещава адреса, проверява уреда и установява причината за проблема, преди да бъде предприет ремонт или подмяна на част.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Диагностика във Варна</p>
              <p class="text-xl font-bold text-white">20,46 € / 40 лв.</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт и диагностика на съдомиялни на адрес</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            При съдомиялните един и същ симптом може да има повече от една причина. Машина, която не източва например, може да има запушване, проблем с филтъра, дренажния маркуч или помпата. При липса на нагряване причината също не е задължително само в нагревателя. Затова ремонтът започва с проверка на конкретния проблем.
          </p>
          <p>
            В зависимост от симптома техникът може да провери системата за подаване и източване на вода, филтрите, помпите, нагревателната система, разпръскващите рамена, уплътненията, вратата, датчиците и електронното управление.
          </p>
          <p>
            Когато повредата позволява, ремонтът се извършва на адрес. Ако е необходима специфична резервна част, клиентът получава информация какво е установено и какво трябва да бъде подменено.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Съдомиялна" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви повреди на съдомиялни ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="emerald" /></div>}

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика на съдомиялни във Варна</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Диагностиката има за цел да установи причината за проблема преди подмяната на части.
            </p>
            <p class="font-medium text-gray-900">Според симптома могат да бъдат проверени:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>филтри;</li>
              <li>дренажна система;</li>
              <li>помпа за източване;</li>
              <li>циркулационна помпа;</li>
              <li>входящ клапан;</li>
              <li>входящ и дренажен маркуч;</li>
              <li>нагревателна система;</li>
              <li>температурни датчици;</li>
              <li>разпръскващи рамена;</li>
              <li>дюзи;</li>
              <li>уплътнения;</li>
              <li>механизъм и заключване на вратата;</li>
              <li>електронен модул;</li>
              <li>управляваща платка;</li>
              <li>видими кодове за грешки.</li>
            </ul>
            <p>
              След проверката клиентът получава информация каква повреда е установена и какъв ремонт е необходим.
            </p>
            <p class="font-semibold text-gray-900">Посещение и диагностика във Варна: 20,46 € / 40 лв.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на съдомиялна във Варна"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на съдомиялната, които проверяваме и ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Често свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Не е необходимо всеки симптом да означава повредена част. Запушване, неправилна връзка или проблем в друга система може да доведе до сходно поведение, затова конкретният ремонт се определя след диагностика.
        </p>
      </section>

      <!-- Pumps -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Помпи и проблеми с циркулацията на водата</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>
            Съдомиялната използва различни системи за движение и отвеждане на водата по време на програмата. Затова проблем с помпа може да се прояви по различен начин – машината да не източва, да мие слабо, да издава необичаен шум или да прекъсва програмата.
          </p>
          <p>
            При диагностиката се проверява дали проблемът идва от помпата, запушване, чужд предмет или друг компонент от системата. Подмяна на помпа се извършва, когато проверката покаже, че това действително е причината за неизправността.
          </p>
        </div>
      </section>

      <!-- Installation -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
