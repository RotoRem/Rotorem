        "url": "https://www.rotorem.bg/услуги/ремонт-съдомиялни-машини",
        "provider": {
          "@type": "LocalBusiness",
          "name": "РотоРем Варна",
          "telephone": "+359 89 834 0982",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Варна",
            "addressCountry": "BG"
          }
        },
        "areaServed": [
          {"@type": "City", "name": "Варна"},
          {"@type": "Place", "name": "Чайка"},
          {"@type": "Place", "name": "Младост"},
          {"@type": "Place", "name": "Аспарухово"}
        ],
        "serviceType": "Appliance Repair",
        "offers": {
          "@type": "Offer",
          "price": "30",
          "priceCurrency": "BGN",
          "description": "Диагностика"
        }
      }
      </script>

      <!-- Why Choose Us Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете нашия сервиз за съдомиялни машини във Варна?</h2>
          <div class="w-20 h-1 bg-emerald-500 mx-auto"></div>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-emerald-200">
            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-emerald-900 mb-3">Бърз ремонт на място</h3>
            <p class="text-emerald-800">Нашият техник идва директно във вашия дом във Варна, за да ремонтира съдомиялната машина. Не е нужно да демонтирате уреда.</p>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-green-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-green-200">
