---
import Layout from '../../layouts/Base.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import Reviews from '../../components/Reviews.astro';
import { getServicePricing } from '../../data/service-prices';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const pricing = getServicePricing('dryer', 'varna', lang);

const title = 'Ремонт на сушилни във Варна | Сервиз на адрес | РотоРем';
const description =
  'Ремонт и диагностика на сушилни по домовете във Варна. Проблеми с нагряване, термопомпа, барабан, ремък, помпа, шум и електроника. РотоРем.';

const heroImage = '/img/services/ремонт-на-сушилня-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-сушилня-варна-диагностика.webp';

const accentBar = 'bg-fuchsia-500';
const accentLink = 'text-fuchsia-700';
const accentShell = 'from-fuchsia-50 via-white to-purple-50 border-fuchsia-100';
const accentBorder = 'border-fuchsia-100';
const tableHeader = 'bg-fuchsia-600';

const problems = [
  {
    title: 'Сушилнята не загрява',
    text: 'Когато барабанът се върти, но дрехите остават студени и влажни, проблемът може да бъде свързан с нагревателя, термостат, температурен датчик, електронно управление или друга част от системата за нагряване. При сушилните с термопомпа причината може да бъде различна от тази при стандартните кондензни модели, затова първо се проверява конкретната система.',
    border: 'border-fuchsia-500',
  },
  {
    title: 'Сушилнята работи, но не суши добре',
    text: 'По-дългото време за сушене невинаги означава сериозна повреда. Причината може да бъде намален въздушен поток, замърсени филтри, проблем с кондензатора, температурен датчик, вентилатор или друга част от системата. При моделите с термопомпа се проверяват и компонентите, свързани с работата на тази система.',
    border: 'border-purple-500',
  },
  {
    title: 'Барабанът не се върти',
    text: 'Ако програмата стартира, но барабанът остава неподвижен, се проверяват ремъкът, моторът, ролките, лагерите и механичното движение на барабана. Скъсан ремък е една от възможните причини, но не е единствената.',
    border: 'border-pink-500',
  },
  {
    title: 'Сушилнята не стартира',
    text: 'Когато машината не реагира или програмата не започва, могат да бъдат проверени захранването, механизмът на вратата, електронният модул, програматорът и останалите компоненти, свързани със стартирането.',
    border: 'border-violet-500',
  },
  {
    title: 'Сушилнята спира по време на програмата',
    text: 'Прекъсването може да бъде свързано с прегряване, температурни датчици, недостатъчен въздушен поток, мотор, електроника или защитна система. Важно е да се установи в кой момент спира сушилнята и дали показва код за грешка.',
    border: 'border-rose-500',
  },
  {
    title: 'Сушилнята издава силен шум',
    text: 'Бучене, стържене, свирене или удари могат да бъдат свързани с ролки, лагери, мотор, барабан или чужд предмет. Типът на шума и моментът, в който се появява, дават важна информация при диагностиката.',
    border: 'border-indigo-500',
  },
  {
    title: 'Сушилнята вибрира',
    text: 'Прекалените вибрации могат да бъдат свързани с нивелирането на уреда, барабана, ролките, лагерите или друга механична част. При сушилня, поставена върху пералня, трябва да се провери и стабилността на монтажа.',
    border: 'border-teal-500',
  },
  {
    title: 'Сушилнята не събира или не отвежда водата',
    text: 'При кондензните модели проблемът може да бъде свързан с помпата, резервоара за конденз, маркуча или друга част от системата за отвеждане на водата. При модели, свързани директно към канализация, се проверява и дренажната връзка.',
    border: 'border-cyan-500',
  },
  {
    title: 'Вратата не се затваря или сушилнята не отчита затварянето',
    text: 'Ако машината не разпознава, че вратата е затворена, програмата може изобщо да не стартира. Проверяват се заключващият механизъм, датчикът на вратата и механичното затваряне.',
    border: 'border-orange-500',
  },
  {
    title: 'Сушилнята показва код за грешка',
    text: 'Кодът за грешка помага да се насочи диагностиката към определена система, но не доказва сам по себе си коя част трябва да бъде сменена. Техникът съпоставя кода с поведението на машината и проверява съответните компоненти.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Нагревател', problem: 'Сушилнята не загрява' },
  { part: 'Термостат', problem: 'Липса на нагряване или прегряване' },
  { part: 'Температурен датчик', problem: 'Неправилна температура' },
  { part: 'Датчик за влажност', problem: 'Програмата приключва твърде рано или късно' },
  { part: 'Ремък', problem: 'Барабанът не се върти' },
  { part: 'Ролки', problem: 'Шум или неправилно движение на барабана' },
  { part: 'Лагери', problem: 'Силен шум при работа' },
  { part: 'Мотор', problem: 'Барабанът не се върти' },
  { part: 'Вентилатор', problem: 'Намален въздушен поток' },
  { part: 'Филтър', problem: 'Дълго сушене / прегряване' },
  { part: 'Кондензатор', problem: 'Намалена ефективност' },
  { part: 'Помпа', problem: 'Водата не се отвежда' },
  { part: 'Заключване на вратата', problem: 'Машината не стартира' },
  { part: 'Електронен модул', problem: 'Прекъсване или проблем с програмите' },
  { part: 'Термопомпа', problem: 'Ниска ефективност или липса на сушене' },
];

const diagnosticChecks = [
  'нагревател;',
  'термостати;',
  'температурни датчици;',
  'датчик за влажност;',
  'барабан;',
  'ремък;',
  'ролки;',
  'лагери;',
  'мотор;',
  'вентилатор;',
  'филтри;',
  'кондензатор;',
  'помпа за кондензна вода;',
  'маркучи;',
  'механизъм на вратата;',
  'електронен модул;',
  'управляваща платка;',
  'система с термопомпа;',
  'видими кодове за грешки.',
];

const realCases = [
  {
    brand: 'AEG',
    problem: 'Сушилня не изсушава добре дрехите',
    area: 'Младост',
    diagnosis: 'Установихме, че сушилнята е много замърсена.',
    repair: 'След извършена профилактика и почистване на компресорен блок сушилнята работи като нова.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-1.webp',
    alt: 'Профилактика и почистване на сушилня AEG, която не изсушава добре дрехите поради силно замърсен компресорен блок в кв. Младост, Варна.',
  },
  {
    brand: 'Bosch',
    problem: 'Не се завърташе барабанът',
    area: 'Левски',
    diagnosis: 'Установихме, че има скъсан ремък на мотора, който задвижва барабана.',
    repair: 'След подмяната му сушилнята работи нормално.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-2.webp',
    alt: 'Ремонт на сушилня Bosch с незавъртащ се барабан и подмяна на скъсан задвижващ ремък в кв. Левски, Варна.',
  },
  {
    brand: 'BEKO',
    problem: 'Активираше се защитата от прегряване на сушилнята.',
    area: 'Център',
    diagnosis: 'Установихме, че няма циркулация на въздух поради замърсяване.',
    repair: 'След почистването заработи нормално и вече не показваше никаква грешка.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-3.webp',
    alt: 'Ремонт на сушилня BEKO със задействана защита от прегряване поради липса на въздушна циркулация в Център, Варна.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Свързвате се с РотоРем',
    text: 'Опишете как се проявява проблемът. Ако има код за грешка, кажете и него.',
    circleClass: 'bg-gradient-to-r from-fuchsia-500 to-fuchsia-600',
  },
  {
    step: 2,
    title: 'Уговаряме посещение',
    text: 'Техник посещава адреса във Варна според уговорката.',
    circleClass: 'bg-gradient-to-r from-purple-500 to-purple-600',
  },
  {
    step: 3,
    title: 'Диагностика',
    text: 'Проверяват се компонентите и системите, които могат да причинят конкретния проблем.',
    circleClass: 'bg-gradient-to-r from-pink-500 to-pink-600',
  },
  {
    step: 4,
    title: 'Информация за ремонта',
    text: 'Клиентът получава информация каква повреда е установена и какво трябва да бъде направено.',
    circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600',
  },
  {
    step: 5,
    title: 'Ремонт и тест',
    text: 'При възможност ремонтът се извършва на място, след което сушилнята се тества.',
    circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600',
  },
];

const brands = ['AEG', 'Bosch', 'Whirlpool', 'Beko', 'Indesit', 'Samsung', 'LG', 'Electrolux'];

const faqs = getServiceFaqItems('/services/dryer-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dryer-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на сушилня на адрес във Варна"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-purple-950/85 via-fuchsia-900/75 to-purple-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес във Варна
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на сушилни по домовете във Варна
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Сушилнята не загрява, не изсушава добре дрехите, барабанът не се върти или машината прекъсва по време на програмата?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            РотоРем извършва диагностика и ремонт на сушилни по домовете във Варна. Работим с кондензни сушилни и модели с термопомпа, като първо установяваме причината за проблема, преди да се пристъпи към ремонт или подмяна на компонент.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Диагностика във Варна</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт и диагностика на сушилни на адрес</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            При сушилните един и същ симптом може да има различни причини.
          </p>
          <p>
            Машина, която не суши добре например, може да има проблем с въздушния поток, филтрите, нагревателната система, температурен датчик или термопомпата. Ако барабанът не се върти, причината може да бъде ремък, мотор, ролки или друга механична част.
          </p>
          <p>
            Затова ремонтът започва с диагностика на системите, които са свързани с конкретния симптом.
          </p>
          <p>
            В зависимост от модела и проблема техникът може да провери нагревателя, термостатите, температурните датчици, ремъка, барабана, ролките, лагерите, мотора, вентилатора, помпата, кондензната система, термопомпата и електронното управление.
          </p>
          <p>
            Когато повредата позволява, ремонтът се извършва на адрес.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Сушилня" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви повреди на сушилни ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Pricing — higher on the page -->
      {pricing && (
        <div class={sectionClass}>
          <ServicePricing pricing={pricing} accent="purple" />
          <p class="mt-6 text-center text-gray-800 leading-relaxed max-w-3xl mx-auto">
            Крайната цена зависи от установената повреда, необходимия труд и използваните резервни части. Клиентът получава информация за ремонта след диагностика.
          </p>
        </div>
      )}

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика на сушилни във Варна</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-start">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Диагностиката има за цел да установи причината за проблема преди подмяната на части.
            </p>
            <p class="font-medium text-gray-900">В зависимост от симптома могат да бъдат проверени:</p>
            <ul class="list-disc pl-5 space-y-1.5 columns-1 sm:columns-2 gap-x-8">
              {diagnosticChecks.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p>
              След проверката клиентът получава информация какво е установено и какъв ремонт е необходим.
            </p>
            <p class="font-semibold text-gray-900">Диагностика във Варна: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на сушилня във Варна"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на сушилнята, които проверяваме и ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част / система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Често свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Не всеки симптом означава повредена част. Замърсен филтър, ограничен въздушен поток или друг проблем в системата може да причини сходно поведение, затова конкретният ремонт се определя след диагностика.
        </p>
      </section>

      <!-- Heat pump -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт на сушилни с термопомпа</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>
            Сушилните с термопомпа работят по различен начин от стандартните модели с нагревател и използват затворена система за повторно използване на топлината.
          </p>
          <p>
            Когато такъв уред започне да суши значително по-бавно, не достига необходимата температура или прекъсва програмата, причината може да бъде свързана с въздушния поток, датчици, вентилатор, кондензна система или компоненти на термопомпата.
          </p>
          <p>
