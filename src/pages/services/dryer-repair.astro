---
import Layout from '../../layouts/Base.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import Reviews from '../../components/Reviews.astro';
import { getServicePricing } from '../../data/service-prices';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const pricing = getServicePricing('dryer', 'varna', lang);

const title = 'Ремонт на сушилни във Варна | Сервиз на адрес | РотоРем';
const description =
  'Ремонт и диагностика на сушилни по домовете във Варна. Проблеми с нагряване, барабан, ремък, термопомпа, източване и електроника. Обадете се на РотоРем.';

const heroImage = '/img/services/ремонт-на-сушилня-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-сушилня-варна-диагностика.webp';

const accentBar = 'bg-fuchsia-500';
const accentLink = 'text-fuchsia-700';
const accentShell = 'from-fuchsia-50 via-white to-purple-50 border-fuchsia-100';
const accentBorder = 'border-fuchsia-100';
const tableHeader = 'bg-fuchsia-600';

const problems = [
  {
    title: 'Сушилнята не загрява',
    text: 'Когато програмата завърши, а дрехите остават студени, причината може да бъде нагревател, термостат, сензори, електронен модул или друга част от системата за нагряване. При сушилни с термопомпа проблемът не винаги е в класическия нагревател, затова диагностиката започва от реалното поведение на уреда.',
    border: 'border-fuchsia-500',
  },
  {
    title: 'Дрехите не се изсушават добре',
    text: 'Влажни или частично сухи дрехи могат да означат проблем с въздушния поток, филтъра, системата за кондензиране, сензорите за влажност или електронното управление. Проверяват се и условията на натоварване, но ако проблемът се повтаря, е нужна техническа диагностика.',
    border: 'border-purple-500',
  },
  {
    title: 'Барабанът не се върти',
    text: 'Ако сушилнята стартира, но барабанът не се движи, могат да бъдат проверени ремъкът, моторът, ролките, електрониката и механичната част на барабана. Причината може да е сравнително малка, но е важно уредът да не се форсира, докато не се установи повредата.',
    border: 'border-pink-500',
  },
  {
    title: 'Сушилнята не стартира',
    text: 'Когато уредът не реагира или програмата не тръгва, проверката може да включва захранването, заключването на люка, управляващата платка и останалите електронни компоненти. Не всяка сушилня, която „не тръгва“, има повредена платка – диагностиката започва от конкретния симптом.',
    border: 'border-violet-500',
  },
  {
    title: 'Сушилнята спира по време на цикъл',
    text: 'Прекъсване на програмата може да бъде свързано с прегряване, сензори, проблем в системата за източване на конденз, електроника или механична част. Техникът проверява какво показва дисплеят и как се държи уредът преди ремонт.',
    border: 'border-rose-500',
  },
  {
    title: 'Сушилнята шуми или вибрира',
    text: 'Силен шум, удари или необичайни вибрации могат да идват от износени ролки, лагери, ремък, чужд предмет в барабана или неправилно позициониране. Характерът на шума дава първа насока, но окончателната причина се установява след проверка.',
    border: 'border-indigo-500',
  },
  {
    title: 'Сушилнята не източва водата',
    text: 'При кондензни модели и част от сушилните с термопомпа може да остане вода в резервоара или системата за източване. Проверяват се маркучи, помпа, филтър и свързаните компоненти според конструкцията на машината.',
    border: 'border-teal-500',
  },
  {
    title: 'Мирише на изгоряло или прегряване',
    text: 'Такъв симптом изисква внимание – препоръчително е сушилнята да не се използва до преглед. Възможни причини са проблем с нагревател, въздушен поток, електрически компонент или натрупване на fluff, което ограничава охлаждането.',
    border: 'border-red-500',
  },
  {
    title: 'Лукът или вратата не се отварят',
    text: 'Блокираният люк може да е свързан с заключващ механизъм, остатъчна топлина, програмата или електроника. Не е препоръчително вратата да се отваря със сила, защото това може да повреди механизма.',
    border: 'border-orange-500',
  },
  {
    title: 'Сушилнята показва код за грешка',
    text: 'Кодовете за грешка помагат при диагностиката, но един код невинаги означава, че конкретна част трябва директно да бъде сменена. Техникът съпоставя информацията от дисплея с реалното поведение на уреда и проверките на съответните системи.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Нагревател', problem: 'Сушилнята не загрява' },
  { part: 'Термостат и сензори', problem: 'Неправилно нагряване или прекъсване' },
  { part: 'Мотор и ремък', problem: 'Барабанът не се върти' },
  { part: 'Ролки и лагери', problem: 'Шум и проблем с въртенето' },
  { part: 'Филтър и въздушен поток', problem: 'Лошо изсушаване' },
  { part: 'Помпа и източване', problem: 'Остава вода при кондензни модели' },
  { part: 'Кондензатор / теплообменник', problem: 'Проблеми при кондензно изсушаване' },
  { part: 'Система с термопомпа', problem: 'Слабо или липсващо нагряване при heat pump модели' },
  { part: 'Заключване на люка', problem: 'Машината не стартира или люкът остава блокиран' },
  { part: 'Електронен модул', problem: 'Прекъсване, грешки или неправилна програма' },
  { part: 'Температурен и влажностен датчик', problem: 'Непълно или прекалено сушене' },
  { part: 'Вентилация и маркучи', problem: 'Проблеми при отвеждащи модели' },
];

const realCases = [
  {
    brand: 'AEG',
    problem: 'Не изсушаваше добре дрехите',
    area: 'Младост',
    diagnosis: 'Установихме, че сушилнята е много замърсена.',
    repair: 'След извършена профилактика и почистване на компресорен блок сушилнята работи като нова.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-1.webp',
    alt: 'Профилактика и почистване на сушилня AEG, която не изсушава добре дрехите поради силно замърсен компресорен блок в кв. Младост, Варна.',
  },
  {
    brand: 'Bosch',
    problem: 'Не се завърташе барабанът',
    area: 'Левски',
    diagnosis: 'Установихме, че има скъсан ремък на мотора, който задвижва барабана.',
    repair: 'След подмяната му сушилнята работи нормално.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-2.webp',
    alt: 'Ремонт на сушилня Bosch с незавъртащ се барабан и подмяна на скъсан задвижващ ремък в кв. Левски, Варна.',
  },
  {
    brand: 'BEKO',
    problem: 'Активираше се защитата от прегряване',
    area: 'Център',
    diagnosis: 'Установихме, че няма циркулация на въздух поради замърсяване.',
    repair: 'След почистването заработи нормално и вече не показваше никаква грешка.',
    image: '/img/services/ремонт-на-сушилня-варна-случай-3.webp',
    alt: 'Ремонт на сушилня BEKO със задействана защита от прегряване поради липса на въздушна циркулация в Център, Варна.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Свързвате се с РотоРем',
    text: 'Опишете какъв проблем има сушилнята и как се проявява.',
    circleClass: 'bg-gradient-to-r from-fuchsia-500 to-fuchsia-600',
  },
  {
    step: 2,
    title: 'Уговаряме посещение',
    text: 'Техник посещава адреса във Варна според уговорката.',
    circleClass: 'bg-gradient-to-r from-purple-500 to-purple-600',
  },
  {
    step: 3,
    title: 'Извършваме диагностика',
    text: 'Проверяват се компонентите и системите, свързани с конкретния симптом.',
    circleClass: 'bg-gradient-to-r from-pink-500 to-pink-600',
  },
  {
    step: 4,
    title: 'Получавате информация за ремонта',
    text: 'Обясняваме каква повреда е установена и какво трябва да бъде направено.',
    circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600',
  },
  {
    step: 5,
    title: 'Ремонт и тест',
    text: 'При възможност ремонтът се извършва на място и сушилнята се тества преди приключване на посещението.',
    circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600',
  },
];

const brands = ['Bosch', 'Siemens', 'AEG', 'Electrolux', 'Gorenje', 'Samsung', 'LG', 'Beko', 'Indesit', 'Whirlpool', 'Candy', 'Miele'];

const faqs = getServiceFaqItems('/services/dryer-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dryer-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на сушилня на адрес във Варна"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-purple-950/85 via-fuchsia-900/75 to-purple-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес във Варна
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на сушилни по домовете във Варна
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Проблем със сушилнята? РотоРем извършва диагностика и ремонт на сушилни по домовете във Варна. Работим при проблеми с нагряване, барабан, ремък, термопомпа, източване, шум и електроника.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            Техник посещава адреса, установява причината за повредата и ви информира какъв ремонт е необходим преди извършването му.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Диагностика във Варна</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт и диагностика на сушилни на адрес</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            При повреда на сушилнята първата задача е да се установи откъде действително идва проблемът. Един и същ симптом може да бъде причинен от различни компоненти – нагревател, сензори, ремък, електроника или система с термопомпа – затова не препоръчваме подмяна на части преди диагностика.
          </p>
          <p>
            При посещението техникът проверява състоянието на сушилнята според конкретния проблем: нагряване, въздушен поток, барабан, източване, филтри, електроника и останалите системи, свързани със симптома.
          </p>
          <p>
            Когато ремонтът може да бъде извършен на място, той се прави по време на посещението. При необходимост от специфична резервна част клиентът предварително получава информация какво трябва да бъде подменено. Можете да видите и <a href="/reviews/" class={`${accentLink} font-medium hover:underline`}>отзиви от клиенти на РотоРем</a>.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Сушилня" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви повреди на сушилни ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="purple" /></div>}

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика на сушилни във Варна</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Диагностиката е отделна част от ремонта и има за цел да установи причината за повредата, преди да се подменят части.
            </p>
            <p class="font-medium text-gray-900">В зависимост от симптома и типа сушилня могат да бъдат проверени:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>нагревателят и термостатът;</li>
              <li>сензорите за температура и влажност;</li>
              <li>моторът, ремъкът и ролките;</li>
              <li>барабанът и механичното движение;</li>
              <li>филтърът и въздушният поток;</li>
              <li>системата за източване на конденз;</li>
              <li>компоненти на термопомпата (достъпни при диагностика);</li>
              <li>заключването на люка;</li>
              <li>електронният модул и управлението.</li>
            </ul>
            <p>
              След проверката клиентът получава информация какво е установено и какъв ремонт е необходим.
            </p>
            <p class="font-semibold text-gray-900">Цена за диагностика във Варна: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на сушилня във Варна"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на сушилнята, които проверяваме и ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Често свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Не е необходимо всяка повреда да води до смяна на част. В много случаи диагностиката показва друг проблем в системата, затова конкретният ремонт се определя след проверка.
        </p>
      </section>

      <!-- Heat pump -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт на сушилни с термопомпа</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>
            Сушилните с термопомпа имат различна конструкция от класическите модели с директно нагряване. При диагностика могат да бъдат проверени сензори, електроника, филтри, въздушен поток и други достъпни компоненти на системата.
          </p>
          <p>
            РотоРем не обещава ремонт на херметично запечатан компресор. След преглед техникът информира какво е установено и дали ремонтът е технически и икономически оправдан за конкретния модел.
          </p>
          <p>
            При повтарящи се проблеми с нагряване или прекъсване на програмата е важно уредът да бъде диагностициран според типа му, а не само по симптом, общ за различни видове сушилни.
          </p>
        </div>
      </section>

      <!-- Belt and drum -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремък, барабан и механика на сушилнята</h2>
