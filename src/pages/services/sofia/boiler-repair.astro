  },
  {
    "service": "Теч",
    "price": "След диагностика"
  },
  {
    "service": "Проблем с предпазител",
    "price": "След диагностика"
  },
  {
    "service": "Почистване",
    "price": "След диагностика"
  },
  {
    "service": "Монтаж",
    "price": "След уточняване"
  },
  {
    "service": "Демонтаж",
    "price": "След уточняване"
  }
];

const realCases = [
  {
    "brand": "Бойлер Tesy",
    "problem": "Липса на електрозахранване към контакт, бойлерен ключ и ключ за осветление.",
    "area": "Център",
    "diagnosis": "При проверката бяха установени прегорели проводници, причинени от разхлабени електрически връзки.",
    "repair": "Подменени са повредените контакт, бойлерен ключ и ключ за осветление и са възстановени електрическите връзки.",
    "image": "/img/services/ремонт-на-бойлер-софия-случай-1.webp",
    "alt": "Ремонт на контакт, бойлерен ключ и ключ за осветление при липса на електрозахранване на бойлер Tesy в Център, София"
  },
  {
