      <!-- Process -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Процес на ремонт на бойлери в София</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-teal-500 to-teal-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">1</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Вие ни звъните</h3>
              <p class="text-gray-700">Обадете се на 089 834 0982 за ремонт на бойлер в София.</p>
            </div>
          </div>
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ние идваме при вас</h3>
              <p class="text-gray-700">Нашият техник пристига на адрес и извършва пълна диагностика с ясна оферта.</p>
