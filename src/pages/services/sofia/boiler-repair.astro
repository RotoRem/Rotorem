const processSteps = [
  {
    "step": 1,
    "title": "Свързвате се с РотоРем",
    "text": "Описвате симптома — липса на топла вода, теч, шум или друг проблем.",
    "circleClass": "bg-gradient-to-r from-teal-500 to-teal-600"
  },
  {
    "step": 2,
    "title": "Уговаряме посещение",
    "text": "Техник посещава посочения адрес.",
    "circleClass": "bg-gradient-to-r from-emerald-500 to-emerald-600"
  },
  {
    "step": 3,
    "title": "Диагностика",
    "text": "Проверяват се компонентите, свързани с конкретния проблем.",
    "circleClass": "bg-gradient-to-r from-amber-500 to-amber-600"
  },
  {
    "step": 4,
    "title": "Информация за ремонта",
    "text": "Обясняваме какво е установено и какъв ремонт е необходим.",
    "circleClass": "bg-gradient-to-r from-cyan-500 to-cyan-600"
  },
  {
    "step": 5,
    "title": "Ремонт и тест",
    "text": "След ремонта бойлерът се проверява за нормална и безопасна работа.",
    "circleClass": "bg-gradient-to-r from-teal-600 to-teal-700"
  }
];

const brands = ["TESY","Ariston","Atlantic","Eldom","Diplomat","Gorenje","AEG","Beko"];

const faqs = getServiceFaqItems('/services/sofia/boiler-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="boiler-service-page">
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на бойлер на адрес в София"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-teal-950/85 via-teal-900/75 to-teal-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес в София
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на бойлери в София
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Бойлерът не загрява, загрява бавно, тече, изключва предпазителя или издава необичаен шум?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            РотоРем извършва диагностика, ремонт, монтаж и демонтаж на електрически бойлери по домовете в София и около града.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Посещение и диагностика</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика и ремонт на бойлери</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>Преди подмяна на част се установява причината за проблема.</p>
            <p>При липса на топла вода могат да бъдат проверени нагревателят, термостатът, термозащитата и електрическите връзки. При теч се проверяват фланецът, уплътненията, връзките и състоянието на уреда.</p>
            <p>Ремонтът на бойлери е част от услугите на РотоРем за <a href="/services/sofia/" class="text-teal-700 font-medium hover:underline">ремонт на битова техника в София</a>.</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на бойлер в София"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Бойлер" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви проблеми с бойлери ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-teal-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Бойлерът не загрява</h3>
                <p class="text-gray-800 leading-relaxed">Проверяват се нагревателят, термостатът, термозащитата и управлението.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-emerald-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Бойлерът загрява бавно</h3>
                <p class="text-gray-800 leading-relaxed">Причината може да бъде свързана с нагревателя, натрупвания или температурния контрол.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Бойлерът тече</h3>
                <p class="text-gray-800 leading-relaxed">Проверяват се фланецът, уплътненията, връзките и водосъдържателят.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Бойлерът изключва предпазителя</h3>
                <p class="text-gray-800 leading-relaxed">Проверяват се електрическите компоненти и изолацията.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-cyan-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Бойлерът издава шум или пукане</h3>
                <p class="text-gray-800 leading-relaxed">Причината може да бъде свързана с натрупвания, нагряването или друг технически проблем.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Няма достатъчно топла вода</h3>
                <p class="text-gray-800 leading-relaxed">Проверяват се нагревателят, термостатът и настройките.</p>
              </div>
              <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-slate-500">
                <h3 class="text-lg font-semibold mb-3 text-gray-900">Бойлерът не се включва</h3>
                <p class="text-gray-800 leading-relaxed">Проверяват се захранването, термозащитата и електрическите компоненти.</p>
              </div>
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какво проверяваме при диагностиката</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">В зависимост от симптома могат да бъдат проверени:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>нагревателят</li>
            <li>термостатът</li>
            <li>термозащитата</li>
            <li>фланецът</li>
            <li>уплътненията</li>
            <li>предпазният клапан</li>
            <li>електрическите връзки</li>
            <li>захранването</li>
            <li>управлението</li>
            <li>магнезиевият анод</li>
            <li>състоянието на водосъдържателя</li>
          </ul>
          <p>Първо се установява причината за конкретната неизправност и след това се определя необходимият ремонт.</p>
          <p class="font-semibold text-gray-900">Посещение и диагностика: {diagnosticPrice}</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на бойлера, които проверяваме и ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Не е необходимо всяка повреда да води до смяна на част. В много случаи диагностиката показва друг проблем в системата, затова конкретният ремонт се определя след проверка.
        </p>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Бойлерът не загрява водата</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>При липса на топла вода не се приема автоматично, че нагревателят е изгорял.</p>
          <p>Проверяват се нагревателят, термостатът, термозащитата, електрическите връзки и захранването.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Теч от бойлера</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p><a href="/blog/koga-e-opasen-boilerat/" class="text-teal-700 font-medium hover:underline">Течът</a> трябва да бъде проверен възможно най-скоро.</p>
          <p>Водата може да идва от фланеца, уплътнението, предпазния клапан, връзките или водосъдържателя.</p>
          <p>При някои повреди трябва да се прецени дали ремонтът е безопасен и икономически оправдан.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Странен шум или пукане от бойлера</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>Необичаен шум по време на нагряване може да бъде свързан с натрупвания, работата на нагревателя, движението на водата или друга техническа причина.</p>
          <p>Ако бойлерът започне да издава <a href="/blog/stranen-shum-ili-pukane-ot-boilera-na-kakvo-mozhe-da-se-dalzhi/" class="text-teal-700 font-medium hover:underline">странен шум или пукане</a>, промяната в поведението на уреда не трябва да бъде пренебрегвана.</p>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Натрупвания в бойлера</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
