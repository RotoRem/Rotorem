---
import Layout from '../../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'Ремонт и монтаж на бойлери в София | Сервиз РотоРем';
const description = 'Сервиз за ремонт на бойлери в София с бързо обслужване на адрес ✓ Професионален монтаж и демонтаж ✓ Гаранция за качество ✓ Свържете се с нас на ☎ 089 834 0982!';
