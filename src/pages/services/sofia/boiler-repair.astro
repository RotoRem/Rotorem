          {"@type": "City", "name": "София"},
          {"@type": "Place", "name": "Лозенец"},
          {"@type": "Place", "name": "Младост"},
          {"@type": "Place", "name": "Люлин"},
          {"@type": "Place", "name": "Студентски град"},
          {"@type": "Place", "name": "Център"}
