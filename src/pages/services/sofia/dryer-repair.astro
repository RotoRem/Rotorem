---
import Layout from '../../../layouts/Base.astro';
import Reviews from '../../../components/Reviews.astro';
import { getServiceFaqItems } from '../../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const title = 'Ремонт на сушилни в София | На адрес | РотоРем';
const description =
  'Ремонт и диагностика на сушилни по домовете в София. Проблеми с нагряване, сушене, барабан, ремък, конденз и други повреди. Диагностика 30 €.';

const heroImage = '/img/services/ремонт-на-сушилня-софия-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-сушилня-софия-диагностика.webp';
const diagnosticPrice = '30 €';

const accentBar = 'bg-fuchsia-500';
const accentLink = 'text-fuchsia-700';
const accentShell = 'from-fuchsia-50 via-white to-purple-50 border-fuchsia-100';
const accentBorder = 'border-fuchsia-100';
const tableHeader = 'bg-fuchsia-600';

const problems = [
  { title: 'Сушилнята не загрява', text: 'Ако барабанът се върти, но дрехите остават студени и влажни, се проверяват компонентите и системите, които осигуряват необходимата температура.', border: 'border-fuchsia-500' },
  { title: 'Сушилнята не суши добре', text: 'Причината може да бъде свързана с филтрите, въздушния поток, нагряването, температурните датчици, датчиците за влажност или друга част от процеса на сушене.', border: 'border-purple-500' },
  { title: 'Барабанът не се върти', text: 'Проверяват се ремъкът, двигателят, ролките, барабанът и свързаните механични компоненти.', border: 'border-pink-500' },
  { title: 'Сушилнята не се включва', text: 'Проверяват се захранването и компонентите, свързани със стартирането и управлението на уреда.', border: 'border-violet-500' },
  { title: 'Сушилнята не стартира програмата', text: 'Проверяват се вратата, заключването, управлението и останалите условия, необходими за стартиране.', border: 'border-rose-500' },
  { title: 'Сушилнята спира по време на работа', text: 'Проверява се кога машината прекъсва програмата и дали има промяна в температурата, въртенето на барабана или поведението на дисплея.', border: 'border-indigo-500' },
  { title: 'Сушилнята работи прекалено дълго', text: 'Причината може да бъде ограничен въздушен поток, замърсени филтри, проблем с нагряването, датчик или друг компонент.', border: 'border-teal-500' },
  { title: 'Сушилнята издава силен шум', text: 'Стържене, тропане, свирене или друг необичаен шум може да бъде свързан с барабана, ролките, ремъка, двигателя или друг движещ се компонент.', border: 'border-red-500' },
  { title: 'Сушилнята вибрира', text: 'Проверяват се поставянето и стабилността на машината, барабанът и механичните компоненти.', border: 'border-orange-500' },
  { title: 'Сушилнята не събира вода в контейнера', text: 'Проверяват се системата за отвеждане на конденза, помпата, маркучите и свързаните компоненти.', border: 'border-amber-500' },
  { title: 'Вратата не се затваря', text: 'Проверяват се механичното затваряне, заключващият механизъм и отчитането на състоянието на вратата.', border: 'border-lime-600' },
  { title: 'Сушилнята показва код за грешка', text: 'Кодът се разглежда заедно със симптомите и действителното поведение на машината.', border: 'border-slate-500' },
];

const partsTable = [
  { part: 'Ремък', problem: 'Барабанът не се върти' },
  { part: 'Двигател', problem: 'Проблем с въртенето' },
  { part: 'Ролки', problem: 'Шум или проблем с движението' },
  { part: 'Нагревателна система', problem: 'Сушилнята не загрява' },
  { part: 'Температурни датчици', problem: 'Неправилна температура' },
  { part: 'Датчици за влажност', problem: 'Неправилно отчитане на сушенето' },
  { part: 'Филтри', problem: 'Намален въздушен поток' },
  { part: 'Въздушна система', problem: 'Бавно или неефективно сушене' },
  { part: 'Помпа за конденз', problem: 'Проблем с отвеждането на водата' },
  { part: 'Система за конденз', problem: 'Проблем със събирането на вода' },
  { part: 'Термопомпена система', problem: 'Проблем с нагряването или сушенето' },
  { part: 'Компресор', problem: 'Проблем в термопомпената система' },
  { part: 'Заключване на вратата', problem: 'Програмата не стартира' },
  { part: 'Електронно управление', problem: 'Проблем с програмите или работата' },
];

const pricingRows = [
  { service: 'Посещение и диагностика', price: '30 €' },
  { service: 'Сушилнята не загрява', price: 'След диагностика' },
  { service: 'Сушилнята не суши добре', price: 'След диагностика' },
  { service: 'Барабанът не се върти', price: 'След диагностика' },
  { service: 'Проблем с ремъка', price: 'След диагностика' },
  { service: 'Проблем с конденза', price: 'След диагностика' },
  { service: 'Проблем с вратата', price: 'След диагностика' },
  { service: 'Ремонт на електроника', price: 'След диагностика' },
  { service: 'Монтаж', price: 'След уточняване' },
  { service: 'Демонтаж', price: 'След уточняване' },
];

const realCases = [
  {
    brand: 'LG',
    problem: 'Сушилнята издаваше силен шум при въртене',
    area: 'Централен',
    diagnosis: 'Оказаха се ролките.',
    repair: 'Подменени са и работи отлично без шум.',
    image: '/img/services/ремонт-на-сушилня-софия-случай-1.webp',
    alt: 'Ремонт на LG сушилня в център, София',
  },
  {
    brand: 'BEKO',
    problem: 'Сушилнята не завърташе барабана',
    area: 'Люлин',
    diagnosis: 'Оказа се проблем с ремъка.',
    repair: 'Подменен е, сега работи нормално.',
    image: '/img/services/ремонт-на-сушилня-софия-случай-2.webp',
    alt: 'Ремонт на BEKO сушилня в Люлин, София',
  },
  {
    brand: 'Whirlpool',
    problem: 'Не завърташе барабана',
    area: 'Лозенец',
    diagnosis: 'Оказа се проблем със стартиращия кондензатор на мотора, завъртащ барабана.',
    repair: 'Подменен е с нов и работи нормално сега.',
    image: '/img/services/ремонт-на-сушилня-софия-случай-3.webp',
    alt: 'Ремонт на Whirlpool сушилня в Лозенец, София',
  },
];

const processSteps = [
  { step: 1, title: 'Свързвате се с РотоРем', text: 'Описвате проблема, марката и модела на сушилнята.', circleClass: 'bg-gradient-to-r from-fuchsia-500 to-fuchsia-600' },
  { step: 2, title: 'Уговаряме посещение', text: 'Техник посещава посочения адрес.', circleClass: 'bg-gradient-to-r from-purple-500 to-purple-600' },
  { step: 3, title: 'Проверяваме сушилнята', text: 'Проверяват се системите и компонентите, свързани с конкретния симптом.', circleClass: 'bg-gradient-to-r from-pink-500 to-pink-600' },
  { step: 4, title: 'Получавате информация за ремонта', text: 'Обясняваме какво е установено и какъв ремонт е необходим.', circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600' },
  { step: 5, title: 'Ремонт и тест', text: 'След ремонта работата на сушилнята се проверява.', circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600' },
];

const brands = ['Bosch', 'Siemens', 'AEG', 'Electrolux', 'Gorenje', 'Samsung', 'LG', 'Beko', 'Whirlpool'];

const faqs = getServiceFaqItems('/services/sofia/dryer-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="dryer-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на сушилня на адрес в София"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-purple-950/85 via-fuchsia-900/75 to-purple-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес в София
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на сушилни в София
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Сушилнята не загрява, не суши добре, барабанът не се върти, спира по време на програмата или издава необичаен шум?
          </p>
          <p class="text-base md:text-lg text-white/90 mb-5 leading-relaxed max-w-2xl mx-auto">
            РотоРем извършва диагностика и ремонт на сушилни по домовете в София и населени места около града. Техник посещава адреса, проверява уреда и установява причината за проблема.
          </p>
          <p class="text-base md:text-lg text-white/85 mb-8 leading-relaxed max-w-2xl mx-auto">
            Работим с кондензни сушилни, сушилни с термопомпа и други основни видове сушилни.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Посещение и диагностика</p>
              <p class="text-xl font-bold text-white">{diagnosticPrice}</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика и ремонт на сушилни на адрес</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
            <p>
              Когато сушилнята спре да работи нормално, видимият проблем не винаги показва директно коя част е повредена.
            </p>
            <p>
              Ако дрехите остават влажни, причината може да бъде свързана с нагряването, движението на въздуха, филтрите, температурните датчици, термопомпената система или друг компонент според конструкцията на уреда.
            </p>
            <p>
              При сушилня, чийто барабан не се върти, се проверяват задвижването, ремъкът, двигателят и свързаните механични части. Техникът започва от конкретния симптом и проверява системите, които могат да го причинят.
            </p>
            <p>
              След диагностиката клиентът получава информация какво е установено и какъв ремонт е необходим. Ремонтът на сушилни е част от услугите на РотоРем за{' '}
              <a href="/services/sofia/" class={`${accentLink} font-medium hover:underline`}>ремонт на битова техника в София</a>, които се извършват по домовете на клиентите.
            </p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика и ремонт на сушилня в София"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Сушилня" />

    <div class="container max-w-5xl">
      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви проблеми със сушилни ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-xl border`}>
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Diagnostics checklist -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какво проверяваме при диагностиката</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`max-w-4xl mx-auto bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed`}>
          <p class="font-medium text-gray-900">В зависимост от типа сушилня и проблема могат да бъдат проверени:</p>
          <ul class="list-disc pl-5 space-y-2 columns-1 md:columns-2 gap-x-8">
            <li>захранването;</li>
            <li>барабанът;</li>
            <li>ремъкът;</li>
            <li>ролките;</li>
            <li>двигателят;</li>
            <li>филтрите;</li>
            <li>въздушният поток;</li>
            <li>нагревателната система;</li>
            <li>температурните датчици;</li>
            <li>датчиците за влажност;</li>
            <li>системата за конденз;</li>
            <li>помпата за конденз;</li>
            <li>термопомпената система;</li>
            <li>компресорът;</li>
            <li>вратата и заключването;</li>
            <li>електрическите връзки;</li>
            <li>електронното управление;</li>
            <li>кодовете за грешка.</li>
          </ul>
          <p>Първо се установява причината за конкретната неизправност и след това се определя необходимият ремонт.</p>
          <p class="font-semibold text-gray-900">Посещение и диагностика: {diagnosticPrice}</p>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на сушилнята, които проверяваме и ремонтираме</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class={`bg-white rounded-xl border ${accentBorder} p-5 shadow-sm`}>
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class={`hidden md:block overflow-hidden rounded-xl border ${accentBorder} bg-white shadow-lg`}>
          <table class="w-full text-left">
            <thead>
              <tr class={`${tableHeader} text-white`}>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Не е необходимо всяка повреда да води до смяна на част. В много случаи диагностиката показва друг проблем в системата, затова конкретният ремонт се определя след проверка.
        </p>
      </section>

      <!-- Heating -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Сушилнята не загрява</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>Когато сушилнята работи, но не достига необходимата температура, дрехите могат да останат влажни дори след цял цикъл.</p>
          <p class="font-medium text-gray-900">В зависимост от типа и модела могат да бъдат проверени:</p>
          <ul class="list-disc pl-5 space-y-2">
            <li>нагревателните компоненти;</li>
            <li>температурните датчици;</li>
            <li>въздушният поток;</li>
            <li>електрическите връзки;</li>
            <li>термопомпената система;</li>
            <li>управлението.</li>
          </ul>
          <p>Преди подмяна на част се установява дали самият компонент е повреден или проблемът идва от друга система.</p>
        </div>
      </section>

      <!-- Heat pump -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт на сушилни с термопомпа</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>РотоРем извършва диагностика и ремонт на основните видове сушилни с термопомпа.</p>
          <p>
            При проблем с температурата или продължителността на сушене могат да бъдат проверени въздушният поток, температурните датчици, топлообменната система, компресорът и останалите компоненти, свързани с термопомпената система.
          </p>
          <p>Слабият резултат от сушенето не означава автоматично повреда на термопомпата. Проверяват се всички системи, които могат да причинят същия симптом.</p>
        </div>
      </section>

      <!-- Airflow -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Когато сушилнята суши бавно</h2>
          <div class={`w-20 h-1 ${accentBar} mx-auto`}></div>
        </div>
        <div class={`bg-gradient-to-r ${accentShell} p-6 md:p-8 rounded-2xl shadow-lg border space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto`}>
          <p>За нормалното сушене въздухът трябва да преминава правилно през дрехите и системата на машината.</p>
