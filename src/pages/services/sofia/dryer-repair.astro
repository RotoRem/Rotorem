---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pricing = getServicePricing('dryer', 'sofia', lang);

const title = 'Ремонт на сушилни в София | Професионален сервиз РотоРем';
const description = 'Сервиз за ремонт и монтаж на сушилни в София по домовете ✓ Бърза диагностика и ремонт в същия ден за всички марки ✓ Обадете се сега на ☎ 089 834 0982!';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-indigo-600 to-indigo-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Ремонт и монтаж на сушилни по домовете в София
        </h1>
        <p class="text-xl md:text-2xl text-indigo-100 max-w-3xl mx-auto mb-8">
          Професионален ремонт на сушилни в София и околността. Бърз сервиз на място с гаранция за качество.
        </p>
        <p class="text-base md:text-lg text-indigo-100 max-w-2xl mx-auto mb-8">
          Диагностика в София - 30 €
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-indigo-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпратете имейл
          </a>
          <a href="tel:0898340982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">Обади се на 089 834 0982</a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">

      <!-- Why Choose Us -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете нашия сервиз за сушилни в София?</h2>
          <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-indigo-200">
            <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-indigo-900 mb-3">Сервиз на място</h3>
            <p class="text-indigo-800">Идваме директно при вас в рамките на София. Без нужда от транспортиране на уреда.</p>
          </div>

          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-emerald-200">
            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-emerald-900 mb-3">Бърза реакция</h3>
            <p class="text-emerald-800">В повечето случаи завършваме ремонта в същия ден. Разполагаме с често нужните части.</p>
          </div>

          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Гаранция</h3>
            <p class="text-amber-800">Гаранция за извършения ремонт и използваните части.</p>
          </div>

          <div class="bg-gradient-to-br from-lime-50 to-lime-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-lime-200">
            <div class="w-12 h-12 bg-lime-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-lime-900 mb-3">Справедливи цени</h3>
            <p class="text-lime-800">Диагностика в София - 30 €. Ясни цени без скрити такси за ремонт на сушилни.</p>
          </div>
        </div>
      </section>

      <!-- Common Problems -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Чести повреди при сушилни</h2>
          <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-indigo-50 via-white to-indigo-50 p-8 rounded-2xl shadow-xl border border-indigo-100">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
              <h3 class="text-lg font-semibold text-indigo-900 mb-3">Сушилня не загрява</h3>
              <p class="text-indigo-800">Нагревател, термостат или датчик. Тест и подмяна при необходимост.</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-emerald-500">
              <h3 class="text-lg font-semibold text-emerald-900 mb-3">Барабанът не се върти</h3>
              <p class="text-emerald-800">Ремък, лагер или мотор. Професионална диагностика на място.</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
              <h3 class="text-lg font-semibold text-amber-900 mb-3">Изключва се или дава грешка</h3>
              <p class="text-amber-800">Проблеми със сензори, електроника или окабеляване.</p>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
              <h3 class="text-lg font-semibold text-red-900 mb-3">Необичаен шум или вибрации</h3>
              <p class="text-red-800">Лагери, ролки, баланс. Профилактика и ремонт.</p>
            </div>
          </div>
        </div>
      </section>

      {pricing && <ServicePricing pricing={pricing} accent="indigo" />}

      <!-- Process -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Процес на ремонт на сушилни в София</h2>
          <div class="w-20 h-1 bg-indigo-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-indigo-500 to-indigo-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">1</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Вие ни звъните</h3>
              <p class="text-gray-700">Обадете се на 089 834 0982 за ремонт на сушилня в София.</p>
            </div>
          </div>
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ние идваме при вас</h3>
              <p class="text-gray-700">Нашият техник пристига в уговорения час с необходимите инструменти и части.</p>
            </div>
          </div>
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">3</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ремонтираме</h3>
              <p class="text-gray-700">Диагностицираме проблема и ремонтираме сушилнята ви още същия ден, когато е възможно.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Coverage Section -->
      <section class="mb-16 bg-gray-50 border border-gray-200 rounded-2xl p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Обслужване на всички квартали</h2>
        <p class="text-gray-700 text-center max-w-3xl mx-auto mb-8">
          Посещаваме адреси във всички райони на София – център, южни райони около Витоша и западни комплекси като Люлин и Обеля.
        </p>
        <div class="grid md:grid-cols-3 gap-6 text-gray-700">
          <ul class="space-y-2">
            <li>Център</li>
            <li>Лозенец</li>
            <li>Иван Вазов</li>
            <li>Красно село</li>
          </ul>
          <ul class="space-y-2">
            <li>Младост</li>
            <li>Дървеница</li>
            <li>Дианабад</li>
            <li>Стрелбище</li>
          </ul>
          <ul class="space-y-2">
            <li>Люлин</li>
            <li>Обеля</li>
            <li>Овча купел</li>
            <li>Гоце Делчев</li>
          </ul>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="text-center bg-gradient-to-r from-indigo-600 to-indigo-800 text-white p-12 rounded-2xl shadow-2xl">
        <h2 class="text-3xl font-bold mb-4">Нужен ви е ремонт на сушилня в София?</h2>
        <p class="text-xl mb-8 text-indigo-100">Обадете се сега за бърз ремонт на място!</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-indigo-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпрати имейл
          </a>
          <a href="tel:0898340982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>
        <div class="text-indigo-100">
          <p class="text-sm">
            Посещение и диагностика: София - 30 € • Гаранция за качество • Сервиз в София
          </p>
        </div>
      </section>
    </div>
  </article>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
<p dir="ltr">Сушилнята не изсушава добре, не загрява или спира по средата на програмата? Това са чести проблеми, които изискват бърза намеса, особено когато разчитате на уреда всеки ден. Ние от РотоРем предлагаме ремонт на сушилни по домовете в София с диагностика на място и ефективно решение още при посещението. Работим в целия град и близките райони, без нужда от транспортиране на уреда до сервиз.</p>
      <h2 dir="ltr">Какви проблеми със сушилни ремонтираме в София</h2>
      <p dir="ltr">В практиката си като сервиз за сушилни в София отстраняваме различни неизправности, които пречат на нормалната работа на уреда. Често получаваме заявки за ремонт на сушилни за уред, който не загрява, вибрира прекомерно или не изсушава дрехите достатъчно добре.</p>
      <p dir="ltr">Проблемите могат да бъдат свързани с нагревател, термостат, датчици или електронен модул. При модели с термопомпа се наблюдават специфични неизправности, които изискват опит и правилна диагностика.&nbsp;</p>
      <p dir="ltr">Освен ремонт на сушилни по домовете, извършваме и монтаж на сушилни с термопомпа, както и стандартен монтаж при нов уред. Ако пространството е ограничено, предлагаме и монтаж на сушилня върху пералня с правилно нивелиране и стабилно закрепване.</p>
      <p dir="ltr">Ако имате нужда от помощ и с други електроуреди, можете да разгледате услугите ни за&nbsp;<a href="https://www.rotorem.bg/services/sofia/washing-machine-repair/" style="text-decoration:none;">ремонт на перални</a>&nbsp;или&nbsp;<a href="https://www.rotorem.bg/services/sofia/dishwasher-repair/" style="text-decoration:none;">ремонт на съдомиялни</a>, както и всички предложения на страницата ни за&nbsp;<a href="https://www.rotorem.bg/services/sofia/" style="text-decoration:none;">ремонт на бяла техника в София</a>.</p>
      <h2 dir="ltr">Какви марки сушилни обслужваме</h2>
      <p dir="ltr">Извършваме ремонт на сушилни на всички популярни марки на пазара. Работим с Bosch, Whirlpool, Samsung, LG, Beko, AEG и други производители, включително съвременни модели с термопомпа. Познаваме добре различните технологии и специфики, което ни позволява да предложим точна диагностика и дълготрайно решение при всеки ремонт на сушилни.</p>
      <h2 dir="ltr">Райони в София, които обслужваме</h2>
      <p dir="ltr">Предлагаме диагностика, монтаж и ремонт на сушилни по домовете в цяла София и околността. Обслужваме квартали като Люлин, Младост, Надежда, Дружба, Студентски град, Манастирски ливади, Бояна, Лозенец, Център, както и райони до около 20 км извън града. Целта ни е да реагираме бързо, независимо къде се намирате.</p>
      <h2 dir="ltr">Как протича ремонтът на сушилни</h2>
      <p dir="ltr">Процесът започва с посещение на адрес и диагностика, за да установим точната причина за проблема. След това даваме ясна оферта, преди да започнем работа. При одобрение извършваме ремонта на място. Накрая правим тест на уреда, за да сме сигурни, че функционира нормално и безопасно.</p>
      <p dir="ltr">При нов уред, извършваме монтаж на сушилня според условията в дома. Монтажът включва правилно свързване, нивелиране и проверка на работата, за да се избегнат бъдещи проблеми.</p>
      <h2 dir="ltr">Защо да изберете сервиз за сушилни РотоРем в София</h2>
      <p>Клиентите ни избират, защото получават реално решение, а не временно оправяне. Работим директно на адрес, което спестява време и усилия. Всеки ремонт се извършва с внимание към детайла и с гаранция за услугата. Разполагаме с дългогодишен опит и познания за различни марки и модели, което ни позволява да реагираме бързо и адекватно.&nbsp;<a href="https://www.rotorem.bg/contact/">Свържете се с нас</a> и запазете удобен час за посещение.</p>

    </div>
  </div>
</Layout>

