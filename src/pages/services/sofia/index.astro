---
import Layout from '../../../layouts/Base.astro';
import StatsBar from '../../../components/StatsBar.astro';

const title = 'Ремонт на бяла техника София | Експертен сервиз РотоРем';
const description = 'Професионален сервиз за бяла техника в София ✓ Гаранция за качество ✓ Бързо посещение на адрес ✓ Всички марки и модели ✓ Обадете се сега на ☎ 089 834 0982!';

type IconKey = 'washing-machine' | 'dishwasher' | 'oven' | 'dryer';

const serviceColors: Record<IconKey, string> = {
  'washing-machine': 'from-blue-700/80 to-blue-600/80',
  'dishwasher': 'from-emerald-700/80 to-emerald-600/80',
  'oven': 'from-amber-700/80 to-amber-600/80',
  'dryer': 'from-indigo-700/80 to-indigo-600/80',
};

const services = [
  {
    icon: 'washing-machine' as IconKey,
    title: 'Перални',
    description: 'Бърз ремонт на перални в София – течове, шум, електроника, помпа. Сервиз на място с гаранция.',
    url: '/services/sofia/washing-machine-repair/',
  },
  {
    icon: 'washing-machine' as IconKey,
    title: 'Сушилни',
    description: 'Професионален ремонт на сушилни: не загрява, не върти барабана, грешки и сензори. София и околността.',
    url: '/services/sofia/dryer-repair/',
  },
  {
    icon: 'dishwasher' as IconKey,
    title: 'Съдомиялни',
    description: 'Надежден ремонт на съдомиялни – не взима вода, не източва, грешки. Диагностика и ремонт на място.',
    url: '/services/sofia/dishwasher-repair/',
  },
  {
    icon: 'oven' as IconKey,
    title: 'Фурни',
    description: 'Експертен ремонт на електрически фурни и плотове: нагреватели, термостати, платки. Гарантирана работа.',
    url: '/services/sofia/oven-repair/',
  },
  {
    icon: 'oven' as IconKey,
    title: 'Бойлери',
    description: 'Ремонт и профилактика на бойлери: нагревател, термостат, течове и почистване от котлен камък.',
    url: '/services/sofia/boiler-repair/',
  },
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-16">
    <div class="container max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Професионален ремонт на бяла техника в София</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
        Професионален ремонт на перални, сушилни, съдомиялни, фурни и бойлери. Сервиз на място в София – бързо и с гаранция.
      </p>
      <p class="text-base md:text-lg text-blue-100 max-w-2xl mx-auto mb-8">
        Диагностика в София - 30 €
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-primary px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Изпратете имейл
        </a>
        <a href="/contact" class="bg-accent text-white px-8 py-4 rounded-lg font-semibold hover:bg-accent-dark transition-colors shadow-lg">Свържете се с нас</a>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <StatsBar />

  <!-- Services Grid (Sofia) -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-blue-50 to-white relative overflow-hidden">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-2">Нашите услуги в София</h2>
        <p class="mt-4 text-xl text-gray-600">Всички ремонти се извършват във вашия дом – без нужда от транспортиране на уредите.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
        {services.map((service) => {
          const gradientClass = serviceColors[service.icon];
          return (
            <div class="relative rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow group">
              <div class="absolute inset-0">
                <div class={`absolute inset-0 bg-gradient-to-br ${gradientClass} group-hover:opacity-80 transition-opacity duration-300`}></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
              </div>

              <div class="relative z-10 p-6 md:p-8 h-full flex flex-col text-white">
                <h3 class="text-xl font-semibold drop-shadow-sm">{service.title}</h3>
                <p class="mt-2 text-white/90 flex-grow">{service.description}</p>
                <div class="mt-6 pt-4 border-t border-white/20">
                  <a href={service.url} class="bg-white/30 hover:bg-white/40 backdrop-blur-sm text-white font-medium py-2 px-4 rounded-lg inline-flex items-center transition-colors shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                    Научете повече
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-12 text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+359 89 834 0982" class="btn-primary inline-flex items-center justify-center shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Обадете се сега
          </a>
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="btn-cta inline-flex items-center justify-center shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Изпратете имейл
          </a>
          <div class="flex items-center text-gray-600 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
            <span>Обадете се за час</span>
          </div>
        </div>
      </div>
    </div>
  </section>

    <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
<p dir="ltr">Когато някой от електроуредите у дома спре да работи, животът не може да чака и комфортът бързо се нарушава. Независимо дали става дума за пералня, бойлер или фурна, проблемът изисква бърза реакция. Нашият сервиз за битова техника РотоРем предлага ремонт на електроуреди в София и околността с посещение на място, ясна диагностика и практично решение. Работим в целия град и реагираме в удобен за вас момент, без излишно чакане.</p>
      <h2 dir="ltr">Какви ремонти на електроуреди извършваме в София</h2>
      <p dir="ltr">Всеки уред има своята специфика, но повредите често започват по сходен начин - блокиране, шум, теч, липса на загряване или спиране на програма. В нашия сервиз за домакинска техника се справяме както с ежедневни проблеми, така и с по-сложни технически случаи.</p>
      <p dir="ltr">Ако имате нужда от&nbsp;<a href="https://www.rotorem.bg/services/sofia/washing-machine-repair/" style="text-decoration:none;">ремонт на пералня</a>, когато програмата не стартира или не изпира дрехите, можете да разчитате на бърза реакция и точна диагностика. При проблеми със сушенето или сензори предлагаме ефективен&nbsp;<a href="https://www.rotorem.bg/services/sofia/dryer-repair/" style="text-decoration:none;">ремонт на сушилни</a>, включително и професионален монтаж. При течове или грешки в програмите извършваме надежден&nbsp;<a href="https://www.rotorem.bg/services/sofia/dishwasher-repair/" style="text-decoration:none;">ремонт на съдомиялни</a>.</p>
      <p dir="ltr">За домакинства с проблеми с топлата вода, осигуряваме&nbsp;<a href="https://www.rotorem.bg/services/sofia/boiler-repair/" style="text-decoration:none;">ремонт и поддръжка на бойлери</a>, както и почистване от котлен камък. При кухненските уреди извършваме&nbsp;<a href="https://www.rotorem.bg/services/sofia/oven-repair/" style="text-decoration:none;">ремонт на фурни и готварски печки</a>, когато има неравномерно нагряване или отказ на уреда.</p>
      <p dir="ltr">Предлагаме и монтаж на нови електроуреди с правилна инсталация, което е важно за тяхната дългосрочна работа. Така получавате цялостно решение от един сервиз за битова техника в София, без да търсите различни специалисти.</p>
      <h2 dir="ltr">Какви марки обслужваме в София</h2>
      <p dir="ltr">Работим с широка гама брандове, което ни позволява да реагираме при различни модели и технологии. Извършваме ремонт на бяла техника за марки като Bosch, Whirlpool, Samsung, LG, Electrolux, Gorenje и други утвърдени производители. Познаваме спецификите им и използваме подходящи компоненти при нужда, което намалява риска от повторна повреда и осигурява по-надежден резултат.</p>
      <h2 dir="ltr">Райони в София, които обслужваме</h2>
      <p dir="ltr">Покриваме всички квартали и околността до 20 км. Работим в Люлин, Дружба, Надежда, Овча купел, Манастирски ливади, Лозенец, Център, Студентски град и други. Извършваме и ремонт на електроуреди в кв. Младост с бърза реакция и гъвкави часове за посещение. Независимо къде се намирате, можете да разчитате на навременно обслужване.</p>
      <h2 dir="ltr">Как протича ремонтът на бяла техника</h2>
      <p dir="ltr">Процесът започва с посещение на адрес и диагностика на уреда. Целта е да се установи точната причина за проблема, а не да се предполага. След това получавате ясна оферта с конкретна цена за ремонта. При съгласие се пристъпва към отстраняване на повредата с подходящи инструменти и части. Накрая уредът се тества, за да се уверим, че работи нормално. Така получавате работещо решение без излишни разходи и забавяния.</p>
      <h2 dir="ltr">Защо да изберете сервиз за домакинска техника РотоРем</h2>
      <p>Клиентите търсят нашия сервиз за домакинска техника, когато искат сигурност и ясни условия. Натрупаният опит позволява бърза реакция и точна диагностика. Работим на място, което спестява време и транспорт. Всеки ремонт на бяла техника е с гаранция, а цените се уточняват предварително. Обслужваме всички популярни марки и подхождаме индивидуално към всеки случай. Целта е дългосрочно решение, а не временен резултат. Свържете се с нас още сега и запазете удобен час за посещение. Изпратете запитване или се&nbsp;<a href="https://www.rotorem.bg/contact/">свържете с нас</a>, за да организираме посещение в удобен за вас час.</p>

    </div>
  </div>
</Layout>

