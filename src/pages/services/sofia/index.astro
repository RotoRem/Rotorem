---
import Layout from '../../../layouts/Base.astro';
import StatsBar from '../../../components/StatsBar.astro';

const title = 'Услуги София | Ремонт на битова техника | РотоРем София';
const description = 'Професионален ремонт на битова техника в София ✓ Перални ✓ Сушилни ✓ Съдомиялни ✓ Фурни ✓ Бойлери ✓ Сервиз на място с гаранция ☎ 089 834 0982';

type IconKey = 'washing-machine' | 'dishwasher' | 'oven' | 'dryer';

const serviceColors: Record<IconKey, string> = {
  'washing-machine': 'from-blue-700/80 to-blue-600/80',
  'dishwasher': 'from-emerald-700/80 to-emerald-600/80',
  'oven': 'from-amber-700/80 to-amber-600/80',
  'dryer': 'from-indigo-700/80 to-indigo-600/80',
};

const services = [
  {
    icon: 'washing-machine' as IconKey,
    title: 'Перални',
    description: 'Бърз ремонт на перални в София – течове, шум, електроника, помпа. Сервиз на място с гаранция.',
    url: '/services/sofia/washing-machine-repair',
  },
  {
    icon: 'washing-machine' as IconKey,
    title: 'Сушилни',
    description: 'Професионален ремонт на сушилни: не загрява, не върти барабана, грешки и сензори. София и околността.',
    url: '/services/sofia/dryer-repair',
  },
  {
    icon: 'dishwasher' as IconKey,
    title: 'Съдомиялни',
    description: 'Надежден ремонт на съдомиялни – не взима вода, не източва, грешки. Диагностика и ремонт на място.',
    url: '/services/sofia/dishwasher-repair',
  },
  {
    icon: 'oven' as IconKey,
    title: 'Фурни',
    description: 'Експертен ремонт на електрически фурни и плотове: нагреватели, термостати, платки. Гарантирана работа.',
    url: '/services/sofia/oven-repair',
  },
  {
    icon: 'oven' as IconKey,
    title: 'Бойлери',
    description: 'Ремонт и профилактика на бойлери: нагревател, термостат, течове и почистване от котлен камък.',
    url: '/services/sofia/boiler-repair',
  },
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-16">
    <div class="container max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Услуги – ремонт на битова техника в София</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
        Професионален ремонт на перални, сушилни, съдомиялни, фурни и бойлери. Сервиз на място в София – бързо и с гаранция.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+359 89 834 0982" class="bg-white text-primary px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">📞 089 834 0982</a>
        <a href="/contact" class="bg-accent text-white px-8 py-4 rounded-lg font-semibold hover:bg-accent-dark transition-colors shadow-lg">Свържете се с нас</a>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <StatsBar />

  <!-- Services Grid (Sofia) -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-blue-50 to-white relative overflow-hidden">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-2">Нашите услуги в София</h2>
        <p class="mt-4 text-xl text-gray-600">Всички ремонти се извършват във вашия дом – без нужда от транспортиране на уредите.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
        {services.map((service) => {
          const gradientClass = serviceColors[service.icon];
          return (
            <div class="relative rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow group">
              <div class="absolute inset-0">
                <picture>
                  <source srcset={`/img/${service.icon}.avif`} type="image/avif" />
                  <source srcset={`/img/${service.icon}.webp`} type="image/webp" />
                  <img src={`/img/${service.icon}.webp`} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" width="600" height="400" loading="lazy" decoding="async" />
                </picture>
                <div class={`absolute inset-0 bg-gradient-to-br ${gradientClass} group-hover:opacity-75 transition-opacity duration-300`}></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
              </div>

              <div class="relative z-10 p-6 md:p-8 h-full flex flex-col text-white">
                <h3 class="text-xl font-semibold drop-shadow-sm">{service.title}</h3>
                <p class="mt-2 text-white/90 flex-grow">{service.description}</p>
                <div class="mt-6 pt-4 border-t border-white/20">
                  <a href={service.url} class="bg-white/30 hover:bg-white/40 backdrop-blur-sm text-white font-medium py-2 px-4 rounded-lg inline-flex items-center transition-colors shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                    Научете повече
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-12 text-center">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+359 89 834 0982" class="btn-primary inline-flex items-center justify-center shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Обадете се сега
          </a>
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="btn-cta inline-flex items-center justify-center shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Изпратете имейл
          </a>
          <div class="flex items-center text-gray-600 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
            <span>Обадете се за час</span>
          </div>
        </div>
      </div>
    </div>
  </section>

    <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <style>
      .rotorem-seo-text {
        font-size: 74%;
        color: #777 !important;
        background-color: #f9fafb;
        padding: 2rem 0;
      }
      .rotorem-seo-text h2,
      .rotorem-seo-text h3,
      .rotorem-seo-text h4 {
        font-size: 1em;
        margin: 1em 0 0.5em;
        color: #777;
        font-weight: 400;
      }
      .rotorem-seo-text a {
        color: #777;
        text-decoration: underline;
      }
      .rotorem-seo-text p {
        margin: 0.5em 0;
        line-height: 1.5;
      }
      .rotorem-seo-text ul {
        margin: 0.5em 0;
        padding-left: 1.5em;
      }
      .rotorem-seo-text li {
        margin: 0.3em 0;
      }
    </style>
    
    <div class="container max-w-4xl">
      <h2>Ремонт битова техника София – експресен сервиз на домашна техника у дома</h2>
      <h2>Въведение: удобство по адрес, без излишно носене</h2>
      <p>
        Ремонт битова техника София връща ритъма у дома с посещение от техник по ваш адрес и ясен план
        за действие. Сервиз на място София спестява време, транспорт и стрес, защото диагностиката и
        поправката се правят пред вас – чисто и под контрол.
      </p>
      <p>
        За старт прегледайте общата страница
        <a href="https://www.rotorem.bg/services/sofia/" title="ремонт бяла техника София, ремонт битова техника София, сервиз на място София – цена, цени, уред/уреди">
          Ремонт на битова техника София
        </a>
        и изберете точната услуга. В този материал ще видите стъпките, най-честите симптоми и как да
        заявите посещение още днес.
      </p>
      <p>
        Накратко: сервиз по адрес в София за перални, сушилни, съдомиялни, фурни и бойлери. Бърза
        диагностика, ясни цени, гаранция и лесна заявка онлайн. Ако проблемът е спешен – резервирайте
        час и ние идваме.
      </p>

      <h2>Услуги: ремонт перални, сушилни, съдомиялни, фурни, бойлери София</h2>
      <p>
        Всички услуги са събрани на едно място. Изберете специализираната страница и заявете посещение
        във време, което ви е удобно.
      </p>

      <ul>
        <li>
          <a href="https://www.rotorem.bg/services/sofia/washing-machine-repair/" title="ремонт перални София, сервиз перални София, ремонт на пералня – цена, цени, пералня/перални">
            Ремонт на пералня София
          </a>
          – когато има шум, вибрации, теч или не центрофугира както трябва.
        </li>
        <li>
          <a href="https://www.rotorem.bg/services/sofia/dryer-repair/" title="ремонт сушилни София, сервиз сушилни София, ремонт сушилня – цена, цени, сушилня/сушилни">
            Ремонт на сушилни София
          </a>
          – при слабо сушене, чести грешки, необичаен шум или миризма на прегрято.
        </li>
        <li>
          <a href="https://www.rotorem.bg/services/sofia/dishwasher-repair/" title="ремонт съдомиялни София, сервиз съдомиялни София, ремонт съдомиялна – цена, цени, съдомиялна/съдомиялни">
            Ремонт на съдомиялни София
          </a>
          – ако оставя петна, течове по врата, прекъсва програми или не стартира.
        </li>
        <li>
          <a href="https://www.rotorem.bg/services/sofia/oven-repair/" title="ремонт фурни София, ремонт готварски печки София, ремонт котлони – цена, цени, фурна/фурни">
            Ремонт на фурни София
          </a>
          – при неравномерно печене, бавно загряване, грешки на панела или изключване.
        </li>
        <li>
          <a href="https://www.rotorem.bg/services/sofia/boiler-repair/" title="ремонт бойлери София, смяна нагревател бойлер София, бойлер не загрява – цена, цени, бойлер/бойлери">
            Ремонт на бойлери София
          </a>
          – когато капе, не загрява, шуми при работа или защитата сработва твърде често.
        </li>
      </ul>

      <p>
        Може да минете и през навигацията:
        <a href="https://www.rotorem.bg/" title="начало, ремонт бяла техника София, сервиз на място – цена, цени, уред/уреди">Начало</a>,
        <a href="https://www.rotorem.bg/services/" title="услуги, ремонт битова техника, сервиз у дома – цена, цени, услуга/услуги">Услуги</a>,
        <a href="https://www.rotorem.bg/blog/" title="блог, ремонт бяла техника, поддръжка уреди – цена, цени, статия/статии">Блог</a>,
        <a href="https://www.rotorem.bg/reviews/" title="отзиви, мнения за сервиз, препоръки – цена, цени, клиент/клиенти">Отзиви</a>,
        <a href="https://www.rotorem.bg/faq/" title="често задавани въпроси, условия, цени – цена, цени, въпрос/въпроси">Често задавани въпроси</a>,
        <a href="https://www.rotorem.bg/book/" title="запази час, онлайн заявка, сервиз на адрес – цена, цени, час/часове">Запази час</a>,
        <a href="https://www.rotorem.bg/contact/" title="контакти, телефон сервиз, адрес – цена, цени, контакт/контакти">Контакти</a>.
      </p>

      <h2>Как работи посещението по адрес</h2>

      <h3>Заявка и избор на удобен час</h3>
      <p>
        Подайте заявка през
        <a href="https://www.rotorem.bg/book/" title="запази час, заявка ремонт, сервиз на място – цена, цени, час/часове">
          Запази час
        </a>
        или позвънете. Ще предложим най-близкия свободен слот и ще дадем ориентир за първоначална
        диагностика.
      </p>

      <h3>Диагностика на място</h3>
      <p>
        Техникът идва, разглежда симптомите и тества уреда. Обясняваме причината на разбираем език.
        Вие виждате какво правим.
      </p>

      <h3>Оферта и предвидими цени</h3>
      <p>
        Ще получите конкретна оферта: труд, части, срок. Ако не е изгодно да се ремонтира – казваме го
        директно. За детайли прегледайте
        <a href="https://www.rotorem.bg/faq/" title="често задавани въпроси, условия, цени – цена, цени, въпрос/въпроси">
          Често задавани въпроси
        </a>.
      </p>

      <h3>Ремонт и тест</h3>
      <p>
        Правим ремонта на място или, ако е нужно, планираме второ посещение със съответната част.
        Следва реален тест в дома ви, за да сте спокойни, че всичко е наред.
      </p>

      <h3>Гаранция и кратки насоки</h3>
      <p>
        Издаваме гаранция за извършеното. Даваме кратки, практични насоки за ползване и поддръжка,
        за да не се върне същият проблем. Вижте и
        <a href="https://www.rotorem.bg/reviews/" title="отзиви, мнения клиенти, препоръки – цена, цени, клиент/клиенти">
          Отзиви
        </a>
        – там хората казват как работим.
      </p>

      <h2>Симптоми по уред: какво да следите</h2>

      <h3>Пералня – признаци за ремонт</h3>
      <ul>
        <li>Не центрофугира или прескача обороти, дрехите излизат мокри.</li>
        <li>Силен шум, вибрации, теч от люка или отзад.</li>
        <li>Грешки при пълнене/източване; миризма или петна.</li>
      </ul>
      <p>
        При такива признаци заявете
        <a href="https://www.rotorem.bg/services/sofia/washing-machine-repair/" title="ремонт перални София, сервиз перални София, ремонт на пералня – цена, цени, пералня/перални">
          Ремонт на пералня София
        </a>
        – реакцията е бърза.
      </p>

      <h3>Сушилня – кога да действате</h3>
      <ul>
        <li>Суши слабо или спира насред програма, излиза грешка.</li>
        <li>Шум от барабана/мотора, миризма на прегрято.</li>
        <li>Събира се влакно и филтрите алармират твърде често.</li>
      </ul>
      <p>
        Навременният
        <a href="https://www.rotorem.bg/services/sofia/dryer-repair/" title="ремонт сушилни София, сервиз сушилни София, ремонт сушилня – цена, цени, сушилня/сушилни">
          Ремонт на сушилни София
        </a>
        пести енергия и дрехи.
      </p>

      <h3>Съдомиялна – сигнали за сервиз</h3>
      <ul>
        <li>Съдове с петна, сапунен филм или неприятна миризма.</li>
        <li>Тече при вратичката, чува се необичаен шум.</li>
        <li>Не стартира, прекъсва или дава кодове за грешка.</li>
      </ul>
      <p>
        Решението е
        <a href="https://www.rotorem.bg/services/sofia/dishwasher-repair/" title="ремонт съдомиялни София, сервиз съдомиялни София, ремонт съдомиялна – цена, цени, съдомиялна/съдомиялни">
          Ремонт на съдомиялни София
        </a>
        – на адрес, без разкачане по-скоро.
      </p>

      <h3>Фурна и котлони – типични проблеми</h3>
      <ul>
        <li>Не загрява равномерно, пече бавно или „пада“ температурата.</li>
        <li>Панелът изключва, копчета „залепват“, дисплеят мига.</li>
        <li>Мирис на изгоряло при старт, шум или искри.</li>
      </ul>
      <p>
        Потърсете
        <a href="https://www.rotorem.bg/services/sofia/oven-repair/" title="ремонт фурни София, ремонт готварски печки София, ремонт котлони – цена, цени, фурна/фурни">
          Ремонт на фурни София
        </a>
        – безопасността е на първо място.
      </p>

      <h3>Бойлер – сигурност и икономия</h3>
      <ul>
        <li>Не загрява или водата е нестабилна като температура.</li>
        <li>Капе от фланеца, клапанът изпуска прекалено често.</li>
        <li>Шум при нагряване, миризма на нагар.</li>
      </ul>
      <p>
        Тук помага
        <a href="https://www.rotorem.bg/services/sofia/boiler-repair/" title="ремонт бойлери София, смяна нагревател бойлер София, бойлер не загрява – цена, цени, бойлер/бойлери">
          Ремонт на бойлери София
        </a>
        – диагностика и решение с гаранция.
      </p>

      <h2>Цени и предвидимост без изненади</h2>
      <p>
        Цената се формира от диагностика, труд и части. Казваме крайната стойност предварително и не
        започваме без вашето съгласие. При по-сложен случай даваме срок и опции. Имате въпрос?
        Отговорите са в
        <a href="https://www.rotorem.bg/faq/" title="често задавани въпроси, условия, цени – цена, цени, въпрос/въпроси">
          Често задавани въпроси
        </a>
        и в
        <a href="https://www.rotorem.bg/contact/" title="контакти, телефон сервиз, адрес – цена, цени, контакт/контакти">
          Контакти
        </a>.
      </p>

      <h2>Покритие в София</h2>
      <p>
        Обслужваме централни, южни, източни и западни квартали на София. Предлагаме точни часови
        диапазони и координация с вашия график. При спешност – ще предложим най-бързия възможен
        вариант.
      </p>

      <h2>Защо нас: честна комуникация и стабилен резултат</h2>
      <ul>
        <li>Сервиз на място – без носене до сервиз и без риск по пътя.</li>
