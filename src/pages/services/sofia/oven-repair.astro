---
import Layout from '../../../layouts/Base.astro';
import ServicePricing from '../../../components/ServicePricing.astro';
import { getServicePricing } from '../../../data/service-prices';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pricing = getServicePricing('oven', 'sofia', lang);

const title = 'Ремонт на готварски печки и фурни в София | РотоРем';
const description = 'Професионален ремонт на готварски печки и фурни в София ✓ Бърз ремонт на място още същия ден ✓ Гаранция за качество ✓ Свържете се с нас на ☎ 089 834 0982!';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Ремонт на готварски печки и фурни в София
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
          Професионален ремонт на електрически фурни, котлони, плотове и бойлери за дома и офиса в София.
        </p>
        <p class="text-base md:text-lg text-blue-100 max-w-2xl mx-auto mb-8">
          Диагностика в София - 25,57 € (50лв)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпратете имейл
          </a>
          <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">

      <!-- Service Highlights -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете нашият сервиз за готварски печки, фурни и котлони в София?</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-blue-200">
            <div class="w-12 h-12 bg-blue-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16v16H4z"></path>
                <path d="M8 8h8v8H8z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-blue-900 mb-3">Квалифицирани електротехници</h3>
            <p class="text-blue-800">Сертифицирани специалисти с опит в ремонта на вградени фурни, готварски печки, плотове и комбинирани уреди.</p>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-green-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-green-200">
            <div class="w-12 h-12 bg-green-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v5"></path>
                <path d="M5.5 10.5l4.5 4.5 6-6 4.5 4.5"></path>
                <path d="M19 19H5"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-green-900 mb-3">Бърза подмяна на нагреватели</h3>
            <p class="text-green-800">Разполагаме с нагреватели, термостати и платки за популярни марки: Gorenje, Bosch, Whirlpool, Indesit, Ariston, Electrolux.</p>
          </div>
          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Гаранция и тестове</h3>
            <p class="text-amber-800">След ремонта тестваме всички функции и предоставяме гаранция за извършената работа и монтираните части.</p>
          </div>

          <div class="bg-gradient-to-br from-lime-50 to-lime-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-lime-200">
            <div class="w-12 h-12 bg-lime-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-lime-900 mb-3">Справедливи цени</h3>
            <p class="text-lime-800">Диагностика в София - 25,57 € (50лв). Ясни цени без скрити такси за ремонт на фурни и котлони.</p>
          </div>
        </div>
      </section>

      <!-- Issues Section -->
      <section class="mb-16">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Решаваме често срещани повреди</h2>
          <div class="grid md:grid-cols-2 gap-8">
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">1</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Фурната не загрява</h3>
                  <p class="text-gray-600">Подменяме нагреватели (горен, долен, вентилаторен), реле за време, температурни датчици и електронни платки.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">2</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Котлонът не работи</h3>
                  <p class="text-gray-600">Сменяме изгорели терморегулатори, ключове и нагревателни плочи при керамични и индукционни плотове.</p>
                </div>
              </div>
            </div>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">3</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Фурната не поддържа температура</h3>
                  <p class="text-gray-600">Подменяме термостат, температурни сензори, проверяваме изолацията и ремонтираме уплътнения на вратата.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-semibold">4</span>
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">Грешки и изключване</h3>
                  <p class="text-gray-600">Диагностицираме защитни системи, термостати, кабели и предпазители. Отстраняваме късо съединение и прегряване.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {pricing && <ServicePricing pricing={pricing} accent="blue" />}

      <!-- Repair Process Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Процес на ремонт на фурни в София</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">1</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Вие ни звъните</h3>
              <p class="text-gray-700">Обадете се на 089 834 0982 за ремонт на фурна в София.</p>
            </div>
          </div>

          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ние идваме при вас</h3>
              <p class="text-gray-700">Нашият техник пристига в уговореното време с всички необходими инструменти и части.</p>
            </div>
          </div>

          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">3</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ремонтираме</h3>
              <p class="text-gray-700">Диагностицираме проблема и ремонтираме фурната ви още същия ден в дома ви в София.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Coverage Section -->
      <section class="mb-16 bg-gray-50 border border-gray-200 rounded-2xl p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Обслужване на всички квартали</h2>
        <p class="text-gray-700 text-center max-w-3xl mx-auto mb-8">
          Посещаваме адреси във всички райони на София – централни квартали, южни райони около Витоша и западни комплекси като Люлин и Обеля.
        </p>
        <div class="grid md:grid-cols-3 gap-6 text-gray-700">
          <ul class="space-y-2">
            <li>Център</li>
            <li>Лозенец</li>
            <li>Иван Вазов</li>
            <li>Красно село</li>
          </ul>
          <ul class="space-y-2">
            <li>Младост</li>
            <li>Дървеница</li>
            <li>Дианабад</li>
            <li>Стрелбище</li>
          </ul>
          <ul class="space-y-2">
            <li>Люлин</li>
            <li>Обеля</li>
            <li>Овча купел</li>
            <li>Гоце Делчев</li>
          </ul>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="text-center bg-gradient-to-r from-blue-600 to-blue-800 text-white p-12 rounded-2xl shadow-2xl">
        <h2 class="text-3xl font-bold mb-4">Нужен ви е ремонт на фурна в София?</h2>
        <p class="text-xl mb-8 text-blue-100">Обадете се сега за бърз ремонт на място!</p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпрати имейл
          </a>
          <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>

        <div class="text-blue-100">
          <p class="text-sm">
            Посещение и диагностика: София - 25,57 € (50лв) • Гаранция за качество • Сервиз в София
          </p>
        </div>
      </section>
    </div>
  </article>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
<p dir="ltr">Котлонът не включва, фурната не пече или печката прекъсва по време на готвене? Това са проблеми, които не търпят отлагане. Предлагаме професионален ремонт на готварски печки, фурни и котлони в София директно във вашия дом. Реагираме бързо, работим в целия град, като целта ни е уредът ви да бъде отново изправен още при първото посещение.</p>
      <h2 dir="ltr">Какви проблеми с печки и фурни ремонтираме в София</h2>
      <p dir="ltr">При постоянна употреба кухненските уреди се износват и започват да се появяват дефекти. Често се търси ремонт на готварски печки при случаи, когато фурната не достига желаната температура или пече неравномерно. Това обикновено е свързано с проблем в нагревателя или термостата.</p>
      <p dir="ltr">Срещат се и ситуации, при които уредът изобщо не стартира. Това може да се дължи на дефект в електрониката, прекъснат кабел или изгорял предпазител. При керамични и индукционни модели, когато плотът не реагира или загрява неравномерно, извършваме ремонт на керамични и индукционни котлони.</p>
      <p dir="ltr">Друг често срещан случай е при вентилаторните фурни, където топлият въздух не се разпределя равномерно. Това води до недопечена храна и нужда от сервиз за поправка на проблема.</p>
      <p dir="ltr">Ако използвате вградени уреди, извършваме ремонт на фурни, включително при повреден дисплей, програматор или врата. При нужда можем да поемем и монтаж на нов уред след покупка.</p>
      <p dir="ltr">Освен тази услуга, можете да разчитате на нас и за други ремонти в дома. Ако имате проблем с пералнята, разгледайте нашата услуга за&nbsp;<a href="https://www.rotorem.bg/services/sofia/washing-machine-repair/" style="text-decoration:none;">ремонт на перални в София</a>. При повреда или нужда от монтаж на бойлер предлагаме и услуга за&nbsp;<a href="https://www.rotorem.bg/services/sofia/boiler-repair/" style="text-decoration:none;">ремонт на бойлери</a>, а всички услуги за града ще откриете на страницата за&nbsp;<a href="https://www.rotorem.bg/services/sofia/" style="text-decoration:none;">сервиз на бяла техника в София</a>.</p>
      <h2 dir="ltr">Какви марки печки и фурни обслужваме</h2>
      <p dir="ltr">Работим с всички популярни марки на пазара като Gorenje, Bosch, Whirlpool, Beko, Indesit и други. Независимо дали става дума за стандартен уред или модерна фурна за вграждане, познаваме спецификите на различните модели. Често извършваме ремонт на фурна Gorenje, като това ни позволява бързо да открием причината за повредата и да предложим адекватно решение.</p>
      <h2 dir="ltr">Райони в София, които обслужваме</h2>
      <p dir="ltr">Предлагаме ремонт на готварски печки във всички квартали на София и околностите до 20 км. Обслужваме Младост, Люлин, Надежда, Дружба, Студентски град, Лозенец, Красно село, Овча купел, Център и други райони. Посещения се извършват гъвкаво, така че да получите помощ в удобно за вас време.</p>
      <h2 dir="ltr">Как протича ремонтът на готварски печки</h2>
      <p dir="ltr">Процесът започва с посещение на техник на място. Извършва се подробна диагностика, за да се установи точната причина за проблема. След това получавате ясна оферта с крайна цена, без неочаквани разходи.</p>
      <p dir="ltr">При одобрение ремонтът започва веднага, като в много случаи повредата се отстранява още при първото посещение. След приключване уредът се тества, за да се гарантира, че работи нормално и безопасно. Целта е да получите работеща печка, котлон или фурна без излишно чакане и допълнителни посещения.</p>
      <h2 dir="ltr">Защо да изберете сервиз за готварски печки и фурни РотоРем</h2>
      <p dir="ltr">Клиентите ни търсят, когато искат сигурно и бързо решение. Работим на място, което спестява време и транспорт. Имаме дългогодишен опит с различни модели уреди. Използваме качествени части и предоставяме гаранция за извършения ремонт.</p>
      <p>Цените са ясни, без скрити такси, а комуникацията е директна и честна. Ако имате нужда от монтаж или ремонт на печки в София,&nbsp;<a href="https://www.rotorem.bg/contact/">свържете се с нас</a> и заявeте посещение в удобен за вас час.</p>

    </div>
  </div>
</Layout>
