---
import Layout from '../../layouts/Base.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import Reviews from '../../components/Reviews.astro';
import { getServicePricing } from '../../data/service-prices';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const pricing = getServicePricing('oven', 'varna', lang);

const title = 'Ремонт на фурни във Варна | Сервиз на адрес | РотоРем';
const description =
  'Ремонт и диагностика на фурни по домовете във Варна. Проблеми с нагреватели, температура, вентилатор, врата, програматор и електроника. РотоРем.';

const heroImage = '/img/services/ремонт-на-фурна-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-фурна-варна-диагностика.webp';

const problems = [
  {
    title: 'Фурната не загрява',
    text: 'Когато фурната се включва, но остава студена, трябва да се проверят нагревателната система и компонентите, които управляват температурата. Според модела причината може да бъде свързана с долен или горен нагревател, грил нагревател, кръгов нагревател при конвекционните модели, термостат, температурен датчик или електронно управление. Преди смяна на част се установява кой компонент действително причинява проблема.',
    border: 'border-orange-500',
  },
  {
    title: 'Фурната не достига зададената температура',
    text: 'Ако уредът загрява, но температурата остава по-ниска от зададената или достигането ѝ отнема необичайно дълго време, трябва да бъдат проверени нагревателите и системата за температурен контрол. Важно е да се установи и дали проблемът се появява при всички режими или само при определена функция.',
    border: 'border-amber-500',
  },
  {
    title: 'Фурната пече неравномерно',
    text: 'Когато храната прегаря отгоре, остава недопечена отдолу или различните части на камерата се нагряват неравномерно, причината може да бъде свързана с нагревател, вентилатор или температурен контрол. При конвекционните модели се проверява и правилното движение на нагретия въздух.',
    border: 'border-red-500',
  },
  {
    title: 'Фурната прегрява',
    text: 'Когато температурата се покачва значително над зададената стойност, трябва да бъде проверена системата, която измерва и контролира нагряването. Възможните причини включват термостат, температурен датчик, електронно управление или друг свързан компонент. При неконтролирано прегряване уредът не трябва да продължава да се използва преди проверка.',
    border: 'border-rose-500',
  },
  {
    title: 'Фурната не се включва',
    text: 'Когато дисплеят не реагира или фурната изобщо не стартира, проблемът може да бъде свързан със захранването, електрическите връзки, програматора, селектора за функции, термозащитата или електронния модул. Диагностиката се извършва според конкретното поведение на уреда.',
    border: 'border-yellow-500',
  },
  {
    title: 'Фурната изключва предпазителя',
    text: 'Ако при включване на фурната или определен режим автоматичният предпазител изключва, уредът трябва да бъде проверен преди повторна употреба. Причината може да бъде свързана с нагревател, електрическа връзка, изолация на компонент или друга електрическа неизправност. РотоРем има реален случай във Варна с Whirlpool фурна, при който такъв симптом е бил причинен от долния нагревател.',
    border: 'border-red-600',
    extra: 'При проблем с електрическата инсталация или предпазителя може да е необходима и проверка на ',
    link: { href: '/services/electrical-services/', label: 'електроуслуги на адрес' },
  },
  {
    title: 'Вентилаторът на фурната не работи',
    text: 'При конвекционните фурни вентилаторът участва в разпределението на нагретия въздух. Ако той не се върти, работи прекъснато или издава необичаен шум, могат да бъдат проверени перката, моторът, захранването и свързаните управляващи компоненти.',
    border: 'border-indigo-500',
  },
  {
    title: 'Фурната издава необичаен шум',
    text: 'Шумът може да се появява само при работа на вентилатора, при определен режим или след достигане на температура. Това помага да се установи коя система трябва да бъде проверена. При конвекционните модели причината може да бъде свързана с вентилатора, мотора или механичен проблем около перката.',
    border: 'border-purple-500',
  },
  {
    title: 'Фурната изключва по време на работа',
    text: 'Когато фурната стартира нормално, но прекъсва след определено време, могат да бъдат проверени температурният контрол, термозащитата, електрониката и останалите системи, свързани с конкретния симптом. Полезно е клиентът да обясни след колко време се появява проблемът и дали фурната може да бъде включена отново след охлаждане.',
    border: 'border-teal-500',
  },
  {
    title: 'Вратата на фурната не се затваря правилно',
    text: 'Неправилното затваряне може да доведе до загуба на топлина и проблем с поддържането на температурата. Проверяват се пантите, механизмът на вратата, уплътнението и позиционирането спрямо корпуса.',
    border: 'border-orange-600',
  },
  {
    title: 'Осветлението на фурната не работи',
    text: 'Причината може да бъде изгоряла лампа, фасунга, електрическа връзка или друг компонент от осветителната система. Проблемът се проверява заедно с останалите симптоми на уреда, за да се установи дали е изолиран или е част от по-широка неизправност.',
    border: 'border-amber-600',
  },
  {
    title: 'Таймерът или програматорът не работи',
    text: 'При електронно управляваните фурни проблем с таймера, дисплея или програматора може да попречи на определени функции или на стартирането на уреда. Проверява се дали проблемът е в самото управление или е резултат от друга неизправност.',
    border: 'border-slate-500',
  },
  {
    title: 'Фурната показва код за грешка',
    text: 'Кодът за грешка може да насочи диагностиката към определена система, но не доказва автоматично коя част трябва да бъде сменена. Техникът съпоставя кода с поведението на фурната и проверява съответните компоненти.',
    border: 'border-gray-500',
  },
];

const partsTable = [
  { part: 'Долен нагревател', problem: 'Не пече добре отдолу / не загрява' },
  { part: 'Горен нагревател', problem: 'Недостатъчно нагряване отгоре' },
  { part: 'Грил нагревател', problem: 'Грил функцията не работи' },
  { part: 'Кръгов нагревател', problem: 'Проблем при режим с вентилатор' },
  { part: 'Термостат', problem: 'Неправилна температура' },
  { part: 'Температурен датчик', problem: 'Прегряване или недостатъчно нагряване' },
  { part: 'Термозащита', problem: 'Фурната прекъсва или не стартира' },
  { part: 'Вентилатор', problem: 'Неравномерно печене' },
  { part: 'Мотор на вентилатора', problem: 'Вентилаторът не работи / шуми' },
  { part: 'Селектор за функции', problem: 'Определен режим не работи' },
  { part: 'Програматор', problem: 'Проблем със стартирането или програмите' },
  { part: 'Таймер / дисплей', problem: 'Проблем с управлението' },
  { part: 'Електронен модул', problem: 'Уредът не реагира или прекъсва' },
  { part: 'Панти', problem: 'Вратата не се затваря' },
  { part: 'Уплътнение', problem: 'Загуба на топлина' },
  { part: 'Осветление', problem: 'Лампата не работи' },
];

const realCases = [
  {
    brand: 'Whirlpool',
    problem: 'Фурната не изпичаше отдолу',
    area: 'Чайка',
    diagnosis: 'Установихме проблем с долния нагревател на машината.',
    repair: 'След смяна на нагревателя фурната работи нормално.',
    image: '/img/services/ремонт-на-фурна-варна-случай-1.webp',
    alt: 'Ремонт на фурна Whirlpool, която не изпича отдолу, с подмяна на повреден долен нагревател в кв. Чайка, Варна.',
  },
  {
    brand: 'Samsung',
    problem: 'Фурната не се включваше и изключваше предпазителя',
    area: 'Възраждане',
    diagnosis: 'Установихме проблем с основната платка.',
    repair: 'Клиентът предпочете да не извърши ремонта след получената оферта; при подобни повреди смяната на платката може да възстанови нормалната работа на фурната.',
    image: '/img/services/ремонт-на-фурна-варна-случай-2.webp',
    alt: 'Ремонт на фурна Samsung, която не се включва и изключва предпазителя, с диагностициран проблем в основната платка в кв. Възраждане, Варна.',
  },
  {
    brand: 'Bosch',
    problem: 'Фурната не загряваше отгоре',
    area: 'Младост',
    diagnosis: 'Установихме проблем с горен нагревателен елемент.',
    repair: 'След подмяната на елемента фурната работи нормално.',
    image: '/img/services/ремонт-на-фурна-варна-случай-3.webp',
    alt: 'Ремонт на фурна Bosch, която не загрява отгоре, с подмяна на повреден горен нагревател в кв. Младост, Варна.',
  },
];

const processSteps = [
  {
    step: 1,
    title: 'Свързвате се с РотоРем',
    text: 'Опишете как се проявява проблемът с фурната. Ако определена функция не работи или дисплеят показва код за грешка, кажете това при заявката.',
    circleClass: 'bg-gradient-to-r from-orange-500 to-orange-600',
  },
  {
    step: 2,
    title: 'Уговаряме посещение',
    text: 'Техник посещава посочения адрес във Варна според уговорката.',
    circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600',
  },
  {
    step: 3,
    title: 'Извършваме диагностика',
    text: 'Проверяват се компонентите и системите, свързани с конкретния симптом.',
    circleClass: 'bg-gradient-to-r from-red-500 to-red-600',
  },
  {
    step: 4,
    title: 'Получавате информация за ремонта',
    text: 'Обясняваме какво е установено и какъв ремонт се препоръчва.',
    circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600',
  },
  {
    step: 5,
    title: 'Ремонт и тест',
    text: 'Когато е възможно, ремонтът се извършва на място и работата на фурната се проверява преди приключване на посещението.',
    circleClass: 'bg-gradient-to-r from-orange-600 to-orange-800',
  },
];

const brands = ['Bosch', 'Siemens', 'Electrolux', 'Whirlpool', 'Beko', 'Indesit', 'Gorenje'];

const faqs = getServiceFaqItems('/services/oven-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="oven-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на фурна на адрес във Варна"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-orange-950/85 via-orange-900/75 to-orange-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.2),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес във Варна
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на фурни по домовете във Варна
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Фурната не загрява, не достига зададената температура, пече неравномерно или изключва по време на работа? РотоРем извършва диагностика и ремонт на фурни по домовете във Варна. Проверяваме причината за конкретния проблем, преди да бъде предприета подмяна на нагревател, термостат, датчик, вентилатор, електронен компонент или друга част.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            Работим с вградени и свободностоящи електрически фурни и извършваме ремонта на адрес, когато повредата позволява.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Диагностика във Варна</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт и диагностика на фурни на адрес</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            При фурните един и същ симптом може да бъде причинен от различни компоненти. Фурна, която не загрява например, може да има повреден нагревател, но причината може да бъде и в термостата, температурния датчик, термозащитата, електронното управление или друга част от системата.
          </p>
          <p>
            При неравномерно печене проблемът може да бъде свързан с отделен нагревател, вентилатора или контрола на температурата. Затова ремонтът започва с диагностика. Според конкретния симптом техникът проверява компонентите и системите, които могат да го причинят.
          </p>
          <p>
            След проверката клиентът получава информация какво е установено и какъв ремонт се препоръчва. Когато естеството на повредата позволява, ремонтът се извършва на адрес във Варна. Можете да видите и <a href="/reviews/" class="text-orange-700 font-medium hover:underline">отзиви от клиенти на РотоРем</a>, включително за ремонти на фурни във Варна.
          </p>
        </div>
      </section>
    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Фурна" />

    <div class="container max-w-5xl">
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви повреди на фурни ремонтираме</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-orange-50 via-white to-orange-50 p-6 md:p-8 rounded-2xl shadow-xl border border-orange-100">
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
                {item.extra && item.link && (
                  <p class="mt-3 text-gray-800 leading-relaxed">
                    {item.extra}
                    <a href={item.link.href} class="font-semibold text-orange-700 hover:underline">{item.link.label}</a>.
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="orange" /></div>}

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика на фурни във Варна</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Диагностиката има за цел да установи конкретната причина за проблема преди подмяна на части.
            </p>
            <p class="font-medium text-gray-900">В зависимост от симптома могат да бъдат проверени:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>долен, горен, грил и кръгов нагревател;</li>
              <li>термостат, температурен датчик и термозащита;</li>
              <li>вентилатор и мотор на вентилатора;</li>
              <li>селектор за функции, програматор, таймер и дисплей;</li>
              <li>електронен модул и управляваща платка;</li>
              <li>електрически връзки, врата, панти, уплътнение и осветление;</li>
              <li>кодове за грешка.</li>
            </ul>
            <p>След проверката клиентът получава информация какво е установено и какъв ремонт е необходим.</p>
            <p class="font-semibold text-gray-900">Посещение и диагностика във Варна: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на фурна във Варна"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на фурната, които проверяваме и ремонтираме</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-orange-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-orange-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-orange-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Често свързан симптом</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
