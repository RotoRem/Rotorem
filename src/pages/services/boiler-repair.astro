---
import Layout from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = 'Ремонт и монтаж на бойлери във Варна | Сервиз РотоРем';
const description = 'Ремонт на бойлери Варна с бърз сервиз на адрес ✓ Професионален монтаж и демонтаж ✓ Гаранция за качество ✓ Свържете се с нас на ☎ 089 834 0982!';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-teal-600 to-teal-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Ремонт и монтаж на бойлери във Варна
        </h1>
        <p class="text-xl md:text-2xl text-teal-100 max-w-3xl mx-auto mb-8">
          Професионален ремонт и поддръжка на електрически бойлери във Варна. Бърз сервиз на място с гаранция.
        </p>
        <p class="text-base md:text-lg text-teal-100 max-w-2xl mx-auto mb-8">
          Диагностика във Варна - 20,46 € (40лв)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-teal-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпратете имейл
          </a>
          <a href="tel:+359 89 834 0982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">
      <!-- Schema for Service Page -->
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Ремонт на бойлери Варна",
        "description": "Професионален ремонт и поддръжка на електрически бойлери във Варна и региона. Бърз сервиз на място, гаранция, ремонт в същия ден.",
        "url": "https://www.rotorem.bg/услуги/ремонт-бойлери",
        "provider": {
          "@type": "LocalBusiness",
          "name": "РотоРем Варна",
          "telephone": "+359 89 834 0982",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Варна",
            "addressCountry": "BG"
          }
        },
        "areaServed": [
          {"@type": "City", "name": "Варна"},
          {"@type": "Place", "name": "Чайка"},
          {"@type": "Place", "name": "Младост"},
          {"@type": "Place", "name": "Аспарухово"}
        ],
        "serviceType": "Appliance Repair",
        "offers": {
          "@type": "Offer",
          "price": "30",
          "priceCurrency": "BGN",
          "description": "Диагностика"
        }
      }
      </script>

      <!-- Why Choose Us -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете нашия сервиз за бойлери във Варна?</h2>
          <div class="w-20 h-1 bg-teal-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-teal-50 to-teal-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-teal-200">
            <div class="w-12 h-12 bg-teal-600 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-teal-900 mb-3">Сервиз на място</h3>
            <p class="text-teal-800">Посещение във Варна в удобен за вас час. Без излишно чакане.</p>
          </div>
          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-emerald-200">
            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-emerald-900 mb-3">Бърза реакция</h3>
            <p class="text-emerald-800">В повечето случаи завършваме ремонта в същия ден.</p>
          </div>
          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Гаранция</h3>
            <p class="text-amber-800">Гаранция за извършения ремонт и използваните части.</p>
          </div>

          <div class="bg-gradient-to-br from-lime-50 to-lime-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-lime-200">
            <div class="w-12 h-12 bg-lime-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
