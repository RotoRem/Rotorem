  .boiler-service-page :global(#service-pricing-heading + div + p),
  .boiler-service-page :global(section[aria-labelledby="service-pricing-heading"] .text-gray-600),
  .boiler-service-page :global(section[aria-labelledby="service-pricing-heading"] .text-gray-500) {
    color: rgb(31 41 55) !important;
  }
