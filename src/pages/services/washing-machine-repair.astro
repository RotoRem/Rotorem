---
import Layout from '../../layouts/Base.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import { getServicePricing } from '../../data/service-prices';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pricing = getServicePricing('washing-machine', 'varna', lang);

const title = 'Ремонт на перални по домовете във Варна | Сервиз РотоРем';
const description = 'Професионален сервиз за ремонт и монтаж на перални по домовете във Варна ✓ Гаранция за качество ✓ Всички марки перални ✓ Обадете се сега на ☎ 089 834 0982!';
---

<Layout title={title} description={description}>
  <article class="">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16 mb-16">
      <div class="container max-w-4xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Ремонт и монтаж на перални по домовете във Варна
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
          Професионален ремонт на перални машини във Варна и околността. Бърз сервиз на място с гаранция за качество.
        </p>
        <p class="text-base md:text-lg text-blue-100 max-w-2xl mx-auto mb-8">
          Диагностика във Варна - 20,46 €
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпратете имейл
          </a>
          <a href="tel:0898340982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-4xl">

      <!-- Why Choose Us Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете нашия сервиз за перални машини във Варна?</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-blue-200">
            <div class="w-12 h-12 bg-blue-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-blue-900 mb-3">Бърз ремонт на място</h3>
            <p class="text-blue-800">Нашият техник идва директно във вашия дом във Варна, за да ремонтира пералнята машина. Не е нужно да транспортирате тежкия уред до сервиз.</p>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-green-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-green-200">
            <div class="w-12 h-12 bg-green-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-green-900 mb-3">Ремонт в същия ден</h3>
            <p class="text-green-800">В повечето случаи ремонтираме перални машини в същия ден във Варна. Бърза диагностика и ефективно решаване на проблема.</p>
          </div>

          <div class="bg-gradient-to-br from-amber-50 to-amber-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-amber-200">
            <div class="w-12 h-12 bg-amber-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-900 mb-3">Гаранция за качество</h3>
            <p class="text-amber-800">Всички ремонти на перални машини във Варна се извършват с гаранция за качеството на работата и използваните части.</p>
          </div>

          <div class="bg-gradient-to-br from-purple-50 to-purple-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-purple-200">
            <div class="w-12 h-12 bg-purple-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-purple-900 mb-3">Обслужваме цяла Варна</h3>
            <p class="text-purple-800">Ремонтираме перални машини в кварталите: Чайка, Младост, Аспарухово, Левски, Владислав Варненчик, Център и други райони на Варна.</p>
          </div>

          <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-indigo-200">
            <div class="w-12 h-12 bg-indigo-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-indigo-900 mb-3">Всички марки перални</h3>
            <p class="text-indigo-800">Ремонтираме перални машини от всички марки: Bosch, Samsung, LG, Whirlpool, Indesit, Hotpoint, Candy и други.</p>
          </div>

          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-emerald-200">
            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-emerald-900 mb-3">Справедливи цени</h3>
            <p class="text-emerald-800">Диагностика във Варна - 20,46 €. <br> Ясни цени без скрити такси за ремонт на перални машини във Варна.</p>
          </div>
        </div>
      </section>

      <!-- Common Problems Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Най-чести проблеми с перални машини във Варна</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        
        <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 p-8 rounded-2xl shadow-xl border border-blue-100">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-blue-500">
              <h3 class="text-lg font-semibold text-blue-900 mb-3">От пералнята тече вода</h3>
              <p class="text-blue-800">Течове отдолу, от вратата или от дозатора за препарати. Нашият техник ще намери и отстрани теча бързо.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-green-500">
              <h3 class="text-lg font-semibold text-green-900 mb-3">Пералнята не центрофугира</h3>
              <p class="text-green-800">Барабанът не се върти поради проблеми с мотора, ремъка или електрониката. Ремонтираме на място във Варна.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-amber-500">
              <h3 class="text-lg font-semibold text-amber-900 mb-3">Пералнята не източва вода</h3>
              <p class="text-amber-800">Проблем с помпата за източване или запушване на филтъра. Професионално почистване и ремонт.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-red-500">
              <h3 class="text-lg font-semibold text-red-900 mb-3">Пералнята не се включва</h3>
              <p class="text-red-800">Електрически проблеми, повредени контакти или платка. Диагностика и ремонт от сертифициран техник във Варна.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-purple-500">
              <h3 class="text-lg font-semibold text-purple-900 mb-3">Пералнята не пере добре</h3>
              <p class="text-purple-800">Проблеми с дозирането на препарати, запушени филтри или износени части. Възстановяваме пълната функционалност.</p>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-l-4 border-indigo-500">
              <h3 class="text-lg font-semibold text-indigo-900 mb-3">От пералнята се чува шум</h3>
              <p class="text-indigo-800">Износени лагери, разхлабени болтове или чужди предмети в барабана. Отстраняваме всички причини за шум.</p>
            </div>
          </div>
        </div>
      </section>

      {pricing && <ServicePricing pricing={pricing} accent="blue" />}

      <!-- Process Section -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Процес на ремонт на перални машини във Варна</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">1</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Вие ни звъните</h3>
              <p class="text-gray-700">Обадете се на 089 834 0982 за ремонт на пералня машина във Варна.</p>
            </div>
          </div>
          
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ние идваме при вас</h3>
              <p class="text-gray-700">Нашият техник пристига в уговореното време с всички необходими инструменти и части.</p>
            </div>
          </div>
          
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">3</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ремонтираме</h3>
              <p class="text-gray-700">Диагностицираме проблема и ремонтираме пералнята ви машина в същия ден в дома ви във Варна.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Brands Section - Clean text-focused approach -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Марки перални, които ремонтираме във Варна</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        
        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {[
              'Bosch', 'Samsung', 'LG', 'Whirlpool', 
              'Indesit', 'Hotpoint', 'Candy', 'Други марки'
            ].map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200 group hover:border-blue-300">
                <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                  {brand}
                </h3>
                <p class="text-xs text-gray-600">
                  {brand === 'Други марки' ? 'Всички други марки' : `Ремонт на ${brand}`}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Service Areas -->
      <section class="mb-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Райони във Варна, които обслужваме</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { area: 'Център на Варна', desc: 'Ремонт на перални в центъра' },
            { area: 'Чайка', desc: 'Сервиз за перални в Чайка' },
            { area: 'Младост', desc: 'Ремонт на перални в Младост' },
            { area: 'Аспарухово', desc: 'Техник за перални в Аспарухово' },
            { area: 'Левски', desc: 'Ремонт на перални в Левски' },
            { area: 'Владислав Варненчик', desc: 'Ремонт на перални във Владислав Варненчик' }
          ].map((item, index) => (
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-blue-200">
              <h3 class="font-semibold text-blue-900 mb-2">{item.area}</h3>
              <p class="text-sm text-blue-800">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Final CTA -->
      <section class="text-center bg-gradient-to-r from-blue-600 to-blue-800 text-white p-12 rounded-2xl shadow-2xl">
        <h2 class="text-3xl font-bold mb-4">Нужен ви е ремонт на пералня машина във Варна?</h2>
        <p class="text-xl mb-8 text-blue-100">Обадете се сега за бърз ремонт на място!</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
          <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Изпрати имейл
          </a>
          <a href="tel:0898340982" class="bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
            Обади се на 089 834 0982
          </a>
        </div>
        
        <div class="text-blue-100">
          <p class="text-sm">
            Посещение и диагностика: Варна - 20,46 € • Гаранция за качество • Сервиз във Варна
          </p>
        </div>
      </section>
    </div>
  </article>

  <!-- SEO Content Section -->
  <div class="rotorem-seo-text">
    <div class="container max-w-4xl">
      <p>Когато пералнята спре да работи или започне да създава проблеми, ежедневието се нарушава веднага. Ние предлагаме бърз и практичен ремонт на перални по домовете във Варна, без да се налага транспортиране на уреда до сервиз. Реагираме в кратки срокове, диагностицираме проблема на място и отстраняваме повредата директно при вас.</p>
      <h2>Какви повреди на перални ремонтираме във Варна</h2>
      <p>Всеки проблем има решение, стига да бъде диагностициран правилно. При нас можете да разчитате на професионален ремонт при често срещани ситуации когато центрофугата на пералнята не работи, не източва или не загрява водата и при други подобни проблеми.</p>
      <p>Извършваме както стандартни ремонти, така и по-специфични услуги като ремонт на барабан на пералня или смяна на лагери на пералня. При необходимост поемаме и монтаж на перални, включително правилно свързване към водопроводната и електрическата система, за да се избегнат бъдещи проблеми.</p>
      <p>Освен за поправка на перални, можете да разчитате на нас и за други уреди в дома. Ако имате нужда от съдействие, разгледайте услугите ни за <a href="https://www.rotorem.bg/services/dishwasher-repair/">ремонт на съдомиялни</a> или <a href="https://www.rotorem.bg/services/dryer-repair/">ремонт на сушилни</a>, както и пълния списък с решения за <a href="https://www.rotorem.bg/services/">ремонт на електроуреди в град Варна</a>. Това позволява да получите цялостно обслужване от нашият доверен екип.</p>
      <h2>Какви марки перални обслужваме във Варна</h2>
      <p>Работим с всички популярни марки на пазара и познаваме добре техните специфики. Извършваме ремонт на перални Bosch, Whirlpool, AEG, Samsung, LG, Beko, Indesit и други разпространени производители. Без значение дали уредът е нов модел или по-стар, можем да предложим адекватно решение. Натрупаният опит ни позволява бързо да открием причината за проблема и да предложим ефективен ремонт.</p>
      <h2>Райони във Варна, които обслужваме</h2>
      <p>Покриваме цялата градска зона. Посещаваме адреси в квартали като Чайка, Левски, Владислав Варненчик, Младост, Аспарухово, Галата и централната част. Осигуряваме сервиз по домовете и в радиус до 20 км от Варна, което гарантира удобство и бърза реакция, независимо къде се намирате.</p>
      <h2>Как протича ремонтът</h2>
      <p>Процесът е максимално опростен, за да спестим време и усилия. След заявка организираме посещение в удобен за вас час. На място извършваме диагностика, за да установим точната причина за повредата. След това получавате ясна оферта с крайна цена за ремонта.</p>
      <p>При съгласие започваме работа веднага, като използваме подходящи части и инструменти. След приключване тестваме уреда, за да сме сигурни, че всичко функционира нормално. Така гарантираме, че ремонтът на перални в дома ви се извършва бързо, прозрачно и без излишни усложнения.</p>
      <h2>Защо да изберете сервиз за перални РотоРем</h2>
