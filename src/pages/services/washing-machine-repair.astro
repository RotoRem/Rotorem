          </div>
          
          <div class="text-center group">
            <div class="relative mb-6">
              <div class="w-20 h-20 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-full flex items-center justify-center mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <span class="text-2xl font-bold">2</span>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Ние идваме при вас</h3>
