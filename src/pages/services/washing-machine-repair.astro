---
import Layout from '../../layouts/Base.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import Reviews from '../../components/Reviews.astro';
import { getServicePricing } from '../../data/service-prices';
import { getServiceFaqItems } from '../../lib/jsonldOverrides';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const pricing = getServicePricing('washing-machine', 'varna', lang);

const title = 'Ремонт на перални във Варна | Сервиз на адрес | РотоРем';
const description = 'Ремонт и диагностика на перални по домовете във Варна. Отстраняване на течове, проблеми с центрофуга, източване, нагряване, лагери, помпи и електроника. Обадете се на РотоРем.';

const heroImage = '/img/services/ремонт-на-пералня-варна-HERO.webp';
const diagnosticImage = '/img/services/ремонт-на-пералня-варна-диагностика.webp';

const problems = [
  {
    title: 'Пералнята не източва водата',
    text: 'Ако след края на програмата в барабана остава вода, проблемът може да бъде свързан със запушен филтър, дренажния маркуч, помпата за източване или друга част от дренажната система. При диагностиката се проверява дали има механично запушване и дали помпата работи правилно, преди да се предприеме подмяна на компонент.',
    border: 'border-blue-500',
  },
  {
    title: 'Пералнята не центрофугира',
    text: 'Когато пералнята пере, но не преминава нормално към центрофуга, причината може да бъде в двигателя, ремъка, четките, електронното управление, източването или движението на барабана. Преди ремонт техникът проверява дали проблемът е механичен, електрически или свързан с друга система на пералнята.',
    border: 'border-green-500',
    link: { href: '/blog/peralnyata-ne-tsentrofugira-prichini/', label: 'Какво може да причини проблем с центрофугата' },
  },
  {
    title: 'Пералнята не загрява водата',
    text: 'Студеното пране не винаги означава автоматично изгорял нагревател. Причината може да бъде самият нагревател, температурният датчик, електронният модул или управлението на програмата. При диагностиката се проверява конкретната причина и едва след това се определя дали е необходим ремонт или подмяна на част.',
    border: 'border-amber-500',
  },
  {
    title: 'Пералнята тече',
    text: 'Течът може да се появи около люка, под пералнята или по време на определен етап от програмата. Проверяват се маншонът на люка, входящите и изходящите маркучи, помпата, връзките и останалите места, през които може да се получи загуба на вода. При теч е препоръчително машината да не се използва до установяване на причината.',
    border: 'border-red-500',
  },
  {
    title: 'Пералнята шуми или вибрира силно',
    text: 'Силен шум при центрофуга, метално стържене, удари или прекалени вибрации могат да бъдат свързани с лагери, амортисьори, барабан, ремък, чужд предмет или неправилно нивелиране. Точният характер на шума често дава първа насока, но окончателната причина се установява след проверка на машината.',
    border: 'border-purple-500',
  },
  {
    title: 'Барабанът не се върти',
    text: 'Когато пералнята стартира, но барабанът не се върти нормално, трябва да бъдат проверени ремъкът, моторът, четките, електронното управление и механичната част на барабана. Причината може да бъде сравнително малка повреда, но може да е и признак за по-сериозен проблем, затова е важно машината да бъде диагностицирана.',
    border: 'border-indigo-500',
  },
  {
    title: 'Пералнята не стартира',
    text: 'Ако пералнята не реагира или програмата не тръгва, проверката може да включва захранването, заключването на люка, управляващата платка, програматора и останалите електронни компоненти. Не всяка пералня, която „не тръгва“, има повредена платка. Диагностиката трябва да започне от конкретния симптом.',
    border: 'border-teal-500',
    extra: 'При проблем със захранването или инсталацията може да е необходима и проверка на електрическата инсталация.',
    link: { href: '/services/electrical-services/', label: 'Електрически услуги на адрес' },
  },
  {
    title: 'Люкът на пералнята не се отваря',
    text: 'Блокираният люк може да бъде причинен от дефект в заключващия механизъм, останала вода в машината или проблем с програмата и електрониката. Не е препоръчително вратата да се отваря със сила, защото това може да повреди дръжката, механизма или самия люк.',
    border: 'border-orange-500',
  },
  {
    title: 'Пералнята показва код за грешка',
    text: 'Кодовете за грешка помагат при диагностиката, но един код невинаги означава, че конкретна част трябва директно да бъде сменена. Техникът използва информацията от дисплея заедно с реалното поведение на машината и проверките на съответните компоненти, за да установи причината за проблема.',
    border: 'border-slate-500',
  },
];

const partsTable = [
  { part: 'Помпа за източване', problem: 'Пералнята не източва водата' },
  { part: 'Филтър и дренаж', problem: 'Остава вода или машината прекъсва' },
  { part: 'Нагревател', problem: 'Водата не се загрява' },
  { part: 'Температурен датчик', problem: 'Неправилно нагряване' },
  { part: 'Лагери', problem: 'Силен шум при центрофуга' },
  { part: 'Семеринг', problem: 'Проблем около лагерите и проникване на вода' },
  { part: 'Ремък', problem: 'Барабанът не се върти' },
  { part: 'Мотор', problem: 'Липса или проблем с въртенето' },
  { part: 'Четки на мотор', problem: 'Проблем с въртенето и центрофугата' },
  { part: 'Амортисьори', problem: 'Силни вибрации' },
  { part: 'Маншон', problem: 'Теч около люка' },
  { part: 'Входящ клапан', problem: 'Пералнята не пълни вода' },
  { part: 'Заключване на люка', problem: 'Машината не стартира или вратата остава блокирана' },
  { part: 'Програматор', problem: 'Програмата не работи правилно' },
  { part: 'Електронен модул', problem: 'Машината прекъсва, не стартира или показва грешки' },
];

const realCases = [
  {
    brand: 'Bosch',
    problem: 'Имаше теч на вода от пералня',
    area: 'Христо Ботев',
    diagnosis: 'Установи се, че е от челния маншон за люка на пералнята.',
    repair: 'След подмяната му теча е преустановен и пералнята работи нормално.',
    image: '/img/services/ремонт-на-пералня-варна-случай-1.webp',
    alt: 'Ремонт на пералня Bosch с теч на вода от челния маншон, с подмяна на повредения маншон в кв. Христо Ботев, Варна.',
  },
  {
    brand: 'LG',
    problem: 'Пералня не източваше вода',
    area: 'Център',
    diagnosis: 'Оказа се изгоряла помпа за източване на водата.',
    repair: 'След подмяната и машината източва водата както е необходимо и пералнята работи нормално.',
    image: diagnosticImage,
    alt: 'Ремонт на пералня LG, която не източва водата, с подмяна на изгоряла дренажна помпа в Център, Варна.',
  },
  {
    brand: 'Candy',
    problem: 'Пералнята издаваше голям шум при центрофугиране',
    area: 'Владислав Варненчик',
    diagnosis: 'Оказа се, че има проблем с амортисьорите на пералнята.',
    repair: 'След подмяна на амортисьорите на пералнята и нивелирането и шумът изчезна и пералнята работи нормално.',
    image: '/img/services/ремонт-на-пералня-варна-случай-2.webp',
    alt: 'Ремонт на пералня Candy със силен шум при центрофугиране, с подмяна на повредени амортисьори и нивелиране в кв. Владислав Варненчик, Варна.',
  },
];

const processSteps = [
  { step: 1, title: 'Свързвате се с РотоРем', text: 'Опишете какъв проблем има пералнята и как се проявява.', circleClass: 'bg-gradient-to-r from-blue-500 to-blue-600' },
  { step: 2, title: 'Уговаряме посещение', text: 'Техник посещава адреса във Варна според уговорката.', circleClass: 'bg-gradient-to-r from-green-500 to-green-600' },
  { step: 3, title: 'Извършваме диагностика', text: 'Проверяват се компонентите и системите, свързани с конкретния симптом.', circleClass: 'bg-gradient-to-r from-amber-500 to-amber-600' },
  { step: 4, title: 'Получавате информация за ремонта', text: 'Обясняваме каква повреда е установена и какво трябва да бъде направено.', circleClass: 'bg-gradient-to-r from-violet-500 to-violet-600' },
  { step: 5, title: 'Ремонт и тест', text: 'При възможност ремонтът се извършва на място и пералнята се тества преди приключване на посещението.', circleClass: 'bg-gradient-to-r from-indigo-500 to-indigo-600' },
];

const brands = ['Bosch', 'Siemens', 'AEG', 'Electrolux', 'Gorenje', 'Samsung', 'LG', 'Beko', 'Indesit', 'Whirlpool'];

const faqs = getServiceFaqItems('/services/washing-machine-repair/');
const sectionClass = 'mb-28 pt-4';
---

<Layout title={title} description={description} hideServiceFaq={true}>
  <article class="wm-service-page">
    <!-- Hero -->
    <section class="relative min-h-[560px] md:min-h-[640px] flex items-center overflow-hidden mb-24">
      <img
        src={heroImage}
        alt="Ремонт на пералня на адрес във Варна"
        class="absolute inset-0 w-full h-full object-cover object-center scale-105"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/85 via-blue-900/75 to-blue-800/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.18),transparent_45%)]"></div>

      <div class="container max-w-5xl relative z-10 py-16 md:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <span class="inline-block mb-5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
            Сервиз на адрес във Варна
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Ремонт на перални по домовете във Варна
          </h1>
          <p class="text-lg md:text-xl text-white/95 mb-5 leading-relaxed">
            Проблем с пералнята? РотоРем извършва диагностика и ремонт на перални по домовете във Варна. Работим при проблеми с източване, центрофуга, нагряване, течове, шум, барабан, помпа, лагери, мотор и електроника.
          </p>
          <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
            Техник посещава адреса, установява причината за повредата и ви информира какъв ремонт е необходим преди извършването му.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Диагностика във Варна</p>
              <p class="text-xl font-bold text-white">20 €</p>
            </div>
            <div class="rounded-xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
              <p class="text-xs uppercase tracking-wide text-white/80 mb-1">Телефон</p>
              <a href="tel:0898340982" class="text-xl font-bold text-white hover:underline">089 834 0982</a>
            </div>
          </div>

          <a href="tel:0898340982" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-xl font-semibold shadow-xl shadow-amber-900/30 transition-colors text-lg">
            Обадете се за посещение
          </a>
        </div>
      </div>
    </section>

    <div class="container max-w-5xl">

      <!-- Intro -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт и диагностика на перални на адрес</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="max-w-4xl mx-auto space-y-5 text-base md:text-lg text-gray-800 leading-relaxed">
          <p>
            При повреда на пералнята първата задача е да се установи откъде действително идва проблемът. Един и същ симптом може да бъде причинен от различни компоненти, затова не препоръчваме подмяна на части преди извършване на диагностика.
          </p>
          <p>
            При посещението техникът проверява състоянието на пералнята според конкретния проблем – системата за подаване и източване на вода, нагревателя, помпата, двигателя, барабана, електрониката и останалите компоненти, свързани със симптома.
          </p>
          <p>
            Когато ремонтът може да бъде извършен на място, той се прави по време на посещението. При необходимост от специфична резервна част клиентът предварително получава информация какво трябва да бъде подменено. Можете да видите и <a href="/reviews/" class="text-blue-700 font-medium hover:underline">отзиви от клиенти на РотоРем</a>, които потвърждават качеството на обслужването.
          </p>
        </div>
      </section>

    </div>

    <Reviews title="Отзиви от клиенти на РотоРем" prioritizeAppliance="Пералня" />

    <div class="container max-w-5xl">

      <!-- Problems -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Какви повреди на перални ремонтираме</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 p-6 md:p-8 rounded-2xl shadow-xl border border-blue-100">
          <div class="grid md:grid-cols-2 gap-8">
            {problems.map((item) => (
              <div class={`bg-white p-6 rounded-xl shadow-md border-l-4 ${item.border}`}>
                <h3 class="text-lg font-semibold mb-3 text-gray-900">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
                {item.extra && item.link && (
                  <p class="mt-3 text-gray-800 leading-relaxed">
                    {item.extra}{' '}
                    <a href={item.link.href} class="font-semibold text-blue-700 hover:underline">{item.link.label}</a>.
                  </p>
                )}
                {item.link && !item.extra && (
                  <p class="mt-3">
                    <a href={item.link.href} class="font-bold text-blue-700 hover:underline">{item.link.label}</a>
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Diagnostics -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Диагностика на перални във Варна</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div class="space-y-5 text-gray-800 leading-relaxed">
            <p>
              Диагностиката е отделна част от ремонта и има за цел да установи причината за повредата, преди да се подменят части.
            </p>
            <p class="font-medium text-gray-900">В зависимост от симптома могат да бъдат проверени:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>системата за подаване на вода;</li>
              <li>помпата и източването;</li>
              <li>филтърът и дренажният маркуч;</li>
              <li>нагревателят;</li>
              <li>температурните датчици;</li>
              <li>моторът и четките;</li>
              <li>ремъкът;</li>
              <li>барабанът;</li>
              <li>лагерите и амортисьорите;</li>
              <li>заключващият механизъм;</li>
              <li>програматорът;</li>
              <li>електронният модул и управляващата платка.</li>
            </ul>
            <p>
              След проверката клиентът получава информация какво е установено и какъв ремонт е необходим.
            </p>
            <p class="font-semibold text-gray-900">Цена за диагностика във Варна: 20 €</p>
          </div>
          <div>
            <img
              src={diagnosticImage}
              alt="Диагностика на пералня във Варна"
              class="w-full rounded-2xl shadow-lg object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>
        </div>
      </section>

      <!-- Parts table -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Части и системи на пералнята, които проверяваме и ремонтираме</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="md:hidden space-y-4">
          {partsTable.map((row) => (
            <div class="bg-white rounded-xl border border-blue-100 p-5 shadow-sm">
              <p class="font-semibold text-gray-900 mb-2">{row.part}</p>
              <p class="text-gray-800">{row.problem}</p>
            </div>
          ))}
        </div>

        <div class="hidden md:block overflow-hidden rounded-xl border border-blue-100 bg-white shadow-lg">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-blue-600 text-white">
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Част или система</th>
                <th scope="col" class="px-5 py-4 text-sm font-semibold">Често свързан проблем</th>
              </tr>
            </thead>
            <tbody>
              {partsTable.map((row, index) => (
                <tr class:list={['border-t border-gray-100', index % 2 === 1 ? 'bg-gray-50/70' : 'bg-white']}>
                  <td class="px-5 py-3 text-sm font-medium text-gray-900">{row.part}</td>
                  <td class="px-5 py-3 text-sm text-gray-800">{row.problem}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-8 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          Не е необходимо всяка повреда да води до смяна на част. В много случаи диагностиката показва друг проблем в системата, затова конкретният ремонт се определя след проверка.
        </p>
      </section>

      <!-- Bearings -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Смяна на лагери и проблеми с барабана</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100 space-y-5 text-gray-800 leading-relaxed max-w-4xl mx-auto">
          <p>Силно бучене или метален шум при центрофуга често насочват към проблем в лагерите, но преди ремонт трябва да се провери цялата механична система.</p>
          <p>При проверката могат да бъдат огледани лагерите, мерингът, барабанът и състоянието на останалите свързани компоненти.</p>
          <p>При по-стари перални е важно да се прецени и дали стойността на ремонта е разумна спрямо състоянието на машината.</p>
          <p>РотоРем информира клиента какво е установено и какъв ремонт се препоръчва, преди да започне работата.</p>
        </div>
      </section>

      <!-- Installation -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Монтаж и демонтаж на перални</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="space-y-8 text-gray-800 leading-relaxed">
          <p>Освен ремонт, РотоРем извършва монтаж и демонтаж на перални във Варна.</p>

          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Монтаж на пералня</h3>
            <p class="mb-3 font-medium text-gray-900">При монтажа може да бъдат извършени:</p>
            <ul class="list-disc pl-5 space-y-2 mb-4">
              <li>позициониране на пералнята;</li>
              <li>нивелиране;</li>
              <li>свързване към водопровода;</li>
              <li>свързване към канализацията;</li>
              <li>проверка на входящите и изходящите връзки;</li>
              <li>тест за правилна работа.</li>
            </ul>
            <p>Правилното нивелиране е особено важно, тъй като неправилно поставена машина може да вибрира и да се мести при центрофуга.</p>
          </div>

          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Демонтаж на пералня</h3>
            <p>При необходимост стара или повредена машина може да бъде безопасно разкачена от водопровода и канализацията. Целта е демонтажът да бъде направен без течове и без повреждане на съществуващите връзки.</p>
          </div>

          <div class="bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Пералня и сушилня</h3>
            <p>Когато към пералнята има и сушилня, може да бъде необходима допълнителна проверка на начина на разполагане и свързване на двата уреда. РотоРем извършва и <a href="/services/dryer-repair/" class="text-blue-700 font-medium hover:underline">ремонт и монтаж на сушилни във Варна</a>.</p>
          </div>
        </div>
      </section>

      {pricing && <div class={sectionClass}><ServicePricing pricing={pricing} accent="blue" /></div>}

      <!-- Brands -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Марки перални, които обслужваме</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="bg-gradient-to-r from-gray-50 to-white p-8 rounded-2xl shadow-lg">
          <p class="text-gray-800 leading-relaxed mb-6 text-center">
            РотоРем ремонтира перални на различни производители, включително:
          </p>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            {brands.map((brand) => (
              <div class="bg-white p-4 rounded-lg text-center shadow-sm hover:shadow-md transition-shadow border border-gray-200">
                <h3 class="font-semibold text-gray-900">{brand}</h3>
              </div>
            ))}
          </div>
          <p class="text-gray-800 leading-relaxed mt-6 text-center max-w-3xl mx-auto">
            При различните марки конструкцията, електрониката и кодовете за грешка могат да се различават, затова диагностиката се извършва според конкретния модел и симптом.
          </p>
        </div>
      </section>

      <!-- Real cases -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Реални ремонти на перални във Варна</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="space-y-8">
          <div class="grid lg:grid-cols-2 gap-8">
            {realCases.slice(0, 2).map((item) => (
              <article class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full md:w-2/5 lg:w-5/12 object-cover min-h-[220px] md:min-h-[280px]"
                  loading="lazy"
                  width="480"
                  height="360"
                />
                <div class="p-6 md:p-7 flex-1 space-y-3">
                  <h3 class="text-xl font-bold text-gray-900">{item.brand} – Пералня</h3>
                  <p class="text-gray-800"><span class="font-semibold">Проблем:</span> {item.problem}</p>
                  <p class="text-gray-800"><span class="font-semibold">Район:</span> {item.area}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Диагностика:</span> {item.diagnosis}</p>
                  <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Ремонт:</span> {item.repair}</p>
                </div>
              </article>
            ))}
          </div>

          <article class="flex flex-col lg:flex-row bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow max-w-5xl mx-auto">
            <img
              src={realCases[2].image}
              alt={realCases[2].alt}
              class="w-full lg:w-2/5 object-cover min-h-[240px] lg:min-h-[300px]"
              loading="lazy"
              width="560"
              height="400"
            />
            <div class="p-6 md:p-8 flex-1 space-y-3">
              <h3 class="text-xl font-bold text-gray-900">{realCases[2].brand} – Пералня</h3>
              <p class="text-gray-800"><span class="font-semibold">Проблем:</span> {realCases[2].problem}</p>
              <p class="text-gray-800"><span class="font-semibold">Район:</span> {realCases[2].area}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Диагностика:</span> {realCases[2].diagnosis}</p>
              <p class="text-gray-800 leading-relaxed"><span class="font-semibold">Ремонт:</span> {realCases[2].repair}</p>
            </div>
          </article>
        </div>
      </section>

      <!-- Process: 3 + 2 grid -->
      <section class={sectionClass}>
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Как протича ремонтът</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-8">
          {processSteps.slice(0, 3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {processSteps.slice(3).map((item) => (
            <div class="text-center">
              <div class:list={['w-16 h-16 text-white rounded-full flex items-center justify-center mx-auto shadow-lg mb-4', item.circleClass]}>
                <span class="text-xl font-bold">{item.step}</span>
              </div>
              <div class="bg-white p-5 rounded-xl shadow-lg border border-gray-100">
                <h3 class="text-base font-semibold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-800 leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Service areas -->
      <section class={sectionClass}>
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Ремонт на перални в различни райони на Варна</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>
        <div class="bg-gradient-to-r from-blue-50 via-white to-blue-50 p-6 md:p-8 rounded-2xl shadow-lg border border-blue-100 space-y-5 text-gray-800 leading-relaxed text-center max-w-3xl mx-auto">
          <p>
            РотоРем извършва посещения по домовете във Варна и обслужва различни части на града, включително райони като Младост, Левски, Чайка, Аспарухово, Владислав Варненчик и други обслужвани зони.
          </p>
          <p>
            Не е необходимо клиентът да транспортира пералнята до физически сервиз – техникът идва на посочения адрес.
          </p>
        </div>
      </section>

      <!-- FAQ -->
      <section class={sectionClass} id="faq">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Често задавани въпроси</h2>
          <div class="w-20 h-1 bg-blue-500 mx-auto"></div>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          {faqs.map((faq) => (
            <div class="bg-gradient-to-r from-gray-50 to-white rounded-lg border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
              <details class="group">
                <summary class="flex justify-between items-center p-5 cursor-pointer">
                  <h3 class="text-lg font-semibold text-gray-900 pr-4">{faq.q}</h3>
                  <div class="flex-shrink-0 text-gray-600 transition-transform duration-300 group-open:rotate-180">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </summary>
                <div class="p-5 pt-0 text-gray-800 border-t border-gray-100">
                  <p class="leading-relaxed">{faq.a}</p>
                </div>
              </details>
            </div>
          ))}
        </div>
      </section>
    </div>
  </article>

  <div class="container max-w-5xl mb-28">
    <section class="text-center bg-gradient-to-r from-blue-600 to-blue-800 text-white p-12 md:p-14 rounded-2xl shadow-2xl">
      <h2 class="text-3xl font-bold mb-4">Проблем с пералнята?</h2>
      <p class="text-lg md:text-xl mb-4 text-white/90 max-w-3xl mx-auto leading-relaxed">
        Ако пералнята не източва, не центрофугира, не загрява, тече, шуми или не стартира, свържете се с РотоРем за диагностика и ремонт на адрес във Варна.
      </p>
      <p class="text-lg mb-8">Телефон: <a href="tel:0898340982" class="font-semibold text-white hover:underline">089 834 0982</a></p>
      <a href="tel:0898340982" class="inline-block bg-amber-500 text-white px-8 py-4 rounded-lg font-semibold hover:bg-amber-600 transition-colors shadow-lg">
        Обадете се за посещение
      </a>
    </section>
  </div>
</Layout>

<style>
  .wm-service-page :global(#service-pricing-heading + div + p),
  .wm-service-page :global(section[aria-labelledby="service-pricing-heading"] .text-gray-600),
  .wm-service-page :global(section[aria-labelledby="service-pricing-heading"] .text-gray-500) {
    color: rgb(31 41 55) !important;
  }
