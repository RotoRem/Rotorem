---
import Layout from '../../../layouts/Base.astro';
import Reviews from '../../../components/Reviews.astro';

const title = 'Ремонт на перални Пловдив | РотоРем';
const description = 'Диагностика на място и ремонт на перални, котлони сушилни, съдомиялни, фурни и бойлери в Пловдив. Без транспорт на уреда. Обадете се на 089 834 0982.';

type IconKey = 'washing-machine' | 'dryer' | 'dishwasher' | 'oven' | 'boiler';

const serviceColors: Record<IconKey, string> = {
  'washing-machine': 'from-blue-700/80 to-blue-600/80',
  dryer: 'from-indigo-700/80 to-indigo-600/80',
  dishwasher: 'from-emerald-700/80 to-emerald-600/80',
  oven: 'from-amber-700/80 to-amber-600/80',
  boiler: 'from-teal-700/80 to-teal-600/80',
};

const icons: Record<IconKey, string> = {
  'washing-machine': `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="20" x="3" y="2" rx="2"/><circle cx="12" cy="14" r="4"/><circle cx="12" cy="14" r="1"/><path d="M8 6h.01M11 6h.01M14 6h.01"/></svg>`,
  dryer: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="20" x="3" y="2" rx="2"/><circle cx="12" cy="14" r="4"/><path d="M8 6h.01M11 6h.01M14 6h.01"/><path d="M16 10l2 2"/></svg>`,
  dishwasher: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M8 16v-4"/><path d="M16 16v-4"/><path d="M8 6h.01"/><path d="M12 6h.01"/><path d="M16 6h.01"/></svg>`,
  oven: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M7 16h10"/><path d="M7 8h10"/><path d="M7 12h10"/><path d="M7 7v6"/><path d="M17 7v6"/></svg>`,
  boiler: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="18" x="5" y="3" rx="2"/><path d="M8 21v-2M12 21v-2M16 21v-2"/><path d="M8 7h8M8 11h8"/></svg>`,
};

const services: { icon: IconKey; title: string; description: string; url: string }[] = [
  {
    icon: 'washing-machine',
    title: 'Перални',
    description: 'Най-честите повреди при перални са износени лагери, неработещ нагревател или повредена помпа за източване на вода. РотоРем Пловдив извършва диагностика и ремонт на перални машини на адрес в Пловдив, включително смяна на лагери, нагреватели и помпи.',
    url: '/services/remont-na-peralni-plovdiv/',
  },
  {
    icon: 'dryer',
    title: 'Сушилни',
    description: 'Сушилните машини често спират да сушат ефективно заради запушен кондензатор или изгорял нагревател. РотоРем Пловдив извършва диагностика и ремонт на адрес, без да е нужно демонтиране и пренасяне на уреда извън дома.',
    url: '/services/remont-na-sushilni-plovdiv/',
  },
  {
    icon: 'dishwasher',
    title: 'Съдомиялни',
    description: 'Съдомиялните най-често се нуждаят от смяна на нагревателен елемент или помпа. РотоРем Пловдив извършва диагностика и ремонт на адрес, без да е нужно демонтиране и пренасяне на уреда извън дома.',
    url: '/services/remont-na-sadomiyalni-plovdiv/',
  },
  {
    icon: 'oven',
    title: 'Фурни и котлони',
    description: 'При фурните чести повреди са изгорял нагревател или неизправен термостат. При котлоните РотоРем Пловдив извършва диагностика и смяна на повредена нагревателна зона.',
    url: '/services/remont-na-furni-plovdiv/',
  },
  {
    icon: 'boiler',
    title: 'Бойлери',
    description: 'При бойлерите най-честите намеси са смяна на нагревател или термостат, както и профилактика за удължаване на живота на уреда. Работата се извършва на мястото в Пловдив, където е монтиран, без демонтаж, освен когато е необходима пълна подмяна.',
    url: '/services/remont-na-boileri-plovdiv/',
  },
];

const stats = [
  { value: '5000', label: 'Успешни ремонти' },
  { value: '15+', label: 'Години опит' },
  { value: '24h', label: 'Време за реакция' },
  { value: '5★', label: 'Google рейтинг' },
];

const steps = [
  'Обаждане - свържете се с нас по телефона.',
  'Посещение - техникът идва в уговорения час.',
  'Диагностика - диагностика за 25 € и оферта за ремонта.',
  'Ремонт - ремонт на място с гаранция за работата.',
];

const brands = ['Bosch', 'Siemens', 'AEG', 'Electrolux', 'Whirlpool', 'Samsung', 'LG', 'Gorenje', 'Beko', 'Indesit'];
---

<Layout title={title} description={description} image="/img/hero-page-plovdiv.webp">
  <section class="relative overflow-hidden text-white">
    <img
      src="/img/hero-page-plovdiv.webp"
      alt="Ремонт на бяла техника на адрес в Пловдив"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-blue-900/80 to-blue-700/65"></div>

    <div class="container relative z-10 max-w-4xl text-center py-16 md:py-24">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 font-heading drop-shadow-sm">РотоРем Пловдив, сервиз за бяла техника</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8">
        РотоРем Пловдив извършва диагностика на място и ремонт на перални, котлони сушилни, съдомиялни, фурни и бойлери в дома на клиента, без да е нужно уредът да се транспортира до сервиз.
      </p>
      <p class="text-base md:text-lg text-blue-100 max-w-2xl mx-auto mb-4">
        Диагностика в Пловдив - 25 €
      </p>
      <p class="text-lg text-white font-medium mb-8">
        Ремонт още същия ден.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-primary px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Изпратете имейл
        </a>
        <a href="/contact/" class="bg-accent text-white px-8 py-4 rounded-lg font-semibold hover:bg-accent-dark transition-colors shadow-lg">
          Свържете се с нас
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-r from-blue-600 to-blue-800 py-8 shadow-inner border-t border-b border-blue-900/20">
    <div class="container">
      <div class="hidden md:grid md:grid-cols-4 gap-6 text-center">
        {stats.map((stat) => (
          <div class="flex flex-col items-center justify-center p-4">
            <div class="text-3xl font-bold text-white mb-1">{stat.value}</div>
            <div class="text-sm text-white/90 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-2 gap-4 md:hidden">
        {stats.map((stat) => (
          <div class="flex flex-col items-center justify-center p-4 bg-white/10 rounded-lg backdrop-blur-sm">
            <div class="text-2xl font-bold text-white mb-1">{stat.value}</div>
            <div class="text-xs text-white/90 font-medium text-center">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gradient-to-b from-blue-50 to-white relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-100 rounded-full opacity-50"></div>
    <div class="absolute -bottom-20 -left-20 w-60 h-60 bg-blue-100 rounded-full opacity-30"></div>
    <div class="container relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-2">Нашите услуги</h2>
        <div class="w-24 h-1 bg-primary mx-auto my-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mt-10">
        {services.map((service) => (
          <div class="relative rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow group">
            <div class="absolute inset-0">
              <div class={`absolute inset-0 bg-gradient-to-br ${serviceColors[service.icon]} group-hover:opacity-80 transition-opacity duration-300`}></div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
            </div>
            <div class="relative z-10 p-6 md:p-8 h-full flex flex-col text-white">
              <div class="flex items-center gap-4 mb-4">
                <div class="p-2 bg-white/20 rounded-full text-white">
                  <Fragment set:html={icons[service.icon]} />
                </div>
                <h3 class="text-xl font-semibold drop-shadow-sm">{service.title}</h3>
              </div>
              <p class="mt-2 text-white/90 flex-grow">{service.description}</p>
              <div class="mt-6 pt-4 border-t border-white/20">
                <a href={service.url} class="bg-white/30 hover:bg-white/40 backdrop-blur-sm text-white font-medium py-2 px-4 rounded-lg inline-flex items-center transition-colors shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>
                  Научете повече.
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-b from-white to-gray-50">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Защо да изберете РотоРем</h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <article class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Сервиз за бяла техника в Пловдив</h3>
          <p class="text-gray-600">РотоРем Пловдив е сервиз, специализиран в диагностика, ремонт и монтаж на бяла техника. Екипът на РотоРем покрива перални, сушилни, съдомиялни, фурни, котлони и бойлери. Бизнесът не поема услуги извън тези категории уреди, а се фокусира изцяло върху тях, което позволява на екипа да разпознава бързо повредите и да носи със себе си конкретните части, нужни за ремонт.</p>
        </article>

        <article class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Диагностика на място, без да носите уреда от сервиз</h3>
          <p class="text-gray-600">Пералня, която тежи над 60 килограма, или вграден бойлер, свързан с тръби и ел. инсталация, не са уреди, които се пренасят лесно до сервиз. Затова РотоРем работи по модел на сервиз по домовете: техникът идва с инструменти и резервни части на адреса в Пловдив, преглежда уреда на място и обяснява какво точно не работи, преди да започне ремонта.</p>
          <p class="text-gray-600 mt-4">Диагностиката на място пести време и елиминира риска от допълнителни щети при транспорт на тежка или вградена техника. Клиентът остава в дома си през целия процес и вижда с какво точно се занимава техникът.</p>
        </article>

        <article class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Прозрачност в ценообразуването</h3>
          <p class="text-gray-600">Преди да започне каквато и да е намеса, техникът на РотоРем обяснява на клиента какво точно е установил при диагностиката и какво предстои за отстраняване на повредата.</p>
          <p class="text-gray-600 mt-4">Цената за посещение и диагностика е 25 евро.Според проблема всичко останало се изкоментира на място с клиента.</p>
        </article>

        <article class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-gray-100">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Обслужваме цял Пловдив</h3>
          <p class="text-gray-600">РотоРем идва на адреси в Пловдив. Кварталите, които обслужваме: Център, Смирненски, Кършияка, Мараша, Кючук Париж, Каменица, Гагарин, Захарна фабрика, Филипово, Прослав, Коматево, Остромила, Беломорски. За адреси извън града се прилага доплащане от 2 € на километър.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Как работи нашият сервиз</h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        {steps.map((step, index) => (
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">{index + 1}</div>
            <p class="text-gray-900 font-semibold">{step}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-b from-gray-50 to-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Марки, които обслужваме</h2>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="mt-6 text-gray-800 leading-relaxed">
          РотоРем ремонтира бяла техника на всички популярни марки, сред които Bosch, Siemens, AEG, Electrolux, Whirlpool, Samsung, LG, Gorenje, Beko и Indesit.
        </p>
      </div>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {brands.map((brand) => (
          <li class="bg-white border border-gray-200 rounded-lg shadow-sm min-h-[4.5rem] px-4 py-4 flex items-center justify-center text-center font-semibold text-gray-900">
            {brand}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Reviews title="Отзиви от клиенти на РотоРем" />

  <section class="container pb-8">
    <div class="text-center bg-gradient-to-r from-primary to-primary-dark text-white py-16 px-6 rounded-2xl shadow-2xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 max-w-3xl mx-auto">Обадете се сега на 089 834 0982 за бърза диагностика на място в Пловдив и заявете час за ремонт.</h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:n.ivanov.ivanov@abv.bg" class="inline-flex items-center justify-center bg-white text-primary px-8 py-4 rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Изпрати имейл
        </a>
        <a href="tel:0898340982" class="bg-accent text-white px-8 py-4 rounded-lg font-semibold hover:bg-accent-dark transition-colors shadow-lg">
          Обади се на 089 834 0982
        </a>
      </div>
    </div>
  </section>
</Layout>
