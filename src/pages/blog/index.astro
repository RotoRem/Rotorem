---
import Layout from '../../layouts/Base.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEN = lang === 'en';

const title = isEN
  ? 'Appliance Repair Blog | Tips & Guides | RotoRem Varna'
  : 'Блог за ремонт на битова техника | Съвети и ръководства | РотоРем Варна';

const description = isEN
  ? 'Helpful tips and guides for appliance maintenance and repair from RotoRem Varna experts.'
  : 'Полезни съвети и ръководства за поддръжка и ремонт на битова техника от експертите на РотоРем Варна.';

const heading = isEN ? 'Appliance Repair Blog' : 'Блог за ремонт на битова техника';
const subheading = isEN
  ? 'Updates and guides from the RotoRem team.'
  : 'Актуализации и ръководства от екипа на РотоРем.';
const emptyMessage = isEN
  ? 'There are no published articles at the moment.'
  : 'В момента няма публикувани статии.';
---

<Layout title={title} description={description}>
  <section class="py-16">
    <div class="container max-w-3xl">
      <header class="text-center mb-10">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{heading}</h1>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-xl text-gray-600">{subheading}</p>
      </header>

      <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-700">
        <p class="text-lg">{emptyMessage}</p>
      </div>
    </div>
  </section>
</Layout>
