---
import Layout from '../../layouts/Base.astro';

const title = 'Съвети и ръководства за ремонти на битова техника от РотоРем';
const description = 'Научете как да удължите живота на вашите уреди ✓ Полезни съвети за поддръжка и ремонт на битова техника от експертите на РотоРем';

const heading = 'Блог за ремонт на битова техника';
const subheading = 'Новини и полезни ръководства от екипа на РотоРем.';
const emptyMessage = 'В момента няма публикувани статии.';
---

<Layout title={title} description={description}>
  <section class="py-16">
    <div class="container max-w-3xl">
      <header class="text-center mb-10">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{heading}</h1>
        <div class="w-20 h-1 bg-accent mx-auto my-4"></div>
        <p class="text-xl text-gray-600">{subheading}</p>
      </header>

      <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-700">
        <p class="text-lg">{emptyMessage}</p>
      </div>
    </div>
  </section>
</Layout>