const description = 'Шумна пералня София и Варна – разберете какво означават вибрации, тропане и течове и кога е време за професионален ремонт от РотоРем София, запазете час.';
const blogImage = '/img/blog/kogato-peralnyata-spre-remont-na-peralni-kojto-idva-na-myasto.jpg';
const datePublished = '2025-12-16';
