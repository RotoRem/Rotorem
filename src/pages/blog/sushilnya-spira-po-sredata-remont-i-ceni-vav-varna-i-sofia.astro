const description = 'Сушилня спира по средата, сушилня прекъсва програмата? РотоРем София диагностицира и ремонтира сушилни във Варна и София – заяви посещение още днес.';
const blogImage = '/img/blog/remont-na-sushilni-varna-serviz-sushilni-remont-sushilnya-sushilnya-ne-sushi-proverete-ceni.jpg';
const datePublished = '2025-12-30';
---

<Layout title={title} description={description}>
  <!-- Blog Post Header -->
